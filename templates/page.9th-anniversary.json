n","review_info":"We hosted a cookout with my famaliy, and the Eminence 425 didn’t flinch. Burgers, brats, corn, skewers—all going at once. The burners heated evenly across the whole surface, and the side shelf made prep easy. My old grill would’ve struggled, but this handled it like a champ. People asked if I was a pro—just the right grill, I said."}}},"block_order":["review_jURW4d","review_KmQ3qV","review_7wBewr"],"name":"9th Anniversary Review","settings":{"reviews_id":"","reviews_image":"shopify:\/\/shop_images\/E605--4_1.jpg","reviews_title":"Voices from Every Backyard","reviews_subtitle":"90% of Users Rate Us 5 Stars! Because Quality, Trust, and Community Come First","reviews_btn_text":"Shop Now","reviews_btn_link":"https:\/\/monumentgrills.com\/collections\/grills-on-sale"}},"logo_list_fGGknE":{"type":"logo-list","blocks":{"logo_iKrzgx":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/542aa4c2d7c83660fff0b69768bc841d8dff0f6c.png","url":"","logo_width":200,"text":""}},"logo_79FE4M":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/4fa35498703fd900bf079267ae45bd68e7e26cfb.png","url":"","logo_width":200,"text":""}},"logo_PWmzGb":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/7b4f2cc735d664c66f4fc9ee390fc68e8707524a.png","url":"","logo_width":200,"text":""}},"logo_96wKYi":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/a5f9ebaf54d4d906ecda7462fa76ec600df92542.png","url":"","logo_width":200,"text":""}},"logo_YwCtRA":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/362d96052f49fd98bddec3d605d32e298a7c5a43.png","url":"","logo_width":200,"text":""}}},"block_order":["logo_iKrzgx","logo_79FE4M","logo_PWmzGb","logo_96wKYi","logo_YwCtRA"],"disabled":true,"custom_css":["@media (max-width: 850px) {.logo-list {grid-template-columns: repeat(3, minmax(0, 1fr)); }}"],"name":"Logo list -- wenfei","settings":{"full_screen":false,"padding_top":60,"padding_bottom":60,"title":"As Seen In","font_size":48,"mobile_font_size