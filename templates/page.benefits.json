in-top: 20px;\n}\n.count_bosd span {\n    font-size: 24px;\n}\n.count_bosd svg {\n    width: 30px;\n    height: 30px;\n}\np.count_bosd {\n           margin-bottom: 0;\n    margin-top: 10px;\n}\nsection#shopify-section-template--16294048301119__custom_liquid_ftf4mT, section#shopify-section-template--16294048301119__custom_liquid_J4xyC8, section#shopify-section-template--16294048301119__custom_liquid_8LqwBP{\n    display: none;\n}\n}\n<\/style>\n<script>\n$(document).ready(function() {\n      \/\/ 遍历每个 .learn-more 链接\n      $('.learn-more').each(function() {\n        const id = $(this).data('id'); \/\/ 获取当前链接的唯一 ID\n        let count = localStorage.getItem(`interestCount_${id}`); \/\/ 从 localStorage 中获取当前数字\n        const userKey = `userClicked_${id}`; \/\/ 用户的点击状态键名\n\n        \/\/ 如果 localStorage 中没有数据，则使用 HTML 中的初始值\n        if (count === null) {\n          count = $(this).data('count'); \/\/ 从 data-count 属性中获取初始值\n        } else {\n          count = parseInt(count); \/\/ 将字符串转换为数字\n        }\n\n        \/\/ 更新页面上的数字\n        $(`.count[data-id=\"${id}\"]`).text(count);\n\n        \/\/ 点击链接时增加数字并跳转\n        $(this).on('click', function(e) {\n          e.preventDefault(); \/\/ 阻止默认的跳转行为\n\n          \/\/ 检查用户是否已经点击过\n          if (localStorage.getItem(userKey)) {\n            console.log(`You have already clicked link ${id}!`); \/\/ 在控制台输出提示\n             window.open($(this).attr('href'), '_blank');\/\/ 直接跳转\n            return; \/\/ 不再执行后续逻辑\n          }\n\n          count++; \/\/ 数字加 1\n          $(`.count[data-id=\"${id}\"]`).text(count); \/\/ 更新页面显示\n          localStorage.setItem(`interestCount_${id}`, count); \/\/ 存储到 localStorage\n          localStorage.setItem(userKey, 'true'); \/\/ 标记用户已经点击过\n\n          \/\/ 延迟 300ms 后跳转，确保数字更新完成\n          setTimeout(() => {\n             window.open($(this).attr('href'), '_blank');\/\/ 跳转到链接地址\n          }, 300);\n        });\n      });\n    });\n<\/script>","section_height":"default","full_width":false,"dividers":"none","prevent_animation":false}}},"order":["main","172126765511b4ec37","image_banner_zir8dt","media_with_text_PXDxYE","media_with_text_7PCkDU","custom_liquid_ftf4mT","media_with_text_xhcLUX","custom_liquid_J4xyC8","media_with_text_4ULpeq","custom_liquid_8LqwBP","custom_liquid_e7Leb7"]}