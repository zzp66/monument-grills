{% form 'customer' %}
  <input type="hidden" name="customer[email]" value="{{ customer.email }}">
  <input type="hidden" name="customer[accepts_marketing]" value="0">
  
  {% for field in customer.metafields.custom %}
    <input type="hidden" 
           name="customer[metafields][custom][{{ field.key }}]" 
           value="{{ field.value }}">
  {% endfor %}
{% endform %}