xt_color":"","padding_top":80,"padding_bottom":80,"button_label":"Optiona button","is_click":false,"show_popup":false,"cur_liquid":"","click_id":"","is_nofollow":false,"button_link":"","button_style":"btn btn--primary","show_gird":true,"show_row":false,"mobile_show_gird":false,"heading":"Ways to Earn Points","heading_title_color":"","heading_size":"h3","title_des":"","title_type_scale":"medium","heading_align":"text-center","font_weight":true,"font_uppercase":false,"data_list":false,"hr_line":true,"data_color":"","number1_name":"","number1_des":"","number2_name":"","number2_des":"","show_online_display":false,"icon_size":48,"text_type_scale":"medium","icon_position":"above","mobile_stack":false,"show_all_on_mobile":true,"section_height":"medium","bg":"","text_color":"","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"faq_wgPkb9":{"type":"faq","blocks":{"category_39ReEd":{"type":"category","settings":{"text":"Earning Points","text_id":""}},"question_XCxMgh":{"type":"question","settings":{"icon":"question_mark","heading":"1. How do I earn points?","text":"<p>You earn points with every purchase on MonumentGrills.com. Points are automatically added to your account after the purchase is complete.<\/p>","read_number":0}},"question_bEQATb":{"type":"question","settings":{"icon":"question_mark","heading":"2.  Do I earn points on discounted or sale items?","text":"<p>Yes, you earn points on all qualifying purchases, including discounted or sale items, unless otherwise noted.<\/p>","read_number":0}},"question_P6zATq":{"type":"question","settings":{"icon":"question_mark","heading":"3. Is there a limit to the number of points I can earn?","text":"<p>No, there’s no limit to how many points you can earn. The more you shop, the more rewards you can enjoy!<\/p>","read_number":0}},"category_YBENmf":{"type":"category","settings":{"text":"Checking and Managing Points","text_id":""}},"question_WtJMCH":{"type":"question","settings":{"icon":"question_mark","heading":"1. How do I check my points balance?","text":"<p>To view your points balance, <a href=\"https:\/\/monumentgrills.com\/account\/login\" target=\"_blank\" title=\"https:\/\/monumentgrills.com\/account\/login\"><strong>log in<\/strong><\/a><strong> <\/strong>to your Monument Grills account. If you don’t have an account yet, <a href=\"https:\/\/monumentgrills.com\/account\/register\" target=\"_blank\" title=\"https:\/\/monumentgrills.com\/account\/register\"><strong>sign up<\/strong><\/a> to start tracking your rewards.<\/p>","read_number":0}},"question_dzWdKe":{"type":"question","settings":{"icon":"question_mark","heading":"2. Do my points expire?","text":"<p>Yes, points expire after 12 months if they are not redeemed. Be sure to redeem them before they expire!<\/p>","read_number":0}},"question_GkQaij":{"type":"question","settings":{"icon":"question_mark","heading":"3. Can I transfer my points to someone else?","text":"<p>No, points are non-transferable and can only be used by the account holder who earned them.<\/p>","read_number":0}},"question_LEYkmj":{"type":"question","settings":{"icon":"question_mark","heading":"4. Can I need to create an account aside from the account created when I make a purchase?","text":"<p>Each person only needs to create an account once, and points will only be credited to the account created by the email address at the time of purchase<\/p>","read_number":0}},"category_wHARhE":{"type":"category","settings":{"text":"Redeeming Points","text_id":""}},"question_MbzyBd":{"type":"question","settings":{"icon":"question_mark","heading":"1. How do I redeem my points?","text":"<p>To redeem your points, go to the <a href=\"https:\/\/monumentgrills.com\/pages\/monument-grills-rewards-program\"><strong>Membership page<\/strong><\/a>. Browse the available rewards, select the product you’d like to redeem, and follow the instructions to complete the redemption.<\/p>","read_number":0}},"question_TahzC6":{"type":"question","settings":{"icon":"question_mark","heading":"2. Do I need to log in to redeem points?","text":"<p>Yes, you need to log in to your Monument Grills account to access the <a href=\"https:\/\/monumentgrills.com\/pages\/monument-grills-rewards-program\"><strong>Membership page<\/strong><\/a> and redeem your points.<\/p>","read_number":0}},"question_rwrx4x":{"type":"question","settings":{"icon":"question_mark","heading":"3. What kind of rewards can I redeem?","text":"<p>You can redeem points for exciting rewards like exclusive Coupons, Gift Cards, or Monument Grills products to enhance your grilling experience.<\/p>","read_number":0}},"question_dNVEUq":{"type":"question","settings":{"icon":"question_mark","heading":"4. How many points do I need to redeem rewards?","text":"<p>Each reward requires a specific number of points. Visit the <a href=\"https:\/\/monumentgrills.com\/pages\/monument-grills-rewards-program\"><strong>Membership page<\/strong><\/a> to see the full list of available rewards and their point requirements.<\/p>","read_number":0}},"question_DE8bzA":{"type":"question","settings":{"icon":"question_mark","heading":"5. Can I combine points with other discounts or promotions?","text":"<p>No, points cannot be combined with other discounts, promotions, or coupon codes unless stated otherwise.<\/p>","read_number":0}},"question_QCTNmH":{"type":"question","settings":{"icon":"question_mark","heading":"6. How do I know if my redemption was successful?","text":"<p>Once you redeem your points on the <a href=\"https:\/\/monumentgrills.com\/pages\/monument-grills-rewards-program\"><strong>Membership page<\/strong><\/a>, you will receive a confirmation email with details about your reward.<\/p>","read_number":0}},"category_WKHwNA":{"type":"category","settings":{"text":"Support and Updates","text_id":""}},"question_378Y8F":{"type":"question","settings":{"icon":"question_mark","heading":"1. What happens if I return an item I earned points for?","text":"<p>If you return an item, the points earned from that purchase will be deducted from your account balance.<\/p>","read_number":0}},"question_NwYAk3":{"type":"question","settings":{"icon":"question_mark","heading":"2. How do I stay updated on new rewards?","text":"<p>Check the <a href=\"https:\/\/monumentgrills.com\/pages\/monument-grills-rewards-program\"><strong>Rewards Program page<\/strong><\/a> regularly for the latest rewards and offers.<\/p>","read_number":0}},"question_WAHcBX":{"type":"question","settings":{"icon":"question_mark","heading":"3. Who can I contact if I have questions about my points or rewards?","text":"<p>If you have any issues or questions, contact our customer service team at <a href=\"mailto:yuliawu@monumentgrills.com\" target=\"_blank\" title=\"mailto:yuliawu@monumentgrills.com\">Support@monumentgrills.com<\/a> for assistance.<\/p>","read_number":0}}},"block_order":["category_39ReEd","question_XCxMgh","question_bEQATb","question_P6zATq","category_YBENmf","question_WtJMCH","question_dzWdKe","question_GkQaij","question_LEYkmj","category_wHARhE","question_MbzyBd","question_TahzC6","question_rwrx4x","question_dNVEUq","question_DE8bzA","question_QCTNmH","category_WKHwNA","question_378Y8F","question_NwYAk3","question_WAHcBX"],"settings":{"heading":"Frequently Asked Questions","heading_align":"text-center","color_scheme":"none","full_width":true}},"172126765511b4ec37":{"type":"apps","settings":{"link_id":"","full_width":false}}},"order":["main","use_image_banner_QXrwTq","icons_with_step_kDLED8","how_it_work_mqAyRd","tab_rewards_pbyx6n","earn_points_R3KQVJ","icons_with_card_GdMQxi","icons_with_card_ffmAg4","icons_with_card_LARUTW","icons_with_card_MapyRj","icons_with_text_LyenMp","faq_wgPkb9","172126765511b4ec37"]}