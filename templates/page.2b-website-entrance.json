ript>\n  window['ShopifyForms'] = {\n    ...window['ShopifyForms'],\n    currentPageType: \"page\"\n  };\n<\/script>\n\n\n<\/div>\n<\/div>\n\n\n<\/section>\n                  <\/div>\n                  {% style %}\n                    .support-info__block{\n                      overflow: hidden;\n                      border-radius: 20px;\n                    }\n                  {% endstyle %}\n              <\/div>\n            <\/div>\n        <\/div>\n\n <script>\n    var scrollPosition = '';\n    $( document ).ready(function() {\n      $('.icons-popup').removeAttr('open');\n      \n      $('.popupBtn3').on('click',function(e){\n        \n        e.stopPropagation();\n const popupId = $(this).data('popup'); \n    $('#' + popupId).attr('open', true); \n        scrollPosition = $(window).scrollTop();\n      });\n  \n      $('.icons-popup .js-close-modal').on('click',function(){\n        $(window).scrollTop(scrollPosition);\n        $('#popupBtn3').removeAttr('open');\n      });\n    });\n    \n  setTimeout(() => {\n    while (!$) {}}, 100);\n    \n<\/script>","section_height":"default","full_width":false,"dividers":"none","prevent_animation":false}},"reviews_UWzWKG":{"type":"Reviews","blocks":{"item_XBwiY9":{"type":"item","settings":{"title":"Perfect purchase","content":"<p>I was hesitant to buy a grill online, but from the moment I hit buy, the purchase was a good one. I received an email immediately and had constant follow-up with a link to the shipping. We are thrilled with the grill and how well it cooks.<\/p>","name":"Steve.G","star_rating":5}},"item_YbQWCP":{"type":"item","settings":{"title":"Quality cooking","content":"<p>Nice price for an awesome grill! The searer makes steaks to perfection. Heats up fast and maintains heat. The glass window makes it easy to keep an eye on food without losing heat. Would definitely recommend.<\/p>","name":"Greg B.","star_rating":5}},"item_ymLY4W":{"type":"item","settings":{"title":"Great grill!","content":"<p>I love it. My wife and I put it together. Great fun doing so. Instructions were clear, and it took us about an hour and a half total. I have now only used it twice, and it's a beast. Smooth, very easy to use, and cooks wonderfully. <\/p>","name":"Susan H.","star_rating":5}},"item_KY9knE":{"type":"item","settings":{"title":"Fantastic grill and excellent customer service","content":"<p>I was hesitant about buying this grill because I had to assemble it based on past experiences putting one together. So I rolled the dice and was pleasantly surprised at how simple this was to assemble, as it only took about 1 hour. <\/p>","name":"James D.","star_rating":5}},"item_dfEpTr":{"type":"item","settings":{"title":"Love it!!","content":"<p>I got it assembled and couldn’t wait to try it out. I ran to the store, bought some steaks, and fired the grill up. The searing feature was awesome, and I loved how fast the grill heated up. <\/p>","name":"Erica","star_rating":5}},"item_dmKMVK":{"type":"item","settings":{"title":"HOLY COW OR SHOULD I SAY HOLY COW!","content":"<p>This is the best grill I have ever owned. We love it, and I just hope it lasts as long as the warranty. LOL. The even burn on all the burners. The infrared is amazing. The rotisserie handled two 5 lb. chickens. <\/p>","name":"Linda Taylor","star_rating":5}},"item_fkc8Bg":{"type":"item","settings":{"title":"Awesome grill that is versatile","content":"<p>This is our best grill ever. It starts instantly every time, heats up rapidly, cooks evenly, and cleans up nicely. I’ve grilled salmon, NY strips, chops, vegetables, and flank steak—all grilled evenly and perfectly.<\/p>","name":"Kevin C.","star_rating":5}},"item_b8zDLk":{"type":"item","settings":{"title":"Seriously, best grill I have ever owned","content":"<p>Fantastic product. VERY sturdy and well-made grill. Worked right out of the box. My wife grills more than I do, and she loves it too.<\/p>","name":"John Smith","star_rating":5}},"item_CAC437":{"type":"item","settings":{"title":"Beautiful, easy-to-assemble grilling beast","content":"<p>The grill shipping box arrived in good condition, with no damage to the contents. Assembly directions for the Mesa were very simple. <\/p>","name":"Mary Johnson","star_rating":5}},"item_B6VzaA":{"type":"item","settings":{"title":"Love our new grill!","content":"<p>We've had our grill for a couple of weeks and have already used it for many different meals. From low-and-slow to fast grill marks, it's been easy to get the results we want. <\/p>","name":"Michael Brown","star_rating":5}},"item_ekwK4x":{"type":"item","settings":{"title":"GREAT GRILL AND COLOR","content":"<p>“This grill is amazing from the way it was packed easy assembly and great features and the grill itself cooks great! VERY GOOD VALUE I WOULD RECOMMEND this grill.”<\/p>","name":"Jennifer Davis","star_rating":5}}},"block_order":["item_XBwiY9","item_YbQWCP","item_ymLY4W","item_KY9knE","item_dfEpTr","item_dmKMVK","item_fkc8Bg","item_b8zDLk","item_CAC437","item_B6VzaA","item_ekwK4x"],"settings":{"heading":"Hear From Our Customers"}},"media_with_text_GAwaUk":{"type":"media-with-text","blocks":{"heading_YfWRxh":{"type":"heading","settings":{"heading":"Apply for Sponsorship","one_color":"#2a2b2a","two_color":"#2a2b2a","color_angle":"45","heading_size":"h3","title_weight":true,"title_uppercase":false,"heading_h1":false}},"text_zkgiJj":{"type":"text","settings":{"text":"<p>Host a BBQ gathering for family, neighbors, or a community cause, and receive sponsorship support along with exclusive rewards!<\/p>","enlarge_text":false,"enlarge_new_text":false,"text_size":"h6","text_color":""}},"button_QgMnNz":{"type":"button","settings":{"is_copyed_btn":false,"copyed_btn_id":"","button_label":"Learn More","button_link":"https:\/\/monumentgrills.com\/pages\/host-your-bbq-earn-cash","button_style":"btn btn--primary","btn_font_color":"","btn_bg_color":"","is_use_icon":false,"button_icon_color":"","button_icon_alt":"","icon_layout":"right","image_fit":"contain","but