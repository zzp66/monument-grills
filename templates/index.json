,"custom_css":["a.card__media.relative {border-radius: 0;}","@media (max-width: 768px) {.block-carousel .slider .normal-column-carousel-box ul li a .img-box {height: 300px; }}"],"settings":{"set_text_on_image":true,"show_other_blogs":true,"column_info_bg":"#f9f9f9","other_blogs_layout":"carousel","other_blogs_column_size":"medium","other_blogs_column_align":"left","other_blogs_media_align":"text-center","title":"Discover Great Content","heading_size":"h2","use_class_name":"","header_weight":true,"header_uppercase":false,"heading_align":"text-center","show_view_all":false,"blog":"recipes","layout":"carousel","posts_to_show":8,"show_featured_image":true,"show_tags":false,"show_excerpt":false,"show_author":false,"show_date":false,"show_button":false,"color_scheme":"none","image_ratio":"1.77","button_style":"btn btn--primary"}},"marquee_text_iHJpew":{"type":"marquee-text","blocks":{"item_qnnL7M":{"type":"item","settings":{"text":"Consistent Quality You Can Trust—Always Monument   "}},"item_7gfGtQ":{"type":"item","settings":{"text":"Grill Your Favorites, Share the Joy   "}},"item_k8gaVL":{"type":"item","settings":{"text":"Grilling Quality That Stands the Test of Time"}},"item_HAyQfe":{"type":"item","settings":{"text":"Fast Delivery, Arrives in 3-5 Days!   "}},"item_aqAEaN":{"type":"item","settings":{"text":"Consistent Quality You Can Trust—Always Monument   "}},"item_VExraf":{"type":"item","settings":{"text":"No compromises—just great quality and performance, as always."}},"item_wQLTPt":{"type":"item","settings":{"text":"Fast Delivery, Arrives in 3-5 Days!   "}},"item_BzHMkm":{"type":"item","settings":{"text":"Free Grills for Military and Firefighters"}}},"block_order":["item_qnnL7M","item_7gfGtQ","item_k8gaVL","item_HAyQfe","item_aqAEaN","item_VExraf","item_wQLTPt","item_BzHMkm"],"name":"Marquee text","settings":{}},"reviews_bGN8HE":{"type":"Reviews","blocks":{"item_CjyqJV":{"type":"item","settings":{"title":"Perfect purchase","content":"<p>I was hesitant to buy a grill online, but from the moment I hit buy, the purchase was a good one. I received an email immediately and had constant follow-up with a link to the shipping. We are thrilled with the grill and how well it cooks.<\/p>","name":"Steve.G","star_rating":5}},"item_fEURtU":{"type":"item","settings":{"title":"Quality cooking","content":"<p>Nice price for an awesome grill! The searer makes steaks to perfection. Heats up fast and maintains heat. The glass window makes it easy to keep an eye on food without losing heat. Would definitely recommend.<\/p>","name":"Greg B.","star_rating":5}},"item_AxKeWg":{"type":"item","settings":{"title":"Great grill!","content":"<p>I love it. My wife and I put it together. Great fun doing so. Instructions were clear, and it took us about an hour and a half total. I have now only used it twice, and it's a beast. Smooth, very easy to use, and cooks wonderfully. <\/p>","name":"Susan H.","star_rating":5}},"item_kktXYj":{"type":"item","settings":{"title":"Fantastic grill and excellent customer service","content":"<p>I was hesitant about buying this grill because I had to assemble it based on past experiences putting one together. So I rolled the dice and was pleasantly surprised at how simple this was to assemble, as it only took about 1 hour. <\/p>","name":"James D.","star_rating":5}},"item_T8miCh":{"type":"item","settings":{"title":"Love it!!","content":"<p>I got it assembled and couldn’t wait to try it out. I ran to the store, bought some steaks, and fired the grill up. The searing feature was awesome, and I loved how fast the grill heated up. <\/p>","name":"Erica","star_rating":5}},"item_TMqBaB":{"type":"item","settings":{"title":"HOLY COW OR SHOULD I SAY HOLY COW!","content":"<p>This is the best grill I have ever owned. We love it, and I just hope it lasts as long as the warranty. LOL. The even burn on all the burners. The infrared is amazing. The rotisserie handled two 5 lb. chickens. <\/p>","name":"Linda Taylor","star_rating":5}},"item_Kqha4g":{"type":"item","settings":{"title":"Awesome grill that is versatile","content":"<p>This is our best grill ever. It starts instantly every time, heats up rapidly, cooks evenly, and cleans up nicely. I’ve grilled salmon, NY strips, chops, vegetables, and flank steak—all grilled evenly and perfectly.<\/p>","name":"Kevin C.","star_rating":5}},"item_mgtxEE":{"type":"item","settings":{"title":"Seriously, best grill I have ever owned","content":"<p>Fantastic product. VERY sturdy and well-made grill. Worked right out of the box. My wife grills more than I do, and she loves it too.<\/p>","name":"John Smith","star_rating":5}},"item_UYJRxg":{"type":"item","settings":{"title":"Beautiful, easy-to-assemble grilling beast","content":"<p>The grill shipping box arrived in good condition, with no damage to the contents. Assembly directions for the Mesa were very simple. <\/p>","name":"Mary Johnson","star_rating":5}},"item_6LgRm3":{"type":"item","settings":{"title":"Love our new grill!","content":"<p>We've had our grill for a couple of weeks and have already used it for many different meals. From low-and-slow to fast grill marks, it's been easy to get the results we want. <\/p>","name":"Michael Brown","star_rating":5}},"item_gQwnwm":{"type":"item","settings":{"title":"GREAT GRILL AND COLOR","content":"<p>“This grill is amazing from the way it was packed easy assembly and great features and the grill itself cooks great! VERY GOOD VALUE I WOULD RECOMMEND this grill.”<\/p>","name":"Jennifer Davis","star_rating":5}}},"block_order":["item_CjyqJV","item_fEURtU","item_AxKeWg","item_kktXYj","item_T8miCh","item_TMqBaB","item_Kqha4g","item_mgtxEE","item_UYJRxg","item_6LgRm3","item_gQwnwm"],"custom_css":[],"name":"Reviews","settings":{"heading":"Hear From Our Customers"}},"marquee_image_CtiYGx":{"type":"marquee-image","blocks":{"item_zpmNRp":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/0-7.png"}},"item_JwcBBz":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/0-4.png"