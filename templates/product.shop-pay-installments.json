t-center","view_more_label":"View more","view_more_link":"","product_list":"{{ product.metafields.custom.compare_products.value }}","empty_field_text":"","image_ratio":"shortest","image_crop":"center","num_rows":0,"color_scheme":"none","highlight_row":true}},"icons_with_text_hg3VNi":{"type":"icons-with-text","blocks":{"item_kCnrBy":{"type":"item","settings":{"icon":"truck","custom_icon":"shopify:\/\/shop_images\/icons8-signing-a-document-100.png","heading":"Register Your Grill","title_color":"","button_label":"Register Now","button_style":"btn btn--secondary","color_scheme":"white","button_link":"https:\/\/monumentgrills.com\/pages\/register-grill-1","danwei":false,"text":"<p>Get our after-sales service easily and quickly.<\/p>","link":""}},"item_RDdamM":{"type":"item","settings":{"icon":"price_tag","custom_icon":"shopify:\/\/shop_images\/icons8-manual-page-rotation-100.png","heading":"Replacement Parts","title_color":"","button_label":"Find Parts","button_style":"btn btn--secondary","color_scheme":"white","button_link":"https:\/\/monumentgrills.com\/collections\/replacement-parts","danwei":false,"text":"<p>In need of a new part for your Monument Grill? Search Here.<\/p>","link":""}},"item_dbbfCX":{"type":"item","settings":{"icon":"return","custom_icon":"shopify:\/\/shop_images\/icons8-export-pdf-100.png","heading":"Manuals & Videos","title_color":"","button_label":"Download Documents","button_style":"btn btn--secondary","color_scheme":"white","button_link":"https:\/\/monumentgrills.com\/pages\/assembly-manuals-and-videos","danwei":false,"text":"<p>Print, preview or download literature for your grill.<\/p>","link":""}},"item_b7gwR4":{"type":"item","settings":{"icon":"chat_bubble","custom_icon":"shopify:\/\/shop_images\/icons8-warranty-100_f0d6a89c-63d1-407b-b38e-bc39304878ab.png","heading":"Warranty","title_color":"","button_label":"View Warranties","button_style":"btn btn--secondary","color_scheme":"white","button_link":"\/pages\/warranty","danwei":false,"text":"<p>View the warranty details for your grill. <\/p>","link":""}}},"block_order":["item_kCnrBy","item_RDdamM","item_dbbfCX","item_b7gwR4"],"settings":{"link_id":"Support","padding_top":50,"padding_bottom":50,"show_gird":false,"show_row":false,"mobile_show_gird":false,"heading":"","title_type_scale":"large","heading_align":"text-start","font_weight":false,"font_uppercase":false,"data_list":false,"hr_line":true,"data_color":"","number1_name":"","number1_des":"","number2_name":"","number2_des":"","show_online_display":false,"icon_size":48,"text_type_scale":"medium","icon_position":"above","mobile_stack":false,"show_all_on_mobile":true,"section_height":"medium","bg":"#f9f9f9","color_scheme":"1","full_width":true,"dividers":"none","prevent_animation":false}},"faq_tcPUPr":{"type":"faq","blocks":{"question_Wt3AjL":{"type":"question","settings":{"icon":"question_mark","heading":"How to connect all wires for the Denali Series?","text":"<p>We'll show you how to connect all the wires for the Denali Series. <br\/><br\/>Experience the best of life with the quality, capability, and versatility of the Monument Denali Series.<\/p><p><a href=\"https:\/\/www.youtube.com\/watch?v=xiaHpXpa6aA\" target=\"_blank\" title=\"https:\/\/www.youtube.com\/watch?v=xiaHpXpa6aA\"><strong>Click here<\/strong><\/a>.<\/p>","read_number":0}},"question_HdTpHB":{"type":"question","settings":{"icon":"question_mark","heading":"What is the maximum temperature the PULSE can achieve?","text":"<p>The maximum temperature of the grill may vary slightly depending on the ambient temperature and the method of use. We provide reference values for the maximum temperature: approximately 680°F for the 4B grill and approximately 720°F for the 6B grill.<\/p>","read_number":0}},"question_ajrqwL":{"type":"question","settings":{"icon":"question_mark","heading":"What is the minimum wattage for the Denali side burners?","text":"<p>The lowest power of Denali side burner is at 5500 BTU.<\/p>","read_number":0}},"question_KJxpxT":{"type":"question","settings":{"icon":"question_mark","heading":"Does Denali have a night lighting system?","text":"<p>Our Denali currently does not have a night lighting system, and we have tricolor knob lights to enhance your barbecue experience.<\/p>","read_number":0}},"question_fiqFAG":{"type":"question","settings":{"icon":"question_mark","heading":"How long can my battery box support me to use the electronic screen?","text":"<p>Four #5 batteries provide 80 hours of display use when only the display is powered.<\/p>","read_number":0}},"question_GywX64":{"type":"question","settings":{"icon":"question_mark","heading":"Do I need to charge my Denali?","text":"<p>The Denali doesn't need to be charged, but you can choose to power the display with an external battery pack.<\/p>","read_number":0}},"question_7kR3YM":{"type":"question","settings":{"icon":"question_mark","heading":"Why are my display batteries only lasting a few weeks?","text":"<p>In extreme (cold) weather conditions, it is normal for batteries to have a lower-than-expected life span. In order to avoid this, we recommend using an external battery pack and connecting it to the USB port inside of your grill cabinet. It is also recommended to bring the battery pack inside after every use.<\/p>","read_number":0}},"question_CQRLfN":{"type":"question","settings":{"icon":"question_mark","heading":"ls the Bluetooth stable to use?","text":"<p>Yes. The Bluetooth connect with the grill reliably for up to 65 feet outside.<\/p>","read_number":0}},"question_xBDd6i":{"type":"question","settings":{"icon":"question_mark","heading":"Where can I see the temperature?","text":"<p>You can check the temperature via Bluetooth app or Smart Temperature Display.<\/p>","read_number":0}},"question_TJmyXw":{"type":"question","settings":{"icon":"question_mark","heading":"How do I replace the burners？","text":"<p>When replacing the burner make sure that the gas tank valve is closed and that the inside of the furnace is completely cooled. You can operate as follows:<br\/>1. press and hold the burner circlip and push it outward;<br\/>2. Remove the burner;<br\/>3. after replacing the burner with a new one, install the circlip.<\/p>","read_number":0}},"question_KQNPGD":{"type":"question","settings":{"icon":"question_mark","heading":"How do I use the side burner?","text":"<p>Before turning on the gas to \"ON,\" check the supply hose. If there are cuts, abrasions, or signs of wear, it must be replaced before use. If there is a gas smell, do not use the grill.<br\/><br\/>1. Fully open the side burner lid.<br\/>2. Push and turn the side burner knob to the max position. Simultaneously, press and hold the electronic ignition button for 3-5 seconds to ignite the burner.<br\/>3. If the side burner does not light after 5 seconds, turn the knob to OFF. Close the LP gas cylinder and wait 5 minutes for the gas to clear. Then open the lid and repeat step 2.<br\/>4. If the burner still does not ignite, refer to the section on lighting with matches.<\/p>","read_number":0}},"question_BtR348":{"type":"question","settings":{"icon":"question_mark","heading":"How should I preheating?","text":"<p>Ensuring proper preheating of the grill is crucial for achieving the desired high temperature. Begin by lighting the grill following the instructions in your owner's manual. Then, turn up the burners, cover the grill with the lid, and wait approximately 15 minutes. After this time, the grill should reach a temperature between 500 and 550 degrees Fahrenheit. Properly preheating your grill is also essential for preventing food from sticking to the cooking grates.<\/p>","read_number":0}},"question_D7NCmR":{"type":"question","settings":{"icon":"question_mark","heading":"What is the function of the chain hanging beside the front panel?","text":"<p>It is the manual lighting stick, our grill is equipped with a manual ignition device, which you can use to light the grill when there is a problem with the electronic ignition device.<\/p>","read_number":0}},"question_UCiNjG":{"type":"question","settings":{"icon":"question_mark","heading":"How much weight can the side tables on my grill hold?","text":"<p>The shelf is designed to hold plates of food to be cooked, spices, sauces, beverages, etc. It should not be used to hold excessive weight. The Denali grill shelves can hold up to 45lbs and the rest of the grill shelves can hold up to 20lbs.<\/p>","read_number":0}},"question_nL8z78":{"type":"question","settings":{"icon":"question_mark","heading":"Will my grease tray rust?","text":"<p>Our  grease tray has been treated with antirust treatment. In order to prolong the service life of the grease tray, we recommend that you clean the grease tray after each cooking.<\/p>","read_number":0}},"question_mtcQTD":{"type":"question","settings":{"icon":"question_mark","heading":"What should I pay attention to during the cooking process?","text":"<p>Never lean over the grill cooking area while lighting your gas grill. Keep your face and body a safe distance (at least 18 inches) from the cooking grid surface when lighting your grill by match.<\/p>","read_number":0}},"question_D9gQPT":{"type":"question","settings":{"icon":"question_mark","heading":"Do I need to clean my cooking grids?","text":"<p>We suggest you wash your cooking grids in a mild soap<br\/>and warm water solution. You can use a wash cloth or<br\/>soft brush to clean your cooking grids.<\/p>","read_number":0}},"question_zniTJg":{"type":"question","settings":{"icon":"question_mark","heading":"How do I clean the Flame tamer of my gas grill?","text":"<p>Once your grill has cooled completely, use a plastic scraper to scrape the surface grease off the manifold.<\/p>","read_number":0}}},"block_order":["question_Wt3AjL","question_HdTpHB","question_ajrqwL","question_KJxpxT","question_fiqFAG","question_GywX64","question_7kR3YM","question_CQRLfN","question_xBDd6i","question_TJmyXw","question_KQNPGD","question_BtR348","question_D7NCmR","question_UCiNjG","question_nL8z78","question_mtcQTD","question_D9gQPT","question_zniTJg"],"settings":{"heading":"FAQs on 6 Main Burners","heading_align":"text-center","color_scheme":"none","full_width":true}},"1709289004018c5015":{"type":"apps","blocks":{"yotpo_product_reviews_ugc_reviews_xNyrHA":{"type":"shopify:\/\/apps\/yotpo-product-reviews-ugc\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}}},"block_order":["yotpo_product_reviews_ugc_reviews_xNyrHA"],"settings":{"link_id":"","full_width":false}}},"order":["main","rich_text_GPJtyQ","image_banner_fzj3Wf","icons_with_text_cc9MeK","details","product_features_list_8wARwt","video_mQQVY9","parts_dot_d7NbQB","featured_video_cbpk4G","media_with_text_33nNqM","product_comparison_grid_P3476i","recommendations","product_comparison_grid_zngHnB","icons_with_text_hg3VNi","faq_tcPUPr","1709289004018c5015"]}