idth":true,"dividers":"none","prevent_animation":false}},"faq_b4qWRM":{"type":"faq","blocks":{"question_eaQiQK":{"type":"question","settings":{"icon":"question_mark","heading":"Who can participate in this BBQ event?","text":"<p>Any <strong>Monument Grills owner<\/strong> can participate! If you own a Monument Grill, you're eligible to share your BBQ moments and earn rewards.<\/p>","read_number":0}},"question_MffzV7":{"type":"question","settings":{"icon":"question_mark","heading":"How do I join the event?","text":"<p>Simply click <strong>Join Now<\/strong> and fill out the form. After you submit, we’ll send you the <strong>exclusive event QR code<\/strong> and the link for submitting your photos\/videos to the email address you provided.<\/p>","read_number":0}},"question_ycaLLL":{"type":"question","settings":{"icon":"question_mark","heading":"What do I need to do at the event?","text":"<p>Once you receive your QR code, print it out and display it at your BBQ gathering. Encourage your guests to scan the code, follow, and subscribe to get an 8% discount. The more people who scan and subscribe, the higher your cash reward—refer to the <strong>Rewards<\/strong> section for full details!<\/p><p>Also, make sure to capture photos and videos of your event! Afterward, submit your best moments using the link provided in the email.<\/p>","read_number":0}},"question_jVaUyw":{"type":"question","settings":{"icon":"question_mark","heading":"How do I submit my photos or videos?","text":"<p>After you receive the QR code and event details, we will also send you a <strong>submission link<\/strong>. Use that link to upload your photos or videos to be considered for rewards!<\/p>","read_number":0}},"question_L7qYhM":{"type":"question","settings":{"icon":"question_mark","heading":"How will I receive my rewards?","text":"<p><strong>Cash rewards<\/strong>: These will be sent via <strong>bank transfer<\/strong> or <strong>PayPal<\/strong>. A link to provide your payment details will be included in the email after you sign up.<\/p><p><strong>Gift card rewards<\/strong>: The <strong>$100 Gift Cards<\/strong> for the best photos\/videos will be sent directly to your email.<\/p>","read_number":0}},"question_XB9PEx":{"type":"question","settings":{"icon":"question_mark","heading":"How do I receive my cash rewards and gift cards?","text":"<p>Cash rewards will be sent via <strong>bank transfer<\/strong> or <strong>PayPal<\/strong> (for cash rewards) and via <strong>email<\/strong> (for gift cards). Please make sure to provide your correct details during registration so we can process your rewards quickly.<\/p>","read_number":0}},"question_YbCzgN":{"type":"question","settings":{"icon":"question_mark","heading":"Can I share photos from past BBQs or do I need to host a new event?","text":"<p>You need to host a <strong>new BBQ event<\/strong> to participate. This campaign encourages <strong>new gatherings<\/strong> where you actively use the QR code, take photos\/videos, and submit them for evaluation.<\/p>","read_number":0}},"question_kzGebT":{"type":"question","settings":{"icon":"question_mark","heading":"How will I know if I won?","text":"<p>We will notify winners via email once your submission has been reviewed and validated. Rewards will be sent after confirmation.<\/p>","read_number":0}},"question_QqNPfM":{"type":"question","settings":{"icon":"question_mark","heading":"Can I participate in multiple events?","text":"<p>Yes! You can host as many BBQ events as you want and <strong>submit multiple entries<\/strong> to increase your chances of winning rewards.<\/p>","read_number":0}},"question_qJBGwr":{"type":"question","settings":{"icon":"question_mark","heading":"How long will this event run?","text":"<p>The event is ongoing and will <strong>continue indefinitely<\/strong>, so you can join and submit your BBQ moments at any time!<\/p>","read_number":0}}},"block_order":["question_eaQiQK","question_MffzV7","question_ycaLLL","question_jVaUyw","question_L7qYhM","qu