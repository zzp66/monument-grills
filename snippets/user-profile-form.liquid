<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<div class="user-profile-container">
  <h5 class="user-profile-title">My Profile</h5>
  
  <div id="profile-message" class="user-profile-form__message" style="display: none;"></div>
  
  <form id="customerProfileForm" class="user-profile-form">
  <div class="customerProfiles">  <div class="form-group">
      <label for="first_name">First Name*</label>
      <input 
        type="text" 
        id="first_name" 
        name="first_name" 
        value="{{ customer.first_name }}" 
        required
        class="form-input"
      >
    </div>

    <div class="form-group">
      <label for="last_name">Last Name*</label>
      <input 
        type="text" 
        id="last_name" 
        name="last_name" 
        value="{{ customer.last_name }}" 
        required
        class="form-input"
      >
    </div>
<div class="form-group">
      <label for="first_name">Email</label>
      <input 
        type="text" 
        id="Email" 
        name="Email" 
        value="{{ customer.email }}" 
         disabled
        class="form-input"
      >
    </div>
    <div class="form-group">
  <label for="phone">Phone Number</label>
  <input 
    type="tel" 
    id="phone" 
    name="phone" 
    value="{{ customer.phone }}" 
    required
    class="form-input"
    style="    width: 100%;"
  >
</div>

    <div class="form-group">
      <label for="customer_password">Enter your password to confirm changes</label>
      <input 
        type="password" 
        id="customer_password" 
        name="customer_password" 
        required
        class="form-input"
      >
    </div>
  </div>
    <div class="form-group_botm">
      <button type="submit" class="btn btn--primary submit-button">Save</button>
    </div>
  </form>
</div>
<style>
  h5.user-profile-title {
    margin-bottom: 40px;
}
  .form-group {
    display: flex;
    flex-flow: column;
    align-items: flex-start;
    font-size: 16px;
    gap: 10px;
    margin-bottom: 0;
}
  .form-group input {
height: 50px;
    border: 1px solid #ccc;
    padding: 0 20px;
    width: 100%;
    outline: none;
}
   .iti {
    width: 100%;
  }
  
  .iti__flag-container {
    height: 50px;
  }
  
  .iti__selected-flag {
    height: 48px;
  }
  .customerProfiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
}
  .form-group_botm {
    margin-top: 40px;
}
  .iti__country-list{
        width: 200px;
    font-size: 12px;
  }
  @media(max-width:991px){
    .customerProfiles {
      grid-template-columns: repeat(1, 1fr);
    gap: 20px;
}
    h5.user-profile-title {
    margin-bottom: 18px;
}
  }
</style>
<script>
  const API_URL = '/api/2024-01/graphql.json';
const STOREFRONT_ACCESS_TOKEN = {{ settings.storefront_access_token | json }};

const MUTATIONS = {
  CREATE_ACCESS_TOKEN: `
    mutation customerAccessTokenCreate($input: CustomerAccessTokenCreateInput!) {
      customerAccessTokenCreate(input: $input) {
        customerAccessToken {
          accessToken
        }
        customerUserErrors {
          code
          field
          message
        }
      }
    }
  `,

  UPDATE_CUSTOMER: `
    mutation customerUpdate($customerAccessToken: String!, $customer: CustomerUpdateInput!) {
      customerUpdate(customerAccessToken: $customerAccessToken, customer: $customer) {
        customer {
          id
          firstName
          lastName
          phone
        }
        customerUserErrors {
          code
          field
          message
        }
      }
    }
  `
};

class ProfileManager {
  constructor() {
    this.form = document.getElementById('customerProfileForm');
    this.submitButton = this.form.querySelector('button[type="submit"]');
    this.phoneInput = this.form.querySelector('#phone');
    this.messageDiv = document.getElementById('profile-message');
    this.initialize();
  }

  initialize() {
    // 初始化电话输入插件
    this.iti = window.intlTelInput(this.phoneInput, {
      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
      preferredCountries: ['CN', 'US', 'GB'],
      autoPlaceholder: 'aggressive',
      separateDialCode: true,
      formatOnDisplay: true,
      nationalMode: false,
      initialCountry: 'auto',
      geoIpLookup: function(callback) {
        fetch('https://ipapi.co/json')
          .then(res => res.json())
          .then(data => callback(data.country_code))
          .catch(() => callback('CN'));
      }
    });

    // 设置现有号码
    if (this.phoneInput.value) {
      this.iti.setNumber(this.phoneInput.value);
    }

    // 输入时验证
    this.phoneInput.addEventListener('input', () => {
      this.validatePhoneNumber(false);
    });

    // 失去焦点时验证
    this.phoneInput.addEventListener('blur', () => {
      this.validatePhoneNumber(true);
    });

    // 表单提交
    this.form.addEventListener('submit', this.handleSubmit.bind(this));
  }

  validatePhoneNumber(showError = true) {
    if (!this.phoneInput.value.trim()) {
      if (showError) {
        this.showMessage('Phone number is required', 'error');
      }
      return false;
    }

    if (!this.iti.isValidNumber()) {
      const errorCode = this.iti.getValidationError();
      let errorMsg = 'Invalid phone number';

      switch(errorCode) {
        case intlTelInputUtils.validationError.INVALID_COUNTRY_CODE:
          errorMsg = 'Invalid country code';
          break;
        case intlTelInputUtils.validationError.TOO_SHORT:
          errorMsg = 'Phone number is too short';
          break;
        case intlTelInputUtils.validationError.TOO_LONG:
          errorMsg = 'Phone number is too long';
          break;
        case intlTelInputUtils.validationError.NOT_A_NUMBER:
          errorMsg = 'Please enter numbers only';
          break;
      }

      if (showError) {
        this.showMessage(errorMsg, 'error');
      }
      return false;
    }

    this.hideMessage();
    return true;
  }

  showMessage(message, type = 'error') {
    if (this.messageDiv) {
      this.messageDiv.textContent = message;
      this.messageDiv.className = `user-profile-form__message ${type}`;
      this.messageDiv.style.display = 'block';
      this.messageDiv.scrollIntoView({ 
        behavior: 'smooth', 
        block: 'center'
      });
    }
  }

  hideMessage() {
    if (this.messageDiv) {
      this.messageDiv.style.display = 'none';
    }
  }

  setButtonState(loading) {
    if (this.submitButton) {
      this.submitButton.disabled = loading;
      this.submitButton.textContent = loading ? 'Saving...' : 'Save';
    }
  }

  async fetchGraphQL(query, variables) {
    try {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': STOREFRONT_ACCESS_TOKEN
        },
        body: JSON.stringify({ query, variables })
      });

      const data = await response.json();
      if (data.errors) {
        throw new Error(data.errors[0].message);
      }
      return data;
    } catch (error) {
      console.error('API Error:', error);
      throw error;
    }
  }

  async createAccessToken(email, password) {
    const response = await this.fetchGraphQL(MUTATIONS.CREATE_ACCESS_TOKEN, {
      input: {
        email: email,
        password: password
      }
    });

    const { customerAccessTokenCreate } = response.data;
    if (customerAccessTokenCreate.customerUserErrors.length > 0) {
      throw new Error('Password verification failed');
    }

    return customerAccessTokenCreate.customerAccessToken.accessToken;
  }

  async updateCustomerInfo(accessToken, formData) {
    const response = await this.fetchGraphQL(MUTATIONS.UPDATE_CUSTOMER, {
      customerAccessToken: accessToken,
      customer: {
        firstName: formData.firstName,
        lastName: formData.lastName,
        phone: this.iti.getNumber()
      }
    });

    const { customerUpdate } = response.data;
    if (customerUpdate.customerUserErrors.length > 0) {
      throw new Error(customerUpdate.customerUserErrors[0].message);
    }

    return customerUpdate.customer;
  }

  async handleSubmit(event) {
    event.preventDefault();
    this.hideMessage();
    
    if (!this.validatePhoneNumber(true)) {
      return;
    }

    this.setButtonState(true);

    try {
      const formData = {
        firstName: this.form.querySelector('#first_name').value.trim(),
        lastName: this.form.querySelector('#last_name').value.trim(),
        phone: this.iti.getNumber(),
        password: this.form.querySelector('#customer_password').value
      };

      if (!formData.firstName || !formData.lastName) {
        throw new Error('Name fields cannot be empty');
      }
      if (!formData.password) {
        throw new Error('Please enter your password to confirm changes');
      }

      const accessToken = await this.createAccessToken(
        '{{ customer.email }}',
        formData.password
      );

      await this.updateCustomerInfo(accessToken, formData);

      this.showMessage('Profile updated successfully!', 'success');

      setTimeout(() => {
        window.location.reload();
      }, 2000);

    } catch (error) {
      console.error('Update failed:', error);
      this.showMessage(error.message || 'Update failed, please try again', 'error');
    } finally {
      this.setButtonState(false);
    }
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('customerProfileForm');
  if (form) {
    new ProfileManager();
  }
});
</script>