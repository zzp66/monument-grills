  {{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
  {{ 'popup.css' | asset_url | stylesheet_tag }}
  {{ 'modal.css' | asset_url | stylesheet_tag }}    
  <script src="{{ 'pop-up.js' | asset_url }}" defer="defer"></script>

  <div class="button-popup-modal popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center" data-mode data-show-on-mobile="true">
    <div class="modal__window flex relative bg-theme-bg text-theme-text text-start has-motion flex flex-col" role="dialog" aria-modal="true" tabindex="-1">
      <button type="button" class="modal__close-btn absolute text-current js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <div class="flex-auto modal__content modal__content--p-large relative text-left">
        {% if popup_content != blank %}
          <div class="support-info__block">
            {{ popup_content }}
          </div>
          {% style %}
            .support-info__block{
              overflow: hidden;
              border-radius: 20px;
            }
          {% endstyle %}
        {% endif %}
      </div>
    </div>
</div>

  <script>
    var scrollPosition = '';
    $( document ).ready(function() {
      $('.button-popup-modal').removeAttr('open');
      
      $('#popupBtn').on('click',function(e){
        $('.button-popup-modal').attr('open',true);
        e.stopPropagation();
        scrollPosition = $(window).scrollTop();
      });

      $('.popup-btn').on('click',function(e){
        $('.button-popup-modal').attr('open',true);
        e.stopPropagation();
        scrollPosition = $(window).scrollTop();
      });
  
      $('.js-close-modal').on('click',function(){
        $(window).scrollTop(scrollPosition);
        $('.button-popup-modal').removeAttr('open');
        $('.modal').removeAttr('open');
      });
    });
    
  setTimeout(() => {
    while (!$) {}}, 100);
    
</script>