{%- liquid
  assign blocks = section.blocks | where: 'type', 'news'
-%}

{% if blocks.size > 0 %}
  {% liquid
    assign breakpoint_sm = 600
    assign breakpoint_md = 769
    assign breakpoint_lg = 1024

    if section.index == 1 or section.settings.prevent_animation
      assign lazy_load_images = false
    else
      assign lazy_load_images = true
    endif

    if section.settings.other_blogs_layout == 'carousel'
      assign carousel = true
      if section.settings.other_blogs_column_size == 'small'
        assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4 '
      elsif section.settings.other_blogs_column_size == 'medium'
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-3 lg:auto-cols-3'
      else
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-3'
      endif

    else
      assign carousel = false
    endif

    assign color_scheme = section.settings.color_scheme

    if section.settings.image_ratio == 'shortest'
      assign image_ratio = 0
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio > image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    elsif section.settings.image_ratio == 'tallest'
      assign image_ratio = 99
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio < image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    else
      assign image_ratio = section.settings.image_ratio
    endif
  %}

  {%- if carousel == false -%}
    {% style %}
      {% if section.settings.column_size == 'small' %}
        @media (min-width: {{ breakpoint_sm }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .multi-column {
            width: calc(25% - var(--column-gap));
          }
        }
      {% else %}
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        {% if section.settings.column_size == 'medium' %}
          @media (min-width: {{ breakpoint_lg }}px) {
            #{{ section.id }} .multi-column {
              width: calc((100% / 3) - var(--column-gap));
            }
          }
        {% endif %}
      {% endif %}
    {% endstyle %}
  {% else %}
  {%- endif -%}

  {% style %}
    .block-carousel[inactive] .slider {
      margin-bottom: 20px;
    }
    .block-carousel .slider .normal-column-carousel-box ul {
      margin-bottom: 0px;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a {
      display: block;
      position: relative;
    }
    .article-url .article-title {
      font-weight: bold;
      color: #fff;
    }
    .article-url:hover .article-title {
      color: #e55420;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a .img-box {
      height: 380px;
      overflow: hidden;
      position: relative;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a .img-box img {
      position: relative;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a .article-info {
      width: 100%;
      padding: 10px;
      overflow: hidden;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a .article-info.custom-article-info {
      display: flex;
      align-items: center;
    }
    .block-carousel .slider .normal-column-carousel-box ul li a.put-text-on-image .article-info {
      position: absolute;
      bottom: 0;
      z-index: 2;
    }
    .block-carousel
      .slider
      .normal-column-carousel-box
      ul
      li
      a
      .img-box:hover
      .block-carousel
      .slider
      .normal-column-carousel-box
      ul
      li
      a.put-text-on-image
      .article-info
      .article-title {
      color: #e55420;
    }
    @media (max-width: 768px) {
      .block-carousel .slider {
        padding-bottom: 0;
        margin-bottom: 20px;
      }
      .block-carousel .slider .normal-column-carousel-box ul li a .img-box {
        height: auto;
      }
      .block-carousel .slider .normal-column-carousel-box ul {
        column-gap: 8px;
      }
      .carousel .slider .slider__grid {
        grid-auto-columns: 80%;
        column-gap: 8px;
      }
    }
  {% endstyle %}

  {%- if carousel -%}
    <carousel-slider class="carousel block-carousel block" inactive>
      <div class="{% if section.settings.full_screen %}multi-column-carousel{% else %} container{% endif %} relative">
        <div class="slider" id="slider-{{ section.id }}">
  {%- endif -%}

  <div class="{% if section.settings.full_screen %}multi-column-carousel-box{% else %}normal-column-carousel-box {% endif %}">
    <ul
      class="{% if carousel %}slider__grid grid {{ grid_classes }}{% else %} flex flex-wrap{% endif %} gap-x-theme{% if color_scheme == 'none' and carousel == false %} gap-y-12 md:gap-y-6{% else %} gap-y-6{% endif %}"
      role="list"
    >
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'news' %}
            {% liquid
              assign articles = block.settings.articles_id
              assign article_cover_sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'

              assign article_cover = articles.image
              assign article_title = articles.title
              assign article_url = articles.url
              assign article_excerpt = articles.excerpt

              assign custom_article_picker = block.settings.custom_article_picker
              assign custom_article_title = block.settings.custom_article_title
              assign custom_article_url = block.settings.custom_article_url
            %}
            {% if custom_article_picker != blank %}
              <li
                class="articles multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} "
                data-cc-animate
                data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"
              >
                <a
                  class="article-url {% if section.settings.set_text_on_image != blank %} put-text-on-image{% endif %}"
                  href="{{ custom_article_url }}"
                  target="_blank"
                >
                  <div class="img-box">
                    {%- render 'image',
                      image: custom_article_picker,
                      widths: '240, 480, 960, 1400',
                      src_width: 240,
                      src_placeholder: true,
                      sizes: article_cover_sizes,
                      lazy_load: lazy_load_images,
                      class: 'img-fit article-cover'
                    -%}
                  </div>
                  <div class="article-info custom-article-info">
                    <{{ block.settings.article_title_size }} class="article-title">
                      {{- custom_article_title -}}
                    </{{ block.settings.article_title_size }}>
                  </div>
                </a>
              </li>
            {% elsif articles %}
              <li
                class="articles multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} "
                data-cc-animate
                data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"
              >
                <a
                  class="article-url {% if section.settings.set_text_on_image != blank %} put-text-on-image{% endif %}"
                  href="{{ article_url }}"
                  target="_blank"
                >
                  {% if article_cover != blank %}
                    <div class="img-box">
                      {%- render 'image',
                        image: article_cover,
                        widths: '240, 480, 960, 1400',
                        src_width: 240,
                        src_placeholder: true,
                        sizes: article_cover_sizes,
                        lazy_load: lazy_load_images,
                        class: 'img-fit article-cover'
                      -%}
                    </div>
                  {% endif %}
                  {% if article_title != blank %}
                    <div class="article-info">
                      <{{ block.settings.article_title_size }} class="article-title">
                        {{- article_title -}}
                      </{{ block.settings.article_title_size }}>
                    </div>
                  {% endif %}
                </a>
              </li>
            {% else %}
              <li
                class="articles multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} "
                data-cc-animate
                data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"
              >
                <a
                  class="article-url {% if section.settings.set_text_on_image != blank %} put-text-on-image{% endif %}"
                  href="{{ custom_article_url }}"
                  target="_blank"
                >
                  <div class="img-box">
                    {%- render 'image',
                      image: custom_article_picker,
                      widths: '240, 480, 960, 1400',
                      src_width: 240,
                      src_placeholder: true,
                      sizes: article_cover_sizes,
                      lazy_load: lazy_load_images,
                      class: 'img-fit article-cover'
                    -%}
                  </div>
                  <div class="article-info custom-article-info">
                    <{{ block.settings.article_title_size }} class="article-title">
                      {{- custom_article_title -}}
                    </{{ block.settings.article_title_size }}>
                  </div>
                </a>
              </li>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </ul>
  </div>

  {%- if carousel -%}
    </div>
    {%- if section.settings.slider_show_arrows == 'never' -%}
      <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
        <button
          type="button"
          class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon"
          name="next"
          aria-controls="slider-{{ section.id }}"
        >
          <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
          {% render 'icon-chevron-right' %}
        </button>
        <button
          type="button"
          class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon"
          name="prev"
          aria-controls="slider-{{ section.id }}"
        >
          <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
          {% render 'icon-chevron-left' %}
        </button>
      </div>
    {%- endif -%}
    </div>
    </carousel-slider>
  {%- endif -%}
{% endif %}
