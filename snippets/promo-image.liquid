{%- liquid
  assign is_link = false
  if link_url != blank and button_label == blank
    unless content contains "<a"
      assign is_link = true
    endunless
  endif

  if image == blank and video_shopify
    assign image = video_shopify.preview_image
  endif
-%}

{% style %}
  {% if header_title_color != blank %}
  .promo__content .rte{
    color: {{ header_title_color }};
  }
  {% endif %}
{% endstyle %}

{%- if is_link -%}
  <a href="{{- link_url -}}" class="promo promo--border video-section relative flex h-full w-full{% unless min_height_image and content == blank and button_label == blank %} hover:grow-media{% endunless %} overflow-hidden {{ text_alignment }}"{% if min_height_image and content == blank and button_label == blank %} style="padding-top: {{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"{% endif %}>
{%- else -%}
  <div class="promo promo--border video-section relative flex h-full w-full {{ text_alignment }}"{% if min_height_image and content == blank and button_label == blank %} style="padding-top: {{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"{% endif %}>
{%- endif -%}

  {%- if image -%}
    {%- capture sizes %}{% render 'sizes-attribute', grid: true, min: 1, sm: col_span_two_col, md: col_span_three_col, lg: col_span_four_col %}{% endcapture -%}
    <div class="media absolute top-0 left-0 w-full h-full">
      {% render 'image',
        image: image,
        src_width: 460,
        widths: '320, 460, 600, 700, 800, 900, 1200',
        src_placeholder: true,
        sizes: sizes,
        class: 'img-fit'
      -%}
    </div>
  {%- endif -%}

  {%- if video_shopify != blank -%}
    <deferred-media class="media absolute top-0 left-0 w-full h-full">
      <template>
        <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                         data-autoplay="true"
                         data-background="true">
          {{ video_shopify | video_tag: class: 'img-fit promo__mp4 pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
        </video-component>
      </template>
    </deferred-media>
  {%- endif -%}

  {%- if content != blank or button_label != blank or sub_title != blank or text_description != blank or text_type_scale != blank or collection_des != blank or pc_collection_des != blank or mobile_collection_des != blank or des_tag != blank -%}
    <div class="promo__content relative" style="max-width: {{ text_width }}px;">
      {% style %}
        .des-size{
          font-size: {{ pc_collection_des }}px;
        }
        @media (max-width: 768px){
           .des-size{
             font-size: {{ mobile_collection_des }}px;
           }
        }
      {% endstyle %}
      {%- if content != blank -%}
        <div class="rte rte--inherit-heading-color{% if font_weight != blank %} font-weight{% endif %}" >
          <{% if text_type_scale != blank %}{{ text_type_scale }}{% else %}h1{% endif %}>{{- content -}}</{% if text_type_scale != blank %}{{ text_type_scale }}{% else %}h1{% endif %}>
          <{% if des_tag != blank %}{{ des_tag }}{% else %}p{% endif %} class="des-size">{{ collection_des }}</{% if des_tag != blank %}{{ des_tag }}{% else %}p{% endif %}>
        </div>
      {%- endif -%}

      
      {% style %}
        .font-weight{
          font-weight: bold;
        }
      {% endstyle %}
      {%- if button_label != blank -%}
        <a class="promo__button {{ button_style }}{% if button_style == "link" %} block{% endif %}{% if content != blank %} mt-3{% endif %}" {% if link_url != blank %}href="{{ link_url }}"{% else %}role="link" aria-disabled="true"{% endif %} target="_blank"
           style="{% if button_style == 'btn btn--primary' %}
                     background:{{ button_bg_primary }};
                     border-color: {{ button_bg_primary }};
                     color:{{ button_text_primary }};
                  {% elsif button_style == 'btn btn--secondary' %}
                     background: transparent;
                     border-color: transparent;
                     color:{{ button_text_secondary }};
                  {% endif %} ">
          {{- button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

{%- if is_link -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}
