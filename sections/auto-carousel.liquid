.cc-auto-carousel{
  
}
.cc-auto-carousel .carousel-box{
  width:60%;
  margin:auto;
  white-space: nowrap;
  box-sizing: border-box;
  display: flex;
  grid-auto-flow: row;
  /* grid-template-columns: repeat(4, 1fr); */
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  grid-gap: 20px 20px;
}
  .cc-auto-carousel .carousel-box .item-img{
    transition: 0.5s ease-in;
  }
.cc-auto-carousel .carousel-box .item-img img{
  position: relative;
  object-fit: contain;
  transition: 0.5s ease-in;
}
.carousel-animation {
  animation: marquee var(--marquee-time, 3s) linear infinite;
}
@keyframes marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}


{% endstyle %}



<div class="section {% if section.settings.full_screen != blank %} {% else %}container {% endif %} " id="{{ section.id }}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;">
  <div class="hide" id="{% if section.settings.link_id != blank %}{{ section.settings.link_id }}{% endif %}"></div>
  <div class="carousel-box relative flex {{ section.settings.height_mode }}-height">
    {% for block in section.blocks %}
       {% case block.type %}
          {% when 'item-img' %}
            {% liquid
               assign icon_sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
               assign item_img = block.settings.custom_img
               assign item_url = block.settings.custom_url
            %}
          {% if item_img != blank %}
            <{% if item_url != blank %}a{% else %}div{% endif %} class="item-img carousel-animation" {% if item_url != blank %}href="{{ item_url }}" target="_blank"{% endif %}>
               {%- render 'image',
                  image: item_img,
                  widths: '240, 480, 960',
                  src_width: 240,
                  src_placeholder: true,
                  sizes: icon_sizes,
                  lazy_load: lazy_load_images,
                  class: 'img-fit header-icon'
                -%}
             </{% if item_url != blank %}a{% else %}div{% endif %}>
          {% endif %}
       {% endcase %}
    {% endfor %}
  </div>
</div>


{% schema %}
