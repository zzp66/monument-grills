{% liquid
  assign text_length = text | size
  assign text_width = text_length | plus: 1 | times: one_text_width
  assign carousel_time = text_width | times: 15
  
  if section.index == 1 or section.settings.prevent_animation
    assign lazy_load_images = false
  else
    assign lazy_load_images = true
  endif
%}

