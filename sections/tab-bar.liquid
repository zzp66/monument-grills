                            {%- if block.settings.img4_url != blank %}
                              <a class="btn {{ block.settings.button_1_style }}" {% if block.settings.img4_url == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.img4_url }}"{% endif %} target="_blank">
                                SHOP NOW >
                              </a>
                            {%- endif -%}
                          </div>
                        {% endif %}
                      </li>
                      <li class="item">
                        {% if block.settings.img5 != blank %}
                          <div class="tab-img">
                            {%- render 'image',
                              image: block.settings.img5,
                              widths: '480, 980, 1200, 1400',
                              src_width: 480,
                              src_placeholder: true,
