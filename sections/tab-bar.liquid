{% if section.blocks.size > 0 %}



{{ 'text-overlay.css' | asset_url | stylesheet_tag }}


{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign breakpoint_sm = 600
  assign breakpoint_md = 769
  assign breakpoint_lg = 1024
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if section.settings.layout == 'carousel'
    assign carousel = true
    if section.settings.column_size == 'small'
      assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4 '
    elsif section.settings.column_size == 'medium'
      assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2 lg:auto-cols-3'
    else
      assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2'
    endif

  else
    assign carousel = false
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
-%}
{%- if carousel == false -%}
  {% style %}
     #{{ section.id }} .cc-tab-bar .section{
       margin-bottom: 20px;
     }
    {% if section.settings.column_size == 'small' %}
      @media (min-width: {{ breakpoint_sm }}px) {
        #{{ section.id }} .multi-column {
          width: calc(50% - var(--column-gap));
        }
      }
      @media (min-width: {{ breakpoint_md }}px) {
        #{{ section.id }} .multi-column {
          width: calc((100% / 3) - var(--column-gap));
        }
      }
      @media (min-width: {{ breakpoint_lg }}px) {
        #{{ section.id }} .multi-column {
          width: calc(25% - var(--column-gap));
        }
      }
    {% else %}
      @media (min-width: {{ breakpoint_md }}px) {
        #{{ section.id }} .multi-column {
          width: calc(50% - var(--column-gap));
        }
      }
      {% if section.settings.column_size == 'medium' %}
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .multi-column {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
      {% endif %}
    {% endif %}
  {% endstyle %}
{%- endif -%}

{%- unless section.settings.full_width -%}
  <div class="container">
{%- endunless -%}

<div class="section{% unless bg_color == false %} section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% endunless %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}{% if bg_color == false %} color-scheme--transparent{% endif %}" id="{{ section.id }}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %} style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.bg_color }};margin-bottom:20px;">
  <div class="container flex {{ section.settings.text_position }} {{ section.settings.text_align }}{% if section.settings.mob_center_text %} md-down:text-center{% endif %}">
    <div class="max-w-text-overlay">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %} class="section__block section__block--heading md-down:px-gutter {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                <span class="contained-heading inline-block">{{- block.settings.heading | escape -}}</span>
              </{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %}>
            {%- endif -%}

          {%- when 'subheading' -%}
            {%- if block.settings.text != blank -%}
              <p class="section__block section__block--subheading subheading md-down:px-gutter" {{ block.shopify_attributes }}>
                <span class="contained-heading inline-block">{{- block.settings.text | escape -}}</span>
              </p>
            {%- endif -%}

          {%- when 'subTitle' -%}
            {%- if block.settings.sub_text != blank -%}
              <{% if block.settings.sub_text_size %}{{ block.settings.sub_text_size }}{% else %}h2{% endif %} class="section__block section__block--heading md-down:px-gutter {{ block.settings.sub_text_size }}" {{ block.shopify_attributes }} style="padding-top:{{ block.settings.sub_padding_top }}px;padding-bottom:{{ block.settings.sub_padding_bottom }}px;">
                {{ block.settings.sub_text | escape }}
              </{% if block.settings.sub_text_size %}{{ block.settings.sub_text_size }}{% else %}h2{% endif %}>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="section__block reading-width--inline md-down:px-gutter rte{% if section.settings.text_align == 'text-start' %} mr-auto{% elsif section.settings.text_align == 'text-end' %} ml-auto{% else %} mx-auto{% endif %}{% if block.settings.enlarge_text %} enlarge-text{% endif %}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
              {%- if carousel -%}
              <carousel-slider class="carousel block" inactive>
                <div class="container relative" style="padding-top: {{ section.settings.btn_group_padding_top }}px;padding-bottom:{{ section.settings.btn_group_padding_bottom }}px;">
                  <div class="slider" id="slider-{{ section.id }}">
              {%- endif -%}
                  <ul class="{% if carousel %}slider__grid grid {{ grid_classes }}{% else %} flex flex-wrap{% endif %} gap-x-theme{% if color_scheme == 'none' and carousel == false %} gap-y-12 md:gap-y-6{% else %} gap-y-6{% endif %} {% if section.settings.text_align == 'text-start' %} justify-start{% elsif section.settings.text_align == 'text-end' %} justify-end{% else %} justify-center{% endif %}{% if section.settings.mob_center_text %} md-down:center{% endif %}" role="list">
                   {%- if block.settings.button_3_label != blank %}
                      <li class="btn tab-nav {{ block.settings.button_3_style }} active" data-tab="{{ block.settings.button_3_label }}" id="{{ block.settings.button_3_label }}">
                        {{- block.settings.button_3_label | escape -}}
                      </li>
                    {%- endif -%}
                    {%- if block.settings.button_2_label != blank %}
                      <li class="btn tab-nav {{ block.settings.button_2_style }}" data-tab="{{ block.settings.button_2_label }}" id="{{ block.settings.button_2_label }}">
                        {{- block.settings.button_2_label | escape -}}
                      </li>
                    {%- endif -%}
                     {%- if block.settings.button_1_label != blank %}
                      <li class="btn tab-nav {{ block.settings.button_2_style }}" data-tab="{{ block.settings.button_1_label }}" id="{{ block.settings.button_1_label }}">
                        {{- block.settings.button_1_label | escape -}}
                      </li>
                    {%- endif -%}
                  </ul>
              {%- if carousel -%}
                    </div>
                    {%- if settings.slider_show_arrows != 'never' -%}
                      <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
                        <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
                          <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                          {% render 'icon-chevron-right' %}
                        </button>
                        <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
                          <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                          {% render 'icon-chevron-left' %}
                        </button>
                      </div>
                    {%- endif -%}
                  </div>
                </carousel-slider>
                {%- liquid
                  if section.settings.full_width
                    if section.settings.height_mode == 'screen'
                      assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                    endif
                  else
                    capture sizes
                      render 'sizes-attribute'
                    endcapture
                  endif
      
                  if m_img != blank
                    assign desktop_image_class = 'img-fit hidden sm:block'
                  else
                    assign desktop_image_class = 'img-fit'
                  endif
                -%}
                <div class="content">
                  {% style %}
                    .cc-tab-bar .img-title-color{
                      {% if block.settings.img_title_color != blank %}
                        color:{{ block.settings.img_title_color }};
                      {% endif %}}
                    }
                  {% endstyle %}
                  <div id="tab3" class="tab-content active">
                    <ul class="list">
