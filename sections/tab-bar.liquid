                            <h5 class="{% if block.settings.img_title_color != blank %}img-title-color{% endif %}">{{ block.settings.img8_title | escape }}{% if block.settings.series8_title != blank %}<strong style="color:{{ block.settings.series8_title_color }}">{{ block.settings.series8_title | escape }}</strong>{% endif %}</h5>
                            {%- if block.settings.img8_url != blank %}
                              <a class="btn {{ block.settings.button_1_style }}" {% if block.settings.img8_url == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.img8_url }}"{% endif %} target="_blank">
                                SHOP NOW >
                              </a>
                            {%- endif -%}
                          </div>
                        {% endif %}
                      </li>
                      
                    </ul>
                  </div>
                  <div id="tab2" class="tab-content">
                    <ul class="list">
                      <li class="item">
                        {% if block.settings.img4 != blank %}
                          <div class="tab-img">
                            {%- render 'image',
                              image: block.settings.img4,
                              widths: '480, 980, 1200, 1400',
                              src_width: 480,
                              src_placeholder: true,
                              sizes: sizes,
