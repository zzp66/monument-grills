                {% style %}
                  .cc-tab-bar .carousel .slider ul li{
                      font-size: 30px;
                      font-weight: bold;
                      opacity: .7;
                      cursor: pointer;
                      background: transparent;
                      color: #000;
                      text-transform: uppercase;
                      border-radius: 0;
                      border-color: transparent;
                      border-bottom: 3px solid transparent;
                  }
                  .cc-tab-bar .carousel .slider ul li.active{
                      opacity: 1;
                      border-bottom: 3px solid #c20000;
                  }
                  .cc-tab-bar .tab-content{
                    display:none;
                    transition: all 0.3s ease-in;
                  }
                  .cc-tab-bar .tab-content.active{
                    display:block;
                  }
                  .cc-tab-bar .tab-content .list{
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    grid-gap: 20px 20px;
                  }
                  .cc-tab-bar .tab-content .list .item{
                    position: relative;
                    {% if block.settings.img_info_bottom != false %}
                      margin-bottom:50%;
                    {% endif %}
                  }
                  .cc-tab-bar .tab-content .list .item .tab-img{
                    width: 100%;
                    height:100%;
                    display: block;
                    z-index: 1;
                    position: relative;
                    cursor: pointer;
                  }
                  .cc-tab-bar .tab-content .list .item .tab-img .img-fit{
                    position: relative;
                  }
                  .cc-tab-bar .tab-content .list .item .info{
                    /* position: absolute; */
                     /* height: 100%; */
                    /*  */
                    /* opacity: 0; */
                    /* transform: translateY(100%); */
                    /* position:relative; */
                    position: absolute;
                    z-index: 2;
                    width: 100%;
                    height: 100%;
                    /* padding-top:1em;
                    height:auto; */
                    /* background: rgba(256, 256, 256, .5); */
                    bottom: 0;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                    opacity: 1;
                    transform: translateY(0%);
                    {% if block.settings.img_info_bottom != false %}
                      height:auto;
                      padding:1em 0;
                      transform: translateY(100%);
                      background:#f9f9f9;
                    {% endif %}
                    transition: all 0.3s ease-in;
                  }
                  .cc-tab-bar .tab-content .list .item .info h5{
                    font-size: 28px;
                    font-weight: 600;
                    margin-bottom:1em;
                    {% if block.settings.img_info_bottom != false %}
                    font-size: 35px;
                    {% endif %}
                  }
                  .cc-tab-bar .tab-content .list .item .info h5 strong{
                    padding-left:10px;
                  }
                  /* .cc-tab-bar .tab-content .list .item:hover > .info{
                    opacity: 1;
                    transform: translateY(0%);
                    transition: all 0.3s ease-in;
                  } */
                  .cc-tab-bar .content{
                    padding-top:4%;
                    width:100%;
                   
                  }
                  .cc-tab-bar .tab-content .list .item:hover h5 strong{
                    text-decoration: underline;
                    transition: all 0.3s;
                  }
                  .cc-tab-bar .tab-content .list .item .btn{
                    width: auto;
                    color: {{ block.settings.link_title_color }};
                    font-size:12px;
                    padding:5px 10px 4px 10px;
                  }
                  @media (min-width: 1024px) {
                    .cc-tab-bar .section .max-w-text-overlay{
                      max-width: 100%;
                    }
                  }
                  @media (max-width:850px){
                    .cc-tab-bar .section .container{
                      padding:0;
                    }
                    .cc-tab-bar .slider .slider__grid{
                      width: 100%;
                      display: flex;
                    }
                    
                    .cc-tab-bar .tab-content.active{
                      overflow-x: auto;
                      overflow-y: hidden;
                    }
                    .cc-tab-bar .carousel .slider ul li{
                      font-size: 18px;
                      word-wrap: normal;
                              padding: 0;
                    }
                    .cc-tab-bar .tab-content .list .item .info{
                      opacity: 1;
                      top:0;
                      {% if block.settings.img_info_bottom != false %}
                        transform: translateY(100%);
                        height: auto;
                        display: block;
                      {% endif %}
                    }
                    .cc-tab-bar .content{
                      padding-top:0;
                      height: 83vw;
                      max-height: 83vw;
                    }
                    .cc-tab-bar .tab-content .list{
                      /* grid-auto-columns: 10px; */
                      width: 300%;
                      grid-gap: 20px;
                      transform: translateX(-104px) translateY(-20px) scale(0.8);
                    }
                    .cc-tab-bar .tab-content.active::-webkit-scrollbar {
                      display: none; /* Chrome Safari */
                    }
                  }
                {% endstyle %}
          
              {%- endif -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>
<script>
  $(function(){
    $('.slider__grid .tab-nav').on('click',function(){
      var index = $(this).index();
     
      $(this).addClass('active').siblings().removeClass('active');
      $('.content .tab-content').eq(index).addClass('active').siblings().removeClass('active');
    })
  })
</script>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}
