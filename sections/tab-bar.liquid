                            {%- if block.settings.img9_url != blank %}
                              <a class="btn {{ block.settings.button_1_style }}" {% if block.settings.img9_url == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.img9_url }}"{% endif %} target="_blank">
                                SHOP NOW >
