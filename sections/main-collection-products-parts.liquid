          {%- endif -%}
        {%- endif -%}
      </div>
    </custom-pagination>
  {%- endpaginate -%}
</div>
</div>
 
<script>
 class CollectionSearch {
  constructor() {
    this.searchInput = document.querySelector('.collection-search-input');
    this.productsContainer = document.querySelector('.collection__partss');
    this.originalProducts = Array.from(document.querySelectorAll('.item-product')); 
    this.searchTimeout = null;
    
    this.init();
  }

  init() {
    this.searchInput.addEventListener('input', (e) => this.handleSearch(e));
  }

  handleSearch(e) {
    clearTimeout(this.searchTimeout);
    const searchTerm = e.target.value.toLowerCase().trim();

    if (!searchTerm) {
      this.showAllProducts();
      return;
    }

    this.searchTimeout = setTimeout(() => {
      this.filterProducts(searchTerm);
    }, 300);
  }

  showAllProducts() {
    this.originalProducts.forEach(product => {
      product.style.display = '';
    });
    const noResults = document.querySelector('.search-no-results');
    if (noResults) {
      noResults.remove();
    }
  }

  filterProducts(searchTerm) {
    let hasResults = false;

    this.originalProducts.forEach(product => {
      // 获取所有需要搜索的元素
      const productTitle = product.querySelector('.card__title')?.textContent.toLowerCase() || '';
      const factoryNumber = product.querySelector('.s_factory_number')?.textContent.toLowerCase() || '';
      const factoryNumber2025 = product.querySelector('.s_factory_number_2025')?.textContent.toLowerCase() || '';
      
      // 如果任何一个字段包含搜索词则显示产品
      if (productTitle.includes(searchTerm) || 
          factoryNumber.includes(searchTerm) || 
          factoryNumber2025.includes(searchTerm)) {
        product.style.display = '';
        hasResults = true;
      } else {
        product.style.display = 'none';
      }
    });

    this.handleNoResults(hasResults);
  }

  handleNoResults(hasResults) {
    const existingNoResults = document.querySelector('.search-no-results');
    if (!hasResults) {
      if (!existingNoResults) {
        const noResultsElement = document.createElement('div');
        noResultsElement.className = 'search-no-results';
        noResultsElement.textContent = 'No related products found';
        this.productsContainer.appendChild(noResultsElement);
      }
    } else if (existingNoResults) {
      existingNoResults.remove();
    }
  }
}

// 页面加载完成后初始化搜索
document.addEventListener('DOMContentLoaded', () => {
  new CollectionSearch();
});
    
  </script>

