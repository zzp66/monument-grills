    <style>
.parts-modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  overflow-y: auto;
}

.parts-modal-content {
    position: absolute;
    background-color: #fff;
    margin: auto;
    padding: 20px;
    width: 90%;
    max-width: 1400px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.parts-modal-inner {
  display: flex;
  gap: 30px;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.parts-modal-image {
    /* flex: 1; */
    /* max-width: 50%; */
    position: sticky;
    top: 0;
    display: flex;
    height: 100%;
    overflow: auto;
    align-items: center;
      width: 50%;
}

.parts-modal-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.parts-modal-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.parts_boxs{
   flex: 1;
}
.parts-products-list {
 
  overflow-y: auto;
  padding-right: 15px;
  max-height: calc(85vh - 150px);
}

.part-item {
  border: 1px solid #eee;
  border-radius: 8px;
  padding: 15px;
  display: flex;
  align-items: flex-start;
  gap: 15px;
  margin-bottom: 10px;
}

.part-number {
  min-width: 24px;
  height: 24px;
  background-color: #000;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 500;
}

.part-info {
  flex: 1;
  padding-right: 20px;
}

.add-to-cart-btn {
  padding: 8px 15px;
  background-color: #e55420;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  min-width: 100px;
  font-size: 12px;
}

.close-modal {
  position: absolute;
  right: 20px;
  top: 20px;
  font-size: 24px;
  cursor: pointer;
  color: #666;
}

/* 不可用产品样式 */
.part-item.unavailable {
  background-color: #f8f9fa;
}

.part-item.unavailable .part-number {
  background-color: #999;
}

.part-item.unavailable .part-status {
  color: #dc3545;
  font-size: 14px;
  margin-top: 5px;
}
.parts_boxs > h2 {
    font-size: 24px;
    margin-top: 35px;
    padding: 0 40px;
}
      .part-title {
    color: #000;
    line-height: 1.2;
}
      .part-price {
    color: #cb0f0f;
}
/* 移动端样式 */
@media (max-width: 768px) {
  .parts-modal-inner {
    flex-direction: column;
        overflow: scroll;
  }
  
  .parts-modal-image {
           max-width: 100%;
        position: relative;
        width: 100%;
        display: block;
        overflow: initial;
  }
  
  .parts-products-list {
    max-height: calc(90vh - 400px);
            overflow: inherit;
  }
  
 .parts_boxs > h2 {
    font-size: 18px;
    margin-top: 0;
    padding: 0;
}
  
  .part-info {
    width: 100%;
    padding-right: 0;
    margin-bottom: 10px;
    font-size: 12px;
  }
  
  .add-to-cart-btn {
        min-width: auto;
        padding: 5px 10px;
  }
 .tem__gas-grills-parts button.btn.btn--secondary {
   
    font-size: 12px;
    margin-top: 10px;
}
  .part-number {
    min-width: 20px;
    height: 20px;
    font-size: 12px;
}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const triggers = document.querySelectorAll('.parts-modal-trigger');
  const modals = document.querySelectorAll('.parts-modal');
  const closeButtons = document.querySelectorAll('.close-modal');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', function() {
      const modal = this.nextElementSibling;
      if (modal && modal.classList.contains('parts-modal')) {
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  closeButtons.forEach(button => {
    button.addEventListener('click', function() {
      const modal = this.closest('.parts-modal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
  });

  window.addEventListener('click', function(event) {
    if (event.target.classList.contains('parts-modal')) {
      event.target.style.display = 'none';
      document.body.style.overflow = '';
    }
  });
});
</script>
 
