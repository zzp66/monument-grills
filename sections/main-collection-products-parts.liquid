      <script>
document.addEventListener('DOMContentLoaded', function() {
  const searchTrigger = document.querySelector('.search-trigger');
  const searchPop = document.querySelector('.search_pop');
  let timeoutId;

  // 鼠标进入 SVG
  searchTrigger.addEventListener('mouseenter', function() {
    clearTimeout(timeoutId);
    searchPop.classList.add('active');
  });

  // 鼠标离开 SVG
  searchTrigger.addEventListener('mouseleave', function(e) {
    // 检查鼠标是否移动到了弹出框
    if (!e.relatedTarget || !searchPop.contains(e.relatedTarget)) {
      timeoutId = setTimeout(() => {
        if (!searchPop.matches(':hover')) {
          searchPop.classList.remove('active');
        }
      }, 100);
    }
  });

  // 鼠标进入弹出框
  searchPop.addEventListener('mouseenter', function() {
    clearTimeout(timeoutId);
  });

  // 鼠标离开弹出框
  searchPop.addEventListener('mouseleave', function() {
    timeoutId = setTimeout(() => {
      searchPop.classList.remove('active');
    }, 100);
  });

  // 点击外部关闭弹出框
  document.addEventListener('click', function(e) {
    if (!searchTrigger.contains(e.target) && !searchPop.contains(e.target)) {
      searchPop.classList.remove('active');
    }
  });
});
</script>
