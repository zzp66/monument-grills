<style>
  .ugc-storyshared {
    padding: 60px 0;
    margin: 0;
  }
  .storyshared-swiper {
    margin-top: 40px;
  }
  .storyshared-item-info {
    width: 100%;
    padding: 15px;
    background-color: #fff7eb;
    min-height: 110px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  p.storyshared-item-title {
    margin: 0;
    font-size: 20px;
    line-height: 22px;
    font-weight: 600;
  }
  p.storyshared-item-btn {
    color: #e55420;
    margin: 10px 0 0;
  }
  p.storyshared-item-btn:hover {
    cursor: pointer;
    text-decoration: underline;
  }
  .storyshared-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .storyshared-swiper-console {
    padding: 0 40px;
    width: 100%;
    margin-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .storyshared-swiper-console .swiper-pagination {
    position: inherit;
  }

  .storyshared-swiper-console .swiper-pagination-bullet-active {
    background: #e55420;
  }

  .storyshared-swiper-console .swiper-button-prev,
  .storyshared-swiper-console .swiper-button-next {
    background-image: none;
    position: static;
    margin-top: 0;
    width: 40px;
    height: 40px;
    border-radius: 40px;
    background-color: #e55420;
    border: 1px solid #e55420;
  }
  .storyshared-swiper-console .swiper-button-prev::after,
  .storyshared-swiper-console .swiper-button-next::after {
    color: #fff;
    font-size: 16px;
  }

  /* 弹窗css */
  .storyshared-popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
    z-index: 999;
  }

  .storyshared-popup-box {
    background: #fff;
    margin: 60px;
    padding: 20px 40px;
    width: 80%;
    max-height: 680px;
    max-width: 640px;
    border-radius: 16px;
    overflow-y: auto;
    text-align: center;
    position: relative;
  }

  .storyshared-popup-close {
    position: absolute;
    top: 10px;
    right: 20px;
    font-size: 30px;
    color: #000;
    cursor: pointer;
  }

  .storyshared-popup-title {
    font-size: 24px;
    margin: 10px 0 30px;
  }

  .storyshared-popup-img {
    max-width: 100%;
    height: auto;
    margin-bottom: 20px;
  }

  .storyshared-popup-content-text {
    font-size: 16px;
    text-align: left;
  }
  @media screen and (max-width: 767px) {
    .storyshared-popup-box {
      padding: 20px;
      margin: 0;
      width: 90%;
      height: auto;
    }
    .storyshared-popup-title {
      font-size: 18px;
    }
    .storyshared-popup-content-text {
      font-size: 14px;
    }
  }
</style>

<div class="ugc-storyshared section">
  <div class="container">
    <h2 class="section__heading mb-0 flex-auto text-center storyshared-title">
      {{ section.settings.storyshared_header }}
    </h2>
    <div class="swiper storyshared-swiper">
      <div class="swiper-wrapper">
        {% for item in section.blocks %}
          {% liquid
            assign data-title = item.settings.story_title
            assign data-img = item.settings.story_img | image_url: width: master
            assign data-content = item.settings.story_content
          %}
          <div class="swiper-slide">
            <div
              class="storyshared-item"
              data-title="{{ data-title }}"
              data-img="{{ data-img }}"
              data-content="{{ data-content }}"
            >
              <div class="storyshared-item-img">
                <img
                  src="{{ item.settings.story_img | image_url: width: master }}"
                  alt=""
                >
              </div>
              <div class="storyshared-item-info">
                <p class="storyshared-item-title">{{ item.settings.story_title }}</p>
                <p class="storyshared-item-btn">Learn More ></p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="storyshared-swiper-console">
        <div class="swiper-button-prev ssc-btn-prev"></div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next ssc-btn-next"></div>
      </div>
    </div>
  </div>
</div>

<!-- 弹窗容器 -->
<div class="storyshared-popup" style="display: none;">
  <div class="storyshared-popup-box">
    <span class="storyshared-popup-close">&times;</span>
    <h3 class="storyshared-popup-title"></h3>
    <img class="storyshared-popup-img" src="" alt="Story Image">
    <div class="storyshared-popup-content-text"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 初始化Swiper
    new Swiper('.storyshared-swiper', {
      slidesPerView: 3,
      spaceBetween: 10,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
        renderBullet: function (index, className) {
          return '<div class="' + className + '"><span></span><i></i></div>';
        },
      },
      navigation: {
        nextEl: '.ssc-btn-next',
        prevEl: '.ssc-btn-prev',
      },
      breakpoints: {
        320: {
          slidesPerView: 1,
          spaceBetween: 10,
        },
        768: {
          slidesPerView: 1.2,
          spaceBetween: 10,
        },
        1280: {
          slidesPerView: 3,
          spaceBetween: 10,
        },
      },
    });

    const btns = document.querySelectorAll('.storyshared-item-btn');
    const popup = document.querySelector('.storyshared-popup');
    const popupTitle = popup.querySelector('.storyshared-popup-title');
    const popupImg = popup.querySelector('.storyshared-popup-img');
    const popupContent = popup.querySelector('.storyshared-popup-content-text');
    const closeBtn = popup.querySelector('.storyshared-popup-close');

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const parentItem = btn.closest('.storyshared-item');
        const title = parentItem.getAttribute('data-title');
        const img = parentItem.getAttribute('data-img');
        const content = parentItem.getAttribute('data-content');

        popupTitle.textContent = title;
        popupImg.src = img;

        // 保留 richtext 格式
        popupContent.innerHTML = content;

        popup.style.display = 'flex';
      });
    });

    closeBtn.addEventListener('click', function () {
      popup.style.display = 'none';
    });

    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        popup.style.display = 'none';
      }
    });
  });
</script>

{% schema %}
{
  "name": "UGC Story Shared",
  "settings": [
    {
      "type": "text",
      "id": "storyshared_header",
      "label": "Header",
      "default": "Stories Shared by Users"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "story_img",
          "label": "Story Img"
        },
        {
          "type": "textarea",
          "id": "story_title",
          "label": "Story Title"
        },
        {
          "type": "richtext",
          "id": "story_content",
          "label": "Story Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Story Shared"
    }
  ]
}
{% endschema %}
