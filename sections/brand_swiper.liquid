</style>
<div class="container">
<div class="brand-endorsement-section" style="background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;display:">
  
  <div class="brand-endorsement-container">
    <h2 class="bands__head">Press Reviews</h2>
    <div class="swiper reviewSwiper2">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="brand-endorsement-content">
            <div class="brand-endorsement-review">
              <p>{{ block.settings.review }}</p>
            </div>
          
          </div>
        </div>
        {% endfor %}
      </div>
      
    </div>
    <div class="bottom__logo">
      <div class="swiper-button-prev logop"></div>
<div thumbsSlider="" class="swiper logoSwiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
        <div class="swiper-slide">
          <img src="{{ block.settings.logo | img_url:'master' }}" alt="" />
        </div>
        {% endfor %}
      </div>
      
      
    </div>
      <div class="swiper-button-next logon"></div>
    </div>
    
  </div>
</div>
</div>
<script>

  document.addEventListener('DOMContentLoaded', function() {
    // 确保Swiper已加载
    if (typeof Swiper !== 'undefined') {
  var swiperThumbs = new Swiper(".logoSwiper", {
    loop: true,
    spaceBetween: 10,
    slidesPerView: 3,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false
    },
    watchSlidesProgress: true,
 freeMode: true,
    breakpoints: { 
      320: {  
        slidesPerView: 2,
        spaceBetween: 0
      },
      768: {   
        spaceBetween: 10,
    slidesPerView: 3
      },
      1280: {  
         spaceBetween: 10,
    slidesPerView: 3
      }
    },

      observer: true, // 启用动态检查
            observeParents: true, // 监测父元素变化
      // 添加触摸支持
            allowTouchMove: true,
            grabCursor: true,
            // 添加调试事件
            on: {
                init: function() {
                    console.log('Swiper initialized');
                },
                touchStart: function() {
                    console.log('Touch started');
                }
            },
  });
  var swiperMain = new Swiper(".reviewSwiper2", {
    loop: true,
    spaceBetween: 10,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false
    },
    thumbs: {
      swiper: swiperThumbs,
    },
     navigation: {
      nextEl: ".logon",
      prevEl: ".logop",
    },
  });
    }
    });
</script>
{% schema %}
{
  "name": "Brand slider",
  "class": "shopify_brandsslide_section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "PC image"
    },
    
    {
      "type": "image_picker",
      "id": "mb_image",
      "label": "Mobile image"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "brand",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "review"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand slider"
    }
  ]
}
{% endschema %}