<style>
.brand-endorsement-section {
  padding: 60px 0 0;
  color: #fff;
      height: 500px;
    display: flex;
    align-items: end;
}
.brand-endorsement-container {
    width: 60%;
    margin: 0;
    padding: 0 40px;
}
.brand-endorsement-content {
  padding-left: 60px;
}
.brand-endorsement-review {
  font-size: 1.2em;
  margin-bottom: 0;
  text-align: left;
}
.brand-endorsement-logo img {
  width: 120px;
  height: auto;
  border-radius: 8px;
  background: #fff;
  padding: 8px;
}
.mySwiper {
  margin-top: 30px;
}
.mySwiper .swiper-slide img {
  width: 60px;
  height: auto;
  border-radius: 6px;
  background: #fff;
  padding: 4px;
  opacity: 0.6;
  transition: opacity 0.2s;
}
.mySwiper .swiper-slide-thumb-active img {
  opacity: 1;
}
  .swiper.logoSwiper {
    margin-top: 3vw;
        padding: 40px 0;
}
 .swiper-button-next.logon {
        width: 40px;
    height: 40px;
      color: #fff;
    border: 1px solid #fff;
    border-radius: 40px;
  }
  .swiper-button-prev.logop{
    width: 40px;
    height: 40px;
     color: #fff;
    border: 1px solid #fff;
    border-radius: 40px;
  }
  .swiper-button-next.logon:after, .swiper-rtl .swiper-button-prev.logop:after {
    content: "next";
    font-size: 14px;
}
  .swiper-button-prev.logop:after, .swiper-rtl .swiper-button-next.logon:after {
    content: "prev";
     font-size: 14px;
}
  .bottom__logo {
    position: relative;
    padding: 0 60px;
}
  .swiper.logoSwiper img {
    vertical-align: middle;
}
  h2.bands__head {
    color: #fff;
    margin-left: 60px;
    margin-bottom: 10px;
}
  .logoSwiper img {
    height: 40px;
  }
  .swiper.logoSwiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
}
.logoSwiper .swiper-slide-thumb-active {
    background: rgb(255 255 255 / 23%);
}
