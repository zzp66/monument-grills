
{% liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == 'default'
    assign bg_color = settings.bg_color
  elsif color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif

  if bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
%}
<div class="section {% if section.settings.full_width %}section--full-width cc-ugc {% endif %} {% if section.settings.full_screen != blank %} {% else %}container {% endif %} {% if section.settings.mobile_stacked and section.settings.height_mode != 'screen' %} mobile-stacked{% if section.settings.full_width and bg_color == false or bg_color == settings.bg_color %} mobile-stacked--spaced{% endif %}{% endif %}{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} {% if section.settings.full_screen %}{% else %} container{% endif %}" id="{{ section.id }}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;">
  {% render 'ugc' %}
</div>
{% schema %}
  {
    "name": "UGC -- fei",
    "settings": [
      {
        "type": "header",
        "content": "跳转ID设置"
      },
      {
        "type": "text",
        "id": "link_id",
        "label": "Link ID"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "checkbox",
        "id": "full_screen",
        "label": "Full screen",
        "default": false
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Top",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Button",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "mobile_stacked",
        "label": "Show text below image on mobile",
        "info": "Does not apply to \"Full screen height\".",
        "default": false
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "options": [
            {
              "value": "white",
              "label": "Transparent background"
            },
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "1",
              "label": "Scheme 1"
            },
            {
              "value": "2",
              "label": "Scheme 2"
            },
            {
              "value": "3",
              "label": "Scheme 3"
            }
          ],
          "default": "white"
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Make section background full width",
          "default": false
        }
    ],
    "blocks": [
      
    ],
    "presets": [
      {
        "name": "UGC -- fei",
        "settings": {
          
        }
      }
    ]
  }
{% endschema %}