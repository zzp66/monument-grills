{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'media-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'media-with-text.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  # constants
  assign gutter_sm = 20

  assign media_type = 'image'
  assign image = section.settings.image

  if section.settings.video_external != blank or section.settings.video_shopify != blank
    assign media_type = 'video'
    assign using_video_tag = false
    assign autoplay = section.settings.video_autoplay

    if section.settings.video_shopify != blank
      assign using_video_tag = true

      if image == blank
        assign image = section.settings.video_shopify.preview_image
      endif
    endif
  endif
-%}

{%- if media_type == 'video' -%}
  {{ 'video.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  assign quality = settings.image_quality
  if section.settings.image_fit == "cover"
    assign quality = 1.4
  endif

  assign angle_size = section.settings.angle_size
-%}

{%- capture video_component -%}
  <video-component class="{% if using_video_tag %}has-video{% else %}has-iframe{% endif %} absolute top-0 left-0 w-full h-full"
                   {%- unless using_video_tag %}data-video-url="{{ section.settings.video_external | escape }}" {% endunless -%}
                   data-video-id="{{ section.id }}"
                   data-autoplay="{% if autoplay %}autoplay{% else %}false{% endif %}"
                   data-background="false"
                   data-natural-width="true"
                   data-description="{{ section.settings.video_description | escape }}">
    {%- if using_video_tag -%}
      {{ section.settings.video_shopify | video_tag: playsinline: true, autoplay: autoplay, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
    {%- else -%}
      <div></div>
    {%- endif -%}
  </video-component>
{%- endcapture -%}

{% if request.path contains "eminence" %}
  {% style %}
      @media (min-width: 1921px){
        .media-with-text .media-with-text__media{
            flex-basis: 80%;
        }
      }
     @media (max-width:768px){
       .media-with-text .media-with-text__media{
            flex-basis: 100%;
        }
     }
  {% endstyle %}
{% endif %}

{% style %}
  
  /* .cc-media-with-text .media-with-text__text, */
  .cc-media-with-text .media-with-text__text .numbers-box{
    padding-left: 0 !important;
  }
  .cc-media-with-text .media-with-text__text .font-weight{
    font-weight: bold;
  }
  .cc-media-with-text .media-with-text__text .font-uppercase{
    text-transform:uppercase;
  }
  .rounded-design{
    overflow: hidden;
    border-radius: {{ angle_size }}px;
  }
  .media-grid{
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 20px 20px;
  }
  .section-media-text .media-full-screen{
    /* max-width: 70%; */
  }
  .section-media-text .header-text {
    padding-top:3em;
  }
 
  @media (max-width:850px){
    .rounded-design{
      border-radius: 0 !important;
    }
 
    .cc-media-with-text .container{
      padding:0;
    }
    .cc-media-with-text .container .media-with-text__text{
      padding:calc(6 * var(--space-unit)) calc(6 * var(--space-unit)) calc(8 * var(--space-unit)) calc(6 * var(--space-unit));
    }
    .cc-media-with-text .section{
      padding:0px !important;
      padding-top:1.5em !important
    }
    .form__field .input-with-button{
       position: relative;
    }
    .form__field .input-with-button button{
      position: absolute;
      margin: 0;
      right: -3px;
      top: 1px;
      width: auto;
    }
    .form__field .input-with-button input[type='email']{
      padding-right: 100px;
    }
  }
  {% if section.settings.max_content_width != blank %}
     .section .max-width-{{ section.settings.max_content_width }}{
       max-width: {{ section.settings.max_content_width }}%;
       margin: 0 auto;
     }
    .section .max-width-{{ section.settings.max_content_width }} .media-with-text__text{
      /* padding-left:0 !important; */
    }
    .section .max-width-{{ section.settings.max_content_width }} .media-with-text__media{
      padding:3em 0;
    }
    .section .max-width-{{ section.settings.max_content_width }} .media-with-text__media .media{
      border-radius: {{ section.settings.media_rounded_size }}px;
    }
   
    @media (max-width:768px){
      .section .max-width-{{ section.settings.max_content_width }} .media-with-text__media{
        padding:0;
      }
       .section-media-text .media-full-screen{
          max-width: 100%;
        }
      .section-media-text .header-text {
        padding-top:2em;
      }
    }
  {% endif %}}

  
  
  
{% endstyle %}
{% if section.settings.image != blank %}
<div class="section color-scheme--transparent {% if section.settings.full_screen %} {% else %} section--padded{% endif %}{% unless color_scheme == 'none' or section.settings.only_content_color_scheme %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background: {{ section.settings.full_screen_bg }};max-width: 100%;">
  <div class="section-media-text max-width-{{ section.settings.max_content_width }}{% if section.settings.full_screen %}{% else %} container{% endif %}"  id="{{ section.settings.link_id }}">
   {%- if section.settings.heading != blank -%}
    <div class="header-text flex {{ section.settings.header_text_position }} text-center md-down:text-center pt-8 pb-2">
      <div class="max-w-text-overlay">
        <{{ section.settings.heading_size }} class="{% if section.settings.title_weight != blank %}font-weight{% endif %} {% if section.settings.title_uppercase != blank %} font-uppercase {% endif %} section__block section__block--heading md-down:px-gutter {{ section.settings.heading_size }}">
          <span class="contained-heading inline-block">{{- section.settings.heading | escape -}}</span>
        </{{ section.settings.heading_size }}>

        {%- if section.settings.header_text != blank -%}
          <{{ section.settings.text_size }} class="section__block reading-width rte {% if section.settings.enlarge_new_text != blank %}enlarge-text{% endif %}" {{ section.shopify_attributes }} {% if section.settings.text_color != blank %}style="color:{{ section.settings.text_color }};"{% endif %}>
            {{ section.settings.header_text }}
          </{{ section.settings.text_size }}>
        {%- endif -%}
      </div>
    </div>
    {% endif %}
    
    <div class="{% if section.settings.rounded_design != blank %}rounded-design {% endif %}{% if section.settings.full_screen %} media-full-screen {% else %}media-with-text {% endif %}{% if section.settings.layout == 'right' %} media-with-text--reverse{% endif %} {% if section.settings.grid_layout != blank %} grid{% endif %}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %} style="--media-width: {{ section.settings.media_width }}%; ">
      <div class="media-with-text__media{% if media_type == 'video' %} video-section{% endif %} relative flex flex-col justify-center overflow-hidden" style="--media-scale: {{ section.settings.media_scale | times: 0.01 }}" style="{% if section.settings.full_screen %}padding: calc(8 * var(--space-unit));{% endif %}">
        <div class="media w-full{% if media_type == 'video' %} absolute{% if section.settings.image_fit == "cover" %} top-0 left-0 h-full{% else %} video-section__media{% endif %} video-played-hidden{% else %} relative{% if section.settings.image_fit == "cover" %} h-full video-section__media--cover{% endif %}{% endif %}"{% if media_type == 'image' and image != blank %} style="padding-top: {{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"{% endif %}>
          {%- if image != blank -%}
            {%- capture sizes_md %}calc((50vw - {{ gutter_sm | times: 2 }}px) + 9px){% endcapture -%}
            {%- capture sizes -%}
              {%- render 'sizes-attribute', min: 'page', sm: 'page', md: sizes_md, lg: '536px', xl: false, max: false -%}
            {%- endcapture -%}
            {% liquid
              if section.settings.img_alt != 'blank'
                  assign img_alt_text = section.settings.img_alt
              endif
            %}
            <{% if section.settings.img_url != blank %}a{% else %}div{% endif %} class="img-url" {% if section.settings.img_url != blank %} href="{{ section.settings.img_url }}" target="_blank"{% endif %}>
              {% render 'image',
                image: image,
                quality: quality,
                widths: '536, 800, 1072, 1280',
                mobile_widths: '690, 800',
                src_width: 536,
                sizes: sizes,
                alt_text: img_alt_text,
                section_index: section.index,
                class: 'img-fit'
              %}
            </{% if section.settings.img_url != blank %}a{% else %}div{% endif %}>
          {%- elsif media_type == 'image' -%}
            {{ 'image' | placeholder_svg_tag: 'media__placeholder dark' }}
          {%- endif -%}
        </div>

        {%- if media_type == 'video' -%}
          {%- if section.settings.video_autoplay -%}
            <deferred-media class="video-section__media{% if section.settings.image_fit == "contain" %} relative{% endif %} block w-full no-js-hidden">
              <template>{{ video_component }}</template>
            </deferred-media>

            <noscript>
              <div class="video-section__media block w-full">
                {{ video_component }}
              </div>
            </noscript>
          {%- else -%}
            <deferred-media class="video-section__media{% if section.settings.image_fit == "contain" %} relative{% endif %} height-clip block w-full no-js-hidden">
              <button type="button" class="video-section__play-btn video-played-hidden absolute top-0 left-0 flex justify-center items-center w-full h-full js-load-media">
                <span class="visually-hidden">{{ 'general.icon_labels.play' | t }}</span>
                {%- render 'icon-play' -%}
              </button>
              <template>
                {{ video_component }}
              </template>
            </deferred-media>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="media-with-text__text {% if section.settings.show_text_color != blank %}media-with-text__color {% endif %}{% if section.settings.only_content_color_scheme and color_scheme != 'none' %} color-scheme color-scheme--{{ color_scheme }}{% elsif section.settings.image_fit == "cover" %} md:mt-14 md:mb-14{% endif %} flex flex-col justify-center {% if section.settings.layout == 'right' %} mie-auto{% endif %}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %} style="{% if section.settings.full_screen %}padding: calc(8 * var(--space-unit));{% endif %}">
        {% style %}
          .media-with-text__color .section__block{
            color:{{ section.settings.set_text_color }};
          }
        {% endstyle %}
        <div class="{{ section.settings.text_align }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- if block.settings.text != blank -%}
                  <h3 class="section__block subheading" {{ block.shopify_attributes }}>
                    {{- block.settings.text | escape -}}
                  </h3>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %} class="section__block section__block--heading {{ block.settings.heading_size }} {% if block.settings.font_size != blank %}font-size{% endif %} {% if block.settings.title_weight %} font-weight{% endif %} {% if block.settings.title_uppercase %} font-uppercase{% endif %}"
                    {{ block.shopify_attributes }} 
                    style="
                      background-image: linear-gradient({{ block.settings.color_angle }}deg, {{ block.settings.one_color }}, {{ block.settings.two_color }});
                      background: linear-gradient({{ block.settings.color_angle }}deg, {{ block.settings.one_color }}, {{ block.settings.two_color }});
                      -webkit-background-clip: text;
                      -webkit-text-fill-color: transparent;
                    ">
                    {% render 'multiline-text' with block.settings.heading %}
                  </{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <{% if block.settings.enlarge_new_text != blank %}{{ block.settings.text_size }}{% else %}h6{% endif %} class="section__block reading-width rte" {{ block.shopify_attributes }} {% if section.settings.text_color != blank %}style="color:{{ section.settings.text_color }};"{% endif %}>
                    {{ block.settings.text }}
                  </{% if block.settings.enlarge_new_text != blank %}{{ block.settings.text_size }}{% else %}h6{% endif %}>
                {%- endif -%}
  {% when 'liquid' %}
             {% if  block.settings.liquid!=blank %} <div>{{ block.settings.liquid }}</div>{% endif %}
              {% when 'header-image' %}
               
              {% if block.settings.header_banner != blank %}
                {% style %}
                  .header-image img{
                     position: relative;
                  }
                {% endstyle %}
                  <div class="header-image mb-4">
                    {% render 'image',
                      image: block.settings.header_banner,
                      widths: '200, 300, 400, 600, 800, 1000',
                      src_width: 300,
                      src_placeholder: true,
                      sizes: sizes,
                      quality: 1,
                      section_index: section.index,
                      class: 'img-fit header-banner-img'
                    %}
                </div>
              {% endif %}

              {% when 'social' %}
                {% style %}
                  .footer-social{
                    padding:20px 0 !important;
                  }
                  .footer .social{
                    width: 100%;
                    display: flex;
                  }
                  .footer .social.flex-center{
                    justify-content: center;
                  }
                {% endstyle %}
                <div class="footer footer-social">
                  <ul class="social inline-flex flex-wrap justify-start {% if block.settings.iscenter != blank %} flex-center{% endif %}">
                    {% if block.settings.fb_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.fb_url }}" target="_blank" rel="noopener" title="Monument Grills on Facebook"><svg width="24" height="24" viewBox="0 0 14222 14222" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M14222 7112c0 3549.352-2600.418 6491.344-6000 7024.72V9168h1657l315-2056H8222V5778c0-562 275-1111 1159-1111h897V2917s-814-139-1592-139c-1624 0-2686 984-2686 2767v1567H4194v2056h1806v4968.72C2600.418 13603.344 0 10661.352 0 7112 0 3184.703 3183.703 1 7111 1s7111 3183.703 7111 7111Zm-8222 7025c362 57 733 86 1111 86-377.945 0-749.003-29.485-1111-86.28Zm2222 0v-.28a7107.458 7107.458 0 0 1-167.717 24.267A7407.158 7407.158 0 0 0 8222 14137Zm-167.717 23.987C7745.664 14201.89 7430.797 14223 7111 14223c319.843 0 634.675-21.479 943.283-62.013Z"></path></svg><span class="visually-hidden">Facebook</span>
                        </a>
                      </li>
                    {% endif %}
                    {% if block.settings.youtube_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.youtube_url }}" target="_blank" rel="noopener" title="Monument Grills on YouTube"><svg width="24" height="17" viewBox="0 0 48 34" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="m19.044 23.27-.001-13.582 12.968 6.814-12.967 6.768ZM47.52 7.334s-.47-3.33-1.908-4.798C43.787.61 41.74.601 40.803.49 34.086 0 24.01 0 24.01 0h-.02S13.914 0 7.197.49c-.939.11-2.984.12-4.81 2.045C.947 4.003.48 7.334.48 7.334S0 11.247 0 15.158v3.668c0 3.912.48 7.823.48 7.823s.468 3.331 1.906 4.798c1.827 1.926 4.226 1.866 5.294 2.067C11.52 33.885 24 34 24 34s10.086-.015 16.803-.505c.938-.113 2.984-.122 4.809-2.048 1.439-1.467 1.908-4.798 1.908-4.798s.48-3.91.48-7.823v-3.668c0-3.911-.48-7.824-.48-7.824Z"></path></svg><span class="visually-hidden">YouTube</span>
                        </a>
                      </li>
                    {% endif %}
                    {% if block.settings.instagram_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" title="Monument Grills on Instagram"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><circle cx="15.238" cy="4.948" r="1.238"></circle><path d="M19.47 3.444A5.11 5.11 0 0 0 16.548.527a7.351 7.351 0 0 0-2.43-.466C13.05.014 12.713 0 9.999 0c-2.712 0-3.057 0-4.12.06A7.351 7.351 0 0 0 3.45.528 5.11 5.11 0 0 0 .528 3.444 7.317 7.317 0 0 0 .06 5.87C.014 6.936 0 7.274 0 9.982s0 3.053.06 4.113c.018.829.176 1.649.468 2.425a5.11 5.11 0 0 0 2.922 2.917 7.35 7.35 0 0 0 2.429.5c1.069.047 1.407.06 4.12.06s3.058 0 4.12-.06a7.351 7.351 0 0 0 2.429-.466 5.11 5.11 0 0 0 2.922-2.918 7.31 7.31 0 0 0 .467-2.424c.047-1.067.06-1.405.06-4.113s0-3.053-.06-4.113a7.317 7.317 0 0 0-.467-2.459zm-1.437 10.537a5.439 5.439 0 0 1-.34 1.843 3.262 3.262 0 0 1-1.87 1.87 5.451 5.451 0 0 1-1.825.34c-1.04.046-1.332.06-3.996.06-2.664 0-2.937 0-3.995-.06a5.451 5.451 0 0 1-1.825-.34 3.255 3.255 0 0 1-1.878-1.87 5.439 5.439 0 0 1-.34-1.823c-.046-1.038-.06-1.33-.06-3.992s0-2.934.06-3.992c.006-.63.121-1.253.34-1.844a3.255 3.255 0 0 1 1.878-1.87 5.451 5.451 0 0 1 1.825-.339c1.038-.046 1.331-.06 3.995-.06s2.937 0 3.996.06c.623.008 1.24.123 1.824.34.86.331 1.54 1.01 1.872 1.87.216.583.331 1.2.34 1.823.046 1.038.06 1.33.06 3.992 0 2.661 0 2.948-.047 3.992h-.014z"></path><path d="M9.991 14.753a4.761 4.761 0 1 1 0-9.523 4.761 4.761 0 0 1 0 9.523zm0-1.905a2.857 2.857 0 1 0 0-5.713 2.857 2.857 0 0 0 0 5.713z"></path></svg><span class="visually-hidden">Instagram</span>
                        </a>
                      </li>
                    {% endif %}
                    {% if block.settings.tiktok_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.tiktok_url }}" target="_blank" rel="noopener" title="Monument Grills on TikTok"><svg width="23" height="24" viewBox="0 0 15 16" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M7.638.013C8.512 0 9.378.007 10.245 0c.054 1.02.42 2.06 1.167 2.78.746.74 1.8 1.08 2.826 1.193V6.66c-.96-.033-1.926-.233-2.8-.647a8.238 8.238 0 0 1-1.08-.62c-.006 1.947.007 3.894-.013 5.834a5.092 5.092 0 0 1-.9 2.626c-.873 1.28-2.387 2.114-3.94 2.14-.953.054-1.907-.206-2.72-.686C1.438 14.513.492 13.06.352 11.5a12.36 12.36 0 0 1-.007-.993A5.003 5.003 0 0 1 2.065 7.2c1.107-.96 2.653-1.42 4.1-1.147.013.987-.027 1.974-.027 2.96-.66-.213-1.433-.153-2.013.247-.42.273-.74.693-.907 1.167-.14.34-.1.713-.093 1.073.16 1.093 1.213 2.013 2.333 1.913.747-.006 1.46-.44 1.847-1.073.127-.22.267-.447.273-.707.067-1.193.04-2.38.047-3.573.007-2.687-.007-5.367.013-8.047Z"></path></svg><span class="visually-hidden">TikTok</span>
                        </a>
                      </li>
                    {% endif %}
                    {% if block.settings.pinterest_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.pinterest_url }}" target="_blank" rel="noopener" title="Monument Grills on Pinterest"><svg width="24" height="24" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M24.001 0C10.748 0 0 10.745 0 24.001c0 9.825 5.91 18.27 14.369 21.981-.068-1.674-.012-3.689.415-5.512.462-1.948 3.087-13.076 3.087-13.076s-.765-1.533-.765-3.799c0-3.556 2.064-6.212 4.629-6.212 2.182 0 3.237 1.64 3.237 3.604 0 2.193-1.4 5.476-2.12 8.515-.6 2.549 1.276 4.623 3.788 4.623 4.547 0 7.61-5.84 7.61-12.76 0-5.258-3.543-9.195-9.986-9.195-7.279 0-11.815 5.427-11.815 11.49 0 2.094.616 3.567 1.581 4.708.446.527.505.736.344 1.34-.113.438-.378 1.505-.488 1.925-.16.607-.652.827-1.2.601-3.355-1.369-4.916-5.04-4.916-9.17 0-6.816 5.75-14.995 17.152-14.995 9.164 0 15.195 6.636 15.195 13.75 0 9.416-5.233 16.45-12.952 16.45-2.588 0-5.026-1.4-5.862-2.99 0 0-1.394 5.53-1.688 6.596-.508 1.85-1.504 3.7-2.415 5.14 2.159.638 4.44.985 6.801.985C37.255 48 48 37.255 48 24.001 48 10.745 37.255 0 24.001 0"></path></svg><span class="visually-hidden">Pinterest</span>
                        </a>
                      </li>
                    {% endif %}
                    {% if block.settings.twitter_url != blank %}
                      <li>
                        <a class="social__link flex items-center justify-center" href="{{ block.settings.twitter_url }}" target="_blank" rel="noopener" title="Monument Grills on Twitter"><svg fill="currentColor" width="40" height="40" viewBox="1 1 22 22" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg><span class="visually-hidden">Twitter</span>
                        </a>
                      </li>
                    {% endif %}
                  </ul>
                </div>
              
              {% when 'newsletter' %}
                {% if block.settings.is_show_newsletter != blank %}
                  {% render 'newsletter-notify-me',
                    id: 'product-newsletter-signup',
                    tags: 'Grills Day',
                    arrow_button: false,
                    use_cur_btn: true,
                    text_name: {{ block.settings.newsletter_name }},
                    btn_icon: {{ block.settings.btn_icon }}
                  %}
                {% endif %}

              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="section__block section__block--button {% if block.settings.is_use_icon != blank %} is-use-icon{% endif %}" {{ block.shopify_attributes }}>
                    {%- if block.settings.button_label != blank %}
                      <link rel="stylesheet" href="{{ 'mobile-product-comparison-grid.css' | asset_url }}" media="print" onload="this.media='all'">
                      <{% if block.settings.is_copyed_btn != blank %}button id="{{ block.settings.copyed_btn_id }}"{% else %}a{% endif %} class="{{ block.settings.button_style }} {% if block.settings.icon_layout == 'left' %} left{% else %} right{% endif %}" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %} {% if block.settings.is_copyed_btn != blank %} data-link="{{ block.settings.button_link }}"{% endif %} style="color: {{ block.settings.btn_font_color }};background:{{ block.settings.btn_bg_color }};border-color:{{ block.settings.btn_bg_color }}">
                        {{- block.settings.button_label | escape -}}
                        {% if block.settings.is_use_icon != blank %}
                          {%- capture sizes_md %}calc((50vw - {{ gutter_sm | times: 2 }}px) + 9px){% endcapture -%}
                          {%- capture sizes -%}
                            {%- render 'sizes-attribute', min: 'page', sm: 'page', md: sizes_md, lg: '536px', xl: false, max: false -%}
                          {%- endcapture -%}
                          {% liquid
                            if block.settings.button_icon_alt != 'blank'
                                assign img_alt_text = block.settings.button_icon_alt
                            endif
                            if block.settings.button_icon != 'blank'
                                assign btn_icon = block.settings.button_icon
                            endif
                          %}
                          {% render 'image',
                            image: btn_icon,
                            quality: quality,
                            widths: '32, 48, 64, 96',
                            mobile_widths: '32, 48',
                            src_width: 48,
                            sizes: sizes,
                            alt_text: img_alt_text,
                            section_index: block.index,
                            class: 'img-fit button-icon'
                          %}
                        {% endif %}
                      </{% if block.settings.is_copyed_btn != blank %}button{% else %}a{% endif %}>
                      <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                        <button type="button" class="{{ block.settings.link_style }} aa" aria-haspopup="dialog">
                          {{- block.settings.link_text -}}
                        </button>
                      </modal-opener>
                      
                      {% if block.settings.button_label2 != blank %}
                        <a class="{{ block.settings.button_style2 }}" {% if block.settings.button_link2 == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link2 }}"{% endif %}>
                          {{- block.settings.button_label2 | escape -}}
                        </a>
                      {% endif %}
                      
                      {% style %}
                        .is-use-icon a{
                          display: inline-flex;
                          justify-content: flex-start;
                          align-items: center;
                        }
                        .is-use-icon a picture{
                          width: 16px;
                        }
                        .is-use-icon a picture img{
                          position: relative;
                          object-fit: contain;
                          fill:{{ block.settings.button_icon_color }};
                        }
                        .is-use-icon a.right{
                          flex-direction:row;
                        }
                        .is-use-icon a.left{
                          flex-direction:row-reverse;
                        }
                        .is-use-icon a.right picture{
                          margin-left: 6px;
                        }
                        .is-use-icon a.left picture{
                          margin-right: 6px;
                        }
                      {% endstyle %}
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {% when 'popup-button' %}
                {% if block.settings.is_show_popup != blank %}
                  <div class="section__block section-btn mt-6 mb-4">
                    <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                      <button id="openModal" data-popup="popup-btn" type="button" class="btn {{ block.settings.button_style }}" aria-haspopup="dialog" {% if block.settings.is_nofollow != false %}rel="nofollow"{% endif %}>
                        {{- block.settings.button_label -}}
                      </button>
                    </modal-opener>
                  </div>
                {% endif %}
                        
              {% when 'social-share' %}
                 {% liquid
                   if block.settings.share_title == blank
                     assign share_title = page.title
                   else
                     assign share_title = block.settigns.share_title
                   endif

                   if block.settings.share_url == blank
                     assign share_url = request.url
                   else
                     assign share_url = block.setings.share_url
                   endif

                   if block.settings.share_img == blank
                     assign share_image = page.image
                   else
                     assign share_image = block.settings.share_img
                   endif
                 %}
                 <div class="share-list mt-6 {% if block.settings.iscenter != blank %}share-center{% endif %}">
                    {% render 'social-share', share_title: share_title, share_url: share_url, share_image: share_image %}
                  </div>

              {% when 'pdf-manuals' %}
                {% if block.settings.is_show_manuals != blank %}
                  {% style %}
                    .file-manuals{
                      display:flex;
                      align-items: center;
                      justify-content: space-between;
                    }
                    
                    .file-manuals p{
                      margin-bottom: 0;
                    }
                    .file-manuals img{
                      position: relative;
                      object-fit: contain;
                      width: 50px;
                    }
                    @media (max-width:768px){
                      .file-manuals{
                        flex-direction: column;
                      }
                      .file-manuals a{
                        margin-top:2em;
                      }
                    }
                  {% endstyle %}
                  {%- capture sizes %}{% render 'sizes-attribute', grid: true, min: section.settings.gallery_cols_min, sm: block.settings.columns %}{% endcapture -%}
                  {% if block.settings.file_url != blank %}
                    <div class="file-manuals mt-4">
                     {% render 'image',
                        image: block.settings.file_icon,
                        widths: '64, 128',
                        src_width: 64,
                        src_placeholder: true,
                        sizes: sizes,
                        quality: 1,
                        section_index: section.index,
                        class: 'img-fit'
                      %}
                     <p>{{ block.settings.file_name }}</p>
                     <p>{{ block.settings.file_version }}</p>
                     <a class="btn btn--primary" href="{{ block.settings.file_url }}" {% if block.settings.is_show_manuals != blank %} download{% endif %} target="_blank">Download</a>
                  </div>
                  {% endif %}
                {% endif %}

              {% when 'rolling-numbers' %}
                {% if settings.show_rolling_numbers != blank %}
                  {% style %}
                    .numbers-box{
                      display: flex;
                      flex-direction: column;
                      padding: 0 2em;
                    }
                    .numbers-box .item-numbers-box{
                      display: flex;
                      flex-direction: column;
                      margin-bottom:2em;
                    }
                    .numbers-box .item-numbers-box .number{
                      display:flex;
                      align-items: flex-end;
                    }
                   .numbers-box .item-numbers-box .description{
                     color:#555;
                     /* font-size:9px; */
                   }
                    .numbers-box .item-numbers-box .number .title{
                      margin-bottom: 0;
                      margin-right: 10px;
                    }
                    .numbers-box .item-numbers-box .number .nuit{
                      margin-bottom: 8px;
                      font-size: 28px;
                    }
                    @media (max-width:768px){
                      .numbers-box .item-numbers-box .number .nuit{
                        margin-bottom: 0px;
                      }
                    }
                  {% endstyle %}
                  <script>
                    $(function(){
                      const numberOne = document.getElementById('numberOne');
                      const target = parseInt(numberOne.dataset.target);
                      let numberOne = 0;

                      

                      function startAnimation() {
                        animateValue(numberOne, target, 3000);
                        numberOne = target; 
                      };

                      function animateValue(start, end, duration) {
                        let startTime = null;
                    
                        function step(timestamp) {
                          if (!startTime) startTime = timestamp;
                          const progress = Math.min((timestamp - startTime) / duration, 1);
                          const value = Math.floor(start + (end - start) * progress);
                          numberOne.textContent = Math.round(value);
                    
                          if (progress < 1) {
                            window.requestAnimationFrame(step);
                          }
                        }
                    
                        window.requestAnimationFrame(step);
                      };

                      startAnimation();

                      setInterval(startAnimation, 8000);
                    });
                  </script>
                  
                   <div class="numbers-box">
                     <div class="item-numbers-box">
                       <div class="number">
                         <{{ block.settings.number_size }} class="title" id="numberOne" data-target="{{ block.settings.number_one }}">{{ block.settings.number_one }}</{{ block.settings.number_size }}><p class="nuit">{{ block.settings.number_one_unit }}</p>
                       </div>
                       <p class="description">{{ block.settings.number_one_des }}</p>
                     </div>
                     <div class="item-numbers-box">
                       <div class="number">
                         <{{ block.settings.number_size }} class="title" id="numberTwo" data-target="{{ block.settings.number_two }}">{{ block.settings.number_two }}</{{ block.settings.number_size }}><p class="nuit">{{ block.settings.number_two_unit }}</p>
                       </div>
                       <p class="description">{{ block.settings.number_two_des }}</p>
                     </div>
                   </div>
                {% endif %}
              
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
