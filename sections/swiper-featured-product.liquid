<style>
  .product-item {
    display: grid;
    grid-template-columns: 70%, 30%;
    border-radius: 16px;
    overflow: hidden;
  }
  .product-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-box {
    padding: 40px 60px 40px 40px;
    background-color: #f5f5f5;
  }
</style>
{{ 'media-with-text.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{{ 'media-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<div class="swiper-featured-product1 section">
  <div class="container">
    <div class="swiper sfp-swiper">
      <div class="swiper-wrapper">
        {% for block in section.settings %}
          {% liquid
            assign product = block.settings.item_product
            assign product_form_id = 'product-form-' | append: section.id
            assign current_variant = product.selected_or_first_available_variant
            assign first_3d_model = product.media | where: 'media_type', 'model' | first
            assign media_ratio = 'natural'
          %}
          <div class="swiper-slide">
            <div class="product-item">
              <div class="product-box">
                <div
                  class="product media-with-text js-product"
                  data-section="{{ section.id }}"
                  style="--media-width: 50%"
                >
                  <div class="product-media mb-4 md:mb-0 product-media--slider media-with-text__media">
                    {%- if product != blank -%}
                      {% render 'media-gallery',
                        product: product,
                        current_variant: current_variant,
                        media_ratio: media_ratio,
                        media_crop: 'none',
                        first_3d_model: first_3d_model,
                        zoom: 'off',
                        featured_product: true
                      %}
                    {%- endif -%}
                  </div>
                </div>
              </div>
              <div class="product-banner">
                <img
                  src="https://cdn.shopify.com/s/files/1/1639/3511/files/p5_c84955d4-63fd-4996-8102-a74d9e4554a6.jpg?v=1754702797"
                  alt=""
                >
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Swiper Featured Product1",
  "settings": [],
  "blocks": [
    {
      "type": "slide_product",
      "name": "Slide Product",
      "settings": [
        {
          "type": "product",
          "id": "item_product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swiper Featured Product1"
    }
  ]
}
{% endschema %}
