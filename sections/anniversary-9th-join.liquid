<style>
  .anniversary-9th-join {
    padding: 60px 0;
  }
  .join-content {
    position: relative;
  }
  .join-infos {
    position: absolute;
    left: 10%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
  }
  p.join-text-1 {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
  }
  p.join-text-2 {
    color: #000;
    margin: 0;
    max-width: 65%;
    margin-bottom: 20px;
  }
  .join-text-1 span {
    color: #e55420;
  }
  .join-btn a {
    color: #fff;
    background-color: #e55420;
    border-radius: 3px;
    padding: 10px 15px;
  }

  @media screen and (max-width: 768px) {
    p.join-text-1 {
      font-size: 14px;
    }
    p.join-text-2 {
      font-size: 14px;
      max-width: 45%;
    }
    .join-btn a {
      font-size: 14px;
    }
  }
</style>
<div class="anniversary-9th-join">
  <div class="join-content container">
    <div class="join-img">
      <img
        src="https://cdn.shopify.com/s/files/1/1639/3511/files/7a734341578ba0d66312d060e44fefbd5d18d956.jpg?v=1754048526"
        alt=""
      >
    </div>
    <div class="join-infos">
      <p class="join-text-1">Celebrate <span>9 Years</span>, Win Big!</p>
      <p class="join-text-2">Tell us your 9 moment. We’re giving back with epic grill giveaways.</p>
      <div class="join-btn"><a href="/">Comment to Win</a></div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "9th Anniversary Join",
  "settings": [],
  "presets": [
    {
      "name": "9th Anniversary Join"
    }
  ]
}
{% endschema %}
