<style>
.logos-wrapper {
    overflow: hidden;
    position: relative;
}

.logos-row {
    display: flex;
    width: 200%; /* 确保足够的宽度来实现无缝滚动 */
  gap: 20px;
}

.scroll-left {
    animation: scrollLeft 30s linear infinite;
}

.scroll-right {
    animation: scrollRight 20s linear infinite;
}

@keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

@keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
}

.logos_box {
    position: relative;
}

.logos_sec {
    margin-top: 60px;
}

.logos__item {
    position: relative;
    width: 200px;
    height: 140px;
  padding-bottom:20px;
  padding-top:20px;
    perspective: 1000px;
    cursor: pointer;
    flex: none;
}
.logo__seccon .logos__item {
    width: 100%;
}
.logos__item-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
}

.logos__item:hover .logos__item-inner {
    transform: rotateY(180deg); /* 翻转180度 */
}

/* 正面和背面的共同样式 */
.logos__item-front,
.logos__item-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
}

/* 图片样式 */
.logos__item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* border: 1px solid #f9f9f9; */
    box-shadow: rgb(0 0 0 / 8%) 2px 5px 15px 0px
}

/* 背面样式 */
.logos__item-back {
    transform: rotateY(180deg);
}

.tabs {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin: 20px 0 40px;
}

.tab-btn {
    padding: 15px 0;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 24px;
    position: relative;
}

.tab-btn.active {
    color: #000;
}

.tab-btn.active:after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 5px;
    background-image: linear-gradient(to right, #c00000, #ffffff);
}
.logo__seccon{
      display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}
  div#tab1:after{
    right: 0;
    background: linear-gradient(to left, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.9) 20%, rgba(255, 255, 255, 0) 100%);
    position: absolute;
    display: block;
    content: '';
    top: 0;
    width: 100px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
   div#tab1:before{
     left: 0;
    background: linear-gradient(to right, 
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0.9) 20%,
        rgba(255, 255, 255, 0) 100%
    );
      position: absolute;
    display: block;
    content: '';
    top: 0;
    width: 100px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
@media(max-width: 991px) {
        .logos__item {
        width: 100px;
        height: 80px;
        padding: 0;
        border: 1px solid #dfdfdf;
    }
  .tab-btn {
    padding: 10px 0;
    font-size: 18px;
}
  .logos__item img {
   
    box-shadow: none;
}
  .scroll-left {
    margin-bottom: 20px;
}
  .logo__seccon {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}
}
</style>

<section class="logos_sec">
    <div class="container">
        <div class="head_sec">
            <h2>{{ section.settings.heading }}</h2>
            <div class="tabs">
                <button class="tab-btn active" data-tab="tab1">{{ section.settings.tab1_heading }}</button>
                <button class="tab-btn" data-tab="tab2">{{ section.settings.tab2_heading }}</button>
            </div>
        </div>
        
        
<div class="logos-wrapper" id="tab1">
    <div class="logos-row scroll-left">
      
        {% for block in section.blocks limit:9 %}
            {% if block.settings.tab_type == 'tab1' %}
                <div class="logos__item">
                    <div class="logos__item-inner">
                        <div class="logos__item-front">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                        <div class="logos__item-back">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        <!-- 重复一遍图片以实现无缝滚动 -->
        {% for block in section.blocks limit:9 %}
            {% if block.settings.tab_type == 'tab1' %}
                <div class="logos__item">
                    <div class="logos__item-inner">
                        <div class="logos__item-front">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                        <div class="logos__item-back">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <div class="logos-row scroll-right">
        {% for block in section.blocks offset:9 limit:9 %}
            {% if block.settings.tab_type == 'tab1' %}
                <div class="logos__item">
                    <div class="logos__item-inner">
                        <div class="logos__item-front">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                        <div class="logos__item-back">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        <!-- 重复一遍图片以实现无缝滚动 -->
        {% for block in section.blocks offset:9 limit:9 %}
            {% if block.settings.tab_type == 'tab1' %}
                <div class="logos__item">
                    <div class="logos__item-inner">
                        <div class="logos__item-front">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                        <div class="logos__item-back">
                            <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

<div class="logos-wrapper" id="tab2" style="display: none;">
  <div class="logo__seccon">
    {% for block in section.blocks %}
        {% if block.settings.tab_type == 'tab2' %}
            <div class="logos__item">
                <div class="logos__item-inner">
                    <div class="logos__item-front">
                        <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                    </div>
                    <div class="logos__item-back">
                        <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}" />
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div></div>
    </div>
</section>



<script>
document.addEventListener('DOMContentLoaded', function() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.logos-wrapper');

    tabBtns.forEach((btn, index) => {
        btn.addEventListener('click', function() {
            // 移除所有活动状态
            tabBtns.forEach(btn => btn.classList.remove('active'));
            tabContents.forEach(content => content.style.display = 'none');

            // 添加新的活动状态
            this.classList.add('active');
            tabContents[index].style.display = 'block'; // 显示对应的内容
        });
    });

    // 初始化显示第一个标签内容
    tabBtns[0].classList.add('active');
    tabContents[0].style.display = 'block';
});
</script>

{% schema %}
{
  "name": "Logo tab",
  "class": "cc-Logoss",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "title",
    },
    {
      "type": "text",
      "id": "tab1_heading",
      "label": "tab1",
      "default": "tab1"
    },
    {
      "type": "text",
      "id": "tab2_heading",
      "label": "tab2",
      "default": "tab2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Logo项目",
      "settings": [
        {
          "type": "select",
          "id": "tab_type",
          "label": "tab",
          "options": [
            {
              "value": "tab1",
              "label": "tab1"
            },
            {
              "value": "tab2",
              "label": "ta2"
            }
          ],
          "default": "tab1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        }
      ]
    }
  ]
}
{% endschema %}