  "name": "Collection new - wenfei",
  "class": "collection-new section section--template mb-0",
  "settings": [
    {
      "type": "header",
      "content": "List Layout"
    },
    {
      "type": "checkbox",
      "id": "list_layout",
      "label": "Show list layout only",
