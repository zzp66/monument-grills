<style>
  .reviews-grid-img {
    background-color: #fff;
    padding: 100px 0;
  }
  .reviews-grid-img img {
    display: block;
  }
  .reviews-grid-img-wrapper {
    padding-inline: 20px;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-areas:
      'c-net google facebook'
      'c-net quote quote';
    grid-template-columns: 2fr 1fr 1fr;
    gap: 20px;
  }
  .review-grid-item {
    position: relative;
    padding: 30px;
    border-radius: 15px;
    overflow: hidden;
  }
  .review-grid-item.c-net {
    grid-area: c-net;
    padding-bottom: 0;
    background-color: #f1f1f1;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  img.c-net-img1 {
    position: absolute;
    top: 0;
    right: 50px;
    max-width: 180px;
    margin: 0 100px 0 25px;
    z-index: 0;
  }
  img.c-net-img2 {
    max-width: 195px;
    margin-bottom: 10px;
  }
  img.c-net-img3 {
    display: block;
    margin-bottom: 5px;
  }
  .c-net-info {
    position: relative;
    top: 40px;
    z-index: 1;
    max-width: 325px;
    margin-bottom: 45px;
    padding-bottom: 45px;
  }
  .c-net-text {
    font-size: 32px;
    font-weight: 700;
    line-height: 34px;
    margin: 0;
    color: #757575;
  }
  .review-grid-item.google {
    grid-area: google;
    background-color: #f1f1f1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .review-grid-item.google img {
    max-width: 95px;
    margin-bottom: 5px;
  }
  .review-grid-item.google p {
    margin: 0;
    font-size: 21px;
    font-weight: bold;
    color: #757575;
    line-height: 24px;
  }
  .review-grid-item.facebook {
    grid-area: facebook;
    background-color: #fbb040;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .review-grid-item.facebook img {
    max-width: 120px;
    margin-bottom: 5px;
  }
  .review-grid-item.facebook p {
    margin: 0;
    font-size: 21px;
    font-weight: bold;
    color: #fff;
    line-height: 24px;
  }
  .review-grid-item.quote {
    grid-area: quote;
    background-color: #f1f1f1;
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  img.quote-img1 {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 50px;
    margin: 0 100px 0 25px;
    max-width: 140px;
  }
  .quote-info {
    order: 2;
    z-index: 1;
  }
  .quote-info img {
    max-width: 75px;
    margin-bottom: 5px;
  }
  .quote-info p {
    font-size: 26px;
    font-weight: bold;
    line-height: 1.2;
    color: #757575;
  }
  img.quote-img3 {
    order: 1;
    max-width: 225px;
    margin-right: 30px;
  }

  @media screen and (max-width: 1024px) {
    img.quote-img3 {
      max-width: 140px;
    }
  }

  @media screen and (max-width: 750px) {
    .reviews-grid-img {
      padding: 30px 0;
    }
    .reviews-grid-img-wrapper {
      grid-template-areas:
        'c-net c-net'
        'google facebook'
        'quote quote';
      gap: 10px;
      grid-template-columns: 1fr 1fr;
    }
    .review-grid-item.c-net {
      align-items: center;
    }
    img.c-net-img1 {
      margin: 0;
    }
    img.c-net-img2 {
      max-width: 160px;
    }
    img.c-net-img3 {
      max-width: 250px;
    }
    .c-net-text {
      font-size: 24px;
      line-height: 26px;
    }
    .review-grid-item.google p,
    .review-grid-item.facebook p {
      font-size: 16px;
      line-height: 18px;
    }
    .quote-info p {
      font-size: 18px;
      line-height: 20px;
    }
  }
</style>

{% assign sec = section.settings %}
<div class="reviews-grid-img">
  <div class="reviews-grid-img-wrapper">
    <div class="review-grid-item c-net">
      <img
        class="c-net-img1"
        src="{{ sec.grid_img_1 | image_url: width: master }}"
        alt=""
      >
      <div class="c-net-info">
        <img
          class="c-net-img2"
          src="{{ sec.grid_img_2 | image_url: width: master }}"
          alt=""
        >
        <p class="c-net-text">{{ sec.grid_text_1 }}</p>
      </div>
      <img
        class="c-net-img3"
        src="{{ sec.grid_img_3 | image_url: width: master }}"
        alt=""
      >
    </div>
    <div class="review-grid-item google">
      <img src="{{ sec.grid_img_4 | image_url: width: master }}" alt="">
      <p>{{ sec.grid_text_2 }}</p>
    </div>
    <div class="review-grid-item facebook">
      <img
        src="{{ sec.grid_img_5 | image_url: width: master }}"
        alt=""
      >
      <p>{{ sec.grid_text_3 }}</p>
    </div>
    <div class="review-grid-item quote">
      <img
        class="quote-img1"
        src="{{ sec.grid_img_6 | image_url: width: master }}"
        alt=""
      >
      <div class="quote-info">
        <img class="quote-img2" src="{{ sec.grid_img_7 | image_url: width: master }}" alt="">
        <p>{{ sec.grid_text_4 }}</p>
      </div>
      <img
        class="quote-img3"
        src="{{ sec.grid_img_8 | image_url: width: master }}"
        alt=""
      >
    </div>
  </div>
</div>
