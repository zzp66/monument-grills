{% endstyle %}

{% if section.settings.is_two_cols != blank %}
  {% style %}
   #{{ section.id }} .multi-media-warp ul{
      justify-content: center;
    }
   #{{ section.id }} .multi-media-warp ul li{
      width:50%;
    }
  {% endstyle %}
{% endif %}



{% liquid
  assign block_min_height = section.settings.block_min_height
  assign mobile_block_min_height = section.settings.mobile_block_min_height
%}

<div class="section section--padded section--full-width {{ section.class}}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;">
  <div class="{% if section.settings.full_screen %}full-screen-column-media{% else %} container{% endif %}">
    <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
      {% if section.settings.title != blank %}
        <{{ section.settings.heading_size }} class="section__heading mb-0 flex-auto {{ section.settings.heading_align }} {% if section.settings.header_weight %} font-weight{% endif %} {% if section.settings.header_uppercase %} font-uppercase{% endif %}">
          {{- section.settings.title | escape -}}
        </{{ section.settings.heading_size }}>
      {% endif %}
    </div>
    {% if section.settings.mobile_carousel %}
        <div class="gallery-mobile-carousel multi-column-media-carousel">
      {% endif %}
        <div class="flex multi-media-warp">
          <ul class="{% if section.settings.mobile_carousel %}slider__grid grid grid-flow-col auto-cols-1 md:auto-cols-2 lg:auto-cols-3 gap-x-theme gap-y-6{% else %}list{% endif %}">
            {% for block in section.blocks %}
              {% liquid
                assign media_image = block.settings.media_image
                assign media_title = block.settings.media_title
                assign media_title_size = block.settings.media_title_size
                
                assign ima_banner_sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'

                assign domain = request.origin
                
              %}
              <li class="item-media media media--has-overlay overflow-hidden relative" data-url="{{ domain }}{{ block.settings.button_link }}">
                    {% if media_image != blank %}
                      {% render 'image',
                        image: media_image,
                        widths: '480, 800, 980, 1024, 1440, 1920',
                        src_width: 980,
                        src_placeholder: true,
                        sizes: ima_banner_sizes,
                        quality: 1,
                        section_index: section.index,
                        class: 'img-fit'
                      %}
                    {% else %}
                      {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                    {% endif %}

                    {% if media_title != blank %}
                      <div class="item-media-info absolute has-motion {{ block.settings.overlay_position }}">
                        <{{ media_title_size }} class="section__heading mb-0 flex-auto {{ block.settings.text_alignment }} {% if block.settings.media_title_weight %} font-weight{% endif %} {% if block.settings.media_title_uppercase %} font-uppercase{% endif %}">{{ media_title }}</{{ media_title_size }}>
                      <div class="overly_content">
                          {% if block.settings.media_des != blank %}
                            <div class="media-sub-title">{{ block.settings.media_des }}</div>
                        {% endif %}
                        <div class="gallery-block__image-text relative">
                          {%- if block.settings.button_label != blank -%}
                            
                          {%- endif -%}

                          {% if block.settings.use_popup_btn != blank and block.settings.button_label != blank %}
                            <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if section.settings.text_alignment == 'text-start' %} justify-start{% elsif section.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                               <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                                  <button type="button" class="popup-btn {{ block.settings.button_style }}" aria-haspopup="dialog" data-popup="popup-btn">
                                    {{- block.settings.button_label -}}
                                  </button>
                               </modal-opener>
                            </div>
                          {% elsif block.settings.show_small_page != blank and block.settings.button_label != blank %}
                            <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if section.settings.text_alignment == 'text-start' %} justify-start{% elsif section.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                               <button type="button" class="show-small-page-btn {{ block.settings.button_style }}">
                                  {{- block.settings.button_label -}}
                               </button>
                              {% liquid
                                assign page_width = block.settings.small_page_width
                                assign page_height = block.settings.small_page_height
                                assign page_url = block.settings.small_page_url
                              %}
                              <script>
                                   function openSmallWindow() {
                                    const width = {{ page_width | to_integer }};
                                    const height = {{ page_height | to_integer }};
                                    const left = ((window.screen.width) - width) / 2;
                                    const top = ((window.screen.height) - height) / 2;
                              
                                    window.open('{{ page_url }}', 'smallWindow', `width=${width},height=${height},left=${left},top=${top}`);
                                  }
                              
                                  $(document).ready(function() {
                                    $('.show-small-page-btn').click(openSmallWindow);
                                  });
                               </script>
                            </div>
                          {% else %}
                            <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if section.settings.text_alignment == 'text-start' %} justify-start{% elsif section.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                            {% if block.settings.more_link !=blank %}<a href="{{ block.settings.more_link }}" class="btn btn--secondary" target="_blank">Learn More</a>{% endif %}
                              <{% if block.settings.button_link == blank %}button{% else %}a{% endif %} data-popup="{{ block.settings.class }}" class="{{ block.settings.button_style }} {{ block.settings.class }}" {% if block.settings.add_target != blank %} target="_blank"{% endif %} {% if block.settings.button_link == blank and is_link == false %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link }}" target="_blank"{% endif %}  style="background:{{ block.settings.button_color }};border-color:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};">
                                {{- block.settings.button_label | escape -}}
                              </{% if block.settings.button_link == blank %}button{% else %}a{% endif %}>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                      </div>
                    {% endif %}
                  </li>
            {% endfor %}
          </ul>
        </div>
      {% if section.settings.mobile_carousel %}
        </div>
      {% endif %}
  </div>
</div>

{% if section.settings.show_small_screen != blank %}
   
{% endif %}

{% if section.settings.show_pop != blank %}
  {{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
  {{ 'popup.css' | asset_url | stylesheet_tag }}
  {{ 'modal.css' | asset_url | stylesheet_tag }}    
  <script src="{{ 'pop-up.js' | asset_url }}" defer="defer"></script>
  
  {% style %}
    
    .popup-section h5{
       border-bottom: 1px solid #eee;
       font-weight: bold;
       color: #111;
    }
    .popup-section .select-img{
      padding-top: 2em;
    }
    .popup-section .select-img ul{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-gap: 20px 20px;
      
    }
    .popup-section .select-img ul li img{
      position: relative;
      max-width: 100%;
    }
    @media (max-width:850px){
      .popup-section .modal__window{
        background:#fff;
      }
      .popup-section .select-img ul{
        grid-template-columns: repeat(2, 1fr);
      }
      
    }
  {% endstyle %}

  <div class="popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center" data-mode data-show-on-mobile="true" id="popup-btn">
    <div class="modal__window flex relative bg-theme-bg text-theme-text text-start has-motion flex flex-col" role="dialog" aria-modal="true" tabindex="-1">
      <button type="button" class="modal__close-btn absolute text-current js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <div class="flex-auto modal__content modal__content--p-large relative text-center">
        {% for b in section.blocks %}
          
          {% case b.type %}
            {% when 'media' %}
            {% liquid
              assign pop_custom_liquid = b.settings.custom_liquid
              assign pop_custom_text = b.settings.custom_text
              assign iframe_url = b.settings.iframe_url
            %}
            {% if pop_custom_liquid != blank %}
              <div class="support-info__block">
                {{ pop_custom_liquid }}
              </div>
            {% elsif pop_custom_text != blank %}
              <div class="support-info__block">
                {{ pop_custom_text }}
              </div>
            {% elsif iframe_url != blank %}
              <div class="support-info__block">
                {{ iframe_url }}
              </div>
            {% else %}
              <div class="support-info__block">
                {{ pop_custom_liquid }}
              </div>
            {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
</div>
{% endif %}

<script src="{{ 'button-modal.js' | asset_url }}"></script>
 <script>
    var scrollPosition = '';
    $( document ).ready(function() {
      $('.popup-section').removeAttr('open');

      $('.popup-btn').on('click',function(e){
        // $('.popup-section').attr('open',true);
        // e.stopPropagation();
         const popupId = $(this).data('popup'); 
    $('#' + popupId).attr('open', true); 
        scrollPosition = $(window).scrollTop();
      });

    
      
      $('.js-close-modal').on('click',function(){
        $(window).scrollTop(scrollPosition);
        $('.popup-section').removeAttr('open');
        $('.modal').removeAttr('open');
      });
    });
    
  setTimeout(() => {
    while (!$) {}}, 100);
    
</script>

