{% schema %}
  {
    "name": "Multi Column Media - fei",
    "tag": "section",
    "class": "multi-column-media",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Top",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Button",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "click_li_link",
        "label": "Click on the picture to link",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "full_screen",
        "label": "Full screen",
        "default": false
      },
      {
        "type":"checkbox",
        "id":"is_two_cols",
        "label":"2列",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "mobile_carousel",
        "label": "Show as a carousel on mobile",
        "default": false
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Media grid"
      },
      {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size",
        "options": [
          {
            "value": "h6",
            "label": "Extra extra small"
          },
          {
            "value": "h5",
            "label": "Extra small"
          },
          {
            "value": "h4",
            "label": "Small"
          },
          {
            "value": "h3",
            "label": "Medium"
          },
          {
            "value": "h2",
            "label": "Large"
          },
          {
            "value": "h1",
            "label": "Extra large"
          },
          {
            "value": "h0",
            "label": "Extra extra large"
          }
        ],
        "default": "h2"
      },
      {
        "type": "select",
        "id": "heading_align",
        "label": "Heading alignment",
        "options": [
          {
            "value": "text-start",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-end",
            "label": "Right"
          }
        ],
        "default": "text-start"
      },
      {
        "type":"header",
        "content":"Heading style"
      },
      {
        "type":"checkbox",
        "id":"header_weight",
        "label":"Font Weight"
      },
      {
        "type":"checkbox",
        "id":"header_uppercase",
        "label":"Font Uppercase",
        "default":false
      },
      {
        "id":"column_font_glow",
        "type": "checkbox",
        "label": "Show text glow",
        "default":false
      },
      {
        "type":"color",
        "id":"title_one_color",
        "label":"Color one"
      },
      {
        "type":"text",
        "id":"title_one_color_size",
        "label":"Color size"
      },
      {
        "type":"color",
        "id":"title_two_color",
        "label":"Color two"
      },
      {
        "type":"text",
        "id":"title_two_color_size",
        "label":"Color size"
      },
      {
        "type":"color",
        "id":"title_three_color",
        "label":"Color three"
      },
      {
        "type":"text",
        "id":"title_three_color_size",
        "label":"Color size"
      },
      {
        "type":"color",
        "id":"title_four_color",
        "label":"Color four"
      },
      {
        "type":"text",
        "id":"title_four_color_size",
        "label":"Color size"
      },
      {
        "type":"text",
        "id":"title_color_angle",
        "label":"Color angle",
        "default":"45"
      },
      {
        "type": "select",
        "id": "gallery_cols_min",
        "label": "Minimum columns on mobile",
        "info": "Only applies when a carousel is not used on mobile.",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          }
        ],
        "default": "1"
      },
      {
        "type": "range",
        "id": "height_desktop",
        "min": 50,
        "max": 800,
        "step": 10,
        "unit": "px",
        "label": "height on large screens",
        "default": 440
      },
      {
        "type": "range",
        "id": "height_mobile",
        "min": 50,
        "max": 500,
