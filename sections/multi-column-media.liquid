        "content": "Pop up"
      },
      {
        "type": "checkbox",
        "id": "show_pop",
        "label": "Use pop up",
        "default": false
      },
      
    ],
    "blocks": [
      {
        "type": "media",
        "name": "Media",
        "limit": 16,
        "settings": [
          {
            "type": "image_picker",
            "id": "media_image",
            "label": "Image"
          },
         {
            "type": "header",
            "content": "Text Content"
          },
          {
            "type": "text",
            "id": "media_title",
            "label": "Media title"
          },
          {
            "type": "select",
            "id": "media_title_size",
            "label": "Heading size",
            "options": [
            {
              "value": "h6",
              "label": "Extra extra small"
            },
            {
              "value": "h5",
              "label": "Extra small"
            },
            {
              "value": "h4",
              "label": "Small"
            },
            {
              "value": "h3",
              "label": "Medium"
            },
            {
              "value": "h2",
              "label": "Large"
            },
        ],
        "default": "h3"
        },
        {
          "type": "checkbox",
          "id": "media_title_weight",
          "label": "Font Weight",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "media_title_uppercase",
          "label": "Font Uppercase",
          "default": false
        },
        {
          "type": "richtext",
          "id": "media_des",
          "label": "media_description"
        },
        {
          "type": "header",
          "content": "Text overlay - Style"
        },
        {
          "type": "select",
          "id": "overlay_position",
          "label": "Text position",
          "options": [
            {
              "value": "justify-start items-start",
              "label": "Top left"
            },
            {
              "value": "justify-center items-start",
              "label": "Top center"
            },
            {
              "value": "justify-end items-start",
              "label": "Top right"
            },
            {
              "value": "justify-start items-center",
              "label": "Middle left"
            },
            {
              "value": "justify-center items-center",
              "label": "Middle center"
            },
            {
              "value": "justify-end items-center",
              "label": "Middle right"
            },
            {
