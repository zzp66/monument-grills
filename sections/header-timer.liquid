{% if settings.show_header_timer_bar != blank %}
   <script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
   
    <div class="header-timer-bar" style="background:{{ section.settings.timer_bg_color }};color:{{ section.settings.timer_text_color }};">
       <div class="{% if section.settings.full_screen != blank %} header-timer-box {% else %}container header-timer-box{% endif %}">
         <div class="timber-title">{{ section.settings.timer_title }}</div>
         <div class="section__block--countdown text-overlay__block" {{ section.shopify_attributes }}>
           {% render 'header-titmer',
              end_date: section.settings.end_date,
              end_time: section.settings.end_time,
              start_date: section.settings.start_date,
              start_time: section.settings.start_time,
              end_text: section.settings.end_text,
              end_midnight: true,
              hide_on_end: false
            %}
         </div>
        </div>
     </div>
    {% style %}
      @media (min-width:769px){
        .header{
          padding-top:18px;
        }
        .announcement{
           top:40px;
        }
        .cc-header--sticky{
          top: 76px;
        }
        #main-content{
          position: relative;
        }
      }
      
      .header-timer-bar{
        position: fixed;
        width: 100%;
        top: 0px;
        height: 40px;
        z-index: 99;
      }
       .header-timer-bar .section__block--countdown {
          position: relative;
          margin-top:0;
          --countdown-size: {{ section.settings.countdown_size }};

          {%- assign countdown_size_int = section.settings.countdown_size | plus: 0 -%}
          {% if countdown_size_int %}
            --countdown-gap: 0.7em;
          {% endif %}
      }
      .header-timer-bar .timber-title{
        margin-right:15px;
      }
      .header-timer-bar .section__block--countdown .countdown__number{
        display:block;
        font-size: 16px;
        padding: 0;
        color: {{ section.settings.timer_text_color }};
        background: transparent;
        margin-bottom: 0;
      }
      .header-timer-bar .section__block--countdown .countdown__unit{
        font-size: 10px;
      }
      .header-timer-bar .section__block--countdown .countdown__item:not(:last-child) .countdown__number:after{
        color: {{ section.settings.timer_text_color }};
        padding-top:0;
      }
      .header-timer-bar .header-timer-box{
        height:100%;
        display:flex;
        justify-content: center;
        align-items: center;
      }
      @media (max-width:768px){
        .header header{
          padding-top:0px;
        }
         .header-timer-bar .timber-title{
           font-size:12px;
         }
        .header-timer-bar{
          height:auto;
        }
        .cc-header--sticky{
          top:84px;
        }
        .announcement{
          top:35px;
          z-index:30;
        }
      }
    {% endstyle %}
{% endif %}

{% schema %}
  {
    "name": "header-timer - fei",
    "class": "header-timer",
    "settings": [
      {
        "type": "header",
        "content": "跳转ID设置"
      },
      {
        "type": "text",
        "id": "link_id",
        "label": "Link ID"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "checkbox",
        "id": "full_screen",
        "label": "Full screen",
        "default": false
      },
      {
        "type": "header",
        "content": "Timer"
      },
      {
        "type": "select",
        "id": "countdown_size",
        "label": "Count size",
        "options": [
          {
            "value": "16",
            "label": "Best small"
          },
          {
            "value": "18",
            "label": "Extra extra small"
          },
          {
            "value": "21",
            "label": "Extra small"
          },
          {
            "value": "24",
            "label": "Small"
          },
          {
            "value": "27",
            "label": "Medium"
          },
          {
            "value": "30",
            "label": "Large"
          },
          {
            "value": "33",
            "label": "Extra large"
          },
          {
            "value": "36",
            "label": "Extra extra large"
          }
        ],
        "default": "18"
      },
      {
        "type": "color",
        "id": "timer_bg_color",
        "label": "Timer bg"
      },
      {
        "type": "color",
        "id": "timer_text_color",
        "label": "Text color"
      },
      {
        "type": "text",
        "id": "timer_title",
        "label": "Timer title"
      },
      {
        "type": "text",
        "id": "start_date",
        "label": "Start date",
        "info": "Format: YYYY-MM-DD. If you don't enter a date, midnight tonight will be used."
      },
      {
        "type": "text",
        "id": "start_time",
        "label": "Start time (optional)",
        "info": "Format: 09:00 (24 hour clock). Uses the store's timezone."
      },
      {
        "type": "text",
        "id": "end_date",
        "label": "End date",
        "info": "Format: YYYY-MM-DD. If you don't enter a date, midnight tonight will be used."
      },
      {
        "type": "text",
        "id": "end_time",
        "label": "End time (optional)",
        "info": "Format: 17:00 (24 hour clock). Uses the store's timezone."
      },
      {
        "type": "richtext",
        "id": "end_text",
        "label": "End text",
        "info": "This shows when the date and time elapses."
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "header-timer - fei"
      }
    ]
  }
{% endschema %}