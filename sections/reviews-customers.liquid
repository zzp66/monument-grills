<style>
  .reviews-customers {
    background-color: #f1f1f1;
    background-image: url({{ section.settings.reviews_customers_bg_img | image_url: width: master }});
    background-repeat: no-repeat;
    background-position: top 180px center;
    padding: 60px 0 95px;
  }
  .reviews-customers-wrapper {
    margin: 0 20px;
  }
  .reviews-customers .review-slider-heading {
    margin: 0 auto;
    text-align: center;
  }
  .reviews-slider-box {
    max-width: 980px;
    width: 100%;
    margin: 0 auto;
  }
  .reviews-swiper {
    margin: 40px 0 20px;
  }
  .slider-top-item {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 380px);
    border-radius: 16px;
    overflow: hidden;
  }
  .slider-review-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 380px;
    height: 100%;
    padding: 30px 40px;
    background-color: #fff;
  }
  .review-star img {
    max-height: 25px;
    width: auto;
  }
  .review-info {
    margin-top: 10px;
    font-size: 24px;
    line-height: 28px;
    font-weight: 600;
  }
  .review-author {
    margin-top: 15px;
    position: relative;
    color: #fbb040;
    font-size: 15px;
  }
  .review-author::after {
    content: '';
    position: absolute;
    background-image: url(https://www.litter-robot.com/media/wysiwyg/Litter-Robot/cms/reviews/quotes.svg);
    left: 40px;
    top: -10px;
    display: block;
    background-repeat: no-repeat;
    width: 145px;
    height: 100px;
    opacity: 0.05;
  }
  .slider-bottom-item {
    position: relative;
    padding: 6px;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
  }
  .slider-bottom-item img {
    border-radius: 16px;
  }

  .swiper-slide.swiper-slide-thumb-active .slider-bottom-item {
    border: 2px solid #e55420;
  }

  @media screen and (max-width: 768px) {
    .reviews-customers {
      padding: 30px 0 40px;
    }
    .slider-top-item {
      grid-template-columns: 1fr;
    }
    .slider-review-box {
      padding: 15px;
      max-width: 100%;
    }
    .review-star img {
      max-width: 20px;
    }
    .review-info {
      font-size: 16px;
      line-height: 20px;
    }
    .review-author::after{
      background-image: none;
    }
  }
</style>

<div class="reviews-customers">
  <div class="reviews-customers-wrapper">
    <h2 class="review-slider-heading">
      {{ section.settings.reviews_customers_title }}
    </h2>
    <div class="reviews-slider-box">
      <div class="swiper reviews-swiper">
        <div class="swiper-wrapper">
          {% for item in section.blocks %}
            <div class="swiper-slide">
              <div class="slider-top-item">
                <div class="slider-img-box">
                  <img
                    src="{{ item.settings.customer_img | image_url: width: master }}"
                    alt=""
                  >
                </div>
                <div class="slider-review-box">
                  <div class="review-star">
                    <img src="{{ item.settings.customer_star | image_url: width: master }}" alt="">
                  </div>
                  <div class="review-info">{{ item.settings.customer_info }}</div>
                  <div class="review-author">{{ item.settings.customer_author }}</div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="swiper reviews-thumbs-swiper">
        <div class="swiper-wrapper">
          {% for item in section.blocks %}
            <div class="swiper-slide">
              <div class="slider-bottom-item">
                <img
                  src="{{ item.settings.customer_img | image_url: width: master }}"
                  alt=""
                >
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.reviews-thumbs-swiper', {});
    new Swiper('.reviews-swiper', {
      allowTouchMove: false,
      thumbs: {
        swiper: {
          el: '.reviews-thumbs-swiper',
          slidesPerView: 5,
          spaceBetween: 45,
          breakpoints: {
            320: {
              slidesPerView: 3.2,
              spaceBetween: 10,
            },
            768: {
              slidesPerView: 5.2,
              spaceBetween: 20,
            },
            1280: {
              slidesPerView: 5.2,
              spaceBetween: 45,
            },
          },
        },
      },
    });
  });
</script>

{% schema %}
{
  "name": "Reviews Customers",
  "settings": [
    {
      "type": "image_picker",
      "id": "reviews_customers_bg_img",
      "label": "背景图",
      "info": "用于该部分的背景图，尺寸1100*578起"
    },
    {
      "type": "text",
      "id": "reviews_customers_title",
      "label": "Header"
    }
  ],
  "blocks": [
    {
      "type": "customer",
      "name": "Customer",
      "settings": [
        {
          "type": "image_picker",
          "id": "customer_img",
          "label": "Customer Img"
        },
        {
          "type": "image_picker",
          "id": "customer_star",
          "label": "Customer Star"
        },
        {
          "type": "textarea",
          "id": "customer_info",
          "label": "Customer Info"
        },
        {
          "type": "text",
          "id": "customer_author",
          "label": "Customer Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Customers"
    }
  ]
}
{% endschema %}
