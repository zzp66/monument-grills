{%- if section.blocks.size > 0 -%}
    <link rel="stylesheet" href="{{ 'icons-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- else -%}
    
  {%- endif -%}
{{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
{{ 'popup.css' | asset_url | stylesheet_tag }}
{{ 'modal.css' | asset_url | stylesheet_tag }}    

{% if section.settings.use_popup != blank %}
  <script src="{{ 'pop-up.js' | asset_url }}" defer="defer"></script>
{% endif %}

  {%- liquid
    assign color_scheme = section.settings.color_scheme
    assign grid_classes = 'auto-cols-1'
    if section.blocks.size == 2
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 icons-with-text--narrow'
    elsif section.blocks.size == 3
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 md:auto-cols-3'
    elsif section.blocks.size > 3
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4'
    endif
  -%}

  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}
{% style %}
  .text-overlay__block{
    margin-top:2em;
  }
  @media (max-width:850px){
    .icons-with-text{
      padding:15px 0;
    }
  }
  .card-warp .card-item {
    background: #f9f9f9;
    padding:4px;
    border-radius: 6px;
    border:1px solid #ddd;
  }

  .card-warp .card-item .card-img{
    width: 100%;
    height: auto;
    display: block;
  }
  .card-warp .card-item .card-img img{
    position: relative;
    max-width:100%;
  }
  .card-warp .card-item .card-btn-bottom{
    padding-bottom: 1em;
    width: 100%;
    display: flex;
    justify-content: space-around;
  }
  .card-warp .card-item .card-btn-bottom a,
  .card-warp .card-item .card-btn-bottom .rules-btn{
    font-size:14px;
    background: transparent;
    cursor: pointer;
  }
  .card-warp .card-item .card-btn-bottom a{
    text-decoration: unset;
  }
  .card-warp .card-item .card-btn-bottom .rules-btn{
    color:#8c8c8c;
  }
  .card-warp .card-item .card-btn-bottom a.redeem{
    font-weight: bold;
  }
  .card-warp .card-item .card-product p{
    margin-bottom:4px;
    font-size:14px;
    color:#aaa;
  }
  .card-warp .card-item .hide-rules{
    display:none;
  }
  .card-warp .no-points{
    opacity: .4;
    cursor: default;
  }
  .card-warp .no-points .card-img img{
    -webkit-filter: grayscale(100%);
    -moz-filter: grayscale(100%);
    -ms-filter: grayscale(100%);
    -o-filter: grayscale(100%);
    filter: grayscale(100%);
    filter: gray;
    opacity: .4;
  }
  .card-warp .no-points .icons-with-text__text p,
  .card-warp .no-points .card-btn-bottom a.redeem
  {
    color: #c0c0c0 !important;
    text-decoration: none;
    pointer-events: none;
    user-select: none;
    cursor: default;
  }
  
{% endstyle %}
  <div class="icons-with-text section{% if section.settings.full_width %} section--full-width{% if section.settings.dividers != "none" %} {{ section.settings.dividers }}{% endif %}{% endif %} section--padded-{{ section.settings.section_height }}" id="{{ section.id }}" style="background: {{ section.settings.bg }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    <div class="hide" id="{% if section.settings.link_id != blank %}{{ section.settings.link_id }}{% endif %}"></div>
    <div class="container relative">
      {%- if section.settings.heading != blank -%}
        <h2 class="h4 section__heading mb-4 {{ section.settings.heading_align }} {% if section.settings.font_weight != blank %} font-blod{% endif %}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %}>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {% if section.settings.card_title != blank %}
        <h6 data-title="{{ section.settings.card_title }}" class="sub-title {{ section.settings.card_title_align }} {% if section.settings.font_weight != blank %} font-blod{% endif %}">{{ section.settings.card_title }}</h6>
      {% endif %}
      <carousel-slider class="{% if section.settings.show_card != blank %}card-warp {% endif %} carousel block relative" inactive{% if section.settings.mobile_stack %} disable-mobile="true"{% endif %}>
          <div class="slider-nav slide-nav--inline flex justify-between absolute top-0 h-full no-js-hidden">
            <button type="button" class="slider-nav__btn tap-target tap-target--left btn text-current has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
              {% render 'icon-chevron-left' %}
            </button>
            <button type="button" class="slider-nav__btn tap-target tap-target--right btn text-current has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
              {% render 'icon-chevron-right' %}
            </button>
        </div>
        <div class="slider slider--contained relative slider--no-scrollbar" id="slider-{{ section.id }}">
          <ul class="slider__grid grid grid-flow-col gap-theme {{ grid_classes }} {% if section.settings.show_all_on_mobile %} show-all-mobile{% endif %} {% if section.settings.show_online_display %} mobile-online{% endif %}">
            {% style %}
              {%- if color_scheme == "white" -%}
                #{{ section.id }} {
                  --color-scheme-white-text: {{ section.settings.transparent_content_color.red }} {{ section.settings.transparent_content_color.green }} {{ section.settings.transparent_content_color.blue }};
                  --color-scheme-white-hover: {{ transparent_hover_color.red }} {{ transparent_hover_color.green }} {{ transparent_hover_color.blue }};
                  --color-scheme-white-text-contrast: {{ transparent_text_contrast }};
                }
              {%- endif -%}
             
            {% endstyle %}
            {%- for block in section.blocks -%}
              
              {%- liquid
                assign is_link = true
                if block.settings.text contains "<a" or block.settings.link == blank
                  assign is_link = false
                endif

                assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'

                assign img = block.settings.custom_coupon
                if img != blank
                  assign desktop_image_class = 'img-fit sm:block'
                else
                  assign desktop_image_class = 'img-fit'
                endif

                if section.index == 1 or section.settings.prevent_animation
                  assign lazy_load_images = false
                else
                  assign lazy_load_images = true
                endif
              -%}
              <li class="card-item {% if block.settings.is_no_points != blank %} no-points{% endif %} slider__item{% unless is_link %} flex{% if section.settings.icon_position == 'above' %} flex-col{% endif %} justify-center items-center{% endunless %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                {% if block.settings.custom_coupon != blank %}
                  <div class="card-img">
                    {%- render 'image',
                      image: img,
                      widths: '480, 980, 1200',
                      src_width: 480,
                      src_placeholder: true,
                      sizes: sizes,
                      lazy_load: lazy_load_images,
                      class: desktop_image_class
                    -%}
                  </div>
                {% endif %}

                
                
                {% unless block.settings.heading == blank and block.settings.text == blank %}
                  <div class="icons-with-text__text rte{% if section.settings.icon_position == 'above' %} mt-2 text-center icons-with-text__text--icons-above{% endif %}">
                    {%- if block.settings.heading != blank -%}
                      <p class="m-0 icons-with-text__title text-body-{{ section.settings.title_type_scale }} {% if block.settings.title_color != blank %} title-color{% endif %}"><strong class="">{{ block.settings.heading | escape }}</strong> {% if block.settings.danwei %}<small>(sqin)</small>{% endif %}</p>
                    {%- endif -%}
                  </div>
                {% endunless %}

                {% if block.settings.pro_name %}
                  <div class="card-product icons-with-text__text rte mt-2 text-center">
                    <p class="pro-price">{{ block.settings.pro_name }}</p>
                  </div>
                {% endif %}

                {% if block.settings.is_product != blank %}
                  <div class="card-product icons-with-text__text rte mt-2 text-center">
                    <p class="pro-price">{{ block.settings.pro_price }}</p>
                  </div>
                {% endif %}
               
                {% if block.settings.button_label != blank %}
                  <div class="card-btn-bottom text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4 mb-2 justify-center md-down:center">
                    <a class="{{ block.settings.button_label | downcase | handleize }} {{ block.settings.button_style }}" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %} style="color:{{ block.settings.button_1_color }};">
                        {{- block.settings.button_label | escape -}}
                    </a>
                    <span class="rules-btn {{ block.settings.button_style2 | downcase | handleize }}" style="color:{{ block.settings.button_2_color }};">
                        {{- block.settings.button_label2 | escape -}}
                    </span>
                  </div>
                {% endif %}

                {% if block.settings.card_rules != blank %}
                  <div class="hide-rules">{{ block.settings.card_rules }}</div>
                {% endif %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </carousel-slider>
    </div>
  </div>
  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}



<div class="cc-popup popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center {{ section.settings.text_align }}" data-mode data-show-on-mobile="true">
    <div class="modal__window flex relative bg-theme-bg text-theme-text text-start has-motion flex flex-col" role="dialog" aria-modal="true" tabindex="-1">
      <button type="button" class="modal__close-btn absolute text-current js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <div class="flex-auto modal__content modal__content--p-large relative text-center">
        <div class="select-img">
          {%- capture sizes -%}
            {%- render 'sizes-attribute', min: 'page', sm: 'page', md: '800px', lg: '1200px', xl: false, max: false -%}
          {%- endcapture -%}
          <img class="cc-img img-fit" sizes data-srcset="" data-src="" src="" alt="" loading="lazy"  />
        </div>
        <h6 class="pop-name relative text-center pb-6"></h6>
        <div class="rules-box">
          <h6>Rules:</h6>
          <div class="rule-details"></div>
        </div>
      </div>
    </div>
</div>

{% style %}
  .cc-popup .modal__window .select-img img,
  .cc-popup .modal__window{
    position: relative;
  }
  .cc-popup .modal__window .select-img img{
    max-width: 60%;
    transform: translateX(-50%);
  }
  .cc-popup .modal__window .pop-name{
    border-bottom:1px solid #eee;
    font-weight: bold;
    text-align: left;
  }
  .cc-popup .modal__window .rules-box{
    text-align: left;
  }
  
{% endstyle %}

<script>


setTimeout(() => {
  while (!$) {}
  var scrollPosition = '';
  $( document ).ready(function() {
    $('.cc-popup').removeAttr('open');
    $('.card-warp .card-item').on('click','.rules-btn',function(e){
      $('.cc-popup').attr('open',true);
    // alert('aaa')
      e.stopPropagation();
      scrollPosition = $(window).scrollTop();
      var index = $(this).index();
      var parentDOM = $(this).parent('.card-btn-bottom');
      
      
      var url = parentDOM.siblings('.card-img').find('img').attr('data-srcset');
      var name = parentDOM.siblings('.icons-with-text__text').find('strong').text();
      var rule = parentDOM.siblings('.hide-rules').html();
      

      
      $('.cc-popup .cc-img').attr('src',url);
      $('.cc-popup .cc-img').attr('data-srcset',url);
      $('.cc-popup .cc-img').attr('data-src',url);
      $('.cc-popup .pop-name').text(name);
      $('.cc-popup .rule-details').html(rule);
      $('.cc-popup .rule-details ul').css({
        'list-style':'disc'
      });
    });

    $('.cc-popup .js-close-modal').on('click',function(){
      $(window).scrollTop(scrollPosition);
      $('.cc-popup').removeAttr('open');
    });
  });
}, 100);


</script>

