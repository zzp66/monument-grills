{% schema %}
  {
    "name": "use article - fei",
    "class": "use-article",
    "settings": [
       {
          "type": "header",
          "content": "跳转ID设置"
        },
        {
          "type": "text",
          "id": "link_id",
          "label": "Link ID"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "checkbox",
          "id": "full_screen",
          "label": "Full screen",
          "default": false
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 200,
          "step": 10,
          "unit": "px",
          "label": "Padding Top",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 200,
          "step": 10,
          "unit": "px",
          "label": "Padding Button",
          "default": 0
        },
        {
          "type": "header",
          "content": "Article settings"
        },
        {
          "type": "checkbox",
          "id": "show_tags",
          "label": "Show tags",
          "default": false
        },
        {
          "type": "header",
          "content": "Layout images"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image",
          "info": "For best results, use a landscape shaped image with a width of 3200px."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (optional)",
          "info": "For best results, use a square or portrait shaped image. If no mobile image is provided, the large screen image will be used."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Image link (optional)"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "height_mode",
          "label": "Image height",
          "info": "Restricted to 1080px maximum.",
          "options": [
            {
              "value": "auto",
              "label": "Original image height"
            },
            {
              "value": "fixed",
              "label": "Fixed height (set below)"
            },
            {
              "value": "screen",
              "label": "Full screen height"
            }
          ],
          "default": "auto"
        },
        {
          "type": "range",
          "id": "fixed_height_desktop",
          "min": 200,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "label": "Minimum fixed height on large screens",
          "default": 400
        },
        {
          "type": "range",
          "id": "fixed_height_mobile",
          "min": 250,
          "max": 500,
          "step": 10,
          "unit": "px",
          "label": "Minimum fixed height on mobile",
          "default": 350
        },
        {
          "type": "select",
          "id": "overlay_text_align",
          "label": "Text alignment",
          "options": [
            {
              "value": "text-start",
              "label": "Left"
            },
            {
              "value": "text-center",
              "label": "Center"
            },
            {
              "value": "text-end",
              "label": "Right"
            }
          ],
          "default": "text-center"
        },
        {
          "type": "checkbox",
          "id": "mob_center_text",
          "label": "Center text on mobile",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "mobile_stacked",
          "label": "Show text below image on mobile",
          "info": "Does not apply to \"Full screen height\".",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "text_bg",
          "label": "Add Font Background",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "mobile_position",
          "label": "Mobile Position",
          "info":"选中，才可以触发 mobile 位置",
          "default": false
        },
        {
          "type": "select",
          "id": "mobile_overlay_position",
          "label": "Mobile Text position",
          "options": [
            {
              "value": "mobile-top-center",
              "label": "Mobile Top center"
            },
            {
              "value": "mobile-middle-center",
              "label": "Mobile Middle center"
            },
            {
              "value": "mobile-bottom-center",
              "label": "Mobile Bottom center"
            }
          ],
          "default": "mobile-top-center"
        },
       {
          "type": "color",
          "id": "transparent_content_color",
          "label": "Text and button color",
          "info": "Only applies when the \"Transparent background\" color scheme is chosen and the text shows over an image.",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "tint_color",
          "label": "Image tint color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "tint_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Image tint opacity",
          "default": 40
        },
        {
          "type": "header",
          "content": "SEO"
        },
        {
          "type": "checkbox",
          "id": "prevent_animation",
          "label": "Load the section without animation",
          "info": "If this section is visible when the page loads, enabling this setting can reduce CLS and may improve site speed scores. [Read more](https://cleancanvas.co.uk/support/enterprise/performance-guide)",
          "default": false
        }
    ],
    "blocks": [
      
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default":"Banner Title",
            "info": "Enter <br> for a line-break."
          },
          {
            "type":"text",
            "id":"header_class",
            "label":"Add Class",
            "info":"h2, h3, h4, h5"
          },
          {
            "type":"checkbox",
            "id":"header_weight",
            "label":"Font Weight"
          },
          {
            "type":"checkbox",
            "id":"header_uppercase",
            "label":"Font Uppercase",
            "default":false
          }
        ]
      },
      {
        "type": "text",
        "name": "Text",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
          },
          {
            "type": "checkbox",
            "id": "enlarge_text",
            "label": "Enlarge text",
            "default": true
          }
        ]
      },
      {
        "type":"article-img",
        "name":"Article image",
        "limit":1,
        "settings":[
          {
            "type": "image_picker",
            "id": "pc_article_picture",
            "label": "Aricle image"
          },
          {
            "type": "image_picker",
            "id": "mobile_article_picture",
            "label": "Aricle image on mobile"
          }
        ]
      },
      {
        "type":"tool",
        "name":"Tool",
        "limit":1,
        "settings":[
          {
            "type":"checkbox",
            "id":"show_tool",
            "label":"Show tools"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "use article - fei"
      }
    ]
  }
{% endschema %}