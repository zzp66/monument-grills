{% liquid
  assign reviews_banner_img_pc = section.settings.reviews_banner_img_pc
  if section.settings.reviews_banner_img_mb != blank
    assign reviews_banner_img_mb = section.settings.reviews_banner_img_mb
  else
    assign reviews_banner_img_mb = section.settings.reviews_banner_img_pc
  endif
%}
<style>
  .hero-banner {
    position: relative;
    color: #fff;
    overflow: hidden;
    min-height: 500px;
    padding: 114px 30px 150px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-banner .hero-background {
    background-repeat: no-repeat;
    background-size: cover;
    bottom: 0;
    height: 100%;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
  }

  .hero-background.mobile {
    background-image: url({{ reviews_banner_img_mb | image_url: width: master }});
    background-color: transparent;
    background-position: center center;
  }
  .hero-background.desktop {
    background-image: url({{ reviews_banner_img_pc | image_url: width: master }});
    background-color: transparent;
    background-position: center center;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-container .page-title {
    color: #fff;
  }

  .page-title-btn-box a.page-title-btn {
    background: #fbb040;
    border: 1px solid #fbb040;
    border-radius: 40px;
    color: #fff;
    cursor: pointer;
    display: inline-block;
    font-weight: 700;
    padding: 15px 30px;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.2;
    box-sizing: border-box;
    vertical-align: middle;
    transition: border-color 0.18s linear, color 0.18s linear, background 0.18s linear;
    text-align: center;
  }

  .hero-container @media (max-width: 767px) {
    .hero-banner > .hero-container > * {
      max-width: 70%;
    }
  }
  @media (min-width: 768px) {
    .hero-banner > .hero-container > * {
      max-width: 475px;
    }
    .hero-banner > .hero-container > p {
      max-width: 350px;
    }
  }
</style>
<div class="reviews-banner">
  <div class="hero-banner">
    <div class="hero-background mobile"></div>
    <div class="hero-background desktop"></div>
    <div class="hero-container">
      <h1 id="page-title-heading" class="page-title">
        {{ section.settings.reviews_banner_title }}
      </h1>
      <p class="page-title-info">{{ section.settings.reviews_banner_info }}</p>
      <div class="page-title-btn-box">
        <a
          class="page-title-btn"
          href="#{{ section.settings.reviews_btn }}"
          onclick="smoothScroll(event, '#{{ section.settings.reviews_btn }}')"
          >Read reviews</a
        >
      </div>
    </div>
  </div>
</div>

<script>
  function smoothScroll(event, targetId) {
    event.preventDefault(); // 阻止默认的跳转行为
    const target = document.querySelector(targetId);
    if (target) {
      // 获取目标元素的顶部位置，减去导航栏的高度（200px）
      const offset = 200;
      const targetPosition = target.offsetTop - offset;

      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth',
      });
    }
  }
</script>

{% schema %}
{
  "name": "Reviews Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "reviews_banner_img_pc",
      "label": "Banner - PC"
    },
    {
      "type": "image_picker",
      "id": "reviews_banner_img_mb",
      "label": "Banner - Mobile"
    },
    {
      "type": "text",
      "id": "reviews_banner_title",
      "label": "Header"
    },
    {
      "type": "textarea",
      "id": "reviews_banner_info",
      "label": "Info"
    },
    {
      "type": "text",
      "id": "reviews_btn",
      "label": "需要跳转到的位置的版块id",
      "default": "yotpo-app"
    }
  ],
  "presets": [
    {
      "name": "Reviews Banner"
    }
  ]
}
{% endschema %}
