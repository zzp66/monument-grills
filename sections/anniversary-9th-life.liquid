<style>
  .anniversary-9th-lifeshared {
    padding: 60px 0;
    margin: 0;
  }
  /* 视频背景容器 */
  .video-container {
    position: relative;
  }

  /* 视频元素样式 */
  .video-bg {
    width: 100%;
    height: auto;
    z-index: 1;
    position: relative;
  }
  /* 20% 黑色遮罩层 */
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4); /* 20% 透明度黑色 */
    z-index: 2;
  }

  /* 内容区域 */
  .lifeshared-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    text-align: center;
    z-index: 3;
    width: 80%;
    max-width: 800px;
  }
  .lifeshared-content .lifeshared-title {
    font-size: 42px;
    font-weight: bold;
    margin-bottom: 0;
  }

  .lifeshared-content .lifeshared-info {
    font-size: 18px;
    line-height: 20px;
    margin-bottom: 30px;
  }
  .lifeshared-btn {
    display: inline-block;
    color: #fff;
    background-color: #e55420;
    border-radius: 3px;
    padding: 10px 15px;
  }

  @media screen and (max-width: 768px) {
    .anniversary-9th-lifeshared {
      padding: 0;
    }
    .lifeshared-content .lifeshared-title {
      font-size: 26px;
    }
    .lifeshared-content .lifeshared-info {
      font-size: 14px;
      line-height: 16px;
      margin-bottom: 15px;
    }
    .lifeshared-btn {
      font-size: 14px;
      padding: 6px 10px;
    }
  }
</style>

{% assign click_id = section.settings.click_id %}
{% assign popup_content = section.settings.cur_liquid %}
<div class="anniversary-9th-lifeshared">
  <div class="video-container">
    <!-- 视频背景 -->
    <video autoplay muted loop class="video-bg">
      <source src="https://cdn.shopify.com/videos/c/o/v/d4c16d31992c439d9c14bf93c08e4db7.mp4" type="video/mp4">
      <!-- 备用提示 -->
      您的浏览器不支持HTML5视频
    </video>

    <!-- 20% 遮罩层 -->
    <div class="overlay"></div>

    <!-- 文案内容 -->
    <div class="lifeshared-content">
      <p class="lifeshared-title">Grill Life Shared</p>
      <p class="lifeshared-info">Upload Your Favorite Monument Moment and Be Part of Our Memory Wall</p>

      <div class="popup-btn-box">
        <button class="lifeshared-btn btn btn--primary popup-btn" id="{{ click_id }}">Share My Moment</button>
      </div>
    </div>
  </div>
  {% render 'popup-button', popup_content: popup_content, click_id: click_id %}
</div>

{% schema %}
{
  "name": "9th Anniversary Life",
  "settings": [
    {
      "type": "text",
      "id": "click_id",
      "label": "Click ID"
    },
    {
      "type": "liquid",
      "id": "cur_liquid",
      "label": "Popup content",
      "info": "<iframe src='https://formbuilder.hulkapps.com/corepage/customform?id=JaRl8X9GB_MqfkcCDxEsew&amp;preview_mode=true' id='frame_JaRl8X9GB_MqfkcCDxEsew' frameborder='0' width='1260' height='600' frameborder='0' marginheight='0' marginwidth='0'></iframe>"
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Life"
    }
  ]
}
{% endschema %}
