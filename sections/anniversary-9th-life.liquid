<style>
  .anniversary-9th-lifeshared {
    padding: 60px 0;
    margin: 0;
  }
  /* 视频背景容器 */
  .video-container {
    position: relative;
  }

  /* 视频元素样式 */
  .video-bg {
    width: 100%;
    height: auto;
    z-index: 1;
    position: relative;
  }
  /* 20% 黑色遮罩层 */
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4); /* 20% 透明度黑色 */
    z-index: 2;
  }

  /* 内容区域 */
  .lifeshared-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    text-align: center;
    z-index: 3;
    max-width: 800px;
  }
  .lifeshared-content .lifeshared-title {
    margin-bottom: 0;
    color: #fff;
  }

  .lifeshared-content .lifeshared-info {
    font-size: 24px;
    line-height: 28px;
    margin-bottom: 30px;
  }
  .lifeshared-btn {
    display: inline-block;
    color: #fff;
    background-color: #e55420;
    border-radius: 3px;
    padding: 10px 15px;
  }
@media (max-width: 768px) {
  .lifeshared-info {
    display: none; /* 这种会让手机端看不到 */
  }
}
}
@media (max-width: 768px) {
 .lifeshared-content .lifeshared-title {
    max-width: 768px;    /* 手机端最大宽度768px */
    padding: 0 10px;     /* 可选，左右留边距 */
  }
}
  @media screen and (max-width: 768px) {
    .anniversary-9th-lifeshared {
      padding: 0;
    }
    .lifeshared-content .lifeshared-title {
      font-size: 26px;
          max-width: 1200px;  /* 手机端最大宽度100% */

    }
    .lifeshared-content .lifeshared-info {
      font-size: 14px;
      line-height: 16px;
      margin-bottom: 15px;
    }
    .lifeshared-btn {
      font-size: 14px;
      padding: 6px 10px;
    }
  }
</style>

{% assign click_id = section.settings.click_id %}
{% assign popup_content = section.settings.cur_liquid %}
<div class="anniversary-9th-lifeshared" id="{{ section.settings.lifeshared_id }}">
  <div class="video-container">
    <!-- 视频背景 -->
    <video autoplay muted loop class="video-bg">
      <source src="https://cdn.shopify.com/videos/c/o/v/d4c16d31992c439d9c14bf93c08e4db7.mp4" type="video/mp4">
      <!-- 备用提示 -->
      您的浏览器不支持HTML5视频
    </video>

    <!-- 20% 遮罩层 -->
    <div class="overlay"></div>

    <!-- 文案内容 -->
    <div class="lifeshared-content">
      <h2 class=" section__heading mb-0 flex-auto text-center lifeshared-title">#MonumentMoments</h2>
      <p class="lifeshared-info">Celebrate Everyday Grilling Moments — From Everyone, Everywhere</p>

      <div class="popup-btn-box">
        <button class="lifeshared-btn btn btn--primary" id="{{ click_id }}">Share My Moment</button>
      </div>
    </div>
  </div>

  {% comment %} 弹窗内容begin {% endcomment %}
  <div
    class="lifeshared-popup popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center"
    data-mode
    data-show-on-mobile="true"
  >
    <div
      class="modal__window flex relative bg-theme-bg text-theme-text text-start has-motion flex flex-col"
      role="dialog"
      aria-modal="true"
      tabindex="-1"
    >
      <button type="button" class="modal__close-btn absolute text-current js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <div class="flex-auto modal__content modal__content--p-large relative text-left">
        {% if popup_content != blank %}
          <div class="support-info__block">
            {{ popup_content }}
          </div>
          {% style %}
            .support-info__block {
              overflow: hidden;
              border-radius: 20px;
            }
          {% endstyle %}
        {% endif %}
      </div>
    </div>
  </div>
  {% comment %} 弹窗内容End {% endcomment %}
</div>

<script>
  var scrollPosition = '';
  $(document).ready(function () {
    $('.lifeshared-popup').removeAttr('open');

    $('#lifesharedBtn').on('click', function (e) {
      $('.lifeshared-popup').attr('open', true);
      e.stopPropagation();
      scrollPosition = $(window).scrollTop();
    });

    $('.lifeshared-popup .js-close-modal').on('click', function () {
      $(window).scrollTop(scrollPosition);
      $('.lifeshared-popup').removeAttr('open');
    });
  });

  setTimeout(() => {
    while (!$) {}
  }, 100);
</script>

{% schema %}
{
  "name": "9th Anniversary Life",
  "settings": [
    {
      "type": "text",
      "id": "lifeshared_id",
      "label": "用于二级导航栏的ID"
    },
    {
      "type": "text",
      "id": "click_id",
      "label": "Click ID"
    },
    {
      "type": "liquid",
      "id": "cur_liquid",
      "label": "Popup content",
      "info": "<iframe src='https://formbuilder.hulkapps.com/corepage/customform?id=JaRl8X9GB_MqfkcCDxEsew&amp;preview_mode=true' id='frame_JaRl8X9GB_MqfkcCDxEsew' frameborder='0' width='1260' height='600' frameborder='0' marginheight='0' marginwidth='0'></iframe>"
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Life"
    }
  ]
}
{% endschema %}
