<style>
  .anniversary-9th-ninja {
    padding: 60px 0;
  }
  p.blogs-title {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  p.blogs-info {
    text-align: center;
    color: #000;
    margin: 10px 0;
  }
  a.blogs-btn {
    display: flex;
    justify-content: flex-end;
    color: #928f8f;
  }
  .blogs-content {
    margin-top: 20px;
  }
  .blogs-item {
    position: relative;
  }
  .blogs-bg {
    position: absolute;
    width: 100%;
    height: 30%;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #000000, #00000000);
    z-index: 1;
  }
  .blogs-item-btn {
    position: relative;
    display: block;
  }
  .blogs-item-info {
    position: absolute;
    bottom: 10px;
    left: 15px;
    z-index: 2;
  }
  p.blogs-item-text {
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  p.blogs-item-info-btn {
    font-size: 16px;
    color: #fff;
    margin: 0;
  }
  .swiper-btn {
    margin-top: 15px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 25px;
  }

  .swiper-btn .swiper-button-prev,
  .swiper-btn .swiper-button-next {
    background-image: none;
    position: static;
    margin-top: 0;
    width: 40px;
    height: 40px;
    border-radius: 40px;
    border: 1px solid #e55420;
  }
  .swiper-btn .swiper-button-prev::after,
  .swiper-btn .swiper-button-next::after {
    color: #e55420;
  }
</style>
<div class="anniversary-9th-blogs section">
  <div class="container">
    <p class="blogs-title">Expert Grilling Tips</p>
    <p class="blogs-info">We Build The Grills And Know How To Use Them Best.</p>
    <a href="{{ section.settings.blogs_link }}" class="blogs-btn">All Blogs ></a>
    <div class="blogs-content">
      <div class="swiper blogs-swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="blogs-item">
                <a href="{{ block.settings.blog_link }}" class="blogs-item-btn">
                  <div class="blogs-img">
                    <img src="{{ block.settings.blog_image | image_url: width: master }}" alt="">
                  </div>
                  <div class="blogs-bg"></div>
                  <div class="blogs-item-info">
                    <p class="blogs-item-text">{{ block.settings.blog_title }}</p>
                    <p class="blogs-item-info-btn">Learn More</p>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- 如果需要导航按钮 -->
        <div class="swiper-btn">
          <div class="swiper-button-prev prev-btn"></div>
          <div class="swiper-button-next next-btn"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.blogs-swiper', {
      slidesPerView: 3.5,
      spaceBetween: 20,
      centeredSlides: true,
      centeredSlidesBounds: true,
      navigation: {
        nextEl: '.next-btn',
        prevEl: '.prev-btn',
      },
    });
  });
</script>

{% schema %}
{
  "name": "9th Anniversary Blogs",
  "settings": [
    {
      "type": "url",
      "id": "blogs_link",
      "label": "All Blogs"
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "blog",
      "settings": [
        {
          "type": "url",
          "id": "blog_link",
          "label": "博客链接"
        },
        {
          "type": "image_picker",
          "id": "blog_image",
          "label": "博客相关图"
        },
        {
          "type": "text",
          "id": "blog_title",
          "label": "博客标题",
          "default": "Quick links"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Blogs"
    }
  ]
}
{% endschema %}
