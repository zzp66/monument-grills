<style>
  .anniversary-9th-blogs {
    padding: 60px 0;
    margin: 0;
  }
  p.blogs-info {
    font-size: 24px;
    line-height: 28px;
    text-align: center;
    color: #000;
    margin: 10px 0;
  }
  a.blogs-btn {
    display: flex;
    justify-content: flex-end;
    color: #928f8f;
  }
  .blogs-content {
    margin-top: 20px;
  }
  .blogs-swiper-wrapper {
    align-items: stretch;
  }
  .blogs-swiper-wrapper .swiper-slide {
    height: 100%;
  }
  .blogs-item {
    position: relative;
  }
  .blogs-bg {
    position: absolute;
    width: 100%;
    height: 30%;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #000000, #00000000);
    z-index: 1;
  }
  .blogs-item-btn {
    position: relative;
    display: block;
  }
  .blogs-img img {
    min-height: 400px;
    object-fit: cover;
  }
  .blogs-item-info {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    padding: 5px 10px;
  }
  p.blogs-item-text {
    font-size: 18px;
    line-height: 20px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  p.blogs-item-info-btn {
    font-size: 16px;
    color: #fff;
    margin: 5px 0 0;
  }
  .swiper-btn {
    margin-top: 15px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 25px;
  }

  .swiper-btn .swiper-button-prev,
  .swiper-btn .swiper-button-next {
    background-image: none;
    position: static;
    margin-top: 0;
    width: 40px;
    height: 40px;
    border-radius: 40px;
    background-color: #e55420;
    border: 1px solid #e55420;
  }
  .swiper-btn .swiper-button-prev::after,
  .swiper-btn .swiper-button-next::after {
    color: #fff;
  }

  @media screen and (max-width: 768px) {
    .anniversary-9th-blogs {
      padding: 30px 0 50px;
    }
    h2.blogs-title {
      font-size: 26px;
    }
    p.blogs-info {
      font-size: 14px;
      line-height: 16px;
    }
    a.blogs-btn {
      justify-content: center;
    }
    .blogs-img img {
      min-height: auto;
      height: 300px;
    }
  }
</style>
<div class="anniversary-9th-blogs section" id="{{ section.settings.blogs_id }}">
  <div class="container">
    <h2 class="section__heading mb-0 flex-auto text-center blogs-title">{{ section.settings.blogs_title }}</h2>
    <p class="blogs-info">{{ section.settings.blogs_subtitle }}</p>
    <a href="{{ section.settings.blogs_link }}" class="blogs-btn">All Blogs ></a>
    <div class="blogs-content">
      <div class="swiper blogs-swiper">
        <div class="swiper-wrapper blogs-swiper-wrapper">
          {% for block in section.blocks %}
            {% assign article = block.settings.blog_url %}
            <div class="swiper-slide">
              <div class="blogs-item">
                <a href="{{ article.url }}" class="blogs-item-btn">
                  <div class="blogs-img">
                    <img src="{{ article.image | image_url: width: master }}" alt="">
                  </div>
                  <div class="blogs-bg"></div>
                  <div class="blogs-item-info">
                    <p class="blogs-item-text">{{ article.title }}</p>
                    <p class="blogs-item-info-btn">Learn More ></p>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- 如果需要导航按钮 -->
        <div class="swiper-btn">
          <div class="swiper-button-prev prev-btn"></div>
          <div class="swiper-button-next next-btn"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.blogs-swiper', {
      slidesPerView: 3.5,
      spaceBetween: 20,
      navigation: {
        nextEl: '.next-btn',
        prevEl: '.prev-btn',
      },
      breakpoints: {
        320: {
          slidesPerView: 1.2,
          spaceBetween: 10,
        },
        768: {
          slidesPerView: 1.2,
          spaceBetween: 15,
        },
        1280: {
          slidesPerView: 3,
          spaceBetween: 20,
        },
      },
    });
  });
</script>

{% schema %}
{
  "name": "9th Anniversary Blogs",
  "settings": [
    {
      "type": "text",
      "id": "blogs_id",
      "label": "用于二级导航栏的ID"
    },
    {
      "type": "text",
      "id": "blogs_title",
      "label": "Title",
      "default": "Expert Grilling Tips"
    },
    {
      "type": "textarea",
      "id": "blogs_subtitle",
      "label": "Info",
      "default": "Learn the Tricks, Master the Flame – Curated by the Gas Grill Experts"
    },
    {
      "type": "url",
      "id": "blogs_link",
      "label": "All Blogs"
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "blog",
      "settings": [
        {
          "type": "article",
          "id": "blog_url",
          "label": "博客选取"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Blogs"
    }
  ]
}
{% endschema %}
