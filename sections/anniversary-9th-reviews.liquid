<style>
  .anniversary-9th-reviews {
    padding: 60px 0;
    margin: 0;
  }
  p.reviews-title {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  p.reviews-info {
    text-align: center;
    color: #000;
    margin: 0;
    margin-top: 10px;
    margin-bottom: 40px;
  }
  .review-content {
    display: grid;
    grid-template-columns: 35% 65%;
    gap: 6px;
  }
  .review-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .review-media {
    border-radius: 10px;
    overflow: hidden;
  }
  .review-media-img {
    width: 100%;
    height: 100%;
  }
  .review-media-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .review-item {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.25);
  }
  .review-item-img {
    padding-top: 10px;
    background: #f6f6f6;
  }
  .review-item-content {
    padding: 20px 15px 35px;
    display: flex;
    flex-direction: column;
  }
  p.review-product-title {
    font-size: 14px;
    font-weight: bold;
    margin: 0;
  }
  p.review-product-title span {
    color: #e55420;
  }
  .review-ring {
    display: flex;
    margin: 5px 0;
  }
  .review-ring img {
    max-height: 14px;
    width: auto;
  }
  p.review-item-title {
    text-align: left;
    font-size: 14px;
    margin: 0;
  }
  p.review-item-info {
    text-align: left;
    font-size: 12px;
    color: #928f8f;
    margin: 0;
  }
  .review-wrapper-mb {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .anniversary-9th-reviews{
      padding: 0;
    }
    .review-content {
      display: flex;
      flex-direction: column;
    }
    .review-wrapper-mb {
      display: block;
    }
    .review-wrapper {
      display: none;
    }
    p.reviews-title {
      font-size: 26px;
    }
    p.reviews-info {
      margin-top: 5px;
      margin-bottom: 20px;
    }

    .review-content {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .review-media{
      display: none;
    }
  }
</style>
<div class="anniversary-9th-reviews section">
  <div class="container">
    <p class="reviews-title">MONUMENT GRILLS FANS</p>
    <p class="reviews-info">Over 90% Of Users Give Monument Grills a 5-Starrating</p>
    <div class="review-content">
      <div class="review-media">
        <div class="review-media-img">
          <img src="{{ section.settings.reviews_image | image_url: width: master }}" alt="">
        </div>
      </div>
      <div class="review-wrapper">
        {% for item in section.blocks %}
          <div class="review-item">
            <div class="review-item-img">
              <img
                src="{{ item.settings.review_image | image_url: width: master }}"
                alt=""
              >
            </div>
            <div class="review-item-content">
              <p class="review-product-title">
                <span>{{ item.settings.review_product_title }}</span>{{ item.settings.review_product_info }}
              </p>
              {% comment %}
                <div class="review-ring">
                  <img
                    src="https://cdn.shopify.com/s/files/1/1639/3511/files/66c00fd044f359a4148a3499d71027b4746d1eba.png?v=1754056511"
                    alt=""
                  >
                </div>
              {% endcomment %}
              <p class="review-item-title">{{ item.settings.review_title }}</p>
              <p class="review-item-info">{{ item.settings.review_info }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="review-wrapper-mb">
        <div class="swiper reviews-swiper">
          <div class="swiper-wrapper">
            {% for item in section.blocks %}
              <div class="swiper-slide">
                <div class="review-item">
                  <div class="review-item-img">
                    <img
                      src="{{ item.settings.review_image | image_url: width: master }}"
                      alt=""
                    >
                  </div>
                  <div class="review-item-content">
                    <p class="review-product-title">
                      <span>{{ item.settings.review_product_title }}</span>{{ item.settings.review_product_info }}
                    </p>
                    {% comment %}
                      <div class="review-ring">
                        <img
                          src="https://cdn.shopify.com/s/files/1/1639/3511/files/66c00fd044f359a4148a3499d71027b4746d1eba.png?v=1754056511"
                          alt=""
                        >
                      </div>
                    {% endcomment %}
                    <p class="review-item-title">{{ item.settings.review_title }}</p>
                    <p class="review-item-info">{{ item.settings.review_info }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.reviews-swiper', {
      slidesPerView: 3,
      spaceBetween: 6,
      breakpoints: {
        320: {
          slidesPerView: 1.2,
          spaceBetween: 6,
        },
        768: {
          slidesPerView: 1.2,
          spaceBetween: 6,
        },
        1280: {
          slidesPerView: 3,
          spaceBetween: 6,
        },
      },
    });
  });
</script>

{% schema %}
{
  "name": "9th Anniversary Review",
  "settings": [
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "评论相关导图"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "review_image",
          "label": "评论主图"
        },
        {
          "type": "text",
          "id": "review_product_title",
          "label": "产品主标题"
        },
        {
          "type": "text",
          "id": "review_product_info",
          "label": "产品副标题"
        },
        {
          "type": "image_picker",
          "id": "review_ring",
          "label": "评论等级星图"
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "评论标题"
        },
        {
          "type": "textarea",
          "id": "review_info",
          "label": "评论内容"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Review"
    }
  ]
}
{% endschema %}
