<style>

section.rewards_section {
    padding-top: 80px;
      padding-bottom: 100px;
}
/* Tab 按钮样式 */
.reward-buttons {
    display: flex;
    margin-bottom: 30px;
    justify-content: center;
      gap: 60px;
}

.reward-btn, .reward-btn3 {
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 16px;
    font-weight: 500;
    padding: 15px 50px;
    color: #333333;
    background: #EEEEEE;
    border-radius: 30px;
    font-weight: 600;
}


.reward-btn.active {
    background: #BC0F0F;
    color: #FFFFFF;
}

/* 内容区域样式 */
.reward-content {
  display: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.reward-content.active {
  display: block;
  opacity: 1;
}

/* 网格布局 */
.rewards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

/* 项目卡片样式 */
.rewards-item {
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background-color: white;
  transition: all 0.3s ease;
  opacity: 0;
  transform: translateY(20px);
}

.rewards-item:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
              0 2px 4px -1px rgba(0, 0, 0, 0.06);
  transform: translateY(-2px);
}

/* 图片样式 */
.item-image {
    overflow: hidden;
    background: #EEEEEE;
    border-radius: 10px 10px 0 0;
}
.rewards__content {
    padding: 20px;
}
.item-image img {
    width: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    margin: 0 auto;
    display: block;
}

.item-image img:hover {
  transform: scale(1.05);
}
.reward-bpttom {
    display: flex;
    justify-content: space-between;
      align-items: center;
}
.rewards__content h3 {
    font-size: 24px;
    font-weight: bold;
    color: #0C0C0C;
}
  .rewards__content p {
    color: #666;
    line-height: 1.3;
    font-weight: 100;
        font-size: 16px;
}
  .reward-bpttom big {
    color: #BC0F0F;
    font-size: 28px;
    font-weight: bold;
}
  .reward-bpttom div {
    color: #666;
    font-size: 16px;
}
  .rewards__content a{
        font-size: 14px;
    line-height: 1;
    min-height: auto;
    font-weight: normal;
  }
/* 动画类 */
.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

  h2.howitwork_title {
    text-align: center;
        margin-bottom: 40px;
}
  .reward_products .rewards__content p{
        color: #000;
    line-height: 1.3;
    font-weight: 600;
    font-size: 20px;
        height: 50px;
  }
@media (max-width: 768px) {
.reward-buttons {
   overflow: auto;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 8px;
      align-items: center;
}
  .reward-btn, .reward-btn3 {
         min-width: 110px;
        text-align: center;
    font-size: 14px;
  
    padding: 10px 15px;
  
    font-weight: normal;
}
  .rewards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}
  .reward-bpttom {
    align-items: flex-start;
    flex-flow: column;
}
  .reward-bpttom big {
    font-size: 22px;
}
  .rewards__content p {
 
    font-size: 14px;
}
  .rewards__content h3 {
    font-size: 20px;
  }
  .rewards__content a {
    font-size: 14px;
    display: block;
    width: 100%;
}
  .rewards-item {
    transform: translateY(0px) !important;
}
  section.rewards_section {
    padding-bottom: 50px;
    padding-top: 40px;
}
}


</style>
