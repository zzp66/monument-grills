{{ 'text-overlay.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
-%}

{% style %}
 #{{ section.id }} .text-box{
    width: 100%;
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
  }
 #{{ section.id }} .text-box .item{
    display: flex;
    align-items: center;
  }
 #{{ section.id }} .text-box .item .big-text{
    margin-right:10px;
  }
  #{{ section.id }} .text-box .item .sub-text,
  #{{ section.id }} .text-box .item .big-text{
    margin-bottom:0;
  }
 #{{ section.id }} .text-box .item .sub-text{
    margin-top: 14px;
  }
  @media (max-width:768px){
   #{{ section.id }} .text-box .item{
      flex-direction: column;
    }
    #{{ section.id }} .section__block{
      /* padding:0; */
    }
    #{{ section.id }} .text-box .item .sub-text{
      min-height:80px;
    }
    #{{ section.id }} .prominent-text-box{
      padding: 0;
    }
  }
  @media (min-width:1921px){
    #{{ section.id }} .text-box .item{
      flex:1;
    }
    #{{ section.id }} .text-box .item .big-text{
      flex-basis: 30%;
    }
    #{{ section.id }} .text-box .item .sub-text{
      font-size:1.5em;
      text-align: left;
      margin-top: 0;
    }
  }
{% endstyle %}

{%- unless section.settings.full_width -%}
  <div class="container">
{%- endunless -%}

<div class="section container{% unless bg_color == false %} section--padded{% if section.settings.full_width %} section--full-width{% endif %}{% endunless %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}{% if bg_color == false %} color-scheme--transparent{% endif %}" id="{{ section.id }}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %} style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.bg_color }};">
  <div class="hide" id="{% if section.settings.link_id != blank %}{{ section.settings.link_id }}{% endif %}"></div>
  <div class="flex {{ section.settings.text_position }} {{ section.settings.text_align }}{% if section.settings.mob_center_text %} md-down:text-center{% endif %}">
    <div class="{% if section.settings.show_post_content != blank %}blog-content{% else %}max-w-text-overlay{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {% when 'blog-post-content' %}
          {% if block.settings.blog_post_content != blank %}
            {% style %}
              .blog-content article:not(img){
                text-align: left;
              }
            {% endstyle %}
            <article class="blog-article">
              {{ block.settings.blog_post_content }}
            </article>
          {% endif %}

          {% when 'banner' %}
          {% if block.settings.banner_pc != blank %}
            <div class="image-banner__image media top-0 left-0 w-full h-full" {% if section.settings.use_video != blank %}style="display:none;"{% endif %}>
              {%- if block.settings.banner_pc != blank -%}
                {%- liquid
                  assign m_img = block.settings.banner_mobile
                  assign img = block.settings.banner_pc
                  if section.settings.full_width
                    if section.settings.height_mode == 'screen'
                      assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                    endif
                  else
                    capture sizes
                      render 'sizes-attribute'
                    endcapture
                  endif
      
                  if m_img != blank
                    assign desktop_image_class = 'img-fit sm:block'
                  else
                    assign desktop_image_class = 'img-fit'
                  endif
                -%}
      
                {%- if m_img != blank -%}
                  {%- render 'image',
                    image: m_img,
                    widths: '480, 980, 1200, 1400',
                    src_width: 980,
                    src_placeholder: true,
                    sizes: sizes,
                    lazy_load: lazy_load_images,
                    class: 'img-fit mobile-img sm:hidden'
                  -%}
                {%- endif -%}
      
                {%- render 'image',
                  image: img,
                  widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                  src_width: 1400,
                  src_placeholder: true,
                  sizes: sizes,
                  lazy_load: lazy_load_images,
                  class: desktop_image_class
                -%}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit dark' }}
              {%- endif -%}
            </div>
          {% endif %}
          
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %} class="{% if block.settings.title_weight != blank %}font-weight{% endif %} {% if block.settings.title_uppercase != blank %} font-uppercase {% endif %} section__block section__block--heading md-down:px-gutter {{ block.settings.heading_size }}" {{ block.shopify_attributes }} 
                style="
                  background-image: linear-gradient({{ block.settings.color_angle }}deg, {{ block.settings.one_color }}, {{ block.settings.two_color }});
                  background: linear-gradient({{ block.settings.color_angle }}deg, {{ block.settings.one_color }}, {{ block.settings.two_color }});
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                ">
                <span class="contained-heading inline-block">{{- block.settings.heading | escape -}}</span>
              </{% if block.settings.heading_h1 %}h1{% else %}h2{% endif %}>
              {% style %}
                .font-weight{
                  font-weight: bold;
                }
                .font-uppercase{
                  text-transform:uppercase;
                }
              {% endstyle %}
            {%- endif -%}

          

          {%- when 'subheading' -%}
            {%- if block.settings.text != blank -%}
              <p class="section__block section__block--subheading subheading md-down:px-gutter" {% if block.settings.enlarge_schema_typeof != blank %}typeof="schema:WebPage"{% endif %}>
                <span class="contained-heading inline-block">{{- block.settings.text | escape -}}</span>
              </p>
            {%- endif -%}
          {% when 'social' %}
          {% style %}
            .footer-social{
              padding:20px 0 !important;
            }
            .footer .social{
              width: 100%;
              display: flex;
            }
            .footer .social.flex-center{
              justify-content: center;
            }
          {% endstyle %}
          <div class="footer footer-social">
            <ul class="social inline-flex flex-wrap justify-start {% if block.settings.iscenter != blank %} flex-center{% endif %}">
              {% if block.settings.fb_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.fb_url }}" target="_blank" rel="noopener" title="Monument Grills on Facebook"><svg width="24" height="24" viewBox="0 0 14222 14222" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M14222 7112c0 3549.352-2600.418 6491.344-6000 7024.72V9168h1657l315-2056H8222V5778c0-562 275-1111 1159-1111h897V2917s-814-139-1592-139c-1624 0-2686 984-2686 2767v1567H4194v2056h1806v4968.72C2600.418 13603.344 0 10661.352 0 7112 0 3184.703 3183.703 1 7111 1s7111 3183.703 7111 7111Zm-8222 7025c362 57 733 86 1111 86-377.945 0-749.003-29.485-1111-86.28Zm2222 0v-.28a7107.458 7107.458 0 0 1-167.717 24.267A7407.158 7407.158 0 0 0 8222 14137Zm-167.717 23.987C7745.664 14201.89 7430.797 14223 7111 14223c319.843 0 634.675-21.479 943.283-62.013Z"></path></svg><span class="visually-hidden">Facebook</span>
                  </a>
                </li>
              {% endif %}
              {% if block.settings.youtube_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.youtube_url }}" target="_blank" rel="noopener" title="Monument Grills on YouTube"><svg width="24" height="17" viewBox="0 0 48 34" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="m19.044 23.27-.001-13.582 12.968 6.814-12.967 6.768ZM47.52 7.334s-.47-3.33-1.908-4.798C43.787.61 41.74.601 40.803.49 34.086 0 24.01 0 24.01 0h-.02S13.914 0 7.197.49c-.939.11-2.984.12-4.81 2.045C.947 4.003.48 7.334.48 7.334S0 11.247 0 15.158v3.668c0 3.912.48 7.823.48 7.823s.468 3.331 1.906 4.798c1.827 1.926 4.226 1.866 5.294 2.067C11.52 33.885 24 34 24 34s10.086-.015 16.803-.505c.938-.113 2.984-.122 4.809-2.048 1.439-1.467 1.908-4.798 1.908-4.798s.48-3.91.48-7.823v-3.668c0-3.911-.48-7.824-.48-7.824Z"></path></svg><span class="visually-hidden">YouTube</span>
                  </a>
                </li>
              {% endif %}
              {% if block.settings.instagram_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" title="Monument Grills on Instagram"><svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><circle cx="15.238" cy="4.948" r="1.238"></circle><path d="M19.47 3.444A5.11 5.11 0 0 0 16.548.527a7.351 7.351 0 0 0-2.43-.466C13.05.014 12.713 0 9.999 0c-2.712 0-3.057 0-4.12.06A7.351 7.351 0 0 0 3.45.528 5.11 5.11 0 0 0 .528 3.444 7.317 7.317 0 0 0 .06 5.87C.014 6.936 0 7.274 0 9.982s0 3.053.06 4.113c.018.829.176 1.649.468 2.425a5.11 5.11 0 0 0 2.922 2.917 7.35 7.35 0 0 0 2.429.5c1.069.047 1.407.06 4.12.06s3.058 0 4.12-.06a7.351 7.351 0 0 0 2.429-.466 5.11 5.11 0 0 0 2.922-2.918 7.31 7.31 0 0 0 .467-2.424c.047-1.067.06-1.405.06-4.113s0-3.053-.06-4.113a7.317 7.317 0 0 0-.467-2.459zm-1.437 10.537a5.439 5.439 0 0 1-.34 1.843 3.262 3.262 0 0 1-1.87 1.87 5.451 5.451 0 0 1-1.825.34c-1.04.046-1.332.06-3.996.06-2.664 0-2.937 0-3.995-.06a5.451 5.451 0 0 1-1.825-.34 3.255 3.255 0 0 1-1.878-1.87 5.439 5.439 0 0 1-.34-1.823c-.046-1.038-.06-1.33-.06-3.992s0-2.934.06-3.992c.006-.63.121-1.253.34-1.844a3.255 3.255 0 0 1 1.878-1.87 5.451 5.451 0 0 1 1.825-.339c1.038-.046 1.331-.06 3.995-.06s2.937 0 3.996.06c.623.008 1.24.123 1.824.34.86.331 1.54 1.01 1.872 1.87.216.583.331 1.2.34 1.823.046 1.038.06 1.33.06 3.992 0 2.661 0 2.948-.047 3.992h-.014z"></path><path d="M9.991 14.753a4.761 4.761 0 1 1 0-9.523 4.761 4.761 0 0 1 0 9.523zm0-1.905a2.857 2.857 0 1 0 0-5.713 2.857 2.857 0 0 0 0 5.713z"></path></svg><span class="visually-hidden">Instagram</span>
                  </a>
                </li>
              {% endif %}
              {% if block.settings.tiktok_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.tiktok_url }}" target="_blank" rel="noopener" title="Monument Grills on TikTok"><svg width="23" height="24" viewBox="0 0 15 16" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M7.638.013C8.512 0 9.378.007 10.245 0c.054 1.02.42 2.06 1.167 2.78.746.74 1.8 1.08 2.826 1.193V6.66c-.96-.033-1.926-.233-2.8-.647a8.238 8.238 0 0 1-1.08-.62c-.006 1.947.007 3.894-.013 5.834a5.092 5.092 0 0 1-.9 2.626c-.873 1.28-2.387 2.114-3.94 2.14-.953.054-1.907-.206-2.72-.686C1.438 14.513.492 13.06.352 11.5a12.36 12.36 0 0 1-.007-.993A5.003 5.003 0 0 1 2.065 7.2c1.107-.96 2.653-1.42 4.1-1.147.013.987-.027 1.974-.027 2.96-.66-.213-1.433-.153-2.013.247-.42.273-.74.693-.907 1.167-.14.34-.1.713-.093 1.073.16 1.093 1.213 2.013 2.333 1.913.747-.006 1.46-.44 1.847-1.073.127-.22.267-.447.273-.707.067-1.193.04-2.38.047-3.573.007-2.687-.007-5.367.013-8.047Z"></path></svg><span class="visually-hidden">TikTok</span>
                  </a>
                </li>
              {% endif %}
              {% if block.settings.pinterest_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.pinterest_url }}" target="_blank" rel="noopener" title="Monument Grills on Pinterest"><svg width="24" height="24" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M24.001 0C10.748 0 0 10.745 0 24.001c0 9.825 5.91 18.27 14.369 21.981-.068-1.674-.012-3.689.415-5.512.462-1.948 3.087-13.076 3.087-13.076s-.765-1.533-.765-3.799c0-3.556 2.064-6.212 4.629-6.212 2.182 0 3.237 1.64 3.237 3.604 0 2.193-1.4 5.476-2.12 8.515-.6 2.549 1.276 4.623 3.788 4.623 4.547 0 7.61-5.84 7.61-12.76 0-5.258-3.543-9.195-9.986-9.195-7.279 0-11.815 5.427-11.815 11.49 0 2.094.616 3.567 1.581 4.708.446.527.505.736.344 1.34-.113.438-.378 1.505-.488 1.925-.16.607-.652.827-1.2.601-3.355-1.369-4.916-5.04-4.916-9.17 0-6.816 5.75-14.995 17.152-14.995 9.164 0 15.195 6.636 15.195 13.75 0 9.416-5.233 16.45-12.952 16.45-2.588 0-5.026-1.4-5.862-2.99 0 0-1.394 5.53-1.688 6.596-.508 1.85-1.504 3.7-2.415 5.14 2.159.638 4.44.985 6.801.985C37.255 48 48 37.255 48 24.001 48 10.745 37.255 0 24.001 0"></path></svg><span class="visually-hidden">Pinterest</span>
                  </a>
                </li>
              {% endif %}
              {% if block.settings.twitter_url != blank %}
                <li>
                  <a class="social__link flex items-center justify-center" href="{{ block.settings.twitter_url }}" target="_blank" rel="noopener" title="Monument Grills on Twitter"><svg fill="currentColor" width="40" height="40" viewBox="1 1 22 22" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg><span class="visually-hidden">Twitter</span>
                  </a>
                </li>
              {% endif %}
            </ul>
          </div>
          {%- when 'subTitle' -%}
            {%- if block.settings.sub_text != blank -%}
              <{% if block.settings.sub_text_size %}{{ block.settings.sub_text_size }}{% else %}h2{% endif %} class="section__block section__block--heading md-down:px-gutter {{ block.settings.sub_text_size }} {% if block.settings.title_weight != blank %}font-weight {% endif %}{% if block.settings.title_uppercase != blank %}font-uppercase{% endif %}" {{ block.shopify_attributes }} style="padding-top:{{ block.settings.sub_padding_top }}px;padding-bottom:{{ block.settings.sub_padding_bottom }}px;">
                {{ block.settings.sub_text | escape }}
              </{% if block.settings.sub_text_size %}{{ block.settings.sub_text_size }}{% else %}h2{% endif %}>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="section__block {% if section.settings.show_post_content != blank %}{% else %}reading-width--inline{% endif %} md-down:px-gutter rte{% if section.settings.text_align == 'text-start' %} mr-auto{% elsif section.settings.text_align == 'text-end' %} ml-auto{% else %} mx-auto{% endif %}{% if block.settings.enlarge_text %} enlarge-text{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {% when 'cur_liquid' %}
            {% if block.settings.cur_liquid != blank %}
              <div class="support-info__block" {{ block.shopify_attributes }}>
                {{ block.settings.cur_liquid }}
              </div>
              {% style %}
                .support-info__block{
                  overflow: hidden;
                  border-radius: 20px;
                }
              {% endstyle %}
            {% endif %}

          {% when 'text_banner' %}
            {% if block.settings.text_pc_img != blank %}
              {% liquid
                  assign pc_banner = block.settings.text_pc_img
                  assign mobile_banner = block.settings.text_mobile_img
                  assign banner_class = 'img-fit text-banner'
              %}
              <div class="text-banner-box">
                {% if pc_banner != blank %}
                  {% render 'image',
                    image: pc_banner,
                    widths: '850, 960, 1200, 1400, 1920',
                    src_width: 850,
                    src_placeholder: true,
                    sizes: sizes,
                    section_index: block.index,
                    class: banner_class
                  %}
                {% endif %}
              </div>
              {% style %}
                .text-banner-box{
                  display:block;
                  width:100%;
                  height:40vw;
                  margin: 0 auto;
                }
                .text-banner-box .text-banner{
                  
                }
              {% endstyle %}
            {% endif %}

          {% when 'icons' %}
            <{% if section.settings.show_gird != blank %}div{% else %}carousel-slider{% endif %} class="icons-warp {% if section.settings.show_gird != blank %}grid-warp{% else %}carousel{% endif %} block relative" inactive{% if section.settings.mobile_stack %} disable-mobile="true"{% endif %}>
            <ul class="slider__grid grid grid-flow-col gap-theme">
              {% liquid
                 assign icon1 =  block.settings.rich_icon1
                 assign icon2 =  block.settings.rich_icon2
                 assign icon3 =  block.settings.rich_icon3
                 assign icon4 =  block.settings.rich_icon4
              %}
              {% style %}
                .icons-warp{
                  padding:3em 0;
                }
                .grid-warp ul{
                  display:grid;
                  grid-auto-flow:row;
                  grid-template-columns: repeat(3, 1fr);
                  grid-gap: 20px 20px;
                }
                .grid-warp ul .item img{
                   position: relative;
                   object-fit: contain;
                }
              {% endstyle %}
              {% if icon1 != blank %}
                <li class="item">
                  {%- render 'image',
                    image: icon1,
                    widths: '240, 480, 960',
                    src_width: 480,
                    src_placeholder: true,
                    sizes: icon_sizes,
                    lazy_load: lazy_load_images,
                    class: 'img-fit rich-icon'
                  -%}
              </li>
              {% endif %}
              {% if icon2 != blank %}
                <li class="item">
                {%- render 'image',
                  image: icon2,
                  widths: '240, 480, 960',
                  src_width: 240,
                  src_placeholder: true,
                  sizes: icon_sizes,
                  lazy_load: lazy_load_images,
                  class: 'img-fit rich-icon'
                -%}
              </li>
              {% endif %}
              {% if icon3 != blank %}
                <li class="item">
                {%- render 'image',
                  image: icon3,
                  widths: '240, 480, 960',
                  src_width: 240,
                  src_placeholder: true,
                  sizes: icon_sizes,
                  lazy_load: lazy_load_images,
                  class: 'img-fit rich-icon'
                -%}
              </li>
              {% endif %}
              {% if icon4 != blank %}
                <li class="item">
                {%- render 'image',
                  image: icon4,
                  widths: '240, 480, 960',
                  src_width: 240,
                  src_placeholder: true,
                  sizes: icon_sizes,
                  lazy_load: lazy_load_images,
                  class: 'img-fit rich-icon'
                -%}
              </li>
              {% endif %}
            </ul>
          </{% if section.settings.show_gird != blank %}div{% else %}carousel-slider{% endif %}>

          {% when 'search' %}
            <div class="input-with-button search-center">
                {% style %}
                  .search-center{
                    max-width:70%;
                    margin:2em auto;
                  }
                {% endstyle %}
        
              <input type="email"
                     class="input newsletter-input focus-inset"
                     placeholder="K104BSBGD2S"
                     autofocus
                     aria-required="true"
                     required>
            
                  <button class="btn btn--primary has-ltr-icon">
                    SEARCH Serial Number
                  </button>
              </div>
         
          {% when 'imgs' %}
          {% style %}
            .imgs-warp{
              margin: 2em 0;
            }
            .imgs-warp ul li.item img{
               position: relative;
            }
          {% endstyle %}
          {% if block.settings.image01 != blank or block.settings.image02 != blank or block.settings.image03 != blank %}
             <{% if block.settings.show_gird != blank %}div{% else %}carousel-slider{% endif %} class="imgs-warp {% if block.settings.show_gird != blank %}grid-warp{% else %}carousel{% endif %} block relative" inactive{% if section.settings.mobile_stack %} disable-mobile="true"{% endif %}>
                <ul class="slider__grid grid grid-flow-col gap-theme">
                   {% liquid
                       assign image_one = block.settings.image01
                       assign image_two = block.settings.image02
                       assign image_three = block.settings.image03
                       assign image_four = block.settings.image04

                       capture sizes
                        render 'sizes-attribute'
                      endcapture

                       if section.index == 1 or section.settings.prevent_animation
                        assign lazy_load_images = false
                      else
                        assign lazy_load_images = true
                      endif
                   %}
                  {% if image_one != blank %}
                    <li class="item">
                      {%- render 'image',
                        image: image_one,
                        widths: '480, 980, 1200, 1400',
                        src_width: 480,
                        src_placeholder: true,
                        sizes: sizes,
                        lazy_load: lazy_load_images,
                        class: 'img-fit imgs'
                      -%}
                    </li>
                  {% endif %}
                  {% if image_two != blank %}
                    <li class="item">
                      {%- render 'image',
                        image: image_two,
                        widths: '480, 980, 1200, 1400',
                        src_width: 480,
                        src_placeholder: true,
                        sizes: sizes,
                        lazy_load: lazy_load_images,
                        class: 'img-fit imgs'
                      -%}
                    </li>
                  {% endif %}
                  {% if image_three != blank %}
                    <li class="item">
                      {%- render 'image',
                        image: image_three,
                        widths: '480, 980, 1200, 1400',
                        src_width: 480,
                        src_placeholder: true,
                        sizes: sizes,
                        lazy_load: lazy_load_images,
                        class: 'img-fit imgs'
                      -%}
                    </li>
                  {% endif %}
                  {% if image_four != blank %}
                    <li class="item">
                      {%- render 'image',
                        image: image_four,
                        widths: '480, 980, 1200, 1400',
                        src_width: 480,
                        src_placeholder: true,
                        sizes: sizes,
                        lazy_load: lazy_load_images,
                        class: 'img-fit imgs'
                      -%}
                    </li>
                  {% endif %}
                </ul>
             </{% if block.settings.show_gird != blank %}div{% else %}carousel-slider{% endif %}>
          {% endif %}

          {% when 'popup-button' %}
          {% if block.settings.is_show_popup != blank %}
