<script>
  $(document).ready(function() {
$('.right__prders').click(function(){
    $('.earn').hide();
    $('.orders').show();
       $('.edit_user').hide();
       $('.boxaddresses').hide();
});
       $('.dashboard').show(); 
    $('.earn').show();
    $('.orders').hide();

    $('.showorder').on('click', function() {
      $(this).addClass("active");
        $('.showProfile').removeClass("active");
       $('.dashboard').hide(); 
    $('.earn').hide();
    $('.orders').show();
       $('.edit_user').hide();
       $('.boxaddresses').hide();
     
    });

    $('.showProfile').on('click', function() {
      $(this).addClass("active");
      $('.showorder').removeClass("active");
       $('.dashboard').hide(); 
    $('.earn').hide();
    $('.orders').hide();
    $('.edit_user').show();
       $('.boxaddresses').hide();
     
    });
  
  $('.account__menu-title').click(function() {
    $(this).toggleClass('active')
           .next('.account__menu-list')
           .slideToggle(300);
    
    $(this).find('svg').toggleClass('rotate-0 rotate-180');
    
  
  });
  
$('.tab_earn').click(function(){
  $(this).addClass("active");
  $('.tab_redeem').removeClass("active");
   $('.con_earn').show();
   $('.con_redeem').hide();
})
    $('.tab_redeem').click(function(){
       $(this).addClass("active");
  $('.tab_earn').removeClass("active");
   $('.con_earn').hide();
   $('.con_redeem').show();
})
});

 

</script>
