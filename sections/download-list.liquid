<style>
  .download-list-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

/* Tab 按钮样式 */
.tab-buttons {
    display: flex;
    margin-bottom: 30px;
    justify-content: space-around;
    border-bottom: 1px solid #e6e6e6;
}

.tab-btn {
    cursor: pointer;
      text-transform: uppercase;
    transition: all 0.3s ease;
    font-size: 16px;
    font-weight: 500;
    padding: 20px 0;
    border-bottom: 3px solid transparent;
  color:#000
}
section.download_section {
    margin-bottom: 80px;
}
.tab-btn:hover {
  
}

.tab-btn.active {
      border-bottom: 3px solid #cb0f0f;
    font-weight: bold;
}

/* 内容区域样式 */
.tab-content {
  display: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tab-content.active {
  display: block;
  opacity: 1;
}

/* 网格布局 */
.download-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

/* 项目卡片样式 */
.download-item {
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background-color: white;
  transition: all 0.3s ease;
  opacity: 0;
  transform: translateY(20px);
}

.download-item:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
              0 2px 4px -1px rgba(0, 0, 0, 0.06);
  transform: translateY(-2px);
}

/* 图片样式 */
.item-image {
  margin-bottom: 15px;
  overflow: hidden;
}

.item-image img {
    width: 65%;
    /* height: 200px; */
    object-fit: cover;
    transition: transform 0.3s ease;
    margin: 0 auto;
    display: block;
}

.item-image img:hover {
  transform: scale(1.05);
}

/* 标题样式 */
.item-title {
    font-size: 40px;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 15px;
    line-height: 1.4;
    text-align: center;
    margin: 0;
    padding: 30px 0;
}

/* 按钮容器 */
.item-buttons {
    display: flex;
    margin-top: auto;
    align-items: center;
    background: #f7f7f7;
  border-top: 1px solid #e5e7eb;
      border-radius: 0 0 10px 10px;
    overflow: hidden;
}

/* 按钮样式 */
.btn {
  display: block;
  padding: 10px;
  text-align: center;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-manual {
border-right: 1px solid #e5e7eb;
      border-radius: 0 0 0 10px;
}

.btn-manual:hover {
  background-color: ;
}

.btn-video {
     border-radius: 0 0 10px 0;
}

.item-buttons a {
    background: #f7f7f7;
    color: #000;
    width: 50%;
    font-size: 12px;
    display: flex;
    height: 60px;
    line-height: 60px;
    padding: 0;
    text-align: center;
    border-radius: 0;
    position: relative;
    align-items: center;
    justify-content: center;
    gap: 5px;
}
  .btn-manual:before {
    content: '';
    background: url(https://cdn.shopify.com/s/files/1/1639/3511/files/pdf_red.png?v=1744597907);
    width: 35px;
    height: 35px;
    background-size: cover;
    display: block;
}
  .btn-manual:hover {
  background-color: #cb0f0f;
  color:#fff
}
   .btn-manual:hover:before {
    content: '';
    background: url(https://cdn.shopify.com/s/files/1/1639/3511/files/pdf_white.png?v=1744597908);
     width: 35px;
    height: 35px;
    background-size: cover;
    display: block;
}
.btn-video:hover {
  background-color: #cb0f0f;
  color:#fff
}

/* 动画类 */
.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.download__content {
    text-align: center;
      margin-bottom: 20px;
}
  .download__content h3 {
    font-size: 15px;
    font-weight: bold;
}
  .download__content p {
    font-size: 12px;
}
@media (max-width: 1024px) {
  .download-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
a.btn.btn-video:before {
    content: '';
    background: url(https://cdn.shopify.com/s/files/1/1639/3511/files/video1.png?v=1747213320);
    width: 35px;
    height: 35px;
    background-size: cover;
}
  a.btn.btn-video {
    width: 60%;
}
  a.btn.btn-manual {
    width: 40%;
}
  a.btn.btn-video:hover:before{
     content: '';
    background: url(https://cdn.shopify.com/s/files/1/1639/3511/files/video2.png?v=1747213320);
    width: 35px;
    height: 35px;
    background-size: cover;
  }
@media (max-width: 768px) {
  .download-grid {
    grid-template-columns: repeat(2, 1fr);
        gap: 20px;
  }
  
  .tab-buttons {
        gap: 20px;
        justify-content: flex-start;
            flex-wrap: nowrap;
            overflow: scroll;
    margin-bottom: 30px;
  }
  
  .tab-btn {
        width: 120px;
        text-align: center;
        flex: none;
    font-size: 13px;
            padding-top: 0;
  }

  .download-list-container {
    padding: 0;
}
  .download__top{
        display: flex;
    align-items: center;
  }
  .item-image{
        width: 40%;
    margin: 0;
  }
  .download__content{
        margin: 0;
    width: 60%;
  }
  .download__content p {
    font-size: 12px;
    margin: 0;
}
  .item-buttons a {
  
    height: 40px;
    line-height: 40px;
}
  .download-item {
    transform: translateY(0px) !important;
}
}


</style>
