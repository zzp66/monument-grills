  <script>
    (function($) {
  'use strict';

  $(document).ready(function() {
    // 初始化变量
    const $tabButtons = $('.tab-btn');
    const $tabContents = $('.tab-content');
    const $downloadItems = $('.download-item');
    
    // 初始化函数
    function init() {
      showActiveTab($tabButtons.first());
      initializeItems();
      handleResponsive();
    }

    // 显示活动标签页
    function showActiveTab($button) {
      const tabId = $button.data('tab');
      
      // 更新按钮状态
      $tabButtons.removeClass('active');
      $button.addClass('active');
      
      // 更新内容状态
      $tabContents.removeClass('active').hide();
      const $activeContent = $(`#${tabId}`);
      $activeContent.addClass('active').fadeIn(300);
      
      // 重置并显示项目
      resetItems($activeContent);
      showItems($activeContent);
    }

    // 初始化所有项目
    function initializeItems() {
      $downloadItems.css({
        opacity: 0,
        transform: 'translateY(20px)'
      });
    }

    // 重置项目状态
    function resetItems($container) {
      $container.find('.download-item').css({
        opacity: 0,
        transform: 'translateY(20px)'
      });
    }

    // 显示项目动画
    function showItems($container) {
      $container.find('.download-item').each(function(index) {
        $(this).delay(index * 100).animate({
          opacity: 1,
          transform: 'translateY(0)'
        }, 300);
      });
    }

    // 处理响应式布局
    function handleResponsive() {
      const windowWidth = $(window).width();
      const $downloadGrid = $('.download-grid');
      
      if (windowWidth <= 480) {
        $downloadGrid.css('grid-template-columns', '1fr');
      } else if (windowWidth <= 768) {
        $downloadGrid.css('grid-template-columns', 'repeat(2, 1fr)');
      } else if (windowWidth <= 1024) {
        $downloadGrid.css('grid-template-columns', 'repeat(3, 1fr)');
      } else {
        $downloadGrid.css('grid-template-columns', 'repeat(4, 1fr)');
      } 
    }

    // 图片加载效果
    function handleImageLoad() {
      $('.item-image img').each(function() {
        if (this.complete) {
          $(this).addClass('fade-in');
        } else {
          $(this).on('load', function() {
            $(this).addClass('fade-in');
          });
        }
      });
    }

    // 按钮悬停效果
    function initButtonHover() {
      $('.btn').hover(
        function() {
          $(this).stop().animate({ opacity: 0.8 }, 200);
        },
        function() {
          $(this).stop().animate({ opacity: 1 }, 200);
        }
      );
    }

    // 事件监听
    $tabButtons.on('click', function() {
      showActiveTab($(this));
    });

    $(window).on('resize', function() {
      handleResponsive();
    });

    // 初始化所有功能
    init();
    handleImageLoad();
    initButtonHover();

    // 性能优化：防抖函数
    function debounce(func, wait) {
      let timeout;
      return function() {
        const context = this;
        const args = arguments;
        clearTimeout(timeout);
        timeout = setTimeout(function() {
          func.apply(context, args);
        }, wait);
      };
    }

    // 使用防抖处理窗口调整
    $(window).on('resize', debounce(function() {
      handleResponsive();
    }, 250));

    // 添加触摸设备支持
    if ('ontouchstart' in window) {
      $('.download-item').on('touchstart', function() {
        $(this).css('transform', 'scale(0.98)');
      }).on('touchend', function() {
        $(this).css('transform', 'scale(1)');
      });
    }
  });
})(jQuery);
  </script>
