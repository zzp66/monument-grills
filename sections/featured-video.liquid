{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'featured-collection.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'featured-collection.css' | asset_url | stylesheet_tag }}
  {{ 'product.css' | asset_url | stylesheet_tag }}
  {{ 'text-overlay.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign collection = section.settings.collection

  assign carousel_desktop_small_promo = ' sm:auto-cols-3 md:auto-cols-2 lg:auto-cols-3 xl:auto-cols-4 small-cards-desktop'
  assign carousel_desktop_medium_promo = ' sm:auto-cols-2 lg:auto-cols-3'
  assign carousel_desktop_large_promo = ' sm:auto-cols-2'
  assign carousel_desktop_small = ' md:auto-cols-3 lg:auto-cols-4 xl:auto-cols-5 small-cards-desktop'
  assign carousel_desktop_medium = ' sm:auto-cols-3 xl:auto-cols-4'
  assign carousel_desktop_large = ' sm:auto-cols-2 lg:auto-cols-3'

  assign grid_desktop_small_promo = ' sm:grid-cols-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 small-cards-desktop'
  assign grid_desktop_medium_promo = ' md:grid-cols-2 lg:grid-cols-3'
  assign grid_desktop_large_promo = ' sm:grid-cols-2'
  assign grid_desktop_small = ' md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 small-cards-desktop'
  assign grid_desktop_medium = ' sm:grid-cols-3 xl:grid-cols-4'
  assign grid_desktop_large = ' sm:grid-cols-2 lg:grid-cols-3'

  if section.settings.card_size_mobile == 'small'
    assign carousel_mobile_cols = 'grid-flow-col auto-cols-2 small-cards-mobile'
    assign grid_mobile_cols = 'grid-cols-2 small-cards-mobile'
  else
    assign carousel_mobile_cols = 'grid-flow-col auto-cols-1'
    assign grid_mobile_cols = 'grid-cols-1'
  endif

  if section.settings.layout == 'carousel'
    assign carousel = true

    if section.settings.show_promo_info
      if section.settings.card_size == 'small'
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_small_promo
      elsif section.settings.card_size == 'medium'
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_medium_promo
      else
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_large_promo
      endif
    else
      if section.settings.card_size == 'small'
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_small
      elsif section.settings.card_size == 'medium'
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_medium
      else
        assign grid_classes = carousel_mobile_cols | append: carousel_desktop_large
      endif
    endif
  elsif section.settings.layout == 'carousel_on_mobile'
    assign carousel = true

    if section.settings.show_promo_info
      if section.settings.card_size == 'small'
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_small_promo
      elsif section.settings.card_size == 'medium'
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_medium_promo
      else
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_large_promo
      endif
    else
      if section.settings.card_size == 'small'
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_small
      elsif section.settings.card_size == 'medium'
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_medium
      else
        assign grid_classes = carousel_mobile_cols | append: grid_desktop_large
      endif
    endif
  elsif section.settings.layout == 'grid'
    assign carousel = false

    if section.settings.show_promo_info
      if section.settings.card_size == 'small'
        assign grid_classes = grid_mobile_cols | append: grid_desktop_small_promo
      elsif section.settings.card_size == 'medium'
        assign grid_classes = grid_mobile_cols | append: grid_desktop_medium_promo
      else
        assign grid_classes = grid_mobile_cols | append: grid_desktop_large_promo
      endif
    else
      if section.settings.card_size == 'small'
        assign grid_classes = grid_mobile_cols | append: grid_desktop_small
      elsif section.settings.card_size == 'medium'
        assign grid_classes = grid_mobile_cols | append: grid_desktop_medium
      else
        assign grid_classes = grid_mobile_cols | append: grid_desktop_large
      endif
    endif
  endif

  if settings.prod_card_image_ratio == 'shortest'
    assign image_ratio = 0
    for product in collection.products limit: section.settings.products_to_show
      if product.featured_media.preview_image.aspect_ratio > image_ratio
        assign image_ratio = product.featured_media.preview_image.aspect_ratio
      endif
    endfor
  elsif settings.prod_card_image_ratio == 'tallest'
    assign image_ratio = 99
    for product in collection.products limit: section.settings.products_to_show
      if product.featured_media.preview_image.aspect_ratio < image_ratio
        assign image_ratio = product.featured_media.preview_image.aspect_ratio
      endif
    endfor
  else
    assign image_ratio = settings.prod_card_image_ratio
  endif

  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == 'default'
    assign bg_color = settings.bg_color
  elsif color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
-%}

<div class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  {%- if section.settings.title != blank or section.settings.show_view_all -%}
    <div class=" {% if section.settings.full_screen != blank %} {% else %} container {% endif %}">
      <div class="section__header items-center flex{% if section.settings.overlay_text_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
        {%- if section.settings.title != blank -%}
          <h2 class="section__block section__block--heading md-down:px-gutter h2 {{ section.settings.heading_align }}">
            {{- section.settings.title | escape -}}
          </h2>
        {%- endif -%}
        {% if section.settings.text_description %}
            <div class="section__block reading-width--inline md-down:px-gutter rte{% if section.settings.text_align == 'text-start' %} mr-auto{% elsif section.settings.text_align == 'text-end' %} ml-auto{% else %} mx-auto{% endif %}{% if section.settings.enlarge_text %} enlarge-text{% endif %}" {{ section.shopify_attributes }}>
              {{ section.settings.text_description }}
            </div>
        {% endif %}
      </div>
      
    </div>
  {%- endif -%}
  {%- if carousel -%}
      <carousel-slider class="carousel block{% if section.settings.show_promo_info %} grow{% endif %}" inactive{% if section.settings.layout == 'carousel_on_mobile' %} disable-desktop="true"{% endif %}>
        <div class="{% unless section.settings.show_promo_info %}container relative{% endunless %} featured-collection-products">
          <div class="slider" id="slider-{{ section.id }}">
          {%- endif -%}

          <div class="container products-grid-container shrink-0">
            <ul class="{% if carousel %}slider__grid {% endif %}grid {{ grid_classes }}{% if section.settings.layout == 'carousel_on_mobile' and section.settings.card_size_mobile == 'small' and settings.card_contain %} sm:gap-x-theme sm:gap-y-4{% else %} gap-x-theme gap-y-4{% endif %}{% if section.settings.card_size_mobile == 'small' and settings.card_contain %} small__grid{% endif %}" role="list">
              
              {% for block in section.blocks limit: section.settings.show_number %}
                  {% if block.settings.video_external != blank %}
                      {{ 'video.css' | asset_url | stylesheet_tag }}
                      <script src="{{ 'video.js' | asset_url }}" defer="defer"></script>
                      <li {% if carousel %}class="slider__item"{% endif %}{% if settings.animations_enabled != "disabled" %}data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                        {% comment %}
                          {% render 'video-item', b: section.settings.blocks %}
                        {% endcomment %}
                          <div class="card">
                            <div class="card__media">
                              {% liquid
                                  assign using_video_tag = false
                                  assign autoplay = block.settings.video_autoplay
                                  assign color_scheme = block.settings.color_scheme
                              
                                  if block.settings.video_select != blank
                                    assign using_video_tag = true
                                  endif
                                %}
                                {%- capture video_component -%}
                                  <video-component class="{% if using_video_tag %}has-video{% else %}has-iframe{% endif %} block w-full h-full"
                                                   data-video-url="{{ block.settings.video_external }}" 
                                                   data-video-id="{{ section.id }}"
                                                   data-autoplay="{% if autoplay %}true{% else %}false{% endif %}"
                                                   data-background="false"
                                                   data-description="{{ block.settings.video_description | escape }}">
                                    {%- if using_video_tag -%}
                                      {{ block.settings.video_select | video_tag: playsinline: true, autoplay: autoplay, muted: autoplay, controls: true, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                                    {%- else -%}
                                      <div></div>
                                    {%- endif -%}
                                  </video-component>
                                {%- endcapture -%}
    
                              <div class="video-section relative flex mx-auto overflow-hidden flex-col{% if block.settings.video_size == 'sm' %} max-w-screen-md{% elsif block.settings.video_size == 'md' %} max-w-screen-lg{% endif %}">
                                {% if section.blocks.size > 0 %}
                                    {% if autoplay %}
                                      <deferred-media class="block top-0 left-0 w-full h-full no-js-hidden">
                                        <template>{{ video_component }}</template>
                                      </deferred-media>
        
                                      <noscript>
                                        <div class="absolute top-0 left-0 w-full h-full">
                                          {{ video_component }}
                                        </div>
                                      </noscript>
                                    {% else %}
                                      <deferred-media class="height-clip top-0 left-0 w-full h-full no-js-hidden"{% if using_video_tag and autoplay == false %} data-hide-controls-instantly="true"{% endif %}>
                                        <button type="button" class="video-section__play-btn absolute top-0 left-0 flex justify-center items-center w-full h-full video-played-hidden js-load-media">
                                          <span class="visually-hidden">{{ 'general.icon_labels.play' | t }}</span>
                                          {%- render 'icon-play' -%}
                                        </button>
                                        <template>
                                          {{ video_component }}
                                        </template>
                                      </deferred-media>
                                    {% endif %}
                                {% endif %}
        
                                <div class="media media--has-overlay absolute top-0 left-0 w-full h-full video-played-hidden">
                                  {%- liquid
                                    assign sizes = false
                                    assign class = 'img-fit object-center'
                                  -%}
                                  {%- if block.settings.poster_image != blank or block.settings.video_select != blank -%}
                                    {%- assign poster_image = block.settings.poster_image | default: block.settings.video_select.preview_image -%}
                                    {%- capture sizes -%}
                                      {%- render 'sizes-attribute', min: '100vw', sm: 'page', md: false, lg: false, xl: 'page', max: 'page' -%}
                                    {%- endcapture -%}
                                    {% render 'image',
                                      image: poster_image,
                                      widths: '750, 856, 1440, 1680, 1920, 2560',
                                      src_width: 1680,
                                      src_placeholder: true,
                                      sizes: sizes,
                                      section_index: section.index,
                                      class: class
                                    %}
                                  {%- else -%}
                                    {%- assign class = class | prepend: 'media__placeholder ' -%}
                                    {{ 'lifestyle-1' | placeholder_svg_tag: class }}
                                  {%- endif -%}
                                </div>
                              </div>
                            </div>
                            {% if block.settings.video_title !=blank %}
                            <div class="card__info">
                              {% if block.settings.video_title != blank %}
                                  <h5>{{ block.settings.video_title | escape }}</h5>
                              {% endif %}
                              {% if block.settings.video_description != blank %}
                                  <p>{{ block.settings.video_description | escape }}</p>
                              {% endif %}
                            </div>
                             {% endif %}
                          </div>
                      </li>
                  {% endif %}
              {% endfor %}
            </ul>
          </div>
          {%- if carousel -%}
          </div>
          {%- if settings.slider_show_arrows != 'never' -%}
            <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                {% render 'icon-chevron-right' %}
              </button>
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                {% render 'icon-chevron-left' %}
              </button>
            </div>
          {%- endif -%}
        </div>
      </carousel-slider>
    {%- endif -%}
</div>
 


{% schema %}
{
  "name": "featured-video -- wenfei",
  "tag": "section",
  "class": "cc-featured-collection cwf",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "Full screen",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Button",
      "default": 0
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text_description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "enlarge_text",
      "label": "Enlarge text",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "text-start",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-end",
          "label": "Right"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "Promotion card"
    },
    {
      "type": "checkbox",
      "id": "show_promo_info",
      "label": "Show promotion",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "carousel_on_mobile",
          "label": "Carousel on mobile"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "show_number",
      "label": "Maximum number to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 3,
      "info":"min: 3, max: 12"
    },
    {
      "type": "select",
      "id": "card_size_mobile",
      "label": "Product card size on mobile",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Promotion card color scheme",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Promotion card button",
      "options": [
        {
          "value": "link",
          "label": "Link"
        },
        {
          "value": "btn btn--primary",
          "label": "Primary button"
        },
        {
          "value": "btn btn--secondary",
          "label": "Secondary button"
        }
      ],
      "default": "btn btn--primary"
    }
  ],
  "max_blocks": 12,
  "blocks":[
    {
      "type": "video_list",
      "name": "video",
      "settings":[
        {
          "type": "video",
          "id": "video_select",
          "label": "Video upload"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Cover image"
        },
        {
          "type": "url",
          "id": "video_external",
          "label": "External video"
        },
        
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title",
          "default":"video title"
        },
        {
          "type": "text",
          "id": "video_description",
          "label": "Video description",
          "default":"video description"
        },
        {
          "type": "select",
          "id": "video_size",
          "label": "Video size",
          "info": "Applies to large screens only.",
          "options": [
            {
              "value": "sm",
              "label": "Small"
            },
            {
              "value": "md",
              "label": "Medium"
            },
            {
              "value": "lg",
              "label": "Large"
            }
          ],
          "default": "md"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay",
          "info": "Some devices will not autoplay videos under certain circumstances. In accordance with Google's guidelines, autoplaying videos will be muted by default. [Learn more](https://cleancanvas.co.uk/support/enterprise/using-videos)",
          "default": true
        },
        {
          "type": "header",
          "content": "Text layout"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            {
              "value": "text-start",
              "label": "Left"
            },
            {
              "value": "text-center",
              "label": "Center"
            },
            {
              "value": "text-end",
              "label": "Right"
            }
          ],
          "default": "text-center"
        },
        {
          "type": "header",
          "content": "Style"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color scheme",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "1",
              "label": "Scheme 1"
            },
            {
              "value": "2",
              "label": "Scheme 2"
            },
            {
              "value": "3",
              "label": "Scheme 3"
            }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured video -- wenfei",
      "blocks":[
        {
          "type": "video_list"
        },
        {
          "type": "video_list"
        },
        {
          "type": "video_list"
        }
      ]
    }
  ],
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
{% style %}
  .has-iframe{
    width:100% !important;
  }
  .has-iframe iframe{
    width:100%;
  }
  .card .card__info{
    padding:1em;
  }
  .card .card__info h5{
    margin-bottom:0;
  }
  @media (max-width:768px){
    .cc-featured-collection.cwf .products-grid-container{
      padding:0;
    }
    .card .card__media .video-section{
      
    }
    .featured-collection-products .slider{
      padding-bottom:0;
    }
    .cc-featured-collection.cwf .carousel ul.slider__grid{
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    .cc-featured-collection.cwf .carousel ul.slider__grid li .card .card__media .video-section{
      height:auto;
      max-width: 100%;
    }
  }
{% endstyle %}
