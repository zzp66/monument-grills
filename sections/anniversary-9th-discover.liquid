<style>
  .anniversary-9th-discover {
    padding: 60px 0;
  }
  p.discover-title {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  .discover-content {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .discover-item {
    position: relative;
  }
  .discover-bg {
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #000000, #00000000);
    z-index: 1;
  }
  .discover-item-btn {
    position: relative;
    display: block;
  }
  .discover-info {
    position: absolute;
    bottom: 10px;
    left: 15px;
    z-index: 2;
  }
  p.info-1 {
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  p.info-2 {
    font-size: 16px;
    color: #fff;
    margin: 5px 0 0 0;
  }
</style>
<div class="anniversary-9th-discover section">
  <div class="container">
    <p class="discover-title">Discover More</p>
    <div class="discover-content">
      <div class="discover-item">
        <a href="/" class="discover-item-btn">
          <div class="discover-img">
            <img src="https://cdn.shopify.com/s/files/1/1639/3511/files/blog-3.jpg?v=1754052551" alt="">
          </div>
          <div class="discover-bg"></div>
          <div class="discover-info">
            <p class="info-1">Monument BBQ Forum</p>
            <p class="info-2">Connect with fellow grill lovers and explore BBQ recipes, tips, and product support.</p>
          </div>
        </a>
      </div>
      <div class="discover-item">
        <a href="/" class="discover-item-btn">
          <div class="discover-img">
            <img src="https://cdn.shopify.com/s/files/1/1639/3511/files/blog-3.jpg?v=1754052551" alt="">
          </div>
          <div class="discover-bg"></div>
          <div class="discover-info">
            <p class="info-1">Monument BBQ Forum</p>
            <p class="info-2">Connect with fellow grill lovers and explore BBQ recipes, tips, and product support.</p>
          </div>
        </a>
      </div>
      <div class="discover-item">
        <a href="/" class="discover-item-btn">
          <div class="discover-img">
            <img src="https://cdn.shopify.com/s/files/1/1639/3511/files/blog-3.jpg?v=1754052551" alt="">
          </div>
          <div class="discover-bg"></div>
          <div class="discover-info">
            <p class="info-1">Monument BBQ Forum</p>
            <p class="info-2">Connect with fellow grill lovers and explore BBQ recipes, tips, and product support.</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
