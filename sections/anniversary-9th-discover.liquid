<style>
  .anniversary-9th-discover {
    padding: 60px 0;
    margin: 0;
  }
  p.discover-title {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  .discover-content {
    margin-top: 30px;
  }
  .discover-item {
    position: relative;
  }
  .discover-bg {
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #000000, #00000000);
    z-index: 1;
  }
  .discover-item-btn {
    position: relative;
    display: block;
  }
  .discover-info {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    padding: 10px 15px;
  }
  p.info-1 {
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  p.info-2 {
    font-size: 16px;
    color: #fff;
    margin: 5px 0 0 0;
  }

  @media screen and (max-width: 768px) {
    .anniversary-9th-discover {
      padding: 30px 0;
    }
    p.discover-title {
      font-size: 26px;
    }
    .discover-content {
      margin-top: 15px;
    }
    p.info-1 {
      font-size: 18px;
      line-height: 20px;
    }
    p.info-2 {
      font-size: 14px;
      line-height: 16px;
    }
  }
</style>
<div class="anniversary-9th-discover section">
  <div class="container">
    <p class="discover-title">Discover More</p>
    <div class="discover-content">
      <div class="swiper discover-swiper">
        <div class="swiper-wrapper">
          {% for info in section.blocks %}
            <div class="swiper-slide">
              <div class="discover-item">
                <a href="{{ info.settings.info_link }}" class="discover-item-btn">
                  <div class="discover-img">
                    <img src="{{ info.settings.info_image | image_url: width: master }}" alt="">
                  </div>
                  <div class="discover-bg"></div>
                  <div class="discover-info">
                    <p class="info-1">{{ info.settings.info_title }}</p>
                    <p class="info-2">{{ info.settings.info_info }}</p>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.discover-swiper', {
      slidesPerView: 3,
      spaceBetween: 20,
      breakpoints: {
        320: {
          slidesPerView: 1.2,
          spaceBetween: 10,
        },
        768: {
          slidesPerView: 1.2,
          spaceBetween: 15,
        },
        1280: {
          slidesPerView: 3,
          spaceBetween: 20,
        },
      },
    });
  });
</script>

{% schema %}
{
  "name": "9th Anniversary Discover",
  "settings": [],
  "blocks": [
    {
      "type": "info",
      "name": "Info",
      "settings": [
        {
          "type": "image_picker",
          "id": "info_image",
          "label": "活动相关图"
        },
        {
          "type": "url",
          "id": "info_link",
          "label": "活动链接"
        },
        {
          "type": "text",
          "id": "info_title",
          "label": "活动标题"
        },
        {
          "type": "text",
          "id": "info_info",
          "label": "活动信息"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Discover"
    }
  ]
}
{% endschema %}
