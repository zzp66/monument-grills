<style>
  .banner-content {
    position: relative;
  }
  .banner-info-img img {
    max-width: 600px;
  }
  .banner-infos {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .banner-text {
    color: #fff;
    text-align: center;
    font-size: 24px;
    margin: 10px 0 0 0;
  }
  .banner-text span {
    color: #e55420;
  }

  @media screen and (max-width: 768px) {
    .banner-info-img img {
      max-width: 100%;
    }
    .banner-text {
      font-size: 16px;
      margin: 0;
    }
  }
</style>
<div class="anniversary-9th-banner">
  <div class="banner-content">
    <div class="banner-img">
      <img
        src="https://cdn.shopify.com/s/files/1/1639/3511/files/920169b0b3d6cbfea6c75e96f03fb91e8ee1b2d9.jpg?v=1754035445"
        alt=""
      >
    </div>
    <div class="banner-infos">
      <div class="banner-info-img">
        <img
          src="https://cdn.shopify.com/s/files/1/1639/3511/files/0dd041a26a40eaf15b82867ba62006e05d63c0fb.png?v=1754035437"
          alt=""
        >
      </div>
      <p class="banner-text">Celebrating <span>9 Years</span> of Expert Grilling</p>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "9th Anniversary Banner",
  "settings": [],
  "presets": [
    {
      "name": "9th Anniversary Banner"
    }
  ]
}
{% endschema %}
