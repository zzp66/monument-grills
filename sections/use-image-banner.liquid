                }
                #{{ section.id }} .section__block--countdown {
                  position: absolute;
                  --countdown-size: {{ aa.settings.countdown_size }};

                  {%- assign countdown_size_int = aa.settings.countdown_size | plus: 0 -%}
                  {% if countdown_size_int %}
                    --countdown-gap: 0.7em;
                  {% endif %}

                  {% if block.settings.use_custom_colors %}
                    .countdown__item .countdown__number{
                      background:{{ aa.settings.count_color }};
                      color:{{ aa.settings.bg_color.rgb }};
                    }
                 
                  {% endif %}
                  #{{ section.id }} .section__block--countdown{
                      bottom: 20%;
                      top: auto !important;
                      left: 50% !important;
                      transform: translateX(-50%);
                  }
                }
              {% endstyle %}
              <div class="section__block--countdown text-overlay__block{% if aa.settings.enlarge_end_text %} countdown-large-endtext{% endif %}" {{ aa.shopify_attributes }}
                {% if aa.settings.time_position == 'top_left' %}
                  style="top:0;left:120px;"
                {% elsif aa.settings.time_position == 'top_center' %}
                  style="top:0;left:50%;transform: translateX(-50%);"
                {% elsif aa.settings.time_position == 'top_right' %}
                  style="top:0;right: 120px;"
                {% elsif aa.settings.time_position == 'middle_left' %}
                  style="top:50%;left:120px;transform: translateY(-50%);"
                {% elsif aa.settings.time_position == 'middle_right' %}
                  style="top:50%;right:120px;transform: translateY(-50%);"
                {% elsif aa.settings.time_position == 'middle_center' %}
                  style="top:50%;left:50%;transform: translate(-50%, -50%);"
                {% elsif aa.settings.time_position == 'bottom_left' %}
                  style="bottom:20px;left:120px;"
                {% elsif aa.settings.time_position == 'bottom_center' %}
                  style="bottom:20px;left:50%;transform: translateX(-50%);"
                {% elsif aa.settings.time_position == 'bottom_right' %}
                  style="bottom:20px;right:120px;"
                {% endif %}
              >
                {% render 'banner-timer',
                  end_date: aa.settings.end_date,
                  end_time: aa.settings.end_time,
                  start_date: aa.settings.start_date,
                  start_time: aa.settings.start_time,
                  end_text: aa.settings.end_text,
                  end_midnight: true,
                  hide_on_end: aa.settings.hide_on_end
                %}
                <script>
