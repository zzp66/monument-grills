<script>
  $(function(){
    $('.banner-tab-bar .nav').on('click','.nav-item',function(){
      var index = $(this).index();
      $(this).addClass('active').siblings().removeClass('active');
      console.log($(this).parent().siblings())
      $(this).parent().siblings().children('.nav-box-item').eq(index).addClass('active').siblings().removeClass('active');
    });
  });
</script>


