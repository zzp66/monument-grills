{%- liquid
  # constants
  assign breakpoint_sm = 600
  assign breakpoint_md = 769
  assign breakpoint_lg = 1024

  if section.index == 1 or section.settings.prevent_animation
    assign lazy_load_images = false
  else
    assign lazy_load_images = true
  endif

  if section.settings.layout == 'carousel'
    assign carousel = true
    assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 lg:auto-cols-3 xl:auto-cols-3'
  else
    assign carousel = false
    assign grid_classes = 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3'
  endif

  if section.settings.image_ratio == 'shortest'
    assign image_ratio = 0
    for article in section.settings.blog.articles
      if article.image.aspect_ratio > image_ratio
        assign image_ratio = article.image.aspect_ratio
      endif
    endfor
  elsif section.settings.image_ratio == 'tallest'
    assign image_ratio = 99
    for article in section.settings.blog.articles
      if article.image.aspect_ratio < image_ratio
        assign image_ratio = article.image.aspect_ratio
      endif
    endfor
  else
    assign image_ratio = section.settings.image_ratio
  endif
-%}
{% style %}
  p.popup-title-info {
    text-align: center;
    color: #000;
    margin: 10px 0;
  }
  .pop-up-slider .slider .slider-item .card .card__media {
    max-height: 300px;
    padding-top: 0 !important;
  }
  .pop-up-slider .slider .slider-item .card .card__info,
  .pop-up-slider .grid .slider-item .card .card__info {
    padding: calc(4 * var(--space-unit));
  }
  .pop-up-slider .popup-section .modal__window .picture-box {
    position: relative;
    width: 100%;
  }
  .pop-up-slider .popup-section .modal__window .picture-box img {
    position: relative;
  }
  .pop-up-slider .arrow-slider .slider {
  }
  .pop-up-slider .arrow-slider .slider-nav:not(.slide-nav--inline) {
    width: 100%;
    display: none;
    justify-content: space-between;
    flex-direction: row-reverse;
    left: 0px;
    transform: translate(0%, -50%);
  }
  @media (max-width: 768px) {
    .pop-up-slider .arrow-slider .slider-nav:not(.slide-nav--inline) {
      display: flex;
    }
    .pop-up-slider .arrow-slider .slider {
      scrollbar-width: none;
      padding-bottom: 0;
    }
  }
{% endstyle %}
{%- if carousel == false -%}
  {% style %}
    {% if section.settings.column_size == 'small' %}
      @media (min-width: {{ breakpoint_sm }}px) {
        #{{ section.id }} .slider-item {
          width: calc(50% - var(--column-gap));
        }
      }
      @media (min-width: {{ breakpoint_md }}px) {
        #{{ section.id }} .slider-item {
          width: calc((100% / 3) - var(--column-gap));
        }
      }
      @media (min-width: {{ breakpoint_lg }}px) {
        #{{ section.id }} .slider-item {
          width: calc(25% - var(--column-gap));
        }
      }
    {% else %}
      @media (min-width: {{ breakpoint_md }}px) {
        #{{ section.id }} .slider-item {
          width: calc(50% - var(--column-gap));
        }
      }
      {% if section.settings.column_size == 'medium' %}
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .slider-item {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
      {% endif %}
    {% endif %}
  {% endstyle %}
{% else %}
{%- endif -%}
<div class="section {{ section.class }}" id="{{ section.settings.popup_id }}">
  <div class="container">
    <div
      class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"
      {% if settings.animations_enabled != 'disabled' %}
        data-cc-animate
      {% endif %}
    >
      {%- if section.settings.title != blank -%}
        <{{ section.settings.heading_size }} class="{{ section.settings.use_class_name }} section__heading mb-0 flex-auto {{ section.settings.heading_align }} {% if section.settings.header_weight != blank %}font-weight {% endif %}{% if section.settings.header_uppercase != blank %}font-uppercase{% endif %}">
          {{- section.settings.title | escape -}}
        </{{ section.settings.heading_size }}>
      {%- endif -%}

      {% if section.settings.title_info != blank %}
        <p class="popup-title-info">
          {{ section.settings.title_info }}
        </p>
      {% endif %}
    </div>
  </div>
  {%- if carousel -%}
    <carousel-slider
      class="carousel block {% if settings.slider_show_arrows == 'never' %}arrow-slider{% endif %}"
      {% if settings.slider_show_arrows == 'never' %}
      {% else %}
        inactive
      {% endif %}
    >
      <div class="container relative {% if settings.slider_show_arrows == 'never' %}arrow-slider-box{% endif %}">
        <div class="slider" id="slider-{{ section.id }}">
  {%- endif -%}

  <div class="{% if section.settings.full_screen %}{% else %} container{% endif %}">
    <ul class="{% if carousel %}slider__grid {% endif %}grid {{ grid_classes }} gap-x-theme gap-y-10" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          if section.settings.image_ratio == 'natural'
            if block.settings.image != blank
              assign image_ratio = block.settings.popup_image
            else
              assign image_ratio = 1.77
            endif
          endif
        -%}
        {% if block.settings.popup_image != blank %}
          <li
            class="slider-item grow w-full max-w-none{% if carousel %} slider__item{% endif %}"
            data-title="{{ block.settings.heading }}"
            data-img="{{ block.settings.popup_image | image_url: width: 400 }}"
            data-description="{{ block.settings.card_description }}"
            {{ block.shopify_attributes -}}
            {% if settings.animations_enabled != 'disabled' %}
              data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"
            {% endif %}
          >
            <div class="card{% if block.settings.round %} image-round {% endif %} relative flex flex-col">
              {% if block.settings.enable_media != blank %}
                <div
                  class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}"
                  style="{% if section.settings.image_ratio == "natural" %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}"
                >
                  {%- if block.settings.popup_image != blank %}
                    {%- liquid
                      assign image_class = 'video-played-hidden'
                      unless section.settings.image_ratio == 'natural'
                        assign image_class = image_class | append: ' img-fit'
                      endunless
                      if section.settings.image_ratio == 'natural'
                        assign image_class = image_class | append: ' img-fit'
                      endif

                      if section.settings.column_size == 'small'
                        assign cols = 3
                      else
                        assign cols = 2
                      endif
                      capture sizes
                        render 'sizes-attribute', grid: true, min: 1, md: cols
                      endcapture
                    -%}
                    {%-
                      render 'image',
                      image: block.settings.popup_image,
                      widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                      src_width: 1400,
                      src_placeholder: true,
                      sizes: sizes,
                      alt: block.settings.heading,
                      lazy_load: lazy_load_images,
                      class: img-fit hidden sm:block
                    -%}
                  {% endif %}
                </div>
              {% else %}
                {%- liquid
                  assign placeholder_class = 'media__placeholder'
                  unless section.settings.image_ratio == 'natural'
                    assign placeholder_class = placeholder_class | append: ' img-fit'
                  endunless
                -%}
                {{- 'image' | placeholder_svg_tag: placeholder_class -}}
              {% endif %}
              <div
                class="card__info flex flex-col flex-auto items-start pt-6{% if section.settings.column_align == 'center' %} text-center items-center{% endif %}"
                {% if block.settings.card_bg != blank %}
                  style="background-color: {{ block.settings.card_bg }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank -%}
                  <{{ block.settings.cart_title_size }} class="card__title {% if block.settings.font_weight != blank %}font-weight{% endif %}">
                    {{- block.settings.heading | escape -}}
                  </{{ block.settings.cart_title_size }}>
                {%- endif -%}

                {% if block.settings.button_modal != false and block.settings.button_label != blank %}
                  <div class="section__block section-btn container flex justify-center mt-6 mb-4">
                    <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                      <button
                        id="openModal"
                        type="button"
                        class="btn popup-btn {{ block.settings.button_style }}"
                        aria-haspopup="dialog"
                        {% if block.settings.is_nofollow != false %}
                          rel="nofollow"
                        {% endif %}
                      >
                        {{- block.settings.button_label -}}
                      </button>
                    </modal-opener>
                  </div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {%- if carousel -%}
    </div>
    {%- if settings.slider_show_arrows == 'never' -%}
      <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
        <button
          type="button"
          class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon"
          name="next"
          aria-controls="slider-{{ section.id }}"
        >
          <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
          {% render 'icon-chevron-right' %}
        </button>
        <button
          type="button"
          class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon"
          name="prev"
          aria-controls="slider-{{ section.id }}"
        >
          <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
          {% render 'icon-chevron-left' %}
        </button>
      </div>
    {%- endif -%}
    </div>
    </carousel-slider>
  {%- endif -%}
</div>

{% if section.settings.show_popup != blank %}
  {% liquid
    assign popup_content = section.settings.cur_liquid
    assign click_id = section.settings.click_id
  %}
  {% style %}
    .popup-btn-box {
      display: flex;
      margin: 2em auto;
      justify-content: center;
    }
  {% endstyle %}

  <div class="popup-btn-box">
    <button class="{{ section.settings.button_style }}" id="{{ click_id }}">
      {{- section.settings.button_label | escape -}}
    </button>
    {% render 'popup-button', popup_content: popup_content, click_id: click_id %}
  </div>
{% endif %}

{% if section.settings.show_pop != blank %}
  {{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
  {{ 'popup.css' | asset_url | stylesheet_tag }}
  {{ 'modal.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pop-up.js' | asset_url }}" defer="defer"></script>

  <div
    class="rich-popup popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center"
    data-mode
    data-show-on-mobile="true"
  >
    <div
      class="modal__window flex relative bg-theme-bg text-theme-text text-start has-motion flex flex-col"
      role="dialog"
      aria-modal="true"
      tabindex="-1"
    >
      <button type="button" class="modal__close-btn absolute text-current js-close-modal">
        {% render 'icon-close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <div class="flex-auto modal__content modal__content--p-large relative text-left">
        <h5 class="pop-name relative text-center pb-6"></h5>
        <div class="picture-box">
          <img src="" data-src="" alt="" width="100%" height="400px" class="img-fit">
        </div>
        <div class="card__rte card-description flex-auto rte mt-4 mb-4"></div>
      </div>
    </div>
  </div>
  <script>
    var scrollPosition = '';
    $(document).ready(function () {
      $('.rich-popup').removeAttr('open');

      $('.popup-btn').on('click', function (e) {
        $('.rich-popup').attr('open', true);
        var title = $(this).parents('li').attr('data-title');
        var img_url = $(this).parents('li').attr('data-img');
        var description = $(this).parents('li').attr('data-description');

        e.stopPropagation();
        scrollPosition = $(window).scrollTop();

        $('.popup-section .modal__content h5').text(title);
        $('.popup-section .modal__content')
          .find('.picture-box')
          .find('img')
          .attr('src', img_url)
          .attr('data-src', img_url);
        $('.popup-section .modal__content').find('.card-description').html(description);
        var index = $(this).index();
      });

      $('.rich-popup .js-close-modal').on('click', function () {
        $(window).scrollTop(scrollPosition);
        $('.rich-popup').removeAttr('open');
      });
    });

    setTimeout(() => {
      while (!$) {}
    }, 100);
  </script>
{% endif %}

