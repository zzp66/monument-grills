{{ 'swiper.min.css' | asset_url | stylesheet_tag }}

{% style %}
  .autoplay-slider-box .swiper .swiper-wrapper .swiper-slide .card{
    min-height:380px;
  }
  .autoplay-slider-box .swiper .swiper-wrapper .swiper-slide .card .card__media{
    min-height: 180px;
    max-height: 240px;
  }
  .autoplay-slider-box .swiper .swiper-wrapper .swiper-slide .card .card__media img{
    object-fit: contain;
    height: auto;
  }
  .autoplay-slider-box .swiper .swiper-wrapper .swiper-slide .card .card__info{
    padding:15px 10px;
  }
  .swiper-button-prev{
    background-image: url(https://cdn.shopify.com/s/files/1/1639/3511/files/icons8-arrow-left.png?v=1739174540);
  }
  .swiper-button-next{
    background-image: url(https://cdn.shopify.com/s/files/1/1639/3511/files/icons8-arrow-right.png?v=1739174540);
  }
  .swiper-button-next, .swiper-button-prev{
    background-size: 40px 40px;
    width: 44px;
  }
  .autoplay-slider-box .section{
    margin: 0 auto;
  }
  .autoplay-progress {
      position: absolute;
      right: 16px;
      bottom: 16px;
      z-index: 10;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: var(--swiper-theme-color);
    }

    .autoplay-progress svg {
      --progress: 0;
      position: absolute;
      left: 0;
      top: 0px;
      z-index: 10;
      width: 100%;
      height: 100%;
      stroke-width: 4px;
      stroke: var(--swiper-theme-color);
      fill: none;
      stroke-dashoffset: calc(125.6px * (1 - var(--progress)));
      stroke-dasharray: 125.6;
      transform: rotate(-90deg);
    }
  @media (max-width:850px){
    .autoplay-slider-box .swiper .swiper-wrapper .swiper-slide .card .card__media{
      min-height: 140px;
    }
  }
{% endstyle %}

<div class="section {{ section.class }} {% if section.settings.mobile_stacked and section.settings.height_mode != 'screen' %} mobile-stacked mobile-stacked--spaced{% endif %}" id="{{ section.id }}" >
  <div class="section-warp {% if section.settings.full_width %}{% else %} container{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;{% if section.settings.full_width %}{% else %}overflow: hidden;{% endif %}">
    {% if section.settings.header_title != blank %}
      <div class="header-info {{ section.settings.heading_align }}">
        <{{ section.settings.heading_size }} class="mt-4 mt-4 {% if section.settings.use_class_name != blank %}{{ section.settings.use_class_name }}{% endif %}{% if section.settings.header_weight != blank %} font-weight{% endif %} {% if section.settings.header_uppercase != blank %} font-uppercase{% endif %}">{{ section.settings.header_title | escape }}</{{ section.settings.heading_size }}>

        {% if section.settings.add_click != blank %}
          <button id="{{ section.settings.click_id }}" type="button" class="btn popup-btn {{ section.settings.button_style }}">
            {{- section.settings.button_label -}}
          </button>
        {% endif %}

        {% if section.settings.add_target != blank %}
          <a type="button" 
            class="btn popup-btn {{ section.settings.button_style }}" 
            {% if section.settings.button_url != blank %} href="{{ section.settings.button_url }}"{% endif %}
            {% if section.settings.show_popup != blank %} aria-haspopup="dialog"{% endif %} 
            {% if section.settings.add_nofollow != blank %} rel="nofollow"{% endif %} 
            {% if section.settings.add_target != blank %} target="_blank"{% endif %}>
            {{- section.settings.button_label -}}
          </a>
        {% endif %}

        {% if section.settings.show_popup != blank %}
            <div class="section__block section-btn container flex justify-center mt-6 mb-4">
              <modal-opener class="no-js-hidden" data-modal="modal-{{ section.id }}">
                <button id="{{ section.settings.click_id }}" 
                  type="button" 
                  class="btn popup-btn {{ section.settings.button_style }}" 
                  aria-haspopup="dialog">
                  {{- section.settings.button_label -}}
                </button>
              </modal-opener>
            </div>
        {% endif %}
      
      </div>
    {% endif %}

    <div class="swiper mySwiper relative mt-2 mb-2">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %} {% if section.settings.wrapper_bg != blank %} style="background-color: {{ section.settings.wrapper_bg }};"{% endif %}>
              <div class="card{% if block.settings.round %} image-round {% endif %} relative flex flex-col">
                {% if block.settings.enable_media != blank %}
                   <div class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}" data-swiper-parallax="-100" style="{% if section.settings.image_ratio == "natural" %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}">
                     {%- if block.settings.image != blank %}
                          {%- liquid
                            assign img = block.settings.image

                            if section.index == 1 or section.settings.prevent_animation
                              assign lazy_load_images = false
                            else
                              assign lazy_load_images = true
                            endif
                            
                            if section.settings.full_width
                              if section.settings.height_mode == 'screen'
                                assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                              endif
                            else
                              capture sizes
                                render 'sizes-attribute'
                              endcapture
                            endif
                
                            if img != blank
                              assign desktop_image_class = 'img-fit sm:block'
                            else
                              assign desktop_image_class = 'img-fit'
                            endif
                          -%}
                         {%- render 'image',
                            image: block.settings.image,
                            widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                            src_width: 980,
                            src_placeholder: true,
                            sizes: sizes,
                            alt: block.settings.img_alt,
                            lazy_load: lazy_load_images,
                            class: desktop_image_class
                          -%}
                      {% endif %}
                   </div>
                 {% else %}
                   {%- liquid
                      assign placeholder_class = "media__placeholder"
                      unless section.settings.image_ratio == "natural"
                        assign placeholder_class = placeholder_class | append: " img-fit"
                      endunless
                    -%}
                    {{- 'image' | placeholder_svg_tag: placeholder_class -}}
                 {% endif %}

                 <div class="card__info flex flex-col flex-auto items-start pt-6{% if section.settings.text_align == 'center' %} text-center items-center{% endif %}" data-swiper-parallax="-200">
                   {%- if block.settings.heading != blank -%}
                      <{{ block.settings.title_size }} class="card__title mb-2{% if block.settings.font_weight != blank %} font-weight{% endif %}">{{ block.settings.heading | escape }}</{{ block.settings.title_size }}>
                    {%- endif -%}

                   {% if block.settings.card_description != blank %}
                      {{ block.settings.card_description }}
                   {% endif %}

                   {% if block.settings.button_label != blank %}
                      <a type="button" 
                        class="btn popup-btn {{ block.settings.button_style }}" 
                        {% if block.settings.button_url != blank %} href="{{ block.settings.button_url }}"{% endif %}
                        {% if block.settings.add_target != blank %} target="_blank"{% endif %}>
                        {{- block.settings.button_label -}}
                      </a>
                   {% endif %}
                 </div>
                
              </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_navigation_btn != blank %}
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      {% endif %}
  
      {% if section.settings.show_pagination_btn != blank %}
        <div class="swiper-pagination"></div>
      {% endif %}
  
      {% if section.settings.show_autoplay_progress != blank %}
        <div class="autoplay-progress">
          <svg viewBox="0 0 48 48">
            <circle cx="24" cy="24" r="20"></circle>
          </svg>
          <span></span>
        </div>
      {% endif %}
    </div>
          
  </div>
</div>

          
  
  {% liquid
    assign loop = section.settings.is_loop
    if loop
       assign show_loop = true
    else
       assign show_loop = false
    endif
  %}
                        
  <script src="{{ 'swiper.min.js' | asset_url }}" ></script>  
  <script>
     setTimeout(() => {
      while (!Swiper) {}

      const progressCircle = document.querySelector(".autoplay-progress svg");
      const progressContent = document.querySelector(".autoplay-progress span");
      
      var swiper = new Swiper(".mySwiper", {
        height:576,
        slidesPerView: 3,
        spaceBetween: 30,
        loop: {{ show_loop }},
        lazy: {
            loadPrevNext: true,
            loadPrevNextAmount: 3,
        },
        breakpoints: {
          320: {
            slidesPerView: 1,
            spaceBetween: 10
          },
          480: {
            slidesPerView: 1.5,
            spaceBetween: 10
          },
          640: {
            slidesPerView: 1.5,
            spaceBetween: 10
          }
        },
        pagination: {
          el: ".swiper-pagination",
          clickable: true
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev"
        },
        on: {
          autoplayTimeLeft(s, time, progress) {
            progressCircle.style.setProperty("--progress", 1 - progress);
            progressContent.textContent = `${Math.ceil(time / 1000)}s`;
          }
        }
      });
          
      window.onresize = function () {
      swiper.update();
    };
    },150);
    
  </script>
          
