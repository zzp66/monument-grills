<style>
  .EarnPoints_sec {
    background: #F6F6F6;
    padding: 60px 0 80px;
    text-align: center;
    margin-bottom: 80px;
}
  .EarnPoints-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}
  .EarnPoints-item {
    background: #fff;
    padding: 30px 0;
}
  .EarnPoints-item img {
    width: 65px;
    margin-bottom: 20px;
}
  .EarnPoints_wrapper h3 {
    color: #BC0F0F;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 5px;
}
  .EarnPoints_info p {
    color: #0C0C0C;
    margin: 0;
}
  .EarnPoints-item-none {
    display: flex;
    align-items: center;
    flex-flow: column;
    justify-content: center;
    gap: 10px;
}
  @media(max-width:991px){
.EarnPoints-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}
    .EarnPoints_wrapper h3 {
    font-size: 18px;
}
    .EarnPoints_info p {
   
    font-size: 14px;
}
    .EarnPoints-item img {
    width: 45px;
}
    .EarnPoints_sec {
    padding: 40px 0 40px;
    margin-bottom: 40px;
}
  }
</style>
<section class="EarnPoints_sec" style="display:" id="EarnPoints_sec">
  <div class="container">

  <h2 class="EarnPoints_title">{{ section.settings.head }}</h2>
  <div class="EarnPoints_container">
        <div class="EarnPoints-wrapper">
          {% for block in section.blocks %}
            <a href="/pages/monument-grills-rewards-program#smile-points-activity-rules" class="EarnPoints-item">
                <img src="{{ block.settings.image | img_url:'master' }}" />
                <div class="EarnPoints_wrapper">
                  <h3>{{ block.settings.title }}</h3>
                  <div class="EarnPoints_info">{{ block.settings.content }}</div>
                </div>
            </a>
          {% endfor %}
           <div class="EarnPoints-item-none">
                <img src="https://cdn.shopify.com/s/files/1/1639/3511/files/more.png?v=1747731743" />
                Expect more
            </div>
        </div>
        
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Ways to Earn Points",
  "class": "cc-earnpoints",
  "settings": [
   
     {
          "type": "text",
          "id": "head",
          "label": "title"
        }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
         {
          "type": "text",
          "id": "title",
          "label": "title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
        
      

        
       
       
      ]
    }
  ],
  "presets": [
    {
      "name": "Ways to Earn Points",
     
    }
  ]
 
}
{% endschema %}
