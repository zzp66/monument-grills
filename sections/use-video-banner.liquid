                  </div>
                
                {%- when 'search_bar' -%}
                  {% if block.settings.search_dom != blank %}
                      <link rel="stylesheet" href="{{ 'predictive-search.css' | asset_url }}"{% unless show_search_types %} media="print" onload="this.media='all'"{% endunless %}>
                      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
                      <script src="{{ 'tabs.js' | asset_url }}" defer="defer"></script>
  
                      <div class="header__search banner__search relative js-closes-menu">
                        {% render 'predictive-search', id: 'support-search', show_search_types: show_search_types, block: block %}
                      </div>
                  {% endif %}
                
                {%- when 'button' -%}
                  {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                    <div class="text-overlay__buttons inline-flex flex-wrap mt-6{% if section.settings.overlay_text_align == 'text-start' %} justify-start{% elsif section.settings.overlay_text_align == 'text-end' %} justify-end{% else %} justify-center{% endif %}{% if section.settings.mob_center_text %} md-down:center{% endif %}" {{ block.shopify_attributes }}>
                      {%- if block.settings.button_1_label != blank %}
                        <a class="{{ block.settings.button_1_style }}" {% if block.settings.button_1_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_1_link }}"{% endif %} style="border-color:{{ block.settings.btn_border_color }};background:{{ block.settings.btn_background_color }};color:{{ block.settings.btn_font_color }};">
                          {{- block.settings.button_1_label | escape -}}
                        </a>
                      {%- endif -%}
                      {%- if block.settings.button_2_label != blank %}
                        <a class="{{ block.settings.button_2_style }}" {% if block.settings.button_2_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_2_link }}"{% endif %} style="border-color:{{ block.settings.btn_border_color }};background:{{ block.settings.btn_background_color }};color:{{ block.settings.btn_font_color }};">
                          {{- block.settings.button_2_label | escape -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
  
                {% when 'timer' %}
                  {% if block.settings.show_timer != blank %}
                    <script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
                    {% style %}
                      #{{ section.id }} .section__block--countdown {
                        --countdown-size: {{ block.settings.countdown_size }};
      
                        {%- assign countdown_size_int = block.settings.countdown_size | plus: 0 -%}
                        {% if countdown_size_int %}
                          --countdown-gap: 0.7em;
                        {% endif %}
      
                        {% if block.settings.use_custom_colors %}
                          .countdown__item .countdown__number{
                            background:{{ block.settings.count_color }};
                            color:{{ block.settings.bg_color.rgb }};
                          }
                       
                        {% endif %}
                      }
                    {% endstyle %}
                    <div class="section__block--countdown text-overlay__block{% if block.settings.enlarge_end_text %} countdown-large-endtext{% endif %}" {{ block.shopify_attributes }}>
                      {% render 'countdown-timer',
                        end_date: block.settings.end_date,
                        end_time: block.settings.end_time,
                        end_text: block.settings.end_text,
                        end_midnight: true,
                        hide_on_end: block.settings.hide_on_end
                      %}
                    </div>
                  {% endif %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <!-- video end -->
    </div>
  </div>
      
  
