<style>
  .trusted_section {
    position: relative;
  }
  .trusted_section img {
    width: 100%;
}

  .trusted_box {
    position: absolute;
    width: 31vw;
    height: 12.2vw;
    background: #fff;
    margin: auto;
    left: 0;
    right: 0;
    top: -0.3vw;
    bottom: 0;
    display: flex;
    flex-flow: column;
    align-items: center;
    justify-content: center;
    /* font-size: 46px; */
    font-size: 2.4vw;
    line-height: 1;
        gap: 8px;
        font-weight: bold;
}
  h3.trusted_title {
    /* font-size: 72px; */
    font-size: 3.75vw;
    color: #BC0F0F;
    font-weight: bold;
    line-height: 1;
        margin: 0;
}
  .trusted_subtitle em {
    font-style: normal;
    font-weight: 400;
}
  @media(max-width:991px){
    .trusted_section img {
    height: 260px;
    object-fit: cover;
}
    .trusted_box {
    width: 250px;
    height: 150px;
    top: 0;
    font-size: 16px;
}
    h3.trusted_title {
    font-size: 34px;
}
  }
</style>
<section class="trusted_section">
  <img src="{{ section.settings.image | img_url:'master' }}" />
  <div class="trusted_box">
    <div class="trusted_subtitle">{{ section.settings.subtitle }}<em> BY</em></div>
    <h3 class="trusted_title">{{ section.settings.number }}</h3>
    <div class="trusted_desc">{{ section.settings.desc }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Trusted",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "subtitle"
    },
    {
      "type": "text",
      "id": "number",
      "label": "number"
    },
    {
      "type": "text",
      "id": "desc",
      "label": "desc"
    }
    
  ],
  "presets": [
    {
      "name": "Trusted"
    }
  ]
}
{% endschema %}