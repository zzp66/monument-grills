<style>
  .anniversary-9th-review {
    padding: 60px 0;
  }
  p.review-title {
    color: #000;
    font-size: 42px;
    font-weight: bold;
    margin: 0;
    text-align: center;
  }
  p.review-info {
    text-align: center;
    color: #000;
    margin: 0;
    margin-top: 10px;
    margin-bottom: 40px;
  }
  .review-content {
    display: grid;
    grid-template-columns: 35% 65%;
    gap: 6px;
  }
  .review-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .review-media {
    border-radius: 10px;
    overflow: hidden;
  }
  .review-media-img {
    width: 100%;
    height: 100%;
  }
  .review-media-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .review-item {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
  }
  .review-item-img {
    padding-top: 10px;
    background: #f6f6f6;
  }
  .review-item-content {
    padding: 20px 15px 35px;
    display: flex;
    flex-direction: column;
  }
  p.review-product-title {
    font-size: 14px;
    font-weight: bold;
    margin: 0;
  }
  p.review-product-title span {
    color: #e55420;
  }
  .review-ring {
    display: flex;
    margin: 5px 0;
  }
  .review-ring img {
    max-height: 14px;
    width: auto;
  }
  p.review-item-title {
    text-align: left;
    font-size: 14px;
    margin: 0;
  }
  p.review-item-info {
    text-align: left;
    font-size: 12px;
    color: #928f8f;
    margin: 0;
  }
</style>
<div class="anniversary-9th-review section">
  <div class="container">
    <p class="review-title">MONUMENT GRILLS FANS</p>
