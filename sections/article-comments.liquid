{% style %}
.cc-article-comments{
  border-top:1px solid #eee;
   background: {{ section.settings.comments_background }} !important;
 }
  .cc-article-comments .form__field input.input,
  .cc-article-comments .form__field textarea.input{
    border-radius: 4px !important;
    border: 1px solid rgb(221, 221, 221);
  }
  .cc-article-comments form{
    background: #f9f9f9;
    padding: 2em;
  }
{% endstyle %}
<div class="{% if section.settings.full_screen %}full-screen-comments{% else %} container{% endif %}">
  <div class="section__header"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
    {% if section.settings.comments_title != blank %}
      <{{ section.settings.comments_title_size }} class="section__heading mb-0 flex-auto flex flex-wrap gap-x-theme {% if section.settings.comments_title_align == 'text-start' %} justify-start{% elsif section.settings.comments_title_align == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
        {{- section.settings.comments_title | escape -}}
      </{{ section.settings.comments_title_size }}>
    {% endif %}
  </div>
  {%- if blog.comments_enabled? -%}
    <div id="comments" class="relative top-header-offset"></div>
    {% comment %}
    <div class="reading-width article-width mt-12">
    {% endcomment %}
    <div class="article-width mt-12">
      {%- if article.comments_count > 0 -%}
        <h2 class="h6 mb-8" id="comments-{{ article.id }}">
          {{- 'blogs.article.comments' | t: count: article.comments_count -}}
        </h2>
        {%- paginate article.comments by section.settings.comments_per_page -%}
          <div class="article__comments mb-16">
            {%- if comment.status == 'pending' and comment.content -%}
              <article class="comment" id="{{ comment.id }}">
                {{ comment.content }}
                <footer class="comment__footer">
                  <span class="comment__author">{{ comment.author }}</span>
                </footer>
              </article>
            {%- endif -%}

            {%- for comment in article.comments -%}
              <article class="comment" id="{{ comment.id }}">
                {{ comment.content }}
                <footer class="comment__footer">
                  <span class="comment__author">{{ comment.author }}, </span>
                  <span class="">{{ comment.created_at | time_tag: format: 'date' }}</span>
                </footer>
              </article>

              {%- unless forloop.last -%}
                <hr class="mb-8">
              {%- endunless -%}
            {%- endfor -%}

            {%- render 'pagination', paginate: paginate, class: 'mt-10', pagination_suffix: '#comments' -%}
          </div>
        {%- endpaginate -%}
      {%- endif -%}

      {% form 'new_comment', article, class: 'form reading-width' %}
        <h2 class="h6{% unless blog.moderated? %} mb-8{% endunless %}">{{ 'blogs.comments.form_title' | t }}</h2>
        {%- if blog.moderated? -%}
          <p class="mb-8">{{ 'blogs.comments.moderated' | t }}</p>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="alert mb-8 bg-success-bg text-success-text" role="status">
            {%- if blog.moderated? and comment.status == 'unapproved' -%}
              {{ 'blogs.comments.success_moderated' | t }}
            {%- else -%}
              {{ 'blogs.comments.success' | t }}
            {%- endif -%}
          </div>
        {%- elsif form.errors -%}
          <div class="alert mb-8 bg-error-bg text-error-text" role="alert">
            <h2 class="h6 text-current">{{ 'blogs.comments.error_heading' | t }}</h2>
            <ul class="styled-list">
              {%- for field in form.errors -%}
                <li>
                  <a class="link text-current" href="#comment-{{ field }}">
                    {%- if form.errors.translated_fields[field] contains 'author' %}
                      {{- 'blogs.comments.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' %}
                      {{- 'blogs.comments.message' | t }}
                    {%- else %}
                      {{- form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="form__field required">
          <label class="label" for="comment-author">{{ 'blogs.comments.name' | t }}</label>
          <input type="text"
                 class="input w-full"
                 id="comment-author"
                 name="comment[author]"
                 autocomplete="name"
                 value="{{ form.author }}"
                  {%- if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="comment-author-error"
                  {% endif -%}
                 aria-required="true"
                 required>
          {%- if form.errors contains 'author' -%}
            <p class="form__field-error" id="comment-author-error">
              {{ 'blogs.comments.name' | t }} {{ form.errors.messages['author'] }}
            </p>
          {%- endif -%}
        </div>

        <div class="form__field required">
          <label class="label" for="comment-email">{{ 'blogs.comments.email' | t }}</label>
          <input type="email"
                 class="input w-full"
                 id="comment-email"
                 name="comment[email]"
                 autocomplete="email"
                 value="{{ form.email }}"
                  {%- if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="comment-email-error"
                  {% endif -%}
                 aria-required="true"
                 required>
          {%- if form.errors contains 'email' -%}
            <p class="form__field-error" id="comment-email-error">
              {{ 'blogs.comments.email' | t }} {{ form.errors.messages['email'] }}
            </p>
          {%- endif -%}
        </div>

        <div class="form__field required">
          <label class="label" for="comment-body">{{ 'blogs.comments.message' | t }}</label>
          <textarea class="input w-full"
                    id="comment-body"
                    name="comment[body]"
                    rows="5"
                      {%- if form.errors contains 'body' %}
                        aria-invalid="true"
                        aria-describedby="comment-body-error"
                      {% endif -%}
                      aria-required="true"
                    required>{{ form.body }}</textarea>
          {%- if form.errors contains 'body' -%}
            <p class="form__field-error" id="comment-body-error">
              {{ 'blogs.comments.message' | t }} {{ form.errors.messages['body'] }}
            </p>
          {%- endif -%}
        </div>

        <div class="mt-6">
          <button class="btn btn--primary w-full md:w-auto">{{ 'blogs.comments.post' | t }}</button>
        </div>
      {% endform %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Article comments",
  "class": "cc-article-comments section",
  "settings": [
     {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Top",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Padding Button",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "full_screen",
        "label": "Full screen",
        "default": false
      },
    {
      "type": "color",
      "id": "comments_background",
      "label": "Comments background"
    },
    {
      "type": "text",
      "id": "comments_title",
      "label": "Comments title"
    },
    {
      "type": "select",
      "id": "comments_title_align",
      "label": "Title alignment",
      "options": [
        {
          "value": "text-start",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-end",
          "label": "Right"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "comments_title_size",
      "label": "Comments title size",
      "options": [
        {
          "value": "h6",
          "label": "Extra extra small"
        },
        {
          "value": "h5",
          "label": "Extra small"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h0",
          "label": "Extra extra large"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "comments_per_page",
      "label": "Comments per page",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 16
    }
  ]
}
{% endschema %}
