{%- comment -%}theme-check-disable LiquidTag{%- endcomment -%}

{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'product-comparison-grid.css' | asset_url }}" media="print" onload="this.media='all'">
  {% if section.settings.only_text != blank %}
  <link rel="stylesheet" href="{{ 'mobile-product-comparison-grid.css' | asset_url }}" media="print" onload="this.media='all'">
  {% endif %}
{%- else -%}
  {{ 'product-comparison-grid.css' | asset_url | stylesheet_tag }}
  {% if section.settings.only_text != blank %}
  {{ 'mobile-product-comparison-grid.css' | asset_url | stylesheet_tag }}
  {% endif %}
{%- endif -%}

{%- liquid
  assign breakpoint_sm = 600
  assign breakpoint_md = 769
  assign breakpoint_xxl = 1536
  assign breakpoint_sm_down = breakpoint_sm | minus: 0.02
  assign head_block = section.blocks | where: "type", "product" | first
  if head_block.settings.show_image
    if section.settings.product_list.count < 3
      capture sizes
        render 'sizes-attribute', grid: true, min: 2
      endcapture
    elsif section.settings.product_list.count == 3
      capture sizes
        render 'sizes-attribute', grid: true, min: 2, sm: 2, lg: 3
      endcapture
    elsif section.settings.product_list.count == 4
      capture sizes
        render 'sizes-attribute', grid: true, min: 2, md: 3, lg: 4
      endcapture
    elsif section.settings.product_list.count == 5
      capture sizes
        render 'sizes-attribute', grid: true, min: 2, md: 3, lg: 4, xl: 5
      endcapture
    endif

    if section.settings.image_ratio != blank
      if section.settings.image_ratio == 'shortest'
        assign image_ratio = 0
        for product in section.settings.product_list
          if product.featured_media.preview_image.aspect_ratio > image_ratio
            assign image_ratio = product.featured_media.preview_image.aspect_ratio
          endif
        endfor
      elsif section.settings.image_ratio == 'tallest'
        assign image_ratio = 99
        for product in section.settings.product_list
          if product.featured_media.preview_image.aspect_ratio < image_ratio
            assign image_ratio = product.featured_media.preview_image.aspect_ratio
          endif
        endfor
      else
        assign image_ratio = section.settings.image_ratio
      endif
    endif
  endif

  if section.settings.product_list.count > 0
    assign num_columns = section.settings.product_list.count
  else
    # number of columns for onboarding
    assign num_columns = 4
  endif

   if section.settings.height_mode == 'screen'
      assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
   endif
-%}

{% style %}
  .table-box table tbody tr:hover{
    background: #f9f9f9;
  }
  .table-box table tbody tr:hover td{
    font-weight: bold;
    color:#c00000;
  }
  .table-box table thead tr{
    background: #f9f9f9;
  }
  .table-box table thead tr th{
    font-weight: bold;
    font-size: 18px;
  }

  
  {% if section.settings.only_text != blank %}
    @media (max-width:768px){
     .table-box table{
       width:100%;
       min-width:100%;
       border:none;
     }
      .table-box table thead tr{
        background:#111;
      }
      .table-box table thead tr th{
        color:#f9f9f9;
      }
    .table-box table tbody tr,
    .table-box table thead tr{
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid #eee;
    }
    .table-box table tbody tr td:nth-child(1),
    .table-box table thead tr th:nth-child(1){
      padding-bottom:0;
      padding-top:10px;
      font-weight: bold;
      font-size: 18px;
      border: 0;
    }
    .table-box table tbody tr td:nth-child(2),
    .table-box table thead tr th:nth-child(2){
      padding-bottom:10px;
      padding-top:0;
        border: 0;
    }
    .table-box table tbody tr:nth-child(even){
      background:{{ section.settings.table_tr_bg }};
    }
  }
  {% endif %}
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <div class="section">
    <div class="container table-box">
        <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_size }} class="section__heading mb-0 flex-auto {{ section.settings.heading_align }}">
              {{- section.settings.heading | escape -}}
            </{{ section.settings.heading_size }}>
          {%- endif -%}
        </div>
      
        {%- if section.settings.text != blank -%}
          <div class="flex {{ section.settings.heading_align }}{% if section.settings.heading_align == "text-start" %} justify-start{% elsif section.settings.heading_align == "text-center" %} justify-center{% elsif section.settings.heading_align == "text-end" %} justify-end{% endif %}">
            <div class="rte product-comparison-text mb-6"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
              {{- section.settings.text -}}
            </div>
          </div>
        {%- endif -%}
      
        <table class="table-fixed w-full h-full mt-2 lg:mt-0 {% if section.settings.only_text != blank %} cc-mobile-tabel{% endif %}" data-num-products="{{ section.settings.product_list.count }}">
          <thead>
              <tr>
                {% for aa in section.blocks %}
                  {% case aa.type %}
                  {% when 'table-th' %}
                    {% if aa.settings.use_img != blank %}
                      {% liquid
                        if section.settings.prevent_animation
                          assign lazy_load_images = false
                        else
                          assign lazy_load_images = true
                        endif

                        assign desktop_image_class = 'img-fit sm:block'
                      %}
                      {% style %}
                        table thead th::after{
                          content:"" !important;
                        }
                        table thead th{
                          /* display: flex;
                          flex-direction: column;
                          justify-content: center;
                          align-items: center; */
                        }
                        table thead th .icon-media img{
                          position: relative;
                        }
                      {% endstyle %}
                      <th class="product-comparison-grid__sticky">
                        {% if aa.settings.use_img != blank %}
                          <div class="icon-media">
                            {% if aa.settings.th_img != blank %}
                              {%- render 'image',
                                image: aa.settings.th_img,
                                widths: '120, 240, 360, 480',
                                src_width: 240,
                                src_placeholder: true,
                                sizes: sizes,
                                lazy_load: lazy_load_images,
                                class: desktop_image_class
                              -%}
                            {% else %}
                              {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit dark' }}
                            {% endif %}
                          </div>
                          <span>{{ aa.settings.th_img_title }}</span>
                        {% endif %}
                      </th>
                    {% else %}
                      <th class="product-comparison-grid__sticky">{{ aa.settings.th_name }}</th>
                    {% endif %}
                  {% endcase %}
                {% endfor %}
              </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                  {%- when 'table-tr' -%}
                  <tr {{ block.shopify_attributes }}>
                    {% if block.settings.tr_name_1 != blank %}
                      <td>{{ block.settings.tr_name_1 }}</td>
                    {% endif %}
                    {% if block.settings.tr_name_2 != blank %}
                      <td>{{ block.settings.tr_name_2 }}</td>
                    {% endif %}
                    {% if block.settings.tr_name_3 != blank %}
                      <td>{{ block.settings.tr_name_3 }}</td>
                    {% endif %}
                    {% if block.settings.tr_name_4 != blank %}
                      <td>{{ block.settings.tr_name_4 }}</td>
                    {% endif %}
                  </tr>
              {%- endcase -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
  </div>
{%- endif -%}

{% schema %}
{
