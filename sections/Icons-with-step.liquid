            },
            {
              "value": "2",
              "label": "Scheme 2"
            },
            {
              "value": "3",
              "label": "Scheme 3"
            }
          ],
          "default": "white"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
