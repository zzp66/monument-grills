          "id": "btn_color",
          "label": "Btn Color"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color scheme",
          "options": [
            {
              "value": "white",
              "label": "Transparent background"
            },
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "1",
