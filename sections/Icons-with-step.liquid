{%- if section.blocks.size > 0 -%}
  {%- if section.index > 2 and section.location != "header" -%}
    <link rel="stylesheet" href="{{ 'icons-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- else -%}
    {{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- liquid
    assign color_scheme = section.settings.color_scheme
    assign grid_classes = 'auto-cols-1'
    if section.blocks.size == 2
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 icons-with-text--narrow'
    elsif section.blocks.size == 3
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 md:auto-cols-3'
    elsif section.blocks.size > 3
      assign grid_classes = grid_classes | append: ' sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4'
    endif
  -%}

  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  <div class="icons-with-text section{% if section.settings.full_width %} section--full-width{% if section.settings.dividers != "none" %} {{ section.settings.dividers }}{% endif %}{% endif %} section--padded-{{ section.settings.section_height }}" id="{{ section.id }}" style="background: {{ section.settings.bg }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    <div class="hide" id="{% if section.settings.link_id != blank %}{{ section.settings.link_id }}{% endif %}"></div>
    <div class="container relative">
      {%- if section.settings.heading != blank -%}
        <h2 class="h4 section__heading {% if section.settings.font_weight != blank %} font-weight{% endif %} {{ section.settings.heading_align }} {% if section.settings.font_weight != blank %} font-blod{% endif %}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %}>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <carousel-slider class="carousel block relative" inactive{% if section.settings.mobile_stack %} disable-mobile="true"{% endif %}>
        <div class="slider-nav slide-nav--inline flex justify-between absolute top-0 h-full no-js-hidden">
          <button type="button" class="slider-nav__btn tap-target tap-target--left btn text-current has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
            <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
            {% render 'icon-chevron-left' %}
          </button>
          <button type="button" class="slider-nav__btn tap-target tap-target--right btn text-current has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
            <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
            {% render 'icon-chevron-right' %}
          </button>
        </div>

        <div class="slider slider--contained relative slider--no-scrollbar" id="slider-{{ section.id }}">
          <ul class="slider__grid grid grid-flow-col gap-theme {{ grid_classes }} {% if section.settings.show_all_on_mobile %} show-all-mobile{% endif %} {% if section.settings.show_online_display %} mobile-online{% endif %}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign is_link = true
                if block.settings.text contains "<a" or block.settings.link == blank
                  assign is_link = false
                endif

                assign index = section.blocks.size
                assign img = block.settings.custom_icon
                assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'

                capture sizes
                  render 'sizes-attribute'
                endcapture

                if section.index == 1 or section.settings.prevent_animation
                  assign lazy_load_images = false
                else
                  assign lazy_load_images = true
                endif

                if img != blank
                  assign desktop_image_class = 'img-fit sm:block'
                else
                  assign desktop_image_class = 'img-fit step-img'
                endif
              
              -%}
              <li class="slider__item{% unless is_link %} flex{% if section.settings.icon_position == 'above' %} flex-col{% endif %} justify-center items-center{% endunless %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="step-box" data-index="{{ index }}">
                  <div class="step-bg">
                    {%- render 'image',
                      image: img,
                      widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                      src_width: 480,
                      src_placeholder: true,
                      sizes: sizes,
                      lazy_load: lazy_load_images,
                      class: desktop_image_class
                    -%}
                  </div>
                  <div class="step-info">
                    <span class="step-tag">Step {{ forloop.index }}</span>
                    <h6>{{ block.settings.heading }}</h6>
                    <p>{{ block.settings.step_des }}</p>
                    {% if block.settings.button_label != blank %}
                      <a class="{{ block.settings.button_style }} {% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                          {{- block.settings.button_label -}}
                      </a>
                    {% endif %}
                  </div>
                </div>
                {% style %}
                  {% if img != blank %}
                      .font-weight{
                        font-weight:bold;
                      }
                     #{{ section.id }} .step-box{
                        width: 100%;
                        display:flex;
                        position: relative;
                      }
                     #{{ section.id }} .step-box .step-bg{
                        width: 72.5vh;
                        height: 100%;
                        overflow: hidden;
                      }
                     #{{ section.id }} .step-box .step-bg img{
                        position: relative;
                        object-fit: contain;
                        height:auto;
                        max-width:100%;
                      }
                     #{{ section.id }} .step-box .step-info{
                        position: absolute;
                        width: 70%;
                        height: 100%;
                      }
                     #{{ section.id }} .step-box .step-info .step-tag{
                        position: relative;
                        top: -2px;
                        margin-bottom: 2em;
                        display: inline-block;
                        padding: 4px 10px;
                        background: #c00000;
                        font-size: 12px;
                        color: #fff;
                        border-bottom-right-radius: 10px;
                      }
                      #{{ section.id }} .step-box .step-info h6{
                        font-size: 20px;
                        padding: 6px 20px;
                        font-weight: bold;
                      }
                      #{{ section.id }} .step-box .step-info p{
                        padding: 6px 20px;
                        font-size: 16px;
                      }
                      #{{ section.id }} .step-box .step-info a.link{
                        display: inline-block;
                        padding: 6px 20px;
                        font-size: 16px;
                        color:{{ block.settings.btn_color }};
                      }
                      @media (max-width:1200px){
                        #{{ section.id }} .step-box .step-info h6,
                        #{{ section.id }} .step-box .step-info p{
                          padding-bottom: 0;
                          margin-bottom: 0;
                        }
                      }
                      @media (max-width:970px)and(min-width:850px){
                        #{{ section.id }} .step-box .step-info h6{
                          font-size:18px;
                        }
                        #{{ section.id }} .step-box .step-info p,
                        #{{ section.id }} .step-box .step-info a.link{
                          font-size:14px;
                        }
                      }
                  {% endif %}
               {% endstyle %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </carousel-slider>
    </div>
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Icons with step -- wenfei",
  "tag": "section",
  "class": "cc-icons-with-step",
  "settings": [
    {
      "type": "header",
