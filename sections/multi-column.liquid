{%- comment -%}theme-check-disable LiquidTag{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- liquid
    # constants
    assign breakpoint_sm = 600
    assign breakpoint_md = 769
    assign breakpoint_lg = 1024
    

    if section.index == 1 or section.settings.prevent_animation
      assign lazy_load_images = false
    else
      assign lazy_load_images = true
    endif

    if section.settings.layout == 'carousel'
      assign carousel = true
      if section.settings.column_size == 'small'
        assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4 '
      elsif section.settings.column_size == 'medium'
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2 lg:auto-cols-3'
      else
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2'
      endif

    else
      assign carousel = false
    endif

    assign color_scheme = section.settings.color_scheme

    if section.settings.image_ratio == 'shortest'
      assign image_ratio = 0
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio > image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    elsif section.settings.image_ratio == 'tallest'
      assign image_ratio = 99
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio < image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    else
      assign image_ratio = section.settings.image_ratio
    endif
  -%}
  {% style %}
    .multi-column-carousel .multi-column-carousel-box ul{
      grid-gap: 30px 30px;
    }
  {% endstyle %}
  
  {%- if carousel == false -%}
    {% style %}
      {% if section.settings.column_size == 'small' %}
        @media (min-width: {{ breakpoint_sm }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .multi-column {
            width: calc(25% - var(--column-gap));
          }
        }
      {% else %}
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        {% if section.settings.column_size == 'medium' %}
          @media (min-width: {{ breakpoint_lg }}px) {
            #{{ section.id }} .multi-column {
              width: calc((100% / 3) - var(--column-gap));
            }
          }
        {% endif %}
      {% endif %}
    {% endstyle %}
  {% else %}
    
  {%- endif -%}
  {% style %}
    /* .left-to-right{
      display: flex;
      flex-direction: row-reverse;
    }
     .left-to-right .main-display-font{
       margin-left:10px;
       margin-right: 0;
     } */
    /* .section.section-bg{
        background:#111;
      } */
     #{{ section.id }} .multiple-text{
       display:flex;
       align-items: center;
       width:100%;
     }
    #{{ section.id }} .multiple-text .main-display-font{
      margin-bottom:0;
      margin-right: 10px;
      white-space: nowrap;
    }
    #{{ section.id }} .multi-column-carousel .slider{
      scrollbar-color: #c00000 #ddd;
      border-radius: 4px;
      padding-bottom:0;
    }
    .section.section-bg h2{
      color:{{ section.settings.font_c }};
      max-width: 80%;
    }
     #{{ section.id }} .card{
       background: {{ section.settings.column_bg_color }};
     }
    #{{ section.id }} .card .card__info .card__title,
    #{{ section.id }} .card .card__info .card__rte{
      color: {{ section.settings.column_text_color }};
    }
    #{{ section.id }} .card .card__info .card__title{
      display: block;
      width: 100%;

    }
    #{{ section.id }} .card .card__info .card__rte{
      margin-bottom:0;
    }
    {% if section.settings.enable_text_on_image != blank %}
      #{{ section.id }} .card.text-on-image .card__info{
        backdrop-filter: blur(4px);
        background-color: rgb(0 0 0 / 10%);
        padding: 1em;
      }
    {% endif %}

    @media (min-width:1921px){
     
      #{{ section.id }} .card .card__info .card__rte{
        font-size:1.5em;
         display: flex;
        align-items: flex-start;
      }
    }
    
    {% if section.settings.column_font_glow != blank %}
      #{{ section.id }} .card .card__info .card__title.column-font-glow{
        margin-bottom:0;
        text-shadow: 0 0 {{ section.settings.title_one_color_size }}px {{ section.settings.title_one_color }}, 0 0 {{ section.settings.title_two_color_size }}px {{ section.settings.title_two_color }}, 0 0 {{ section.settings.title_four_color_size }}px {{ section.settings.title_four_color }};
      }
    {% endif %}}
     #{{ section.id }} .card.text-top{
        flex-direction: column-reverse;
        background: {{ section.settings.column_bg_color }};
      }
     #{{ section.id }} .card.text-top .card__info{
        color: {{ section.settings.column_text_color }};
      }
    #{{ section.id }} .card.text-on-image{
      height:auto;
    }
     #{{ section.id }} .card.text-on-image .card__info{
        position: absolute;
        bottom: 0;
       width:100%;
     }
    {% if section.settings.three_column != blank %}
      @media (min-width: 1024px) {
      .normal-column-carousel-box ul{
          grid-template-columns: repeat(3, 1fr);
          grid-gap: 20px 20px;
        }
      }
      @media (max-width:768px){
       .normal-column-carousel-box ul{
          grid-auto-columns: 80%;
        }
      }
    {% endif %}}
    {% if section.settings.section.settings.is_title_and_btn_online != blank %}
       #{{ section.id }} .title-button-online .card__info{
         display: flex;
       }
    {% endif %}}
  {% endstyle %}

  <div class="section {% if section.settings.text_on_picture != blank %}section-bg{% endif %}" id="{{ section.id }}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    {%- if section.settings.title != blank or section.settings.button_label != blank -%}
      <div class="{% if section.settings.full_screen %}multi-column-wapr{% else %} container{% endif %}" id="{{ section.settings.link_id }}">
        <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          {%- if section.settings.title != blank -%}
            <{% if section.settings.heading_size != blank %}{{ section.settings.heading_size }}{% else %}h3{% endif %} class="section__heading mb-0 flex-auto {{ section.settings.heading_align }} {% if section.settings.pc_title_font_size %} font-size {% endif %}  {% if section.settings.header_weight %} font-weight {% endif %} {% if section.settings.header_uppercase != blank %} uppercase {% endif %}">
              {{- section.settings.title | escape -}}
            </{% if section.settings.heading_size != blank %}{{ section.settings.heading_size }}{% else %}h3{% endif %}>
            {% style %}
              
              #{{ section.id }} .uppercase{
                text-transform:uppercase;
              }
              #{{ section.id }} .font-weight{
                font-weight:blod;
              }
             
            {% endstyle %}

          
          {% else %}
          {%- endif -%}

          {%- if section.settings.description != blank -%}
              <div class="section__block reading-width--inline md-down:px-gutter rte{% if section.settings.text_align == 'text-start' %} mr-auto{% elsif section.settings.text_align == 'text-end' %} ml-auto{% else %} mx-auto{% endif %}{% if section.settings.enlarge_text %} enlarge-text{% endif %}" {{ section.shopify_attributes }}>
                {{ section.settings.description }}
              </div>
            {%- endif -%}

          {%- if section.settings.btn_label != blank -%}
            <a href="{{ section.settings.btn_link }}" class="{{ section.settings.btn_style }}">{{ section.settings.btn_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if carousel -%}
      {% comment %}
      {% style %}
         #{{ section.id }} .multi-column-carousel .multi-column-carousel-box ul{
            column-gap: 16px;
          }
      {% endstyle %}
      {% endcomment %}
    <carousel-slider class="carousel block" inactive>
      <div class="{% if section.settings.full_screen %}multi-column-carousel{% else %} {% endif %} relative">
        <div class="slider" id="slider-{{ section.id }}">
    {%- endif -%}

      <div class="{% if section.settings.full_screen %}multi-column-carousel-box{% else %}normal-column-carousel-box container{% endif %}">
        <ul class="{% if carousel %}slider__grid grid {{ grid_classes }}{% else %} flex flex-wrap{% endif %} gap-x-theme{% if color_scheme == 'none' and carousel == false %} gap-y-12 md:gap-y-6{% else %} gap-y-6{% endif %}" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              if section.settings.image_ratio == "natural"
                if block.settings.image != blank
                  assign image_ratio = block.settings.image.aspect_ratio
                else
                  assign image_ratio = 1.77
                endif
              endif
            -%}
            {% if forloop.length > 4 %}
              {% style %}
                   #{{ section.id }} .multi-column-carousel .multi-column-carousel-box ul{
                      column-gap: 10px;
                    }
                   @media (max-width: 768px){
                      #{{ section.id }} .multi-column-carousel .multi-column-carousel-box ul{
                        width: 100%;
                        grid-auto-columns: 80%;
                        column-gap: 10px;
                      }
                   }
                {% endstyle %}
            {% else %}
              {% style %}
                   #{{ section.id }} .multi-column-carousel .multi-column-carousel-box ul{
                      column-gap: 30px;
                    }
                    @media (max-width: 768px){
                        #{{ section.id }} .multi-column-carousel .multi-column-carousel-box ul{
                          width: 100%;
                          grid-auto-columns: 80%;
                          column-gap: 10px;
                        }
                     }
                {% endstyle %}
            {% endif %}
            {% if forloop.length == 1 %}
              {% style %}
                .card-full{
                    flex-direction: column;
                    max-width: 100%;
                    height: auto;
                    overflow: hidden;
                    margin: 0 auto;
                }
                .card-full .card__media{
                    padding-top: 0 !important;
                    flex: auto;
                }
                .card-full .card__info{
                    flex: auto;
                    padding: calc(8 * var(--space-unit));
                }
               
                @media (max-width:768px){
                  .card-full{
                    height: auto;
                  }
                  .card-full .card__media{
                    flex: 0 0 50%;
                    min-height: 90vw;
                  }
                }
              {% endstyle %}
              {% if block.settings.image != blank or block.settings.video_shopify != blank %}
                  <li class="multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} " {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                    <div class="card-full{% if block.settings.round %} image-round {% endif %}{% if block.settings.video_shopify != blank %} video-section{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative flex flex-col h-full">
                      {%- if block.settings.enable_media -%}
                        {%- liquid
                          if section.settings.column_size == 'small'
                            assign cols = 3
                          else
                            assign cols = 2
                          endif
                          capture sizes
                            render 'sizes-attribute', grid: true, min: 1, md: cols
                          endcapture
                        -%}
      
                        <div class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}" style="{% unless section.settings.image_ratio == "natural" %}padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;{% endunless %}{% if section.settings.image_ratio == "natural" and block.settings.video_shopify %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}">
                          {%- if block.settings.image != blank or block.settings.video_shopify != blank -%}
                            {%- if block.settings.video_shopify != blank -%}
                              <deferred-media class="media absolute top-0 left-0 w-full h-full">
                                <template>
                                  <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                                   data-autoplay="true"
                                   data-background="true">
                                    {{ block.settings.video_shopify | video_tag: class: 'img-fit promo__mp4 pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                                  </video-component>
                                </template>
                              </deferred-media>
                            {%- endif -%}
      
                            {%- if block.settings.image != blank %}
                              {%- liquid
                                assign image_class = "video-played-hidden"
                                unless section.settings.image_ratio == "natural"
                                  assign image_class = image_class | append: " img-fit"
                                endunless
                                if section.settings.image_ratio == "natural" and block.settings.video_shopify != blank
                                  assign image_class = image_class | append: " img-fit"
                                endif
    
                              -%}
                              
                              {%- render 'image',
                                image: block.settings.image,
                                widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                                src_width: 1400,
                                src_placeholder: true,
                                sizes: sizes,
                                lazy_load: lazy_load_images,
                                class: img-fit hidden sm:block
                              -%}
                              {% comment %}
                              {% render 'image',
                                image: block.settings.image,
                                widths: '460, 700, 860, 1296',
                                src_width: 700,
                                sizes: sizes,
                                section_index: section.index,
                                class: image_class,
                                lazy_load: lazy_load_images
                              %}
                              {% endcomment %}
                            {%- endif -%}
                          {%- else -%}
                            {%- liquid
                              assign placeholder_class = "media__placeholder"
                              unless section.settings.image_ratio == "natural"
                                assign placeholder_class = placeholder_class | append: " img-fit"
                              endunless
                            -%}
                            {{- 'image' | placeholder_svg_tag: placeholder_class -}}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
    
                      <div class="card__info flex flex-col flex-auto items-start pt-6{% if section.settings.column_align == 'center' %} text-center items-center{% endif %}{% if section.settings.is_title_and_btn_online != blank %} title-button-online{% endif %}"
                        >
                         {% if block.settings.heading != blank %}
                              <{{ block.settings.heading_size }} class="card__title ">{{ block.settings.heading | escape }}</{{ block.settings.heading_size }}>
                          {% endif %}
      
                        {%- if block.settings.text != blank -%}
                          <div class="card__rte flex-auto rte">
                            {{ block.settings.text }}
                          </div>
                          {% style %}
                            .card__info ul{
                              margin-left:0;
                            }
                          {% endstyle %}
                        {%- endif -%}

                        {% if block.settings.is_popup_btn != blank and block.settings.button_link != blank %}
                          <div class="section__block section-btn container flex justify-center mt-6 mb-4">
                            <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                              <button type="button" class="popup-btn btn {{ block.settings.button_style }}" aria-haspopup="dialog">
                                {{- block.settings.button_label | escape -}}
                              </button>
                            </modal-opener>
                          </div>
                        {% elsif block.settings.button_link != blank %}
                          <div class="mt-8 card-button{% if section.settings.color_scheme == 'none' and carousel == false %} mb-8{% endif %}">
                            <a class="card__button btn {{ block.settings.button_style }} btn--icon btn--lg has-ltr-icon" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %} {% if block.settings.add_target != blank %} target="_blank"{% endif %} {% if block.settings.is_nofollow != blank %} rel="nofollow"{% endif %}>
                              {%- if block.settings.button_label != blank -%}
                                {{- block.settings.button_label | escape -}}
                              {%- else -%}
                                <span class="visually-hidden">{{ "general.labels.please_select" | t }}{% if block.settings.heading != blank %} {{ block.settings.heading }}{% endif %}</span>
                                {%- render 'icon-arrow-right' -%}
                              {%- endif -%}
                            </a>
                          </div>
                        {% else %}
                        {% endif %}
                      </div>
                    </div>
                  </li>
              {% endif %}
              
            {% else %}
              {% if block.settings.image != blank or block.settings.video_shopify != blank %}
                 <li class="multi-column {% if section.settings.text_on_picture != blank %}text-on-picture{% endif %} grow w-full max-w-none{% if carousel %} slider__item{% endif %} " {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                  {% if section.settings.text_on_picture != blank %}
                     {% style %}
                        .text-on-picture .card .card__media{
                           position: relative;
                        }
                       .text-on-picture .card .card__info{
                          position: absolute;
                          width: 100%;
                          height: auto;
                          left: 50%;
                          top: 50%;
                          z-index: 2;
                          padding:0;
                          transform: translate(-50%, -50%);
                       }
                       .text-on-picture .card .card__info h3{
                         color:#fff;
                         margin: 0;
                         padding: 0 20px;
                       }
                       {% if section.settings.text_on_picture_postion == 'top' %}
                         .text-on-picture .card.info-top .card__info{
                            top:20%;
                         }
                         
                       {% endif %}
                       {% if section.settings.text_on_picture_postion == 'bottom' %}
                         .text-on-picture .card.info-bottom .card__info{
                            bottom:20%;
                         }
                       {% endif %}

                       {% if section.settings.text_on_picture_postion == 'middle' %}
                         .text-on-picture .card.info-middle .card__info{
                            top:50%;
                         }
                       {% endif %}

                       {% if section.settings.text_on_picture_postion == 'top' and block.settings.button_style == 'link' %}
                          .card__button.link{
                            color:#c00000;
                            
                          }
                        {% endif %}
                       
                     {% endstyle %}
                   {% endif %}
                   <{% if block.settings.enable_url != blank %}a{% else %}div{% endif %} class="card{% if block.settings.round %} image-round {% endif %}{% if block.settings.video_shopify != blank %} video-section{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative flex flex-col h-full  {% if section.settings.enable_text_the_top != blank %} text-top{% endif %} {% if section.settings.enable_text_on_image != blank %} text-on-image{% endif %}{% if section.settings.text_on_picture_postion == 'top' %} info-top{% endif %}{% if section.settings.text_on_picture_postion == 'bottom' %} info-bottom{% endif %}{% if section.settings.text_on_picture_postion == 'middle' %} info-middle{% endif %}" style="{% if section.settings.full_screen %}max-width:100%;{% endif %}">
                    {%- if block.settings.enable_media -%}
                      {%- liquid
                        if section.settings.column_size == 'small'
                          assign cols = 3
                        else
                          assign cols = 2
                        endif
                        capture sizes
                          render 'sizes-attribute', grid: true, min: 1, md: cols
                        endcapture
  
                        
                      -%}
    
                      <div class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}" style="{% unless section.settings.image_ratio == "natural" %}padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;{% endunless %}{% if section.settings.image_ratio == "natural" and block.settings.video_shopify %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}">
                        {%- if block.settings.image != blank or block.settings.video_shopify != blank -%}
                          {%- if block.settings.video_shopify != blank -%}
                            <deferred-media class="media absolute top-0 left-0 w-full h-full">
                              <template>
                                <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                                 data-autoplay="true"
                                 data-background="true">
                                  {{ block.settings.video_shopify | video_tag: class: 'img-fit promo__mp4 pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                                </video-component>
                              </template>
                            </deferred-media>
                          {%- endif -%}
    
                          {%- if block.settings.image != blank %}
                            {%- liquid
                              assign image_class = "video-played-hidden"
                              unless section.settings.image_ratio == "natural"
                                assign image_class = image_class | append: " img-fit"
                              endunless
                              if section.settings.image_ratio == "natural" and block.settings.video_shopify != blank
                                assign image_class = image_class | append: " img-fit"
                              endif
  
                              if section.settings.img_alt != 'blank'
                                assign img_alt = block.settings.img_alt
                              endif
                            -%}
                            {% render 'image',
                              image: block.settings.image,
                              widths: '460, 700, 860, 1296',
                              src_width: 700,
                              sizes: sizes,
                              section_index: section.index,
                              class: image_class,
                              lazy_load: lazy_load_images,
                              alt_text:img_alt
                            %}
                          {%- endif -%}
                        {%- else -%}
                          {%- liquid
                            assign placeholder_class = "media__placeholder"
                            unless section.settings.image_ratio == "natural"
                              assign placeholder_class = placeholder_class | append: " img-fit"
                            endunless
                          -%}
                          {{- 'image' | placeholder_svg_tag: placeholder_class -}}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
    
                      <div class="card__info flex flex-col flex-auto items-start pt-6{% if section.settings.column_align == 'center' %} text-center items-center{% endif %}">
                      {% style %}
                      
                       #{{ section.id }} .card .card__info .card__title.title-weight{
                          font-weight:bold;
                        }
                        #{{ section.id }} .multiple-text .text-color{
                          display: flex;
                          align-items: flex-end;
                          height: 32px;
                        }
                       #{{ section.id }} .card .card__info .card__rte.text-color{
                         color: #fff;
                       }
                      {% endstyle %}
                      {%- if block.settings.heading != blank -%}
                        <{{ block.settings.heading_size }} 
                          class="card__title 
                          {% if block.settings.heading_font_weight != blank %}title-weight {% endif %}
                          {% if section.settings.column_font_glow != blank %}column-font-glow {% endif %}
                          {% if block.settings.column_text_align == 'text-start' %}text-start {% elsif block.settings.column_text_align == 'text-center' %}text-center {% elsif block.settings.column_text_align == 'text-end' %}text-end {% else %}text-center {% endif %}" 
                          {% if block.settings.is_use_cur_heading_size != blank %} style="font-size: {{ block.settings.cur_heading_size }}px;"{% endif %}>{{ block.settings.heading | escape }}</{{ block.settings.heading_size }}>
                      {%- endif -%}

                      {% if block.settings.is_use_multiple_text_links != blank and block.settings.multiple_text != blank %}
                        <div class="multiple-text">
                            <{{ block.settings.text_size }} class="main-display-font {% if block.settings.is_use_multiple_text_weight != blank %}font-weight{% else %}multiple-text-tag{% endif %}" {% if block.settings.multiple_text_color != blank %}style="color:{{ block.settings.multiple_text_color }};"{% endif %}>{{ block.settings.multiple_text }}</{{ block.settings.text_size }}>
                            <div class="card__rte flex-auto rte {{ block.settings.text_pos }}{% if block.settings.text_color != blank %} text-color{% endif %}">
                              {{ block.settings.text }}
                            </div>
                        </div>
                      {% elsif block.settings.text != blank %}
