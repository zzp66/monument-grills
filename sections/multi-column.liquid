                      {% if block.settings.is_popup_btn != blank and block.settings.button_link != blank %}
                        {{ 'icons-with-text.css' | asset_url | stylesheet_tag }}
                        {{ 'popup.css' | asset_url | stylesheet_tag }}
                        {{ 'modal.css' | asset_url | stylesheet_tag }}   
                        {% style %}
                          .popup-section{
                            display:none;
                          }
                          .popup-section .modal__header{
                            padding:1em;
                          }
                          .popup-section .modal__header h5{
                            margin-bottom:0;
                          }
                          .popup-section[open]{
                            display:block;
                          }
                          .popup-section[open] .modal__window{
                            margin: 0 auto;
                            top: 50%;
                            transform: translateY(-50%);
                          }
                          .popup-section[open] .modal__window .modal__content .custom-text{
                            text-align: left;
                          }
                        {% endstyle %}
                        
                        {% liquid
                          assign pop_custom_liquid = block.settings.custom_liquid
                          assign pop_custom_text = block.settings.custom_text
                          assign pop_custom_text_url = block.settings.custom_text_url
                          assign iframe_url = block.settings.iframe_url
                          assign pop_title = block.settings.pop_title
                          assign pop_img = block.settings.image
                        %}

                        <script src="{{ 'pop-up.js' | asset_url }}" defer="defer"></script>
                        <script>
                            var scrollPosition = '';
                            $( document ).ready(function() {
                              $('.popup-section').removeAttr('open');
                        
                              $('.popup-btn').on('click',function(e){
                                $('.popup-section').attr('open',true);
                      
                                var pop_title = $(this).attr('data-title');
                                var data_liquid = $(this).attr('data-liquid');
                                var data_text = $(this).attr('data-text');
                                var data_iframe = $(this).attr('data-iframe');
                                var pop_lenar_more_url = $(this).attr('data-text-url');
                                
                                $('.popup-section .modal__header').html(`<h5{{ pop_title }}</h5>`);
                                $('.popup-section .modal__content .custom-liquid').text(data_liquid);
                                $('.popup-section .modal__content .custom-text').find('.cur-text').html(data_text);
                                $('.popup-section .modal__content .custom-text .cur-link').find('a').attr('href',pop_lenar_more_url);
                                $('.popup-section .modal__content .iframe-url').html(data_iframe);
                                
                                e.stopPropagation();
                                scrollPosition = $(window).scrollTop();
                              });
                          
                              $('.js-close-modal').on('click',function(){
                                $(window).scrollTop(scrollPosition);
                                $('.popup-section').removeAttr('open');
                                $('.popup-section .modal__header h5').remove();
                                $('.popup-section .modal__content .custom-liquid').empty();
                                $('.popup-section .modal__content .custom-text').find('.cur-text').empty();
                                $('.popup-section .modal__content .custom-text .cur-link').find('a').attr('href','');
                                $('.popup-section .modal__content .iframe-url').empty();
                                
                                $('.modal').removeAttr('open');
                              });
                            });
                            
                          setTimeout(() => {
                            while (!$) {}}, 100);
                            
                        </script>
                          
                          <div class="section__block section-btn container flex justify-center mt-6 mb-4">
                            <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                              <button type="button" 
                                      class="popup-btn btn {{ block.settings.button_style }}" 
                                      data-liquid-"{{ pop_custom_liquid }}"
                                      data-text="{{ pop_custom_text }}"
                                      data-iframe="{{ iframe_url }}"
                                      data-title="{{ pop_title }}"
                                      data-img="{{ pop_img }}"
                                      data-text-url="{{ pop_custom_text_url }}"
                                      aria-haspopup="dialog"
                                >
                                {{- block.settings.button_label | escape -}}
                              </button>
                            </modal-opener>
                          </div>
                        {% elsif block.settings.button_link != blank %}
                          {% style %}
                            {% if block.settings.button_style == 'btn icon-btn' %}
                              .card-button.absolute{
                                position: absolute;
                                right: 15px;
                                top: 50%;
                                transform: translateY(110%);
                                margin: 0;
                                transition: all 0.3s;
                              }
                               .card-button .icon-btn{
                                  display: flex;
                                  align-items: center;
                                  color: #fff;
                                  padding: 5px;
                                  border: 1px solid #fff;
                                  border-radius: 50%;
                                  width: 30px;
                                  height: 30px;
                               }
                              .multi-column:hover .card .card__info .card-button{
                                transform: translateY(-50%);
                                transition: all 0.3s;
                              }
                              .multi-column:hover .card .card__info .card-button .icon-btn{
                                color: #c00000;
                                border: 1px solid #c00000;
                              }
                              @media (max-width:768px){
                                .multi-column .card .card__info .card-button{
                                  transform: translateY(-50%);
                                  transition: all 0.3s;
                                }
                                .multi-column .card .card__info .card-button .icon-btn{
                                  color: #c00000;
                                  border: 1px solid #c00000;
                                }
                              }
                            {% endif %}

                          {% endstyle %}
                          
                          <div class="{% if section.settings.text_on_picture_postion == 'top' %}mt-0{% else %}mt-8{% endif %} {% if block.settings.button_style == 'btn icon-btn' %} card-button{% endif %}{% if section.settings.color_scheme == 'none' and carousel == false %} mb-8{% endif %} {% if block.settings.button_style == 'btn icon-btn' %} absolute{% endif %}">
                              <a class="card__button btn {{ block.settings.button_style }}" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %} {% if block.settings.add_target != blank %} target="_blank"{% endif %} {% if block.settings.is_nofollow != blank %} rel="nofollow"{% endif %}>
                                {%- if block.settings.button_label != blank -%}
                                  {{- block.settings.button_label | escape -}}
                                {%- else -%}
                                  <span class="visually-hidden">{{ "general.labels.please_select" | t }}{% if block.settings.heading != blank %} {{ block.settings.heading }}{% endif %}</span>
                                  {%- render 'icon-arrow-right' -%}
                                {%- endif -%}
                              </a>
                            </div>
                        {% else %}
                        {% endif %}
                    </div>
                      {% if block.settings.show_icon != blank %}
                        {%- liquid
                         assign img = block.settings.icon
  
                         if img != blank
                           assign desktop_image_class = 'img-fit sm:block'
                         else
                           assign desktop_image_class = 'img-fit column-icon'
                         endif
                        -%}
                        <div class="icon">
                          {%- render 'image',
                              image: img,
                              widths: '120, 240, 480, 960, 1920, 2560, 3200',
                              src_width: 240,
                              src_placeholder: true,
                              sizes: sizes,
                              lazy_load: lazy_load_images,
                              class: desktop_image_class
                            -%}
                        </div>
                        {% style %}
                          {% if block.settings.show_icon != blank %}
                            .cc-multi-column .slider .slider__grid{
                              padding:40px;
                            }
                          {% endif %}
                          
                          .slider__grid{
                            padding-left: 30px;
                            padding-right: 30px;
                          }
                          .card {
                            position: relative;
                          }
                          .card .icon{
                            display:block;
                            width: auto;
                            height: auto;
                            position: absolute;
                            top: {{ block.settings.top_left }}%;
                            left: 0;
                            transform: translate(-20px, -50%);
                          }
                          .card .icon img{
                            max-width:20%;
                            position: relative;
                          }
                          @media (max-width: 768.98px) {
                            .card .icon{
                              max-width: 70%;
                              top: {{ block.settings.top_left }}%;
                              left: 7px;
                            }
                            .cc-multi-column .slider .slider__grid{
                              column-gap: 20px !important;
                            }
                          }
                      {% endstyle %}
                    {% endif %}
                  </{% if block.settings.enable_url != blank %}a{% else %}div{% endif %}>
                </li>
              {% endif %}
            {% endif %}
          {%- endfor -%}
        </ul>
      </div>

    {%- if carousel -%}
          </div>
          {%- if section.settings.slider_show_arrows == 'never' -%}
            <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                {% render 'icon-chevron-right' %}
              </button>
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                {% render 'icon-chevron-left' %}
              </button>
            </div>
          {%- endif -%}
        </div>
      </carousel-slider>
    {%- endif -%}
  </div>
{%- endif -%}

{% style %}
  {% if section.settings.slider_show_arrows == 'never' %}
    @media (max-width: 1260px) {
      #{{ section.id }} .carousel .slider-nav {
        width: 1370px;
        display: flex;
        flex-direction: row-reverse;
        justify-content: space-between;
        right: 0;
        left: 0;
        margin: auto;
        transform: none;
      }
  }
  @media (max-width: 768px) {
    #{{ section.id }} .carousel .slider-nav{
      display:none;
    }
  }
  {% endif %}}
{% endstyle %}

{% comment %}
{% render 'content-popups', popups: section.blocks %}
{% endcomment %}

<div class="popup-section modal invisible fixed top-0 left-0 w-full h-full flex justify-center" data-mode data-show-on-mobile="true">
