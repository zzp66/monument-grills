<style>
  .greetings-content {
    margin-top: 30px;
  }
  .greetings-swiper {
    position: relative;
  }
  .greetings-swiper-pagination.swiper-pagination {
    position: relative;
    top: unset;
    left: unset;
    bottom: unset;
    right: unset;
    margin-top: 10px;
  }
  .greetings-swiper .swiper-slide {
    opacity: 0.4;
    transform: scale(0.9);
    transition: transform 0.3s, opacity 0.3s;
  }
  .greetings-swiper .swiper-slide.swiper-slide-active {
    opacity: 1;
    transform: scale(1.05);
  }
  .greeting-item {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
  }
  .greeting-video {
    display: flex;
    position: relative;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    overflow: hidden;
  }
  .mute-toggle-bg {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #1d1c1c80;
  }
  .mute-toggle {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    z-index: 2;
    padding: 8px;
    cursor: pointer;
  }
  .greeting-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    overflow: hidden;
  }
  .greeting-info {
    padding: 30px 30px 40px;
    background-color: #f5f5f5;
  }
  .greeting-info-author {
    display: flex;
    align-items: center;
  }
  .greeting-info-author img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
  }
  p.author-name {
    margin: 0 0 0 15px;
    font-size: 20px;
    font-weight: 600;
    color: #000;
  }
  p.greeting-info-text {
    margin: 30px 0 0;
    font-size: 16px;
    font-weight: 400;
    color: #928f8f;
  }

  .greetings-swiper-pagination .swiper-pagination-bullet {
    position: relative;
    width: 40px;
    height: 5px;
    background: #ddd;
    border-radius: 5px;
    overflow: hidden;
  }
  .swiper-pagination-bullet .progress-inner {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: #e55420;
    width: 0;
  }
  .swiper-pagination-bullet-active .progress-inner {
    animation: bullet-progress linear forwards;
  }

  @keyframes bullet-progress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  @media screen and (max-width: 767px) {
    .greeting-video {
    }
    .greeting-info {
      padding: 20px 15px 25px;
    }
    .greeting-info-author img {
      width: 30px;
      height: 30px;
    }
    p.greeting-info-text {
      margin: 20px 0 0;
    }
  }
</style>
<div class="anniversary-9th-greetings section">
  <div class="container greetings-contant">
    <h2 class="section__heading mb-0 flex-auto text-center discover-title">{{ section.settings.greetings_title }}</h2>
    <div class="greetings-content">
      <div class="swiper greetings-swiper">
        <div class="swiper-wrapper">
          {% for item in section.blocks %}
            <div class="swiper-slide">
              <div class="greeting-item">
                <div class="greeting-video">
                  {{
                    item.settings.greeting_video
                    | video_tag: class: 'slide-video', playsinline: true, autoplay: true, muted: true, loop: true
                  }}
                  <div class="mute-toggle-bg"></div>
                  <div class="mute-toggle">
                    <img src="https://cdn.shopify.com/s/files/1/1639/3511/files/mute.png?v=1755517123" alt="">
                  </div>
                </div>
                <div class="greeting-info">
                  <div class="greeting-info-author">
                    <img src="{{ item.settings.greeting_author_img | image_url: width: master }}" alt="">
                    <p class="author-name">{{ item.settings.greeting_author }}</p>
                  </div>
                  <p class="greeting-info-text">{{ item.settings.greeting_author_info }}</p>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <!-- Swiper 分页器 -->
        <div class="swiper-pagination greetings-swiper-pagination"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var delay = 5000;
    var swiper = new Swiper('.greetings-swiper', {
      centeredSlides: true,
      initialSlide: 1,
      loop: true,
      autoplay: {
        delay: delay,
        disableOnInteraction: false,
      },
      slidesPerView: 3,
      spaceBetween: 15,
      breakpoints: {
        320: {
          slidesPerView: 1.2,
          spaceBetween: 10,
        },
        768: {
          slidesPerView: 1.2,
          spaceBetween: 10,
        },
        1280: {
          slidesPerView: 3,
          spaceBetween: 15,
        },
      },
      pagination: {
        el: '.greetings-swiper-pagination',
        clickable: true,
        renderBullet: function (index, className) {
          // 给每个 bullet 加一个进度条容器
          return '<span class="' + className + '"><span class="progress-inner"></span></span>';
        },
      },
      on: {
        init: function (s) {
          syncVideos(s);
          startBulletProgress(s);
        },
        slideChangeTransitionStart: function (s) {
          syncVideos(s);
          startBulletProgress(s);
        },
        slideChangeTransitionEnd: function (s) {
          syncVideos(s);
        },
        // 兜底：拖拽/尺寸变化时也同步一次
        resize: function (s) {
          syncVideos(s);
        },
        touchEnd: function (s) {
          syncVideos(s);
        },
      },
    });

    function startBulletProgress(swiper) {
      // 清除所有 progress 动画
      var allBullets = swiper.pagination.bullets;
      for (var i = 0; i < allBullets.length; i++) {
        var inner = allBullets[i].querySelector('.progress-inner');
        if (inner) {
          inner.style.animation = 'none';
          inner.offsetHeight; // 触发重绘，重置动画
          inner.style.animation = '';
        }
      }

      // 给当前 active bullet 加动画
      var active = swiper.pagination.bullets[swiper.realIndex];
      if (active) {
        var inner = active.querySelector('.progress-inner');
        if (inner) {
          inner.style.animation = `bullet-progress ${delay}ms linear forwards`;
        }
      }
    }

    // 只让当前 active 的视频播放，其他全部暂停（不重置进度）
    function syncVideos(s) {
      var root = s.el || document; // v4 的根元素
      var all = root.querySelectorAll('.slide-video');

      // 先全部暂停（避免“切走仍在播”）
      Array.prototype.forEach.call(all, function (v) {
        if (!v) return;
        v.pause();
        // 如果你希望切走后从头再看，取消下面注释
        // v.currentTime = 0;
      });

      // 只播放当前激活的 slide 里的视频
      var actives = root.querySelectorAll('.swiper-slide-active .slide-video');
      Array.prototype.forEach.call(actives, function (v) {
        if (!v) return;
        // 保持你原本的 muted/loop/playsinline 设置
        var p = v.play();
        if (p && p.catch)
          p.catch(function () {
            /* 静音自动播被策略拦截时忽略 */
          });
      });
    }

    // —— 静音按钮（事件委托，兼容动态渲染）——
    document.addEventListener(
      'click',
      function (e) {
        var btn = e.target.closest('.mute-toggle');
        if (!btn) return;

        // 避免触发滑动/过渡导致的异常
        e.preventDefault();
        e.stopPropagation();

        // 按钮与容器都标记为不参与滑动（Swiper 4 支持）
        btn.classList.add('swiper-no-swiping');
        var wrap = btn.closest('.greeting-video');
        if (wrap) wrap.classList.add('swiper-no-swiping');

        var video = wrap && wrap.querySelector('.slide-video');
        if (!video) return;

        video.muted = !video.muted;

        // 用户点击属于“用户手势”，可以顺带恢复播放
        if (video.paused) {
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        }
      },
      false
    );

    // 可选：切到其它 tab 时全部暂停，返回时再同步
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        document.querySelectorAll('.slide-video').forEach(function (v) {
          v.pause();
        });
      } else {
        syncVideos(swiper);
      }
    });
  });
</script>

{% schema %}
{
  "name": "9th Anniversary Greetings",
  "settings": [
    {
      "type": "text",
      "id": "greetings_title",
      "label": "Header",
      "default": "Greetings from the bbq master"
    }
  ],
  "blocks": [
    {
      "type": "greeting",
      "name": "Greeting",
      "settings": [
        {
          "type": "video",
          "id": "greeting_video",
          "label": "视频"
        },
        {
          "type": "image_picker",
          "id": "greeting_author_img",
          "label": "红人头像"
        },
        {
          "type": "text",
          "id": "greeting_author",
          "label": "红人网名"
        },
        {
          "type": "textarea",
          "id": "greeting_author_info",
          "label": "红人评论"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "9th Anniversary Greetings"
    }
  ]
}
{% endschema %}
