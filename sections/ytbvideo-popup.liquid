<style>
  .ytbvideo-swiper {
    margin-top: 40px;
  }
  .ytbvideo-popup-item .img-box {
    display: flex;
  }
  .ytbvideo-popup-item .img-box img {
    max-height: 248px;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ytbvideo-popup-item-img {
    position: relative;
    cursor: pointer;
  }
  .ytbvideo-popup-item-img .play-btn {
    display: flex;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    padding: 12px;
  }
  .ytbvideo-popup-info {
    padding: 15px 0;
  }
  .ytbvideo-popup-info p.info-title {
    margin: 0;
    font-size: 20px;
    line-height: 22px;
    font-weight: 700;
    color: #e55420;
  }
  .ytbvideo-popup-info p.info-desc {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 16px;
    color: #9f9f9f;
  }

  /* 弹窗相关css */
  .ytbvideo-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }
  .ytbvideo-modal.hidden {
    display: none;
  }
  .ytbvideo-modal-content {
    position: relative;
    max-width: 80%;
    width: 800px;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }
  .ytbvideo-iframe-box {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }
  .ytbvideo-iframe-box iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .ytbvideo-modal-close {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 40px;
    color: #fff;
    cursor: pointer;
    z-index: 10000; /* 确保在最上层 */
  }

  @media screen and (max-width: 767px) {
    .ytbvideo-swiper {
      margin-top: 20px;
    }
    .ytbvideo-modal-content {
      max-width: 95%;
    }
  }
</style>
<div class="ytbvideo-popup section">
  <div class="container">
    <h2 class="section__heading mb-0 flex-auto text-center discover-title">
      {{ section.settings.ytbvideo_popup_title }}
    </h2>
    <div class="swiper ytbvideo-swiper">
      <div class="swiper-wrapper">
        {% for item in section.blocks %}
          <div class="swiper-slide">
            <div class="ytbvideo-popup-item">
              <div class="ytbvideo-popup-item-img" data-video-url="{{ item.settings.ytbvideo_url }}">
                <div class="img-box">
                  <img src="{{ item.settings.ytbvideo_image | image_url: width: master }}" alt="">
                </div>
                <div class="play-btn">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="white">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              <div class="ytbvideo-popup-info">
                <p class="info-title">{{ item.settings.ytbvideo_title }}</p>
                <p class="info-desc">{{ item.settings.ytbvideo_info }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<div id="ytbvideo-modal" class="ytbvideo-modal hidden">
  <span class="ytbvideo-modal-close">&times;</span>
  <div class="ytbvideo-modal-content">
    <div class="ytbvideo-iframe-box">
      <iframe id="ytbvideo-iframe" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
  </div>
</div>

<script>
  function getYoutubeEmbedUrl(url) {
    try {
      const u = new URL(url);
      let videoId = '';

      if (u.hostname.includes('youtu.be')) {
        // 短链形式 https://youtu.be/VIDEOID
        videoId = u.pathname.slice(1).split('?')[0];
      } else if (u.hostname.includes('youtube.com')) {
        // 标准形式 https://www.youtube.com/watch?v=VIDEOID
        videoId = u.searchParams.get('v');
      }

      if (videoId) {
        return 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
      }
    } catch (e) {
      console.error('Invalid YouTube URL:', url);
    }
    return '';
  }

  function initYtbVideoPopup() {
    const modal = document.getElementById('ytbvideo-modal');
    const iframe = document.getElementById('ytbvideo-iframe');
    const closeBtn = document.querySelector('.ytbvideo-modal-close');

    document.querySelectorAll('.ytbvideo-popup-item-img').forEach((item) => {
      if (!item.dataset.bound) {
        // 防止重复绑定
        item.dataset.bound = 'true';
        item.addEventListener('click', function () {
          const videoUrl = this.getAttribute('data-video-url');
          if (videoUrl) {
            const embedUrl = getYoutubeEmbedUrl(videoUrl);
            if (embedUrl) {
              iframe.src = embedUrl;
              modal.classList.remove('hidden');
            }
          }
        });
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        modal.classList.add('hidden');
        iframe.src = '';
      });
    }

    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          modal.classList.add('hidden');
          iframe.src = '';
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.ytbvideo-swiper', {
      slidesPerView: 3,
      spaceBetween: 20,
      breakpoints: {
        320: { slidesPerView: 1.2, spaceBetween: 10 },
        768: { slidesPerView: 1.2, spaceBetween: 15 },
        1280: { slidesPerView: 3, spaceBetween: 20 },
      },
    });
    initYtbVideoPopup();
  });

  // 兼容 Shopify 编辑器 section 更新
  document.addEventListener('shopify:section:load', function () {
    initYtbVideoPopup();
  });
</script>
{% schema %}
{
  "name": "YouTube Video Popup",
  "settings": [
    {
      "type": "text",
      "id": "ytbvideo_popup_title",
      "label": "Header",
      "default": "Life’s Warmth with Monument Grills"
    }
  ],
  "blocks": [
    {
      "type": "youtube_video",
      "name": "YouTube Video",
      "settings": [
        {
          "type": "url",
          "id": "ytbvideo_url",
          "label": "YouTube视频链接"
        },
        {
          "type": "image_picker",
          "id": "ytbvideo_image",
          "label": "Video封面图"
        },
        {
          "type": "text",
          "id": "ytbvideo_title",
          "label": "Video标题"
        },
        {
          "type": "text",
          "id": "ytbvideo_info",
          "label": "Video文案信息"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YouTube Video Popup"
    }
  ]
}
{% endschema %}
