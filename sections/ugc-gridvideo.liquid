<style>
  .ugc-gridvideo {
    padding: 60px 0;
    margin: 0;
    background-color: #d2e3ed;
  }
  .ugc-gridvideo video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .grid-video-content {
    margin-top: 40px;
  }
  .grid-video-box {
    column-count: 4;
    column-gap: 15px;
  }
  .video-card {
    break-inside: avoid;
    position: relative;
    cursor: pointer;
    margin-bottom: 15px;
    display: block;
  }
  .video-card img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .video-card .video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .video-card .play-btn {
    display: flex;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    padding: 12px;
  }
  .bottom-bar {
    width: 100%;
    position: absolute;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 8px 10px;
    background: linear-gradient(to top, #000000, #00000000);
    color: white;
    font-size: 14px;
  }
  .video-card img.ig-icon {
    max-width: 40px;
    height: auto;
  }
  .bottom-bar-text {
    margin-left: 8px;
    display: flex;
    flex-direction: column;
  }
  .bottom-bar-text span.text-strong {
    font-size: 16px;
    font-weight: 600;
  }
  /* 弹窗相关样式 */
  .popup {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    z-index: 99;
  }

  .popup-content {
    background: white;
    margin: 20px;
    padding: 40px 20px 20px;
    position: relative;
    overflow: hidden;
    width: 500px;
    height: 80%;
    border-radius: 16px;
  }

  #close-popup {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
  }
  #video-container {
    width: 100%;
    height: 100%;
  }

  #video-container iframe {
    width: 100%;
    height: 100%;
  }

  /* 弹窗相关样式End */
  a.gridvideo-link {
    display: flex;
    justify-content: center;
    color: #333;
    margin-top: 40px;
  }

  a.gridvideo-link:hover {
    text-decoration: underline;
    color: #e55420;
  }

  @media (max-width: 767px) {
    .grid-video-content {
      margin-top: 30px;
    }
    .grid-video-box {
      column-count: 2;
      column-gap: 10px;
    }
    .video-card .play-btn {
      padding: 5px;
    }
    .video-card .play-btn svg {
      width: 20px;
      height: auto;
    }
    .video-card img.ig-icon {
      max-width: 20px;
    }
    .bottom-bar-text span.text-strong {
      font-size: 12px;
      line-height: 1;
    }
    .bottom-bar-text span.text-ins {
      font-size: 12px;
      line-height: 1;
    }
    a.gridvideo-link {
      margin-top: 30px;
    }
    .popup-content {
      border-radius: 8px;
    }
  }
</style>

<div class="ugc-gridvideo">
  <div class="container">
    <h2 class="section__heading mb-0 flex-auto text-center gridvideo-title">
      {{ section.settings.header }}
    </h2>
    <div class="grid-video-content">
      <div class="grid-video-box">
        {% for block in section.blocks %}
          <div class="video-card" data-video-id="{{ block.settings.video_url }}">
            <img src="{{ block.settings.thumbnail | image_url: master }}" alt="Video Thumbnail" class="thumbnail">
            <div class="video-overlay">
              <div class="play-btn">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="white">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <div class="bottom-bar">
                {% if block.settings.video_author_img != blank %}
                  <img
                    src="{{ block.settings.video_author_img | image_url: width: master }}"
                    alt="Instagram"
                    class="ig-icon"
                  >
                {% endif %}
                <div class="bottom-bar-text">
                  <span class="text-strong">{{ block.settings.video_author }}</span>
                  <span class="text-ins">Instagram</span>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <a href="{{ section.settings.learn_more_link }}" class="gridvideo-link">Learn More ></a>
    </div>
  </div>

  <!-- 弹窗容器 -->
  <div id="video-popup" class="popup">
    <div class="popup-content">
      <button id="close-popup">&times;</button>
      <div id="video-container"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const videoThumbnails = document.querySelectorAll('.video-card');
    const popup = document.getElementById('video-popup');
    const closePopup = document.getElementById('close-popup');
    const videoContainer = document.getElementById('video-container');

    // 打开弹窗并加载Instagram视频
    videoThumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', function () {
        const videoUrl = this.getAttribute('data-video-id');
        // 创建iframe并插入Instagram视频
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.instagram.com/p/${videoUrl.split('/p/')[1]}/embed`;
        iframe.frameBorder = '0';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.allowFullscreen = true;

        videoContainer.innerHTML = ''; // 清空之前的视频
        videoContainer.appendChild(iframe); // 插入新的视频
        popup.style.display = 'flex'; // 显示弹窗
      });
    });

    // 关闭弹窗
    closePopup.addEventListener('click', function () {
      popup.style.display = 'none';
      videoContainer.innerHTML = ''; // 清空视频
    });

    // 点击弹窗外部区域也可以关闭弹窗
    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        popup.style.display = 'none';
        videoContainer.innerHTML = ''; // 清空视频
      }
    });
  });
</script>

{% schema %}
{
  "name": "UGC Grid Video",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header",
      "default": "Get Monument Moments <br>The Everybody Everywhere Grill."
    },
    {
      "type": "url",
      "id": "learn_more_link",
      "label": "Learn More Link"
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
        {
          "type": "image_picker",
          "id": "video_author_img",
          "label": "红人头像"
        },
        {
          "type": "text",
          "id": "video_author",
          "label": "红人名称",
          "default": "Monument Grills"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (Instagram)",
          "info": "https://www.instagram.com/p/DHjv9hIvreU 链接格式示意，请严格按照这个格式填写"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "UGC Grid Video"
    }
  ]
}
{% endschema %}
