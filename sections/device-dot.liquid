{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'hotspots-image.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'hotspots-image.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'hotspots-image.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign hotspot_color_brightness = section.settings.hotspot_color | color_brightness
-%}

{% style %}
  #{{ section.id }} {
    --hotspot-color: {{ section.settings.hotspot_color.rgb }};
    {%- if hotspot_color_brightness > 128 %}
      --hotspot-cross-color: #000;
    {%- else -%}
      --hotspot-cross-color: #fff;
    {%- endif %}
  }
  .shoppable-image.up{
    flex-direction: column;
  }
  .hotspot__btn_num{
    color:#fff;
    background:#111;
    width:30px;
    height:30px;
    border-radius: 50%;
    transition: transform 0.3s, opacity 0.3s;
    opacity: 0.6;
  }
  .hotspot__btn_num::before {
    content: "";
    position: absolute;
    top: -4px;
    right: -4px;
    bottom: -4px;
    left: -4px;
    animation: pulse 2.5s cubic-bezier(0.1, 0.5, 0.3, 1) infinite;
    border-radius: 50%;
  }
  .hotspot__btn_num:hover {
    opacity: 1;
  }
  .hotspot__btn_num + .hotspot__card{
    padding: 10px;
    border-radius: 6px;
    text-align: center;
  }
  .hotspot__btn_num + .hotspot__card>p{
    font-size: 16px;
    margin-bottom: 0;
  }
  .is-active .hotspot__btn_num.product-hotspot__btn{
    transform: rotate(45deg);
  }
{% endstyle %}

<div class="container" id="{{ section.id }}">
  <div class="section">
    {% comment %}
      <div class="shoppable-image{% if section.settings.layout == 'image_last' %} flex-row-reverse{% endif %} {% if section.settings.layout_column == 'image_up' %} up {% endif %}">
    {% endcomment %}
    <div class="shoppable-image{% if section.settings.layout == 'image_last' %} flex-row-reverse{% endif %}{% if section.settings.layout_column == 'image_up' %} up {% endif %}">
      <hotspots-image class="shoppable-image__image block relative overflow-hidden"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
        {%- if section.settings.image != blank -%}
          {%- capture sizes -%}
            {%- render 'sizes-attribute', min: 'page', sm: 'page', md: false, lg: false, xl: '896px', max: false -%}
          {%- endcapture -%}

          {% render 'image',
            image: section.settings.image,
            widths: '690, 896, 1408, 1792, 1920',
            src_width: 896,
            sizes: sizes,
            class: 'block mx-auto w-full'
          %}
        {%- else -%}
          <div class="media relative" style="padding-top: 56.25%;">
            {{ 'collection-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div class="hotspot absolute" data-x="{{ block.settings.hotspot_x }}" data-y="{{ block.settings.hotspot_x }}" style="top: {{ block.settings.hotspot_y }}%; left: {{ block.settings.hotspot_x }}%">
              {% if product != blank %}
                <button type="button" class="hotspot__btn_num product-hotspot__btn relative tap-target no-js-hidden" aria-expanded="false">
                  <span class="visually-hidden">
                    {{- 'accessibility.view_details' | t }}{% if product and product != empty %} - {{ product.title }}{% endif -%}
                  </span>
                  {% render 'icon-plus' %}
                </button>
              {% else %}
                <button type="button" class="hotspot__btn_num relative tap-target no-js-hidden" aria-expanded="false" style="background-color: {{ block.settings.hotspot_bg }};color:{{ block.settings.hotspot_text_color }}">
                  {{ forloop.index }}
                </button>
              {% endif %}
              
              <div class="hotspot__card absolute no-js-hidden" aria-hidden="true">
                {%- if block.settings.title != empty -%}
                <p class="h5">
                  {{ block.settings.title }}
                </p>
                {%- endif -%}
                
              </div>
              {%- if product and product != empty -%}
              <noscript>
                <a class="hotspot__btn tap-target flex justify-center items-center" href="{{ product.url }}" title="{{ product.title }}">
                  {% render 'icon-plus' %}
                </a>
              </noscript>
            {%- endif -%}
            </div>
          {% comment %}
          <div class="hotspot absolute" data-x="{{ block.settings.hotspot_x }}" data-y="{{ block.settings.hotspot_x }}" style="top: {{ block.settings.hotspot_y }}%; left: {{ block.settings.hotspot_x }}%">
            
            <button type="button" class="hotspot__btn_num relative tap-target no-js-hidden" aria-expanded="false">
              {% if product != blank %}
                <span class="visually-hidden">
                  {{- 'accessibility.view_details' | t }}{% if product and product != empty %} - {{ product.title }}{% endif -%}
                </span>
                {% render 'icon-plus' %}
                {% else %}
                {{ forloop.index }}
              {% endif %}
            </button>
           
            {% if product != blank %}
                <button type="button" class="hotspot__btn_num product-hotspot__btn relative tap-target no-js-hidden" aria-expanded="false">
                  <span class="visually-hidden">
                    {{- 'accessibility.view_details' | t }}{% if product and product != empty %} - {{ product.title }}{% endif -%}
                  </span>
                  {% render 'icon-plus' %}
                </button>
            {% else %}
              <button type="button" class="hotspot__btn_num relative tap-target no-js-hidden" aria-expanded="false" style="background-color: {{ block.settings.hotspot_bg }};color:{{ block.settings.hotspot_text_color }}">
                {{ forloop.index }}
              </button>
            {% endif %}
            <div class="hotspot__card absolute no-js-hidden" aria-hidden="true">
              <p class="h5">
                {{ pot_info }}
              </p>
            </div>
             
              {% if product != blank %}
                  {%- if product and product != empty -%}
                    {%- if section.settings.show_vendor -%}
                      <p class="card__vendor mb-0">{{ product.vendor }}</p>
                    {%- endif -%}
                    <p class="h5">
                      <a href="{{ product.url }}" class="card-link text-current">{{ product.title }}</a>
                    </p>
                    <hr class="mt-4 mb-4">
                    {%- render 'price', product: product -%}
                  {%- else -%}
                    <p class="h5">{{ 'onboarding.product.title' | t }}</p>
                    <hr class="mt-4 mb-4">
                    <div class="card__price theme-money">
                      {%- render 'price' -%}
                    </div>
                  {%- endif -%}
                {% else %}
                  {%- if pot_info != empty -%}
                    {%- if section.settings.show_vendor -%}
                      <p class="h5">
                        {{ pot_info }}
                      </p>
                    {%- endif -%}
                  {%- endif -%}
              {% endif %}
            
            
            {%- if product and product != empty -%}
              <noscript>
                <a class="hotspot__btn tap-target flex justify-center items-center" href="{{ product.url }}" title="{{ product.title }}">
                  {% render 'icon-plus' %}
                </a>
              </noscript>
            {%- endif -%}
          </div>
          {% endcomment %}
        {% endfor %}
      </hotspots-image>

      {%- if section.settings.show_content -%}
        <div class="shoppable-image__text"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          <div class="card card--wide h-full {% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}">
            <div class="card__info{% if section.settings.mob_center_text %} md-down:text-center{% endif %}">
              {%- if section.settings.heading != blank -%}
                <h2 class="section__block section__block--heading h4">
                  {{- section.settings.heading | escape -}}
                </h2>
              {%- endif -%}

              {%- if section.settings.text != blank -%}
                <div class="section__block rte">
                  {{ section.settings.text }}
                </div>
              {%- endif -%}

              {%- if section.settings.button_label != blank -%}
                <div class="section__block section__block--button">
                  <a class="relative {{ section.settings.button_style }}{% if section.settings.button_style != 'link' %} btn--arrow-with-text{% endif %}" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                    {{- section.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Device dot -- wenfei",
  "tag": "section",
  "class": "cc-shoppable-image cwf",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "For best results, use a landscape shaped image with a width of 1920px. Smaller images may be enlarged."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position on large screens",
      "options": [
        {
          "value": "image_first",
          "label": "Left"
        },
        {
          "value": "image_last",
          "label": "Right"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "layout_column",
      "label": "Image position on column",
      "options": [
        {
          "value": "image_up",
          "label": "Up"
        },
        {
          "value": "image_down",
          "label": "Down"
        }
      ],
      "default": "image_up"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "info": "Shown in product popups",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mob_center_text",
      "label": "Center text on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shoppable image"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Create a Shop the Look section to assist with upselling or helping customers with purchasing complementary products.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot color",
      "default": "#070707"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button",
      "options": [
        {
          "value": "link",
          "label": "Link"
        },
        {
          "value": "btn btn--primary",
          "label": "Primary button"
        },
        {
          "value": "btn btn--secondary",
          "label": "Secondary button"
        }
      ],
      "default": "btn btn--primary"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info":"If no product is selected, the default number is displayed"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pot name",
          "default": "Pot name"
        },
        {
          "type":"color",
          "id":"hotspot_bg",
          "label":"Pot background color"
        },
        {
          "type":"color",
          "id":"hotspot_text_color",
          "label":"Pot num color"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Horizontal position",
          "min": 10,
          "max": 90,
          "unit": "%",
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Vertical position",
          "min": 10,
          "max": 90,
          "unit": "%",
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Device dot -- wenfei",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "hotspot_x": 28,
            "hotspot_y": 38
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "hotspot_x": 60,
            "hotspot_y": 23
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "hotspot_x": 73,
            "hotspot_y": 54
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
