{%- comment -%}
  Build: lg:col-span-1 lg:col-span-2 lg:col-span-3 lg:col-span-4 row-span-2 row-span-3
{%- endcomment -%}

{% style %}
   
{% endstyle %}

{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'gallery.css' | asset_url }}" media="print" onload="this.media='all'">

  {%- if section.settings.mobile_carousel -%}
    <link rel="stylesheet" href="{{ 'gallery-mobile-carousel.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}
{%- else -%}
  {{ 'gallery.css' | asset_url | stylesheet_tag }}

  {%- if section.settings.mobile_carousel -%}
    {{ 'gallery-mobile-carousel.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endif -%}

{%- for block in section.blocks -%}
  {%- if block.settings.video_shopify != blank -%}
    {%- if section.index > 2 -%}
      <link rel="stylesheet" href="{{ 'video.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- else -%}
      {{ 'video.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    <script src="{{ 'video.js' | asset_url }}" defer="defer"></script>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  # constants
  assign breakpoint_md = 769
  assign block_number = section.settings.block_number
  assign block_min_height = section.settings.block_min_height
  assign mobile_block_min_height = section.settings.mobile_block_min_height
  assign rounded_design = section.settings.rounded_design
  assign title_tag = section.settings.heading_size

  if section.settings.gallery_cols_min == '1'
    assign grid_classes = 'sm:grid-cols-2'
  else
    assign grid_classes = 'grid-cols-2'
  endif

   if section.settings.is_special_layout != false
    assign grid_classes = 'sm:grid-cols-3'
   endif

  if section.settings.gallery_cols_max == 6
    assign grid_classes = grid_classes | append: ' lg:grid-cols-4'
  elsif section.settings.gallery_cols_max == 3
    assign grid_classes = grid_classes | append: ' lg:grid-cols-3'
  
  endif

  assign text_color_scheme = section.settings.color_scheme

  if text_color_scheme == "white"
    assign brightness = section.settings.transparent_content_color | color_brightness
    assign alpha = section.settings.transparent_content_color | color_extract: 'alpha'
    if brightness < 190 and alpha > 0
      assign transparent_text_contrast = "255 255 255"
      assign transparent_hover_color = section.settings.transparent_content_color | color_lighten: 10
    else
      assign transparent_text_contrast = "0 0 0"
      assign transparent_hover_color = section.settings.transparent_content_color | color_darken: 10
    endif
  endif

  assign section_color_scheme = section.settings.section_color_scheme
  assign section_bg_color = false

  if section_color_scheme == '1'
    assign section_bg_color = settings.color_scheme_1_bg
  elsif section_color_scheme == '2'
    assign section_bg_color = settings.color_scheme_2_bg
  elsif section_color_scheme == '3'
    assign section_bg_color = settings.color_scheme_3_bg
  endif

  if section_bg_color == settings.bg_color or section_bg_color == 'rgba(0,0,0,0)'
    assign section_bg_color = false
  endif
-%}

{%- style -%}
  {% for block in section.blocks %}
    {%- if block.settings.tint_opacity > 0 -%}
      .block-{{ block.id }} .media::after {
        background-color: rgba({{ block.settings.tint_color.red }}, {{ block.settings.tint_color.green }}, {{ block.settings.tint_color.blue }}, {{ block.settings.tint_opacity | divided_by: 100.0 }});
      }
    {%- endif -%}
  {% endfor %}
  #{{ section.id }} .text-below-picture .gallery-block{
    min-height:400px !important;
  }
  #{{ section.id }} .gallery-block { 
    min-height: {{ section.settings.fixed_height_mobile }}px; 
  }
  {% unless section.settings.mobile_carousel %}#{{ section.id }} .gallery-block.row-span-2, #{{ section.id }} .gallery-block.row-span-3 { 
    min-height: {{ section.settings.fixed_height_mobile | times: 1.75 }}px; }{% endunless %}

  {%- if text_color_scheme == "white" -%}
    #{{ section.id }} {
      --color-scheme-white-text: {{ section.settings.transparent_content_color.red }} {{ section.settings.transparent_content_color.green }} {{ section.settings.transparent_content_color.blue }};
      --color-scheme-white-hover: {{ transparent_hover_color.red }} {{ transparent_hover_color.green }} {{ transparent_hover_color.blue }};
      --color-scheme-white-text-contrast: {{ transparent_text_contrast }};
    }
  {%- endif -%}

  @media (min-width: {{ breakpoint_md }}px) {
    .text-overlay__block.max-w{
      max-width:80%;
      margin:1em auto;
    }
    #{{ section.id }} .gallery-block { min-height: calc({{ section.settings.fixed_height_desktop }}px + 8vw); }
    #{{ section.id }} .gallery-block.row-span-2 { min-height: calc(calc({{ section.settings.fixed_height_desktop }}px + 8vw) * 2); }
    #{{ section.id }} .gallery-block.row-span-3 { min-height: calc(calc({{ section.settings.fixed_height_desktop }}px + 8vw) * 3); }
  }
  @media (max-width:850px){
    .text-overlay__block.max-w{
      max-width:95%;
    }
  }
{%- endstyle -%}

<div class="section{% unless section_color_scheme == 'none' %} color-scheme color-scheme--{{ section_color_scheme }} section--padded section--full-width{% endunless %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  {%- if section.settings.title != blank or section.settings.button_label != blank -%}
    <div class="{% if section.settings.full_screen %}{% else %} container{% endif %}">
      <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
        {%- if section.settings.title != blank -%}
          <h2 class="{{ title_tag }} section__heading mb-0 flex-auto {{ section.settings.heading_align }} {% if section.settings.header_weight %} blod{% endif %} {% if section.settings.header_uppercase %} uppercase{% endif %}">
            {{- section.settings.title | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.media_des_1 != blank -%}
          <div class="max-w text-overlay__block reading-width rte" {{ block.shopify_attributes }}>
            {{ section.settings.media_des_1 }}
          </div>
        {%- endif -%}

        

       
      </div>
    </div>
  {%- endif -%}

  {% if section.settings.mobile_carousel %}<div class="gallery-mobile-carousel">{% endif %}

  
  {% style %}
    .rounded_design{
      border-radius: 20px;
      overflow: hidden;
      margin:2em 0;
    }
    #{{ section.id }} .gallery-block.min-block{
      min-height: {{block_min_height}}px;
    }
    #{{ section.id }} .blod{
      font-weight: bold;
    }
    #{{ section.id }} .uppercase{
      text-transform:uppercase;
    }
    #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image{
      padding:0;
    }
    #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image-text{
      padding: calc(8* var(--space-unit));
      color: {{ section.settings.text_color }};
      max-width: 100%;
    }
    #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image-text .column-media-title{
      
    }
    #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image .media img,
     #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image .media{
      position: relative;
    }
    #{{ section.id }} .text-below-picture .gallery-block .gallery-block__image .media.image-has-rounded-corners{
        overflow: hidden;
        border-radius: {{ section.settings.image_border_radius }};
        box-shadow: 0 0 10px #aaa;
    }
    .refer-a-friend form .input-with-button{
      max-width:100%;
    }
    {% if section.settings.column_font_glow != blank %}
      #{{ section.id }} .gallery .gallery-block__image .gallery-block__image-text .column-media-title{
        margin-bottom:0;
        text-shadow: 0 0 {{ section.settings.title_one_color_size }}px {{ section.settings.title_one_color }}, 0 0 {{ section.settings.title_two_color_size }}px {{ section.settings.title_two_color }}, 0 0 {{ section.settings.title_four_color_size }}px {{ section.settings.title_four_color }};
      }
      @media (min-width:1921px){
        
        #{{ section.id }} .gallery .gallery-block__image .gallery-block__image-text .description{
          /* font-size: 1.5em; */
        }
      }
    {% endif %}}
    @media (max-width: 768.98px){
      .rounded_design{
        overflow: inherit;
        margin:0 auto;
      }
      #{{ section.id }} .gallery-block.min-block{
        min-height: {{mobile_block_min_height}}px;
      }
    }
    @media (min-width:1921px){
        #{{ section.id }} .gallery .gallery-block__image .gallery-block__image-text .description{
          /* font-size: 1.5em; */
        }
      }
  {% endstyle %}
  <div class="{% if section.settings.full_screen %}{% else %} container{% endif %}" id="{{ section.id }}">
    <div class="gallery grid sm:2 lg:grid-cols-{{ section.settings.gallery_cols_max }} {% if section.settings.is_three_cols != blank %} three-cols sm:grid-cols-3 lg:grid-cols-3 {% endif %} {% if section.settings.is_four_cols != blank %}four-cols sm:grid-cols-4 lg:grid-cols-{{ section.settings.gallery_cols_max }}{% endif %} {% if section.settings.is_five_cols != blank %}five-cols sm:grid-cols-{{ section.settings.gallery_cols_max }} lg:grid-cols-{{ section.settings.gallery_cols_max }}{% endif %} {% if rounded_design != blank %} rounded_design{% endif %} {% if section.settings.is_text_below_the_picture != blank %} text-below-picture{% endif %}">
      {%- for block in section.blocks -%}
        {% case block.type %}
          {% when 'media' %}
          {%- liquid
            assign img = block.settings.image
            assign overlay_position = block.settings.overlay_position | split: ' '
            assign is_link = true
            if block.settings.title contains "<a" or block.settings.button_link != blank or block.settings.link_url == blank
              assign is_link = false
            endif
          -%}
          {% if is_link %}
          <a href="{{ block.settings.link_url }}" 
        {% else %}
        <div {% endif %}
            class="block-{{ block.id }} block {% if section.settings.is_special_layout != false and forloop.index > 3 %}three-block{% else %}{% endif %} relative flex flex-col gallery-block h-full{% if section.settings.gallery_cols_min == '2' and block.settings.columns >= 2 %} md-down:col-span-2{% endif %} row-span-{{ block.settings.rows }} lg:col-span-{{ block.settings.columns }} {% if is_link %} hover:grow-media{% endif %} {% if block_min_height != blank %} min-block{% endif %}" {%- unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
            <div class="gallery-block__image{% if block.settings.video_shopify != blank %} video-section{% endif %} {% if section.settings.is_text_below_the_picture != blank %}{% else %} overflow-hidden{% endif %} flex relative w-full h-full {{ overlay_position | first }} {{ overlay_position | last }}{% if is_link %} {% if section.settings.is_text_below_the_picture != blank %}{% else %} card__media{% endif %}{% endif %}">
              <div class="media media--has-overlay flex absolute top-0 left-0 w-full h-full has-motion {% if section.settings.is_image_has_rounded_corners != blank %}image-has-rounded-corners{% endif %}">
                {%- if img != blank -%}
                  {%- capture sizes %}{% render 'sizes-attribute', grid: true, min: section.settings.gallery_cols_min, sm: block.settings.columns %}{% endcapture -%}
                  {% liquid
                    assign ima_banner_sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                  %}
                  {% render 'image',
                    image: img,
                    widths: '480, 800, 980, 1024, 1440, 1920',
                    src_width: 980,
                    src_placeholder: true,
                    sizes: ima_banner_sizes,
                    quality: 1,
                    section_index: section.index,
                    class: 'img-fit'
                  %}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                {%- endif -%}
              </div>

              {%- if block.settings.video_shopify != blank -%}
                <deferred-media class="video-section__media media media--has-overlay overflow-hidden absolute top-0 left-0 w-full h-full">
                  <template>
                    <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                                    data-autoplay="true"
                                    data-background="true">
                      {{ block.settings.video_shopify | video_tag: class: 'img-fit pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                    </video-component>
                  </template>
                </deferred-media>
              {%- endif -%}

              
              {%- if block.settings.title != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
                <div class="gallery-block__image-text {{ block.settings.title_position }} {% if text_color_scheme == "white" %} gallery-block__image-text--transparent{% endif %} color-scheme color-scheme--{{ text_color_scheme }} text-overlay text-overlay--grow {{ block.settings.text_alignment }} relative"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %} {% if section.settings.is_text_below_the_picture != blank %}style="display:none;"{% endif %}>
                  {%- if block.settings.subheading != blank -%}
                    <p class="text-overlay__block subheading text-current">
                      {{- block.settings.subheading | escape -}}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <h3 class="column-media-title text-current mb-0 rte {{ block.settings.heading_size }} {% if block.settings.title_weight != blank %}font-weight {% endif %} {% if block.settings.title_uppercase != blank %}font-uppercase{% endif %}{% if section.settings.column_font_glow != blank %} column-font-glow{% endif %}" {% if block.settings.is_use_cur_heading_size != blank %} style="font-size: {{ block.settings.cur_heading_size }}px;"{% endif %}>
                      {{- block.settings.title | newline_to_br -}}
                    </h3>
                  {%- endif -%}

                  {% if block.settings.header_description != blank %}
                    <div class="description">{{ block.settings.header_description | escape }}</div>
                  {% endif %}

                  {%- if block.settings.button_label != blank -%}
                    <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if section.settings.text_alignment == 'text-start' %} justify-start{% elsif section.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                     
                      {% if block.settings.is_copyed_btn != blank %}
                        <{% if block.settings.is_copyed_btn != blank %}button id="{{ block.settings.copyed_btn_id }}"{% else %}a{% endif %} class="{{ block.settings.button_style }} {% if block.settings.icon_layout == 'left' %} left{% else %} right{% endif %}" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %} {% if block.settings.is_copyed_btn != blank %} data-link="{{ block.settings.button_link }}"{% endif %} style="background:{{ block.settings.button_color }};border-color:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};">
                          {{- block.settings.button_label | escape -}}
                        </{% if block.settings.is_copyed_btn != blank %}button{% else %}a{% endif %}>
                      {% else %}
                        <{% if block.settings.button_link == blank %}button{% else %}a{% endif %} class="{{ block.settings.button_style }}" {% if block.settings.button_link == blank and is_link == false %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %} style="background:{{ block.settings.button_color }};border-color:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};">
                          {{- block.settings.button_label | escape -}}
                        </{% if block.settings.button_link == blank %}button{% else %}a{% endif %}>
                      {% endif %}
                      </div>
                  {% else %}
                          {% if block.settings.is_newsletter_email != blank %}
                            <div class="refer-a-friend mt-3">
                              {% render 'newsletter', 
                                id: 'refer_friend', 
                                arrow_button: true, 
                                tags: block.settings.newsletter_tag %}
                            </div>
                          {% endif %}
                  {%- endif -%}
                   
                </div>
              {%- endif -%}
            </div>
            {% if section.settings.is_text_below_the_picture != blank %}
              {%- if block.settings.title != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
                <div class="gallery-block__image-text{% if text_color_scheme == "white" %} gallery-block__image-text--transparent{% endif %} color-scheme color-scheme--{{ text_color_scheme }} text-overlay text-overlay--grow {{ block.settings.text_alignment }} relative"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
                  {%- if block.settings.subheading != blank -%}
                    <p class="text-overlay__block subheading text-current">
                      {{- block.settings.subheading | escape -}}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <{% if block.settings.heading_size != blank %}{{ block.settings.heading_size }}{% endif %} class="text-current mb-0 rte {% if block.settings.title_weight != blank %}font-weight {% endif %} {% if block.settings.title_uppercase != blank %}font-uppercase{% endif %}">
                      {{- block.settings.title | newline_to_br -}}
                    </{% if block.settings.heading_size != blank %}{{ block.settings.heading_size }}{% endif %}>
                  {%- endif -%}

                  {% if block.settings.header_description != blank %}
                    <div>{{ block.settings.header_description | escape }}</div>
                  {% endif %}

                  {%- if block.settings.button_label != blank -%}
                    <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if section.settings.text_alignment == 'text-start' %} justify-start{% elsif section.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                      <{% if block.settings.button_link == blank %}button{% else %}a{% endif %} class="{{ block.settings.button_style }}" {% if block.settings.button_link == blank and is_link == false %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %} style="background:{{ block.settings.button_color }};border-color:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};">
                        {{- block.settings.button_label | escape -}}
                      </{% if block.settings.button_link == blank %}button{% else %}a{% endif %}>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {% endif %}
          {% if is_link %}</a>{% else %}</div>{% endif %}
        {% endcase %}
      {%- endfor -%}
    </div>
    {% if section.settings.is_show_three_cols != blank %}
      <div class="gallery grid {% if section.settings.is_show_three_cols != blank %} mt-6 three-cols sm:grid-cols-3 lg:grid-cols-3 {% endif %} {% if section.settings.is_four_cols != blank %}four-cols sm:grid-cols-4 lg:grid-cols-4{% endif %} {% if rounded_design != blank %} rounded_design{% endif %} {% if section.settings.is_text_below_the_picture != blank %} text-below-picture{% endif %}">
        {% for block in section.blocks %}
          
          {% case block.type %}
            {% when 'three-media' %}
            {% style %}
              {%- if block.settings.three_tint_opacity > 0 -%}
                .block-three-media .media::after {
                  background-color: rgba({{ block.settings.tint_color.red }}, {{ block.settings.tint_color.green }}, {{ block.settings.tint_color.blue }}, {{ block.settings.three_tint_opacity | divided_by: 100.0 }});
                }
              {%- endif -%}
              .color-text {
                background: linear-gradient(to bottom, {{ block.settings.strong_title_color_1 }}, {{  block.settings.strong_title_color_2 }});
                -webkit-background-clip: text;
                color: transparent;
              }
              .block-three-media .gallery-block__image{
                padding:0;
              }
              .block-three-media .gallery-block__image .gallery-block__image-text{
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
                text-align: center;
                padding: 16% 3% 3%;
              }
              .block-three-media .gallery-block__image .gallery-block__image-text .feature-title{
                  position: absolute;
                  bottom: 20px;
                  left: 50%;
                  transform: translate(-50%, 0%);
                  width: 100%;
              }
              .block-three-media .gallery-block__image .gallery-block__image-text .text-overlay__block{
                margin-bottom:0;
                color:{{ block.settings.title_color }};
              }
              @media (max-width:768px){
                .block-three-media .gallery-block__image .gallery-block__image-text{
                  padding:3%;
                }
                .block-three-media .gallery-block__image .gallery-block__image-text .feature-title{
                  position: relative;
                }
                .block-three-media .gallery-block__image{
                  align-items: center;
                }
              }
            {% endstyle %}
            {% liquid
              assign one_img = block.settings.image_one
              assign two_img = block.settings.image_two
              assign three_img = block.settings.image_three

              assign one_title = block.settings.one_title
              assign one_sub_title = block.settings.one_sub_title
              assign one_strong_title = block.settings.one_strong_title
              assign one_feature_title = block.settings.one_feature_title

              assign two_title = block.settings.two_title
              assign two_sub_title = block.settings.two_sub_title
              assign two_strong_title = block.settings.two_strong_title
              assign two_feature_title = block.settings.two_feature_title

              assign three_title = block.settings.three_title
              assign three_sub_title = block.settings.three_sub_title
              assign three_strong_title = block.settings.three_strong_title
              assign three_feature_title = block.settings.three_feature_title

              assign strong_title_size = block.settings.strong_title_size
              assign title_weight = block.settings.title_weight
              assign title_uppercase = block.settings.title_uppercase
            %}

            <div class="block-{{ block.id }} block-three-media block relative flex flex-col gallery-block h-full" tabindex="-1" {{ block.shopify_attributes }}>
              <div class="gallery-block__image {% if section.settings.is_text_below_the_picture != blank %}{% else %} overflow-hidden{% endif %} flex relative w-full h-full {{ overlay_position | first }} {{ overlay_position | last }}{% if is_link %} {% if section.settings.is_text_below_the_picture != blank %}{% else %} card__media{% endif %}{% endif %}">
                <div class="media media--has-overlay flex absolute top-0 left-0 w-full h-full has-motion {% if section.settings.is_image_has_rounded_corners != blank %}image-has-rounded-corners{% endif %}">
                  {%- if one_img != blank -%}
                    {%- capture sizes %}{% render 'sizes-attribute', grid: true, min: section.settings.gallery_cols_min, sm: block.settings.columns %}{% endcapture -%}
                    {% liquid
                      assign ima_banner_sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                    %}
                    {% render 'image',
                      image: one_img,
                      widths: '480, 800, 980, 1024, 1440, 1920',
                      src_width: 980,
                      src_placeholder: true,
                      sizes: ima_banner_sizes,
                      quality: 1,
                      section_index: section.index,
                      class: 'img-fit'
                    %}
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                  {%- endif -%}
                </div>
                <div class="gallery-block__image-text text-overlay text-overlay--grow relative"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
                   {%- if one_title != blank -%}
                      <h3 class="text-overlay__block subheading text-current">
                        {{- one_title | escape -}}
                      </h3>
                    {%- endif -%}
        
                    <{% if strong_title_size != blank %}{{ strong_title_size }}{% endif %} class="text-current mb-0 rte {% if title_weight != blank %} font-weight{% endif %}{% if title_uppercase != blank %} font-uppercase{% endif %}" {% if block.settings.is_show_color_font != blank %}style="background-image: linear-gradient({{ block.settings.strong_title_color_1 }}, {{ block.settings.strong_title_color_2 }});-webkit-background-clip: text;color: transparent;font-size:{{ block.settings.strong_title_size_value }}px;"{% endif %}>
                        {{- one_strong_title | escape -}}
                    </{% if strong_title_size != blank %}{{ strong_title_size }}{% endif %}>
      
                    {% if one_sub_title != blank %}
                      <p class="text-overlay__block subheading text-current">
                        {{ one_sub_title | escape }}
                      </p>
                    {% endif %}

                    {% if one_feature_title != black %}
