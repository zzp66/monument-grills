{%- comment -%}theme-check-disable LiquidTag{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- liquid
    # constants
    assign breakpoint_sm = 600
    assign breakpoint_md = 769
    assign breakpoint_lg = 1024

    if section.index == 1 or section.settings.prevent_animation
      assign lazy_load_images = false
    else
      assign lazy_load_images = true
    endif

    if section.settings.layout == 'carousel'
      assign carousel = true
      if section.settings.column_size == 'small'
        assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-4 '
      elsif section.settings.column_size == 'medium'
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2 lg:auto-cols-3'
      else
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2'
      endif

    else
      assign carousel = false
    endif

    assign color_scheme = section.settings.color_scheme

    if section.settings.image_ratio == 'shortest'
      assign image_ratio = 0
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio > image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    elsif section.settings.image_ratio == 'tallest'
      assign image_ratio = 99
      for block in section.blocks
        assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
        if this_image_ratio < image_ratio
          assign image_ratio = this_image_ratio
        endif
      endfor
    else
      assign image_ratio = section.settings.image_ratio
    endif
  -%}
  {% style %}
    .multi-column-imgs .images-box ul{
      grid-gap: 30px 30px;
    }
    
    .multi-column-imgs .slider{
      scrollbar-color: #c00000 #ddd;
    }
  {% endstyle %}
  {%- if carousel == false -%}
    {% style %}
      {% if section.settings.column_size == 'small' %}
        @media (min-width: {{ breakpoint_sm }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .multi-column {
            width: calc(25% - var(--column-gap));
          }
        }
      {% else %}
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        {% if section.settings.column_size == 'medium' %}
          @media (min-width: {{ breakpoint_lg }}px) {
            #{{ section.id }} .multi-column {
              width: calc((100% / 3) - var(--column-gap));
            }
          }
        {% endif %}
      {% endif %}
    {% endstyle %}
  {%- endif -%}

  <div class="section" id="{{ section.id }}">
    {%- if section.settings.title != blank or section.settings.button_label != blank -%}
      <div class="{% if section.settings.full_screen %}multi-column-img-title{% else %} container{% endif %}">
        <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          {%- if section.settings.title != blank -%}
            <h2 class="h4 section__heading mb-0 flex-auto {{ section.settings.heading_align }}">
              {{- section.settings.title | escape -}}
            </h2>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if carousel -%}
    <carousel-slider class="carousel block" inactive  id="{{ section.settings.link_id }}">
      <div class="{% if section.settings.full_screen %}multi-column-imgs{% else %} container{% endif %} relative">
        <div class="slider" id="slider-{{ section.id }}">
    {%- endif -%}

      <div class="{% if section.settings.full_screen %}images-box{% else %} container{% endif %}">
        <ul class="{% if carousel %}slider__grid grid {{ grid_classes }}{% else %} flex flex-wrap{% endif %} gap-x-theme{% if color_scheme == 'none' and carousel == false %} gap-y-12 md:gap-y-6{% else %} gap-y-6{% endif %}" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              if section.settings.image_ratio == "natural"
                if block.settings.image != blank
                  assign image_ratio = block.settings.image.aspect_ratio
                else
                  assign image_ratio = 1.77
                endif
              endif
            -%}
            {% if forloop.length > 4 %}
              {% style %}
                   #{{ section.id }} .multi-column-imgs .slider .images-box ul{
                      column-gap: 10px;
                    }
                   @media (max-width: 768px){
                      #{{ section.id }} .multi-column-imgs .slider .images-box ul{
                        width: 100%;
                        grid-auto-columns: 80%;
                        column-gap: 10px;
                      }
                   }
                {% endstyle %}
            {% else %}
              {% style %}
                   #{{ section.id }} .multi-column-imgs .slider .images-box ul{
                      column-gap: 30px;
                    }
                    @media (max-width: 768px){
                        #{{ section.id }} .multi-column-imgs .slider .images-box ul{
                          width: 100%;
                          grid-auto-columns: 80%;
                          column-gap: 10px;
                        }
                     }
                {% endstyle %}
            {% endif %}
            {% if forloop.length == 1 %}
              {% style %}
                .card-full{
                    flex-direction: column;
                    max-width: 100%;
                    height: auto;
                    overflow: hidden;
                    margin: 0 auto;
                }
                .card-full .card__media{
                    padding-top: 0 !important;
                    flex: auto;
                }
                .card-full .card__info{
                    display:none;
                    flex: auto;
                    padding: calc(8 * var(--space-unit));
                }
                @media (max-width:768px){
                  .card-full{
                    height: auto;
                  }
                  .card-full .card__media{
                    flex: 0 0 50%;
                    min-height: 90vw;
                  }
                }
              {% endstyle %}
              <li class="multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} " {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="card-full{% if block.settings.round %} image-round {% endif %}{% if block.settings.video_shopify != blank %} video-section{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative flex flex-col h-full">
                  {%- if block.settings.enable_media -%}
                    {%- liquid
                      if section.settings.column_size == 'small'
                        assign cols = 3
                      else
                        assign cols = 2
                      endif
                      capture sizes
                        render 'sizes-attribute', grid: true, min: 1, md: cols
                      endcapture
                    -%}
  
                    <div class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}" style="{% unless section.settings.image_ratio == "natural" %}padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;{% endunless %}{% if section.settings.image_ratio == "natural" and block.settings.video_shopify %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}">
                      {%- if block.settings.image != blank or block.settings.video_shopify != blank -%}
                        {%- if block.settings.video_shopify != blank -%}
                          <deferred-media class="media absolute top-0 left-0 w-full h-full">
                            <template>
                              <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                               data-autoplay="true"
                               data-background="true">
                                {{ block.settings.video_shopify | video_tag: class: 'img-fit promo__mp4 pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                              </video-component>
                            </template>
                          </deferred-media>
                        {%- endif -%}
  
                        {%- if block.settings.image != blank %}
                          {%- liquid
                            assign image_class = "video-played-hidden"
                            unless section.settings.image_ratio == "natural"
                              assign image_class = image_class | append: " img-fit"
                            endunless
                            if section.settings.image_ratio == "natural" and block.settings.video_shopify != blank
                              assign image_class = image_class | append: " img-fit"
                            endif

                          -%}
                          
                          {%- render 'image',
                            image: block.settings.image,
                            widths: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                            src_width: 1400,
                            src_placeholder: true,
                            sizes: sizes,
                            lazy_load: lazy_load_images,
                            class: img-fit hidden sm:block
                          -%}
                          {% comment %}
                          {% render 'image',
                            image: block.settings.image,
                            widths: '460, 700, 860, 1296',
                            src_width: 700,
                            sizes: sizes,
                            section_index: section.index,
                            class: image_class,
                            lazy_load: lazy_load_images
                          %}
                          {% endcomment %}
                        {%- endif -%}
                      {%- else -%}
                        {%- liquid
                          assign placeholder_class = "media__placeholder"
                          unless section.settings.image_ratio == "natural"
                            assign placeholder_class = placeholder_class | append: " img-fit"
                          endunless
                        -%}
                        {{- 'image' | placeholder_svg_tag: placeholder_class -}}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </li>
            {% else %}
              <li class="multi-column grow w-full max-w-none{% if carousel %} slider__item{% endif %} " {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="card{% if block.settings.round %} image-round {% endif %}{% if block.settings.video_shopify != blank %} video-section{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} relative flex flex-col h-full" style="{% if section.settings.full_screen %}max-width:100%;{% endif %}">
                  {%- if block.settings.enable_media -%}
                    {%- liquid
                      if section.settings.column_size == 'small'
                        assign cols = 3
                      else
                        assign cols = 2
                      endif
                      capture sizes
                        render 'sizes-attribute', grid: true, min: 1, md: cols
                      endcapture
                    -%}
  
                    <div class="card__media media relative w-full{% if section.settings.image_ratio == "natural" %} {{ section.settings.media_align }}{% endif %}" style="{% unless section.settings.image_ratio == "natural" %}padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;{% endunless %}{% if section.settings.image_ratio == "natural" and block.settings.video_shopify %}padding-top: 56.25%;{% endif %}{% if block.settings.media_scale < 100 %} transform: scale({{ block.settings.media_scale | divided_by: 100.0 }});{% endif %}">
                      {%- if block.settings.image != blank or block.settings.video_shopify != blank -%}
                        {%- if block.settings.video_shopify != blank -%}
                          <deferred-media class="media absolute top-0 left-0 w-full h-full">
                            <template>
                              <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden"
                               data-autoplay="true"
                               data-background="true">
                                {{ block.settings.video_shopify | video_tag: class: 'img-fit promo__mp4 pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                              </video-component>
                            </template>
                          </deferred-media>
                        {%- endif -%}
  
                        {%- if block.settings.image != blank %}
                          {%- liquid
                            assign image_class = "video-played-hidden"
                            unless section.settings.image_ratio == "natural"
                              assign image_class = image_class | append: " img-fit"
                            endunless
                            if section.settings.image_ratio == "natural" and block.settings.video_shopify != blank
                              assign image_class = image_class | append: " img-fit"
                            endif
                          -%}
                          {% render 'image',
                            image: block.settings.image,
                            widths: '460, 700, 860, 1296',
                            src_width: 700,
                            sizes: sizes,
                            section_index: section.index,
                            class: image_class,
                            lazy_load: lazy_load_images
                          %}
                        {%- endif -%}
                      {%- else -%}
                        {%- liquid
                          assign placeholder_class = "media__placeholder"
                          unless section.settings.image_ratio == "natural"
                            assign placeholder_class = placeholder_class | append: " img-fit"
                          endunless
                        -%}
                        {{- 'image' | placeholder_svg_tag: placeholder_class -}}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </li>
            {% endif %}
            
          {%- endfor -%}
        </ul>
      </div>

    {%- if carousel -%}
          </div>
          {%- if settings.slider_show_arrows != 'never' -%}
            <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                {% render 'icon-chevron-right' %}
              </button>
              <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
                <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                {% render 'icon-chevron-left' %}
              </button>
            </div>
          {%- endif -%}
        </div>
      </carousel-slider>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Multi-image -- wenfei",
  "class": "cc-multi-column",
  "settings": [
    {
      "type": "header",
      "content": "Quick jump"
    },
    {
      "type": "text",
      "id": "link_id",
      "label": "Link ID"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "Full screen",
      "default": false
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Multi-column"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-start",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-end",
          "label": "Right"
        }
      ],
      "default": "text-start"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View more label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View more link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "column_size",
      "label": "Column size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "column_align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_align",
      "label": "Media alignment",
      "info": "Applies to small images with a \"Natural\" aspect ratio.",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Media aspect ratio",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "shortest",
          "label": "Height of shortest image"
        },
        {
          "value": "tallest",
          "label": "Height of tallest image"
        },
        {
          "value": "1.77",
          "label": "Landscape"
        },
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.75",
          "label": "Portrait"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Buttons",
      "options": [
        {
          "value": "link",
          "label": "Link"
        },
        {
          "value": "btn btn--primary",
          "label": "Primary button"
        },
        {
          "value": "btn btn--secondary",
          "label": "Secondary button"
        }
      ],
      "default": "btn btn--secondary"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "id": "enable_media",
          "type": "checkbox",
          "label": "Enable media",
          "default": true
        },
        {
          "id":"round",
          "type":"checkbox",
          "label":"Image Round",
          "default":false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video_shopify",
          "label": "Video upload",
          "info": "Hosted by Shopify. Video will autoplay and be muted. [Read more](https://cleancanvas.co.uk/support/enterprise/using-videos)"
        },
        {
          "type": "range",
          "id": "media_scale",
          "min": 65,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Media scale",
          "default": 100
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave blank for an arrow button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-image -- wenfei",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
{% style %}
  .image-round img{
    left: 50%;
    top: 20%;
    transform: translateX(-50%);
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
  }
  @media (max-width:850px){
    .cc-multi-column .container{
      padding:0;
    }
  }
{% endstyle %}
