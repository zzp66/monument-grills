{{ 'swiper.min.css' | asset_url | stylesheet_tag }}
{% if section.index > 2 %}
  <link rel="stylesheet" href="{{ 'video.css' | asset_url }}" media="print" onload="this.media='all'">
{% else %}
  {{ 'video.css' | asset_url | stylesheet_tag }}
{% endif %}
<script src="{{ 'video.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign breakpoint_sm = 600
  assign breakpoint_md = 769
  assign breakpoint_xxl = 1536
  assign breakpoint_sm_down = breakpoint_sm | minus: 0.02

  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  if section.index == 1 or section.settings.prevent_animation
    assign lazy_load_images = false
  else
    assign lazy_load_images = true
  endif
%}

{% style %}
  .section-warp h2 {
      font-style: italic;
      text-align: center;
      color:#111;
    }

    .section-warp .swiper-container {
        padding-bottom: 40px;
    }


    .section-warp .swiper-slide {
        width: 1024px;
        /* width:56.25vw; */
        height:576px;
        opacity:.8;
        transition-timing-function: linear;
    }
    .section-warp .swiper-slide .video-section .has-video{
      width:100%;
      max-width:100%;
    }
    .section-warp .swiper-slide.swiper-slide-active{
      opacity:1;
      transition-timing-function: linear;
    }

    @media only screen and (max-width:1200px) {
        .section-warp .swiper-slide {
            width: 770px;
        }
    }

    @media only screen and (max-width:980px) {
        .section-warp .swiper-slide {
            width: 471px;
        }
    }

    @media only screen and (max-height:480px) {
        .section-warp .swiper-slide {
            width: 100%;
        }
    }

    .section-warp .swiper-slide img {
        width: 100%;
        border-radius: 4px;
      position:relative;
    }
  .section-warp .swiper-slide video{
    width:100%;
  }

    .section-warp .swiper-slide .title {
        position: absolute;
        z-index: 10;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);

        /* transform: rotate(90deg);
        transform-origin: left top;
        left: -3px;
        font-size: 11px;
        color: rgb(102, 102, 102); */
    }

    .section-warp .swiper-button-next,
    .section-warp .swiper-button-prev {
        /* width: 86px;
        height: 112px;
        background-size: 86px 112px; */
        background-size:50%;
        margin-top: -56px;
        outline: none;
        opacity: 1;
    }

    .section-warp .swiper-button-next {
        /* background-image: url(https://cdn.shopify.com/s/files/1/1639/3511/files/cursor-next.png?v=1721212944); */
    }

    .section-warp .swiper-button-prev {
        /* background-image: url(https://cdn.shopify.com/s/files/1/1639/3511/files/cursor-prev.png?v=1721212944); */
    }

    .section-warp .swiper-pagination-bullet {
        background: none;
        opacity: 1;
        margin: 0 6px !important;
        width: 9px;
        height: 9px;
        position: relative;
        outline: none;
        vertical-align: middle;
    }

    .section-warp .swiper-pagination-bullet span {
        width: 3px;
        height: 3px;
        background: #CCC;
        display: block;
        border-radius: 50%;
        margin-top: 3px;
        margin-left: 3px;
    }

    .section-warp .swiper-pagination-bullet i {
        background: #000;
        height: 1px;
        width: 20px;
        position: absolute;
        top: 4px;
        transform: scaleX(0);
        transform-origin: left;
        z-index: 3;
        transition-timing-function: linear;
    }

    .section-warp .swiper-pagination-bullet i {
    .section-warp .swiper-pagination-bullet i {
    .section-warp .swiper-pagination-bullet i {
    .section-warp .swiper-pagination-bullet-active span,
    .section-warp .swiper-pagination-bullet:hover span {
        width: 9px;
        height: 9px;
        margin-top: 0;
        margin-left: 0;
        background: #000;
        position: relative;
        z-index: 1;
    }

    .section-warp .swiper-pagination-bullet-active i {
        animation: middle 6s;
    }

    .section-warp .swiper-pagination-bullet:first-child.swiper-pagination-bullet-active i {
        animation: first 6s;
    }

    .section-warp .swiper-pagination-bullet:last-child.swiper-pagination-bullet-active i {
        animation: last 6s;
    }

    @keyframes first {
        0% {
            transform: scaleX(0.5);
            left: 0px;
        }

        /*091*/
        100% {
            transform: scaleX(1);
            left: 2px;
        }

        /*0915*/
    }

    @keyframes last {
        0% {
            transform: scaleX(0.7);
            left: -10px;
        }

        /*1090*/
        20% {
            transform: scaleX(0.3);
            left: 2px;
        }

        /*090*/
        100% {
            transform: scaleX(0.3);
            left: 0px;
        }

        /*090*/
    }

    @keyframes middle {
        0% {
            transform: scaleX(0.7);
            left: -10px;
        }

        /*1091*/
        20% {
            transform: scaleX(0.45);
            left: 2px;
        }

        /*092*/
        100% {
            transform: scaleX(1);
            left: 2px;
        }

        /*0913*/
    }


  {%- if section.settings.height_mode == 'fixed' -%}
    #{{ section.id }} .swiper-slide { min-height: {{ section.settings.fixed_height_mobile }}px; }

    {%- if section.settings.mobile_stacked -%}
      @media (max-width: {{ breakpoint_sm_down }}px) {
        #{{ section.id }} .swiper-slide { min-height: {{ section.settings.fixed_height_mobile }}px; }
      }
    {%- endif -%}

    @media (min-width: {{ breakpoint_sm }}px) {
      #{{ section.id }} .swiper-slide {
        min-height: calc({{ section.settings.fixed_height_mobile }}px + ({{ section.settings.fixed_height_desktop }} - {{ section.settings.fixed_height_mobile }}) * ((100vw - {{ breakpoint_sm }}px) / {{ breakpoint_xxl | minus: breakpoint_sm }}));
      }
    }
    @media (min-width: {{ breakpoint_md }}px) {
      #{{ section.id }} .swiper-slide { min-height: {{ section.settings.fixed_height_desktop }}px; }
    }
  {%- endif -%}

  @media (max-width:850px){
    #{{ section.id }} .image-swiper .section{
      padding: 0;
    }
    #{{ section.id }} .image-swiper .max-w-screen-lg{
      max-width:100%;
    }
    #{{ section.id }} .swiper-wrapper{
      height:auto%;
    }
    #{{ section.id }} .swiper-wrapper .swiper-slide .max-w-screen-lg{
      max-width:100%;
    }

  }
  #{{ section.id }}.image-swiper{
    display: block;
    width: 100%;
    height: 100%;
    background-image:url({{ section.settings.swiper_bg }});
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 1;
  }
{% endstyle %}

<div
  class="section {{ section.class }} {% if section.settings.mobile_stacked and section.settings.height_mode != 'screen' %} mobile-stacked {% if section.settings.full_width and bg_color == false or bg_color == settings.bg_color %} mobile-stacked--spaced{% endif %}{% endif %}{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %} {% if section.settings.full_width %}{% else %} container use-image-banner{% endif %}"
  id="{{ section.id }}"
>
  <div
    class="section-warp {% if section.settings.full_width %}{% else %} container{% endif %}"
    style="background: {{ section.settings.lunbo_bg }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;"
  >
    {% if section.settings.header_title != blank %}
      <h2 class="pt-4 {% if section.settings.pc_title_font_size %}font-size {% endif %} {% if section.settings.header_weight %}font-weight {% endif %} {% if section.settings.header_uppercase != blank %}font-uppercase {% endif %} {% if section.settings.header_color %}font-color{% endif %}">
        {{ section.settings.header_title | escape }}
      </h2>
      {% style %}
        #{{ section.id }} .font-color{
          color: {{ section.settings.header_color }};
        }
        #{{ section.id }} .font-size{
          font-size: {{ section.settings.pc_title_font_size }}px;
        }
        #{{ section.id }} .uppercase{
          text-transform:uppercase;
        }
        #{{ section.id }} .font-weight{
          font-weight:blod;
        }
        @media (max-width:850px){
          #{{ section.id }} .font-size{
            font-size: {{ section.settings.mobile_title_font_size }}px;
          }

        }
      {% endstyle %}
    {% endif %}
    <div class="swiper-container grills-day-container">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% style %}
            {%- if section.settings.mobile_stacked -%}
              @media (max-width: {{ breakpoint_sm_down }}px) {
                #{{ section.id }} .swiper-slide { padding-top: {{ m_img_padding }};}
                #{{ section.id }} .swiper-slide::after,
                #{{ section.id }} .media::after {
                  padding-top: 0;
                }
              }
            {%- endif -%}

            @media (min-width: {{ breakpoint_md }}px){

            }
            @media (max-width: {{ breakpoint_sm }}px) {
              #{{ section.id }} .swiper-slide .title-size{
                font-size:{{ block.settings.mobile_title_size }}px;
              }
            }
          {% endstyle %}
          {%- liquid
            assign using_video_tag = false
            assign autoplay = block.settings.video_autoplay
            assign slide_title = block.settings.header_title
            assign video_class = 'cur-video'

            if block.settings.video_shopify != blank
              assign using_video_tag = true
            endif
          -%}
          <div class="swiper-slide">
            {% if slide_title != blank %}
              <h3 class="title section.settings.overlay_position {% if block.settings.title_size %}title-size{% endif %} {% if block.settings.title_color %} title-color{% endif %}">
                {{ slide_title | escape }}
              </h3>
            {% endif %}
            <!-- video start -->
            {%- capture video_component -%}
                    <video-component class="{% if using_video_tag %}has-video{% else %}has-iframe{% endif %} block w-full h-full"
                                     data-video-url="{{ block.settings.video_external }}" 
                                     data-video-id="{{ section.id }}"
                                     data-autoplay="{% if autoplay %}true{% else %}false{% endif %}"
                                     data-background="false"
                                     data-description="{{ block.settings.video_description | escape }}">
                      {%- if using_video_tag -%}
                        {{ block.settings.video_shopify | video_tag: playsinline: true, autoplay: autoplay, muted: autoplay, controls: true, poster: '', class: video_class  | replace: '<img ', '<img loading="lazy" hidden ' }}
                      {%- else -%}
                        <div></div>
                      {%- endif -%}
                    </video-component>
                  {%- endcapture -%}

            {% capture youtube_url %}
                      <iframe width="100%" height="100%" src="{{ block.settings.video_external }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  {% endcapture %}

            <div class="video-section relative flex mx-auto overflow-hidden flex-col{% if block.settings.video_size == 'sm' %} max-w-screen-md{% elsif block.settings.video_size == 'md' %} max-w-screen-lg{% endif %}">
              {% if section.blocks.size > 0 %}
                {% if autoplay %}
                  <deferred-media class="deferred-media block top-0 left-0 w-full h-full no-js-hidden">
                    <template>{{ video_component }}</template>
                  </deferred-media>

                  <noscript>
                    <div class="absolute top-0 left-0 w-full h-full">
                      {{ video_component }}
                    </div>
                  </noscript>
                  {% style %}
                    @media (max-width: {{ breakpoint_sm }}px) {
                      #{{ section.id }} .video-section .deferred-media .has-iframe iframe{
                        width: 100% !important;
                        height: auto !important;
                      }
                      #{{ section.id }} .section-warp .swiper-container{
                        padding-bottom:0;
                      }
                       #{{ section.id }} .section-warp {
                        padding-top: 0 !important;
                      }
                    }
                  {% endstyle %}
                {% else %}
                  <deferred-media
                    class="height-clip top-0 left-0 w-full h-full no-js-hidden"
                    {% if using_video_tag and autoplay == false %}
                      data-hide-controls-instantly="true"
                    {% endif %}
                  >
                    <button
                      type="button"
                      class="video-section__play-btn absolute top-0 left-0 flex justify-center items-center w-full h-full video-played-hidden js-load-media"
                    >
                      <span class="visually-hidden">{{ 'general.icon_labels.play' | t }}</span>
                      {%- render 'icon-play' -%}
                    </button>
                    <template>
                      {{ youtube_url }}
                    </template>
                  </deferred-media>
                {% endif %}
              {% endif %}
              {% comment %}
                <div class="media media--has-overlay absolute top-0 left-0 w-full h-full">
                  {%- liquid
                    assign sizes = false
                    assign class = 'img-fit object-center'
                  -%}
                  {%- if block.settings.video_cover != blank or block.settings.video_shopify != blank -%}
                    {%- assign poster_image = block.settings.video_cover -%}
                    {%- capture sizes -%}
                      {%- render 'sizes-attribute', min: '100vw', sm: 'page', md: false, lg: false, xl: 'page', max: 'page' -%}
                    {%- endcapture -%}
                    {% render 'image',
                      image: poster_image,
                      widths: '750, 856, 1440, 1680, 1920, 2560',
                      src_width: 856,
                      src_placeholder: true,
                      sizes: sizes,
                      section_index: section.index,
                      class: class
                    %}
                  {%- else -%}
                    {%- assign class = class | prepend: 'media__placeholder ' -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: class }}
                  {%- endif -%}
                </div>
              {% endcomment %}
            </div>
            <!-- end video start -->
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</div>
{% style %}
  .section-warp .swiper-pagination-bullet span {
    width: 6px;
    height: 6px;
  }
  .section-warp .swiper-pagination-bullet.swiper-pagination-bullet-active span {
    background: #c00000;
  }
{% endstyle %}

<script src="{{ 'swiper.min.js' | asset_url }}" async></script>
<script>
  setTimeout(() => {
    while (!Swiper) {}

    var swiper = new Swiper('.swiper-container', {
      height: 576,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      speed: 700,
      allowTouchMove: false,
      lazy: {
        loadPrevNext: true,
        loadPrevNextAmount: 3,
      },
      centeredSlides: true,
      slidesPerView: 'auto',
      spaceBetween: 30,
      slidesOffsetBefore: 30,
      loop: true,
      breakpoints: {
        320: {
          slidesPerView: 1,
          spaceBetween: 20,
        },
        480: {
          slidesPerView: 1,
          spaceBetween: 20,
        },
        640: {
          slidesPerView: 2,
          spaceBetween: 20,
        },
      },
      on: {
        slideChangeTransitionEnd: function () {
          this.slides.transition(this.params.autoplay.delay + this.params.speed).transform('translate3d(-60px, 0, 0)');
        },
        slideChangeTransitionStart: function () {
          this.slides.transition(this.params.speed).transform('translate3d(0, 0, 0)');
        },
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
        renderBullet: function (index, className) {
          return '<div class="' + className + '"><span></span><i></i></div>';
        },
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    window.onresize = function () {
      swiper.update();
    };
  }, 150);
</script>

