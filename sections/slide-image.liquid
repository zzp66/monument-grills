<style>
.slideimg__item {
    display: block;
    position: relative;
}
  .slideimg_wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    color: #fff;
    padding: 40px;
}
  .slideimg_wrapper h3 {
    color: #fff;
    font-weight: 600;
    margin-bottom: 5px;
}
  .slideimg__btn {
    margin-top:15px
}
  .slide_head_sec h2 {
    text-align: center;
    margin-bottom: 20px;
}
  a.slideimg__item img {
    vertical-align: middle;
}
  .slideimg_container {
    margin-bottom: 30px;
}
  .swiper-button-next.sbn {
    width: 50px;
    height: 50px;
    border-radius: 50px;
    background: rgb(0 0 0 / 43%);
}
  .swiper-button-prev.sbp{
     width: 50px;
    height: 50px;
    border-radius: 50px;
    background: rgb(0 0 0 / 43%);
  }
  .swiper-button-next.sbn:after, .swiper-rtl .swiper-button-prev.sbp:after {
    font-size: 20px;
    color: #fff;
}
 .swiper-button-prev.sbp:after, .swiper-rtl .swiper-button-next.sbn:after{
     font-size: 20px;
    color: #fff;
  }
  section.slideimg_sec {
    margin-top: 30px;
}
  
   @media(min-width:992px){
    .slideimg_sec .swiper-slide {
        width: 50%;
       margin-right:20px
      }
   }
  @media(max-width:991px){
     a.slideimg__item img {
    height: 300px;
    object-fit: cover;
}
    .swiper-button-prev.sbp, .swiper-button-next.sbn {
  display:none
}
    .slideimg_wrapper{
      padding:20px
    }
  }
</style>
<section class="slideimg_sec" style="display:">
  <div class="container">
  <div class="slide_head_sec">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  
  <div class="slideimg_container">
     <div class="swiper slideimgSwiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <a href="{{ block.settings.link }}" class="slideimg__item">
                <img src="{{ block.settings.image | img_url:'master' }}" />
                <div class="slideimg_wrapper">
                  <h3>{{ block.settings.title }}</h3>
                  <div class="slideimg_info">{{ block.settings.content }}</div>
                  <div class="slideimg__btn btn btn--primary ">Shop Now</div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-button-next sbn"></div>
    <div class="swiper-button-prev sbp"></div>
       <!-- <div class="swiper-pagination swiper-pages"></div> -->
     </div>
  </div>
  </div>
</section>
 <!-- <link rel="stylesheet" href="https://cdn.shopify.com/s/files/1/1639/3511/files/swiper-bundle.min.css?v=1744188233"> -->
 <!-- <link rel="stylesheet" href="{{ 'swiper.css' | asset_url }}"> -->
<!-- <script src="{{ 'swiper.js' | asset_url }}"></script> -->
  <!-- <script src="https://cdn.shopify.com/s/files/1/1639/3511/files/swiper-bundle.min.js?v=1744188234"></script> -->
  <script>
document.addEventListener('DOMContentLoaded', function() {
    // 确保Swiper已加载
    if (typeof Swiper !== 'undefined') {
        const slideimgSwiper = new Swiper('.slideimgSwiper', {
          
           slidesPerView: 2,
            spaceBetween: 20,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false
            },
            observer: true, // 启用动态检查
            observeParents: true, // 监测父元素变化
          breakpoints: { 
    1280: {
                    slidesPerView: 2,
            spaceBetween: 20,
                },
                768: {
                     slidesPerView: 2,
            spaceBetween: 20,
                },
                0: {  
                    slidesPerView: 1.2,
                    spaceBetween: 10,
                }
    },
            navigation: {
        nextEl: ".sbn",
        prevEl: ".sbp",
      },
            // 添加触摸支持
            allowTouchMove: true,
            grabCursor: true,
            // 添加调试事件
            on: {
                init: function() {
                    console.log('Swiper initialized');
                },
                touchStart: function() {
                    console.log('Touch started');
                }
            },
           
        });
    }
});
  </script>
{% schema %}
{
  "name": "Slide images",
  "class": "cc-Slide-images",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
         {
          "type": "text",
          "id": "title",
          "label": "title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
      
        {
          "type": "url",
          "id": "link",
          "label": "link"
        }
       
       
      ]
    }
  ],
  "presets": [
    {
      "name": "Slide images",
     
    }
  ]
 
}
{% endschema %}
