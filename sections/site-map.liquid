{%- if section.blocks.size > 0 -%}
  {%- liquid
    # constants
    assign breakpoint_sm = 600
    assign breakpoint_md = 769
    assign breakpoint_lg = 1024

    if section.settings.layout == 'carousel'
      assign carousel = true
      if section.settings.column_size == 'small'
        assign grid_classes = 'grid-flow-col auto-cols-1 sm:auto-cols-2 md:auto-cols-3 lg:auto-cols-3 '
      elsif section.settings.column_size == 'medium'
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2 lg:auto-cols-3'
      else
        assign grid_classes = 'grid-flow-col auto-cols-1 md:auto-cols-2'
      endif

    else
      assign carousel = false
    endif

    
  -%}
  {% style %}
    .sitemap-box ul li a{
        margin-bottom:10px;
        text-decoration: underline;
      }
      .sitemap-box ul li a:hover{
        color:#c00000;
      }
  {% endstyle %}
  {%- if carousel == false -%}
    {% style %}
      
      
      {% if section.settings.column_size == 'small' %}
        @media (min-width: {{ breakpoint_sm }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc((100% / 3) - var(--column-gap));
          }
        }
        @media (min-width: {{ breakpoint_lg }}px) {
          #{{ section.id }} .multi-column {
            width: calc(25% - var(--column-gap));
          }
        }
      {% else %}
        @media (min-width: {{ breakpoint_md }}px) {
          #{{ section.id }} .multi-column {
            width: calc(50% - var(--column-gap));
          }
        }
        {% if section.settings.column_size == 'medium' %}
          @media (min-width: {{ breakpoint_lg }}px) {
            #{{ section.id }} .multi-column {
              width: calc((100% / 3) - var(--column-gap));
            }
          }
        {% endif %}
      {% endif %}
    {% endstyle %}
  {%- endif -%}

  <div class="section" id="{{ section.id }}">
    {%- if section.settings.title != blank or section.settings.button_label != blank -%}
      <div class="container">
        <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          {%- if section.settings.title != blank -%}
            <{{ section.settings.title_size }} class="ection__heading mb-0 flex-auto {{ section.settings.heading_align }}">
              {{- section.settings.title | escape -}}
            </{{ section.settings.title_size }}>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if carousel -%}
      <carousel-slider class="carousel block" inactive>
        <div class="container relative">
          <div class="slider" id="slider-{{ section.id }}">
    {%- endif -%}

    <div class="{% if section.settings.full_width != blank %}{% else %}container{% endif %}{% if section.settings.show_sitemap_html != blank %} sitemap-box{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;margin: auto;">
      <ul class="{% if carousel %}slider__grid grid {{ grid_classes }}{% else %} flex flex-wrap{% endif %} gap-x-theme gap-y-theme" role="list">
        {%- for block in section.blocks -%}
          {% if block.settings.link_name_1 != blank or 
                block.settings.link_name_2 != blank or 
                block.settings.link_name_3 != blank or
                block.settings.link_name_4 != blank or
                block.settings.link_name_5 != blank or
                block.settings.link_name_6 != blank or
                block.settings.link_name_7 != blank or
                block.settings.link_name_8 != blank or
                block.settings.link_name_9 != blank or
                block.settings.link_name_10 != blank or
                block.settings.link_name_11 != blank or
                block.settings.link_name_12 != blank or
                block.settings.link_name_13 != blank or
                block.settings.link_name_14 != blank or
                block.settings.link_name_15 != blank or
                block.settings.link_name_16 != blank or
                block.settings.link_name_17 != blank or
                block.settings.link_name_18 != blank or
                block.settings.link_name_19 != blank or
                block.settings.link_name_20 != blank or
                block.settings.column_title != blank
          %}
          <li class="multi-column block-{{ block.id }}{% if carousel %} slider__item{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %} {% if block.settings.enlarge_schema_typeof != blank %} typeof="schema:WebPage"{% endif %}>
              <div class="card relative flex flex-col h-full">
                <{{ block.settings.column_title_size }} class="section__block mb-4 section__block--subheading subheading md-down:px-gutter {% if block.settings.title_weight != blank %} font-weight{% endif %}{% if block.settings.title_uppercase != blank %} font-uppercase{% endif %}" {% if block.settings.enlarge_schema_typeof != blank %}typeof="schema:WebPage"{% endif %}>
                  <span class="contained-heading inline-block">{{- block.settings.column_title | escape -}}</span>
                </{{ block.settings.column_title_size }}>
                {% if block.settings.link_name_1 != blank %}
                  <a href="{{ block.settings.link_url_1 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_1 }}</a>
                {% endif %}
                {% if block.settings.link_name_2 != blank %}
                  <a href="{{ block.settings.link_url_2 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_2 }}</a>
                {% endif %}
                {% if block.settings.link_name_3 != blank %}
                  <a href="{{ block.settings.link_url_3 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_3 }}</a>
                {% endif %}
                {% if block.settings.link_name_4 != blank %}
                  <a href="{{ block.settings.link_url_4 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_4 }}</a>
                {% endif %}
                {% if block.settings.link_name_5 != blank %}
                  <a href="{{ block.settings.link_url_5 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_5 }}</a>
                {% endif %}
                {% if block.settings.link_name_6 != blank %}
                  <a href="{{ block.settings.link_url_6 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_6 }}</a>
