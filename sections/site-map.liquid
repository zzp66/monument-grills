                {% endif %}
                {% if block.settings.link_name_12 != blank %}
                  <a href="{{ block.settings.link_url_12 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_12 }}</a>
                {% endif %}
                {% if block.settings.link_name_13 != blank %}
                  <a href="{{ block.settings.link_url_13 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_13 }}</a>
                {% endif %}
                {% if block.settings.link_name_14 != blank %}
                  <a href="{{ block.settings.link_url_14 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_14 }}</a>
                {% endif %}
                {% if block.settings.link_name_15 != blank %}
                  <a href="{{ block.settings.link_url_15 }}" {% if block.settings.enlarge_target != blank %}target="_blank"{% endif %} {% if block.settings.enlarge_schema_property != blank %} property="schema:sameAs"{% endif %}>{{ block.settings.link_name_15 }}</a>
